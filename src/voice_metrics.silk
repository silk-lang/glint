//! Voice training acoustic metrics:
//!   - Vocal Size / Resonance (Apparent Vocal Tract Length in cm from F1..F4 weighted toward F2-F4,
//!     plus normalized Size score 0=big/dark .. 1=small/bright)
//!   - Vocal Weight (Iseli-Shue-Alwan F1/F2-corrected H1*-H2* + upper-harmonic spectral tilt
//!     across 500–3600 Hz, soft-sigmoid normalized 0=heavy/buzzy .. 1=light/thin so it never
//!     clips flat on close vowels or light voices)
//!   - Breathiness / Clarity (Praat Boersma HNR = 10*log10(r / (1 - r)) in dB)
//!   - Whole-clip summary (medians, F1/F2 vowel cloud centroid, active speech bounds)
//!   - Long-Term Average Spectrum (LTAS, 64 log-spaced bins from 60 Hz .. 6000 Hz)
import audio_native
import formants { FormantFrame }
import pitch { PitchFrame }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.usize

/// Speed of sound in warm vocal tract air (cm/s).
const SPEED_OF_SOUND_CM_S: f64 = 35000.0

/// Normalization bounds for apparent VTL (cm): 18.5 cm = very large/dark, 13.0 cm = very small/bright.
pub const VTL_BIG_CM: f64 = 18.5
pub const VTL_SMALL_CM: f64 = 13.0

/// Normalization bounds for H1-H2 (dB): -4 dB = heavy/thick, +14 dB = light/thin.
pub const H1H2_HEAVY_DB: f64 = -4.0
pub const H1H2_LIGHT_DB: f64 = 14.0

pub const LTAS_BINS: usize = 64
pub const LTAS_FMIN: f64 = 60.0
pub const LTAS_FMAX: f64 = 6000.0

pub struct VoiceFrame {
  pub time: f64,
  pub voiced: bool,
  pub f0: f64,
  pub intensityDb: f64,
  /// Apparent Vocal Tract Length (cm). Smaller = brighter/smaller resonance.
  pub vtlCm: f64,
  /// Normalized resonance/size in [0, 1] (0 = big/dark, 1 = small/bright), EMA-smoothed.
  pub sizeNorm: f64,
  /// Formant-corrected H1* - H2* harmonic difference (dB). Higher = lighter/thinner weight.
  pub h1h2Db: f64,
  /// Formant-corrected upper-harmonic spectral tilt (H1* vs 500–3600 Hz harmonics, dB).
  pub tiltDb: f64,
  /// Normalized vocal lightness in [0, 1] (0 = heavy/thick, 1 = light/thin), EMA-smoothed.
  pub weightLightNorm: f64,
  /// Harmonics-to-Noise Ratio (dB) from Boersma autocorrelation peak.
  pub hnrDb: f64,
  /// Smoothed Cepstral Peak Prominence (dB): noise-robust vocal-fold closure metric.
  pub cppsDb: f64,
  /// Epilaryngeal Twang/Ring ratio (2–4 kHz vs 300–1800 Hz, dB).
  pub twangDb: f64,
  /// Normalized Twang/Ring in [0, 1] (0 = mellow/covered, 1 = bright/ringy).
  pub twangNorm: f64,
  /// Acoustic pressed/strain index in [0, 1] (0 = easy/open, 1 = heavily pressed).
  pub strainNorm: f64,
  /// Formant snapshot for vowel cloud & aligned formant ribbon plotting.
  pub f1: f64,
  pub f2: f64,
  pub f3: f64,
  pub f4: f64,
  pub hasFormants: bool,
}

impl Copy for VoiceFrame {}

impl VoiceFrame {
  pub fn unvoiced(time: f64, intensityDb: f64) -> VoiceFrame {
    return VoiceFrame {
      time: time,
      voiced: false,
      f0: 0.0,
      intensityDb: intensityDb,
      vtlCm: 0.0,
      sizeNorm: 0.5,
      h1h2Db: 0.0,
      tiltDb: 15.0,
      weightLightNorm: 0.5,
      hnrDb: 0.0,
      cppsDb: 0.0,
      twangDb: -18.0,
      twangNorm: 0.4,
      strainNorm: 0.0,
      f1: 0.0,
      f2: 0.0,
      f3: 0.0,
      f4: 0.0,
      hasFormants: false,
    }
  }
}

pub struct VoiceSummary {
  pub voicedFrames: usize,
  pub medianF0: f64,
  pub medianVtlCm: f64,
  pub medianSizeNorm: f64,
  pub medianH1H2Db: f64,
  pub medianWeightLight: f64,
  pub medianHnrDb: f64,
  pub medianCppsDb: f64,
  pub medianTwangDb: f64,
  pub medianTwangNorm: f64,
  pub medianStrainNorm: f64,
  pub pitchSpanSt: f64,
  pub expressNorm: f64,
  pub meanF1: f64,
  pub meanF2: f64,
  pub formantCount: usize,
  pub activeStartSec: f64,
  pub activeEndSec: f64,
}

impl Copy for VoiceSummary {}

impl VoiceSummary {
  pub fn empty() -> VoiceSummary {
    return VoiceSummary {
      voicedFrames: 0,
      medianF0: 0.0,
      medianVtlCm: 0.0,
      medianSizeNorm: 0.5,
      medianH1H2Db: 0.0,
      medianWeightLight: 0.5,
      medianHnrDb: 0.0,
      medianCppsDb: 0.0,
      medianTwangDb: -18.0,
      medianTwangNorm: 0.4,
      medianStrainNorm: 0.0,
      pitchSpanSt: 0.0,
      expressNorm: 0.0,
      meanF1: 0.0,
      meanF2: 0.0,
      formantCount: 0,
      activeStartSec: 0.0,
      activeEndSec: 0.0,
    }
  }
}

pub fn vtlToSizeNorm(vtlCm: f64) -> f64 {
  if vtlCm <= 1.0 {
    return 0.5
  }
  let t = (VTL_BIG_CM - vtlCm) / (VTL_BIG_CM - VTL_SMALL_CM)
  return f64.max(0.0, f64.min(1.0, t))
}

pub fn h1h2ToLightNorm(h1h2Db: f64) -> f64 {
  let z = (h1h2Db - 6.0) / 9.5
  let s = 0.5 + 0.48 * (z / (1.0 + 0.42 * f64.abs(z)))
  return f64.max(0.02, f64.min(0.98, s))
}

/// Combines F1/F2-corrected `H1* - H2*` and Hanson-style `H1* - A1/A2/A3` spectral tilt
/// through a soft-knee curve so sustained vowels & light voices never clip flat.
pub fn weightTiltToLightNorm(h1h2StarDb: f64, tiltStarDb: f64) -> f64 {
  let zH = (h1h2StarDb - 4.5) / 7.5
  let zT = (tiltStarDb - 15.0) / 10.5
  let z = 0.30 * zH + 0.70 * zT
  let s = 0.5 + 0.48 * (z / (1.0 + 0.30 * f64.abs(z)))
  return f64.max(0.02, f64.min(0.98, s))
}

/// Maps Omori Singing Power Ratio `peak(2–4 kHz) - peak(0.2–2 kHz)` (dB) into [0, 1]:
/// -42 dB = 0% (mellow/dark), -27 dB = 50% (balanced speech), -12 dB = 100% (strong twang/ring).
pub fn twangToNorm(twangDb: f64) -> f64 {
  return f64.max(0.0, f64.min(1.0, (twangDb + 42.0) / 30.0))
}

/// Acoustic pressed/hyperfunction index in [0, 1]:
/// High closure (CPPS > 9 dB) combined with tight/negative H1*-H2* and flat harsh spectral tilt.
/// Clean bright twang with positive H1*-H2* stays low so bright resonance isn't misread as strain!
pub fn computeStrainNorm(cppsDb: f64, h1h2StarDb: f64, tiltStarDb: f64) -> f64 {
  let highClose = f64.max(0.0, f64.min(1.0, (cppsDb - 8.5) / 7.5))
  let pressComp = f64.max(0.0, f64.min(1.0, (1.5 - h1h2StarDb) / 8.5))
  let tiltComp = f64.max(0.0, f64.min(1.0, (12.5 - tiltStarDb) / 11.0))
  return f64.max(0.0, f64.min(1.0, highClose * (0.55 * pressComp + 0.45 * tiltComp)))
}

pub struct ExpressStats {
  pub pitchSpanSt: f64,
  pub expressNorm: f64,
}

impl Copy for ExpressStats {}

/// Computes pitch-dynamics Expressiveness from sorted voiced F0s (for robust P90-P10 span)
/// and chronological voiced `(f0, time)` pairs (for contour slope activity).
pub fn computeExpressiveness(sortedF0: &[f64], seqF0: &[f64], seqTime: &[f64]) -> ExpressStats {
  let n = sortedF0.length
  if n < 3 {
    return ExpressStats { pitchSpanSt: 0.0, expressNorm: 0.0 }
  }
  // Reject isolated octave-halving/doubling glitches (> ±10 st from median F0)
  let medF0 = sortedF0[n / 2]
  let fMinKeep = medF0 * 0.56
  let fMaxKeep = medF0 * 1.80
  let mut kLo: usize = 0
  while kLo < n && sortedF0[kLo] < fMinKeep {
    kLo = kLo + 1
  }
  let mut kHi: usize = n
  while kHi > kLo && sortedF0[kHi - 1] > fMaxKeep {
    kHi = kHi - 1
  }
  let m = if kHi > kLo + 2 { kHi - kLo } else { n }
  let base = if kHi > kLo + 2 { kLo } else { 0 }
  let loIdx = base + (m * 10) / 100
  let hiIdxRaw = base + (m * 90) / 100
  let hiIdx = if hiIdxRaw >= base + m { base + m - 1 } else { hiIdxRaw }
  let fLo = sortedF0[loIdx]
  let fHi = sortedF0[hiIdx]
  let spanSt = if fLo > 20.0 && fHi > fLo {
    f64.max(0.0, f64.min(24.0, 12.0 * f64.log2(fHi / fLo)))
  } else {
    0.0
  }
  let mut slopeSum: f64 = 0.0
  let mut slopeCnt: usize = 0
  let mut i: usize = 1
  while i < seqF0.length && i < seqTime.length {
    let dt = seqTime[i] - seqTime[i - 1]
    if dt > 0.004 && dt < 0.06 && seqF0[i] > 20.0 && seqF0[i - 1] > 20.0 {
      let dst = f64.abs(12.0 * f64.log2(seqF0[i] / seqF0[i - 1]))
      if dst < 6.0 {
        slopeSum = slopeSum + dst / dt
        slopeCnt = slopeCnt + 1
      }
    }
    i = i + 1
  }
  let meanSlope = if slopeCnt > 0 { slopeSum / usize.toF64(slopeCnt) } else { 0.0 }
  let spanNorm = f64.max(0.0, f64.min(1.0, (spanSt - 1.0) / 10.0))
  let slopeNorm = f64.max(0.0, f64.min(1.0, meanSlope / 32.0))
  let expr = f64.max(0.0, f64.min(1.0, 0.70 * spanNorm + 0.30 * slopeNorm))
  return ExpressStats { pitchSpanSt: spanSt, expressNorm: expr }
}

/// All-pole vocal-tract resonator transfer gain (dB) at `freq` for a formant `(formantHz, bwHz)`.
/// Used for Iseli-Shue-Alwan formant correction (`H1* - H2*` & `H1*` spectral tilt).
fn resonatorGainDb(freq: f64, formantHz: f64, bwHz: f64) -> f64 {
  if formantHz <= 80.0 || freq <= 20.0 {
    return 0.0
  }
  let r = freq / formantHz
  let t1 = 1.0 - r * r
  let t2 = (freq * bwHz) / (formantHz * formantHz)
  let denom = f64.max(1.0e-6, t1 * t1 + t2 * t2)
  return -10.0 * f64.log(denom) / f64.log(10.0)
}

struct HarmonicWeightRaw {
  rawH1H2: f64,
  rawTilt: f64,
  cppsDb: f64,
  twangDb: f64,
  valid: bool,
}

fn fftRadix2Local(re: &mut [f64], im: &mut [f64], n: usize) -> () {
  let mut j: usize = 0
  let mut i: usize = 1
  while i < n {
    let mut bit = n / 2
    while (j & bit) != 0 {
      j = j ^ bit
      bit = bit / 2
    }
    j = j ^ bit
    if i < j {
      let tr = re[i]
      re[i] = re[j]
      re[j] = tr
      let ti = im[i]
      im[i] = im[j]
      im[j] = ti
    }
    i = i + 1
  }
  let mut len: usize = 2
  while len <= n {
    let half = len / 2
    let ang = -2.0 * f64.PI / usize.toF64(len)
    let wlenRe = f64.cos(ang)
    let wlenIm = f64.sin(ang)
    let mut base: usize = 0
    while base < n {
      let mut wRe: f64 = 1.0
      let mut wIm: f64 = 0.0
      let mut k: usize = 0
      while k < half {
        let uRe = re[base + k]
        let uIm = im[base + k]
        let vr = re[base + k + half]
        let vi = im[base + k + half]
        let vRe = vr * wRe - vi * wIm
        let vIm = vr * wIm + vi * wRe
        re[base + k] = uRe + vRe
        im[base + k] = uIm + vIm
        re[base + k + half] = uRe - vRe
        im[base + k + half] = uIm - vIm
        let nextRe = wRe * wlenRe - wIm * wlenIm
        let nextIm = wRe * wlenIm + wIm * wlenRe
        wRe = nextRe
        wIm = nextIm
        k = k + 1
      }
      base = base + len
    }
    len = len * 2
  }
}

fn peakPowerAtHz(re: &[f64], im: &[f64], nHalf: usize, hzPerBin: f64, targetHz: f64) -> f64 {
  let cBinF = targetHz / hzPerBin
  let tolBinsF = f64.max(1.2, (targetHz * 0.045) / hzPerBin)
  let lo = f64.toUsize(f64.max(1.0, f64.floor(cBinF - tolBinsF)))
  let mut hi = f64.toUsize(f64.ceil(cBinF + tolBinsF))
  if hi >= nHalf { hi = nHalf - 1 }
  let mut best: f64 = 1.0e-18
  let mut b = lo
  while b <= hi {
    let p = re[b] * re[b] + im[b] * im[b]
    if p > best { best = p }
    b = b + 1
  }
  return best
}

/// Measures raw `H1 - H2`, Hanson-style `H1 - A1/A2/A3` spectral tilt,
/// Praat-style Smoothed Cepstral Peak Prominence (`cppsDb`), and 2–4 kHz Twang/Ring (`twangDb`)
/// from a single 2048-pt Hann-windowed FFT.
fn measureHarmonicWeight(samples: &[f32], sampleRate: f64, centreSec: f64, f0: f64) -> HarmonicWeightRaw {
  if samples.length < 256 || sampleRate <= 0.0 || f0 < 45.0 || f0 * 2.5 >= sampleRate * 0.5 {
    return HarmonicWeightRaw { rawH1H2: 0.0, rawTilt: 15.0, cppsDb: 0.0, twangDb: -18.0, valid: false }
  }
  let n: usize = 2048
  let nHalf: usize = 1024
  let halfI = usize.toI32(nHalf)
  let centre = f64.toI32(f64.round(centreSec * sampleRate))
  let start = centre - halfI
  let srcLenI = usize.toI32(samples.length)
  let twoPi = 2.0 * f64.PI
  let nF = usize.toF64(n)
  let hzPerBin = sampleRate / nF

  let mut re: [f64; 2048] = [0.0; 2048]
  let mut im: [f64; 2048] = [0.0; 2048]
  let mut k: usize = 0
  while k < n {
    let si = start + usize.toI32(k)
    if si >= 0 && si < srcLenI {
      let w = 0.5 - 0.5 * f64.cos(twoPi * usize.toF64(k) / nF)
      re[k] = f32.toF64(samples[i32.toUsize(si)]) * w
    }
    k = k + 1
  }
  fftRadix2Local(&mut re, &mut im, n)

  let invLn10 = 10.0 / f64.log(10.0)
  let pH1 = peakPowerAtHz(&re, &im, nHalf, hzPerBin, f0)
  let pH2 = peakPowerAtHz(&re, &im, nHalf, hzPerBin, 2.0 * f0)
  let h1Db = invLn10 * f64.log(pH1)
  let h2Db = invLn10 * f64.log(pH2)
  let rawH1H2 = f64.max(-20.0, f64.min(30.0, h1Db - h2Db))

  // Hanson (1997) / VoiceSauce style formant-band harmonic peaks:
  //   A1: peak harmonic in 450..1200 Hz (lower-mid buzz)
  //   A2: peak harmonic in 1200..2300 Hz (mid buzz)
  //   A3: peak harmonic in 2300..3800 Hz (high buzz / glottal abruptness)
  let nyqSafe = f64.min(3800.0, sampleRate * 0.44)
  let mut maxP1: f64 = 0.0
  let mut maxP2: f64 = 0.0
  let mut maxP3: f64 = 0.0

  let mut m: usize = 3
  while m <= 32 {
    let fh = usize.toF64(m) * f0
    if fh > nyqSafe {
      break
    }
    if fh >= 450.0 {
      let p = peakPowerAtHz(&re, &im, nHalf, hzPerBin, fh)
      if fh < 1200.0 {
        if p > maxP1 { maxP1 = p }
      } else if fh < 2300.0 {
        if p > maxP2 { maxP2 = p }
      } else {
        if p > maxP3 { maxP3 = p }
      }
    }
    m = m + 1
  }

  let mut wSum: f64 = 0.0
  let mut tSum: f64 = 0.0
  if maxP1 > 1.0e-17 {
    let d1 = f64.max(-15.0, f64.min(50.0, h1Db - invLn10 * f64.log(maxP1)))
    tSum = tSum + 0.30 * d1
    wSum = wSum + 0.30
  }
  if maxP2 > 1.0e-17 {
    let d2 = f64.max(-10.0, f64.min(60.0, h1Db - invLn10 * f64.log(maxP2)))
    tSum = tSum + 0.35 * d2
    wSum = wSum + 0.35
  }
  if maxP3 > 1.0e-17 {
    let d3 = f64.max(-5.0, f64.min(70.0, h1Db - invLn10 * f64.log(maxP3)))
    tSum = tSum + 0.35 * d3
    wSum = wSum + 0.35
  }
  let rawTilt = if wSum > 0.0 { tSum / wSum } else { rawH1H2 + 16.0 }

  // Epilaryngeal Twang / Ring (Omori Singing Power Ratio): peak(2000..4000 Hz) - peak(200..2000 Hz) in dB
  // Sample-rate & FFT-bin-width invariant!
  let bMid0 = f64.toUsize(f64.max(1.0, f64.floor(200.0 / hzPerBin)))
  let bMid1 = f64.toUsize(f64.min(usize.toF64(nHalf - 1), f64.ceil(2000.0 / hzPerBin)))
  let bTw0 = f64.toUsize(f64.max(1.0, f64.floor(2000.0 / hzPerBin)))
  let bTw1 = f64.toUsize(f64.min(usize.toF64(nHalf - 1), f64.ceil(4000.0 / hzPerBin)))
  let mut maxMid: f64 = 1.0e-18
  let mut bi = bMid0
  while bi <= bMid1 {
    let p = re[bi] * re[bi] + im[bi] * im[bi]
    if p > maxMid { maxMid = p }
    bi = bi + 1
  }
  let mut maxTw: f64 = 1.0e-18
  bi = bTw0
  while bi <= bTw1 {
    let p = re[bi] * re[bi] + im[bi] * im[bi]
    if p > maxTw { maxTw = p }
    bi = bi + 1
  }
  let twangDb = f64.max(-46.0, f64.min(6.0, invLn10 * f64.log(maxTw / maxMid)))

  // Praat / Hillenbrand Power Cepstral Peak Prominence (CPPS, dB) from log-power spectrum
  let mut cre: [f64; 2048] = [0.0; 2048]
  let mut cim: [f64; 2048] = [0.0; 2048]
  let p0 = re[0] * re[0] + im[0] * im[0]
  cre[0] = f64.log(p0 + 1.0e-18)
  let pNyq = re[nHalf] * re[nHalf] + im[nHalf] * im[nHalf]
  cre[nHalf] = f64.log(pNyq + 1.0e-18)
  let mut ci: usize = 1
  while ci < nHalf {
    let lp = f64.log(re[ci] * re[ci] + im[ci] * im[ci] + 1.0e-18)
    cre[ci] = lp
    cre[n - ci] = lp
    ci = ci + 1
  }
  fftRadix2Local(&mut cre, &mut cim, n)
  let invN = 1.0 / nF
  let qLo = f64.toUsize(f64.max(4.0, f64.floor(sampleRate / 380.0)))
  let qHiRaw = f64.toUsize(f64.ceil(sampleRate / 60.0))
  let qHi = if qHiRaw < nHalf - 3 { qHiRaw } else { nHalf - 3 }
  let mut cppsDb: f64 = 0.0
  if qHi > qLo + 6 {
    let mut cDb: [f64; 1024] = [0.0; 1024]
    let qStart = if qLo >= 2 { qLo - 2 } else { 0 }
    let qEnd = if qHi + 2 < nHalf { qHi + 2 } else { nHalf - 1 }
    let mut q = qStart
    while q <= qEnd {
      let mag = cre[q] * invN
      cDb[q] = invLn10 * f64.log(mag * mag + 1.0e-12)
      q = q + 1
    }
    // 5-bin quefrency smoothing + OLS linear regression baseline across [qLo..qHi]
    let mut sumQ: f64 = 0.0
    let mut sumY: f64 = 0.0
    let mut cntQ: usize = 0
    let mut sm: [f64; 1024] = [0.0; 1024]
    q = qLo
    while q <= qHi {
      let y = 0.20 * (cDb[q - 2] + cDb[q - 1] + cDb[q] + cDb[q + 1] + cDb[q + 2])
      sm[q] = y
      sumQ = sumQ + usize.toF64(q)
      sumY = sumY + y
      cntQ = cntQ + 1
      q = q + 1
    }
    let cntF = usize.toF64(cntQ)
    let meanQ = sumQ / cntF
    let meanY = sumY / cntF
    let mut num: f64 = 0.0
    let mut den: f64 = 0.0
    q = qLo
    while q <= qHi {
      let dq = usize.toF64(q) - meanQ
      num = num + dq * (sm[q] - meanY)
      den = den + dq * dq
      q = q + 1
    }
    let slope = if den > 1.0e-12 { num / den } else { 0.0 }
    let intercept = meanY - slope * meanQ
    // Search cepstral peak around the F0 quefrency
    let sLoRaw = f64.toUsize(f64.floor(sampleRate / f64.min(420.0, f0 * 1.35)))
    let sHiRaw = f64.toUsize(f64.ceil(sampleRate / f64.max(55.0, f0 * 0.72)))
    let sLo = if sLoRaw > qLo { sLoRaw } else { qLo }
    let sHi = if sHiRaw < qHi { sHiRaw } else { qHi }
    let mut bestProm: f64 = 0.0
    q = sLo
    while q <= sHi {
      let prom = sm[q] - (intercept + slope * usize.toF64(q))
      if prom > bestProm {
        bestProm = prom
      }
      q = q + 1
    }
    cppsDb = f64.max(0.0, f64.min(30.0, bestProm))
  }

  return HarmonicWeightRaw {
    rawH1H2: rawH1H2,
    rawTilt: rawTilt,
    cppsDb: cppsDb,
    twangDb: twangDb,
    valid: true,
  }
}

/// Estimates apparent Vocal Tract Length (cm) from F1..F3 using quarter-wave tube scaling,
/// weighted heavily toward F2..F3 so vowel articulation on F1 doesn't dominate and live LPC
/// agrees cleanly with post-record Neural FormantsTracker (which predicts F1..F3).
pub fn estimateVtlCm(ff: FormantFrame) -> f64 {
  let mut wSum: f64 = 0.0
  let mut lSum: f64 = 0.0

  if ff.count >= 1 && ff.f1 > 180.0 && ff.f1 < 1250.0 {
    let l1 = (1.0 * SPEED_OF_SOUND_CM_S) / (4.0 * ff.f1)
    if l1 >= 10.0 && l1 <= 24.0 {
      lSum = lSum + l1 * 0.14
      wSum = wSum + 0.14
    }
  }
  if ff.count >= 2 && ff.f2 > 600.0 && ff.f2 < 3400.0 {
    let l2 = (3.0 * SPEED_OF_SOUND_CM_S) / (4.0 * ff.f2)
    if l2 >= 10.0 && l2 <= 24.0 {
      lSum = lSum + l2 * 0.36
      wSum = wSum + 0.36
    }
  }
  if ff.count >= 3 && ff.f3 > 1600.0 && ff.f3 < 4200.0 {
    let l3 = (5.0 * SPEED_OF_SOUND_CM_S) / (4.0 * ff.f3)
    if l3 >= 10.0 && l3 <= 24.0 {
      lSum = lSum + l3 * 0.50
      wSum = wSum + 0.50
    }
  }
  if wSum <= 0.0 {
    return 0.0
  }
  return lSum / wSum
}

/// Praat's Boersma HNR formula from normalized autocorrelation peak `r`: `10 * log10(r / (1 - r))`.
pub fn clarityToHnrDb(clarity: f64) -> f64 {
  let r = f64.max(0.05, f64.min(0.9995, clarity))
  let hnr = 10.0 * f64.log(r / (1.0 - r)) / f64.log(10.0)
  return f64.max(-5.0, f64.min(35.0, hnr))
}

fn insertionSortF64(vals: &mut [f64]) -> () {
  let n = vals.length
  let mut i: usize = 1
  while i < n {
    let key = vals[i]
    let mut j = i
    while j > 0 && vals[j - 1] > key {
      vals[j] = vals[j - 1]
      j = j - 1
    }
    vals[j] = key
    i = i + 1
  }
}

fn medianOfList(vals: &mut List<f64>) -> f64 {
  let n = vals.length()
  if n == 0 {
    return 0.0
  }
  insertionSortF64(vals.asMutSlice())
  let s = vals.asSlice()
  let mid = n / 2
  if (n % 2) == 1 {
    return s[mid]
  }
  return 0.5 * (s[mid - 1] + s[mid])
}

pub struct VoiceMetricsTrack {
  pub frames: List<VoiceFrame>,
  pub summary: VoiceSummary,
  pub ltas: [f32; 64],
  pub hasLtas: bool,
  smoothSize: f64,
  smoothLight: f64,
  hasSmoothSize: bool,
  hasSmoothLight: bool,
}

impl VoiceMetricsTrack {
  pub fn empty() -> VoiceMetricsTrack {
    return VoiceMetricsTrack {
      frames: List<VoiceFrame>.make(),
      summary: VoiceSummary.empty(),
      ltas: [0.0; 64],
      hasLtas: false,
      smoothSize: 0.5,
      smoothLight: 0.5,
      hasSmoothSize: false,
      hasSmoothLight: false,
    }
  }

  pub fn reset(self: &mut Self) -> () {
    self.frames.clear()
    self.summary = VoiceSummary.empty()
    self.ltas = [0.0; 64]
    self.hasLtas = false
    self.smoothSize = 0.5
    self.smoothLight = 0.5
    self.hasSmoothSize = false
    self.hasSmoothLight = false
  }

  /// Incrementally processes any new frames from `pitchFrames` & `formantFrames`.
  pub effect fn update(
    self: &mut Self,
    samples: &[f32],
    sampleRate: f64,
    pitchFrames: &[PitchFrame],
    formantFrames: &[FormantFrame],
    displayClarity: f64,
  ) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.updateChunk(samples, sampleRate, pitchFrames, formantFrames, displayClarity, 1000000)
  }

  /// Processes up to `maxFrames` new voice metric frames for non-blocking progressive analysis.
  pub effect fn updateChunk(
    self: &mut Self,
    samples: &[f32],
    sampleRate: f64,
    pitchFrames: &[PitchFrame],
    formantFrames: &[FormantFrame],
    displayClarity: f64,
    maxFrames: usize,
  ) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut added: usize = 0
    let mut i = self.frames.length()
    let rawMax = pitchFrames.length
    let maxIdx = if i + maxFrames < rawMax { i + maxFrames } else { rawMax }
    while i < maxIdx {
      let pf = pitchFrames[i]
      let voiced = pf.voiced && pf.clarity >= displayClarity && pf.frequency > 45.0
      if !voiced {
        run self.frames.append(VoiceFrame.unvoiced(pf.time, pf.intensityDb))
      } else {
        let hnrDb = clarityToHnrDb(pf.clarity)
        let hw = measureHarmonicWeight(samples, sampleRate, pf.time, pf.frequency)

        let mut vtlCm: f64 = 0.0
        let mut f1: f64 = 0.0
        let mut f2: f64 = 0.0
        let mut f3: f64 = 0.0
        let mut f4: f64 = 0.0
        let mut hasFormants = false
        if i < formantFrames.length {
          let ff = formantFrames[i]
          vtlCm = estimateVtlCm(ff)
          if ff.count >= 2 && ff.f1 > 160.0 && ff.f2 > ff.f1 + 100.0 {
            f1 = ff.f1
            f2 = ff.f2
            if ff.count >= 3 && ff.f3 > ff.f2 { f3 = ff.f3 }
            if ff.count >= 4 && ff.f4 > ff.f3 { f4 = ff.f4 }
            hasFormants = true
          }
        }

        // Apply Iseli-Shue-Alwan F1/F2 formant gain correction so close vowels (/i/, /u/)
        // don't artificially inflate H1 or clamp Weight flat at the ceiling!
        let mut f1OnH1: f64 = 0.0
        let mut f1Corr: f64 = 0.0
        let mut f2Corr: f64 = 0.0
        if hasFormants && f1 > 180.0 {
          let g1H1 = resonatorGainDb(pf.frequency, f1, 80.0)
          let g1H2 = resonatorGainDb(2.0 * pf.frequency, f1, 80.0)
          f1OnH1 = f64.max(0.0, f64.min(10.0, g1H1))
          f1Corr = f64.max(-12.0, f64.min(12.0, g1H1 - g1H2))
          if f2 > f1 + 120.0 {
            let g2H1 = resonatorGainDb(pf.frequency, f2, 110.0)
            let g2H2 = resonatorGainDb(2.0 * pf.frequency, f2, 110.0)
            f2Corr = f64.max(-6.0, f64.min(6.0, g2H1 - g2H2))
          }
        }
        let h1h2Db = f64.max(-14.0, f64.min(26.0, hw.rawH1H2 - f1Corr - f2Corr))
        let tiltDb = f64.max(-5.0, f64.min(65.0, hw.rawTilt - f1OnH1))
        let rawLight = weightTiltToLightNorm(h1h2Db, tiltDb)
        if !self.hasSmoothLight {
          self.smoothLight = rawLight
          self.hasSmoothLight = true
        } else {
          self.smoothLight = self.smoothLight * 0.62 + rawLight * 0.38
        }
        if vtlCm > 1.0 {
          let rawSize = vtlToSizeNorm(vtlCm)
          if !self.hasSmoothSize {
            self.smoothSize = rawSize
            self.hasSmoothSize = true
          } else {
            self.smoothSize = self.smoothSize * 0.70 + rawSize * 0.30
          }
        }

        let twangNorm = twangToNorm(hw.twangDb)
        let strainNorm = computeStrainNorm(hw.cppsDb, h1h2Db, tiltDb)

        run self.frames.append(VoiceFrame {
          time: pf.time,
          voiced: true,
          f0: pf.frequency,
          intensityDb: pf.intensityDb,
          vtlCm: vtlCm,
          sizeNorm: self.smoothSize,
          h1h2Db: h1h2Db,
          tiltDb: tiltDb,
          weightLightNorm: self.smoothLight,
          hnrDb: hnrDb,
          cppsDb: hw.cppsDb,
          twangDb: hw.twangDb,
          twangNorm: twangNorm,
          strainNorm: strainNorm,
          f1: f1,
          f2: f2,
          f3: f3,
          f4: f4,
          hasFormants: hasFormants,
        })
      }
      added = added + 1
      i = i + 1
    }
    return added
  }

  /// Recomputes clip-level medians, vowel centroid, speech bounds, and LTAS.
  pub effect fn finalizeSummary(self: &mut Self, samples: &[f32], sampleRate: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let fs = self.frames.asSlice()
    let mut f0s = List<f64>.make()
    let mut f0Seq = List<f64>.make()
    let mut vtls = List<f64>.make()
    let mut sizes = List<f64>.make()
    let mut h1h2s = List<f64>.make()
    let mut lights = List<f64>.make()
    let mut hnrs = List<f64>.make()
    let mut cppsList = List<f64>.make()
    let mut twangDbs = List<f64>.make()
    let mut twangNorms = List<f64>.make()
    let mut strains = List<f64>.make()
    let mut voicedTimes = List<f64>.make()

    let mut f1Sum: f64 = 0.0
    let mut f2Sum: f64 = 0.0
    let mut fmtCount: usize = 0
    let mut activeStart: f64 = -1.0
    let mut activeEnd: f64 = 0.0

    let mut i: usize = 0
    while i < fs.length {
      let fr = fs[i]
      if fr.voiced {
        if activeStart < 0.0 {
          activeStart = fr.time
        }
        activeEnd = fr.time
        run f0s.append(fr.f0)
        run f0Seq.append(fr.f0)
        run h1h2s.append(fr.h1h2Db)
        run lights.append(fr.weightLightNorm)
        run hnrs.append(fr.hnrDb)
        run cppsList.append(fr.cppsDb)
        run twangDbs.append(fr.twangDb)
        run twangNorms.append(fr.twangNorm)
        run strains.append(fr.strainNorm)
        run voicedTimes.append(fr.time)
        if fr.vtlCm > 1.0 {
          run vtls.append(fr.vtlCm)
          run sizes.append(fr.sizeNorm)
        }
        if fr.hasFormants {
          f1Sum = f1Sum + fr.f1
          f2Sum = f2Sum + fr.f2
          fmtCount = fmtCount + 1
        }
      }
      i = i + 1
    }

    let vc = f0s.length()
    if vc == 0 {
      self.summary = VoiceSummary.empty()
      self.hasLtas = false
      return ()
    }

    let medF0 = medianOfList(&mut f0s)
    let expr = computeExpressiveness(f0s.asSlice(), f0Seq.asSlice(), voicedTimes.asSlice())

    self.summary = VoiceSummary {
      voicedFrames: vc,
      medianF0: medF0,
      medianVtlCm: medianOfList(&mut vtls),
      medianSizeNorm: if sizes.length() > 0 { medianOfList(&mut sizes) } else { 0.5 },
      medianH1H2Db: medianOfList(&mut h1h2s),
      medianWeightLight: medianOfList(&mut lights),
      medianHnrDb: medianOfList(&mut hnrs),
      medianCppsDb: medianOfList(&mut cppsList),
      medianTwangDb: medianOfList(&mut twangDbs),
      medianTwangNorm: medianOfList(&mut twangNorms),
      medianStrainNorm: medianOfList(&mut strains),
      pitchSpanSt: expr.pitchSpanSt,
      expressNorm: expr.expressNorm,
      meanF1: if fmtCount > 0 { f1Sum / usize.toF64(fmtCount) } else { 0.0 },
      meanF2: if fmtCount > 0 { f2Sum / usize.toF64(fmtCount) } else { 0.0 },
      formantCount: fmtCount,
      activeStartSec: if activeStart >= 0.0 { activeStart } else { 0.0 },
      activeEndSec: activeEnd,
    }

    let mut ltasBuf: [f32; 64] = [0.0; 64]
    let ok = audio_native.computeLtasNative(
      samples,
      sampleRate,
      voicedTimes.asSlice(),
      &mut ltasBuf,
      LTAS_FMIN,
      LTAS_FMAX,
    )
    self.ltas = ltasBuf
    self.hasLtas = ok
  }

  pub fn nearest(self: &Self, timeSec: f64) -> Option<VoiceFrame> {
    let fs = self.frames.asSlice()
    if fs.length == 0 {
      return Option<VoiceFrame>.None
    }
    let mut lo: usize = 0
    let mut hi: usize = fs.length - 1
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if fs[mid].time < timeSec {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo > 0 && f64.abs(fs[lo - 1].time - timeSec) < f64.abs(fs[lo].time - timeSec) {
      return Option<VoiceFrame>.some(fs[lo - 1])
    }
    return Option<VoiceFrame>.some(fs[lo])
  }
}
