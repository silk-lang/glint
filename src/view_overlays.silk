          shortcutRow(h, "Repeat drill", "D", ""),
          shortcutRow(h, "Echo mirror", "E", ""),
          settingsSection(h, "View & overlays"),
          shortcutRow(h, "Pin take as reference", "P", ""),
          shortcutRow(h, "Plot mine on ref", "B", ""),
          shortcutRow(h, "Add guide at cursor", "G", ""),
          shortcutRow(h, "Hide spectrogram", "H", ""),
          shortcutRow(h, "Toggle script strip", "N", ""),
          shortcutRow(h, "Reset zoom", "0", ""),
        ],
      ),
      h.column(
        &[h.class("flex-1 min-w-0")],
        &[
          settingsSection(h, "Edit"),
          shortcutRow(h, "Select region", "⇧", "Drag"),
          shortcutRow(h, "Average pitch of selection", "F5", ""),
          shortcutRow(h, "Select all", "⌘", "A"),
          shortcutRow(h, "Copy selection", "⌘", "C"),
          shortcutRow(h, "Cut selection", "⌘", "X"),
          shortcutRow(h, "Paste at cursor", "⌘", "V"),
          shortcutRow(h, "Delete selection", "⌫", ""),
          shortcutRow(h, "Undo edit", "⌘", "Z"),
          settingsSection(h, "File & library"),
          shortcutRow(h, "New blank take", "⌘", "N"),
          shortcutRow(h, "Open audio file", "⌘", "O"),
          shortcutRow(h, "Save take to library", "⌘", "S"),
          shortcutRow(h, "Rename selected item", "F2", ""),
          shortcutRow(h, "Settings", "⌘", ","),
        ],
      ),
    ],
  )
}

/// Floating drag ghost pill when moving a take/folder in the Library rail.
pub fn renderDragGhost(m: &Overtone, h: &Document<Message>) -> Node {
  if !m.explorerDragActive {
    return h.empty()
  }
  let targetRaw = String.view(&m.explorerDropTargetRel)
  let targetEmpty = String.byteLength(targetRaw) == 0
  let cls = if m.explorerDropValid {
    "fixed z-50 pointer-events-none flex items-center gap-[6px] px-[10px] py-[5px] glint-drag-ghost text-[12px] leading-[16px]"
  } else {
    "fixed z-50 pointer-events-none flex items-center gap-[6px] px-[10px] py-[5px] rounded-[6px] bg-white border border-dashed border-[#9A9AA2] text-[12px] leading-[16px] text-[#8A8A90]"
  }
  return h.row(
    &[
      h.class(cls),
      h.style(&[css.left(px(m.explorerDragX + 12.0)), css.top(px(m.explorerDragY - 12.0))]),
    ],
    &[
      h.text("Move "),
      txtA(h, String.view(&m.explorerDragLabel), &[h.classWhen(m.explorerDropValid, "font-semibold")]),
      if m.explorerDropValid {
        h.row(
          &[h.class("items-center gap-[5px]")],
          &[
            txt(h, "→", "text-[#9A9AA2]"),
            if targetEmpty {
              txt(h, "/", "glint-mono text-[11px] text-[#C8C8CC]")
            } else {
              txt(h, targetRaw, "glint-mono text-[11px] text-[#C8C8CC]")
            },
          ],
        )
      } else {
        h.text(" — can’t drop here")
      },
    ],
  )
}
