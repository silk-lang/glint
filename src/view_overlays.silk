  CTX_AUDIO,
  CTX_EXPLORER_DIR,
  CTX_EXPLORER_FILE,
  CTX_EXPLORER_ROOT,
  CTX_FORMANTS,
  CTX_LIB_SORT,
  CTX_NONE,
  CTX_PALETTE,
  CTX_SPEC,
  CTX_SPEED,
  Message,
  Overtone,
  SET_ANALYZER,
  SET_AUDIO,
  SET_COMPARE,
  SET_DISPLAY,
  SET_GUIDES,
  SET_PLAYBACK,
  SET_SHORTCUTS,
  SLIDER_BRIGHTNESS,
  SLIDER_CEILING_DB,
  SLIDER_CLARITY,
  SLIDER_CONTRAST,
  SLIDER_FLOOR_DB,
  SLIDER_FORMANT_CEIL,
  SLIDER_PITCH_CEIL,
  SLIDER_PITCH_FLOOR,
  SLIDER_PLAY_SPEED,
  SLIDER_SILENCE_HOLD,
  SLIDER_SPEC_OPACITY,
  SLIDER_SYNTH_MORPH,
  SLIDER_SYNTH_PITCH,
  SLIDER_SYNTH_SIZE,
  SLIDER_SYNTH_WEIGHT,
  SLIDER_VAD_THRESH,
  SLIDER_VOLUME,
  SLIDER_W_PITCH,
  SLIDER_W_SIZE,
  SLIDER_W_VOWEL,
  SLIDER_W_WEIGHT
}
import view_components {
  countStr,
  menuHeader,
  menuItem,
  menuPaletteItem,
