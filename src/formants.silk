//! Praat-faithful Burg LPC formant analysis, following `voiceapp/wayfinder/voice-practice-tool/research/formant-analysis.md`:
//!   1. Anti-aliased resample to `2 * ceilingHz` (user-adjustable 4000..6500 Hz, default 5500 Hz).
//!   2. Pre-emphasis `y[n] = x[n] - exp(-2*pi*50/fs) * x[n-1]`.
//!   3. Praat's pedestal-subtracted Gaussian window (`actual length = 2 * 0.025 s = 0.050 s`).
//!   4. Burg LPC recursion (`order = 2 * maxFormants`, default 10 for 5 formants).
//!   5. Complex polynomial roots via Aberth-Ehrlich iteration + unit-circle reflection.
//!   6. Root -> (frequency, bandwidth) with Praat's 50 Hz safety margin & ascending sort.
//!   7. LPC vocal-tract spectral envelope evaluation & IPA vowel classification from (F1, F2).
import audio_native
import pitch { PitchFrame }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize

pub const DEFAULT_FORMANT_CEILING_HZ: f64 = 5500.0
pub const DEFAULT_MAX_FORMANTS: usize = 5
pub const DEFAULT_LPC_ORDER: usize = 10
pub const DEFAULT_HALF_WINDOW_S: f64 = 0.025
pub const PREEMPHASIS_FROM_HZ: f64 = 50.0
pub const SAFETY_MARGIN_HZ: f64 = 50.0
pub const MAX_FORMANT_BANDWIDTH_HZ: f64 = 900.0

pub struct FormantPeak {
  pub freq: f64,
  pub bw: f64,
}

impl Copy for FormantPeak {}

pub struct FormantFrame {
  pub time: f64,
  pub count: usize,
  pub f1: f64,
  pub bw1: f64,
  pub f2: f64,
  pub bw2: f64,
  pub f3: f64,
  pub bw3: f64,
  pub f4: f64,
  pub bw4: f64,
  pub intensityDb: f64,
  pub tracked: bool,
  pub candCount: usize,
  pub candFreqs: [f64; 6],
  pub candBws: [f64; 6],
}

impl Copy for FormantFrame {}

impl FormantFrame {
  pub fn empty(time: f64, intensityDb: f64) -> FormantFrame {
    return FormantFrame {
      time: time,
      count: 0,
      f1: 0.0, bw1: 0.0,
      f2: 0.0, bw2: 0.0,
      f3: 0.0, bw3: 0.0,
      f4: 0.0, bw4: 0.0,
      intensityDb: intensityDb,
      tracked: false,
      candCount: 0,
      candFreqs: [0.0; 6],
      candBws: [0.0; 6],
    }
  }
}

/// Hillenbrand et al. (1995) Table V American English vowel landmarks (Hz) for Women & Men.
pub const VOWEL_MODE_FEM: u32 = 0
pub const VOWEL_MODE_MASC: u32 = 1
pub const VOWEL_MODE_BOTH: u32 = 2

pub struct VowelLandmark {
  pub idx: usize,
  pub ipa: string<'static>,
  pub hint: string<'static>,
  pub f1: f64,
  pub f2: f64,
  pub f3: f64,
}

impl Copy for VowelLandmark {}

/// Hillenbrand et al. (1995) Table V — Adult Women (n=48) steady-state formant means (Hz).
pub const VOWELS_FEM: [VowelLandmark; 10] = [
  VowelLandmark { idx: 0, ipa: "i", hint: "seen", f1: 437.0, f2: 2761.0, f3: 3379.0 },
  VowelLandmark { idx: 1, ipa: "ɪ", hint: "hid", f1: 558.0, f2: 2375.0, f3: 2987.0 },
  VowelLandmark { idx: 2, ipa: "e", hint: "hay", f1: 592.0, f2: 2364.0, f3: 2959.0 },
  VowelLandmark { idx: 3, ipa: "ɛ", hint: "head", f1: 731.0, f2: 2258.0, f3: 2913.0 },
  VowelLandmark { idx: 4, ipa: "æ", hint: "had", f1: 860.0, f2: 2058.0, f3: 2843.0 },
  VowelLandmark { idx: 5, ipa: "ɑ", hint: "hod", f1: 850.0, f2: 1335.0, f3: 2838.0 },
  VowelLandmark { idx: 6, ipa: "ɔ", hint: "hawed", f1: 684.0, f2: 1041.0, f3: 2824.0 },
  VowelLandmark { idx: 7, ipa: "o", hint: "hoed", f1: 595.0, f2: 1315.0, f3: 2806.0 },
  VowelLandmark { idx: 8, ipa: "ʊ", hint: "hood", f1: 549.0, f2: 1629.0, f3: 2776.0 },
  VowelLandmark { idx: 9, ipa: "u", hint: "who'd", f1: 455.0, f2: 1145.0, f3: 2781.0 },
]

/// Hillenbrand et al. (1995) Table V — Adult Men (n=45) steady-state formant means (Hz).
pub const VOWELS_MASC: [VowelLandmark; 10] = [
  VowelLandmark { idx: 0, ipa: "i", hint: "seen", f1: 341.0, f2: 2329.0, f3: 2991.0 },
  VowelLandmark { idx: 1, ipa: "ɪ", hint: "hid", f1: 427.0, f2: 2038.0, f3: 2664.0 },
  VowelLandmark { idx: 2, ipa: "e", hint: "hay", f1: 476.0, f2: 2055.0, f3: 2587.0 },
  VowelLandmark { idx: 3, ipa: "ɛ", hint: "head", f1: 588.0, f2: 1951.0, f3: 2570.0 },
  VowelLandmark { idx: 4, ipa: "æ", hint: "had", f1: 691.0, f2: 1756.0, f3: 2439.0 },
  VowelLandmark { idx: 5, ipa: "ɑ", hint: "hod", f1: 732.0, f2: 1139.0, f3: 2471.0 },
  VowelLandmark { idx: 6, ipa: "ɔ", hint: "hawed", f1: 586.0, f2: 902.0, f3: 2452.0 },
  VowelLandmark { idx: 7, ipa: "o", hint: "hoed", f1: 515.0, f2: 1144.0, f3: 2455.0 },
  VowelLandmark { idx: 8, ipa: "ʊ", hint: "hood", f1: 459.0, f2: 1421.0, f3: 2404.0 },
  VowelLandmark { idx: 9, ipa: "u", hint: "who'd", f1: 378.0, f2: 997.0, f3: 2390.0 },
]

/// Corner vowels for subtle secondary labels in "Both" overlay mode.
pub const VOWELS_MASC_CORNERS: [VowelLandmark; 4] = [
  VowelLandmark { idx: 0, ipa: "i", hint: "seen", f1: 341.0, f2: 2329.0, f3: 2991.0 },
  VowelLandmark { idx: 4, ipa: "æ", hint: "had", f1: 691.0, f2: 1756.0, f3: 2439.0 },
  VowelLandmark { idx: 5, ipa: "ɑ", hint: "hod", f1: 732.0, f2: 1139.0, f3: 2471.0 },
  VowelLandmark { idx: 9, ipa: "u", hint: "who'd", f1: 378.0, f2: 997.0, f3: 2390.0 },
]

/// Returns a continuously interpolated vowel landmark along the vocal-tract size / resonance
/// continuum (`resonance = 0.0` dark/larger tract → `0.5` balanced/mid → `1.0` bright/smaller tract),
/// using exact log-frequency (multiplicative Hz) scaling between the Hillenbrand (1995) anchors.
pub fn vowelLandmarkAt(idx: usize, resonance: f64) -> VowelLandmark {
  let i = if idx < VOWELS_MASC.length { idx } else { 0 }
  let r = f64.max(0.0, f64.min(1.0, resonance))
  let lo = VOWELS_MASC[i]
  let hi = VOWELS_FEM[i]
  return VowelLandmark {
    idx: lo.idx,
    ipa: lo.ipa,
    hint: lo.hint,
    f1: lo.f1 * f64.pow(hi.f1 / lo.f1, r),
    f2: lo.f2 * f64.pow(hi.f2 / lo.f2, r),
    f3: lo.f3 * f64.pow(hi.f3 / lo.f3, r),
  }
}

/// Returns the nearest IPA vowel symbol for `(f1, f2)` at the given continuous resonance (`0.0..1.0`).
pub fn estimateVowelForResonance(f1: f64, f2: f64, resonance: f64) -> string<'static> {
  if f1 < 180.0 || f1 > 1200.0 || f2 < 550.0 || f2 > 3400.0 || f2 <= f1 {
    return "—"
  }
  let mut bestIpa: string<'static> = "—"
  let mut bestDist: f64 = 1.0e30
  let mut i: usize = 0
  while i < VOWELS_MASC.length {
    let v = vowelLandmarkAt(i, resonance)
    let d1 = f64.log2(f1 / v.f1)
    let d2 = f64.log2(f2 / v.f2)
    let dist = d1 * d1 + d2 * d2
    if dist < bestDist {
      bestDist = dist
      bestIpa = v.ipa
    }
    i = i + 1
  }
  return bestIpa
}

/// Returns the nearest IPA vowel symbol for `(f1, f2)` using the chosen Hillenbrand (1995) reference.
pub fn estimateVowelForMode(f1: f64, f2: f64, mode: u32) -> string<'static> {
  if f1 < 180.0 || f1 > 1200.0 || f2 < 550.0 || f2 > 3400.0 || f2 <= f1 {
    return "—"
  }
  let mut bestIpa: string<'static> = "—"
  let mut bestDist: f64 = 1.0e30
  if mode == VOWEL_MODE_FEM || mode == VOWEL_MODE_BOTH {
    let mut i: usize = 0
    while i < VOWELS_FEM.length {
      let d1 = f64.log2(f1 / VOWELS_FEM[i].f1)
      let d2 = f64.log2(f2 / VOWELS_FEM[i].f2)
      let dist = d1 * d1 + d2 * d2
      if dist < bestDist {
        bestDist = dist
        bestIpa = VOWELS_FEM[i].ipa
      }
      i = i + 1
    }
  }
  if mode == VOWEL_MODE_MASC || mode == VOWEL_MODE_BOTH {
    let mut i: usize = 0
    while i < VOWELS_MASC.length {
      let d1 = f64.log2(f1 / VOWELS_MASC[i].f1)
      let d2 = f64.log2(f2 / VOWELS_MASC[i].f2)
      let dist = d1 * d1 + d2 * d2
      if dist < bestDist {
        bestDist = dist
        bestIpa = VOWELS_MASC[i].ipa
      }
      i = i + 1
    }
  }
  return bestIpa
}

pub fn estimateVowel(f1: f64, f2: f64) -> string<'static> {
  return estimateVowelForMode(f1, f2, VOWEL_MODE_BOTH)
}

/// Praat's exact pedestal-subtracted Gaussian window (sidelobes < -120 dB):
///   w[i] = (exp(-48 * ((i - mid)/(N+1))^2) - exp(-12)) / (1 - exp(-12))
effect fn makePraatGaussianWindow(n: usize) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut w = List<f64>.make()
  run w.appendRepeated(0.0, n)
  let out = w.asMutSlice()
  let nPlus1 = usize.toF64(n + 1)
  let mid = 0.5 * nPlus1
  let edge = f64.exp(-12.0)
  let invDenom = 1.0 / (1.0 - edge)
  let mut i: usize = 0
  while i < n {
    let idx = usize.toF64(i + 1)
    let rel = (idx - mid) / nPlus1
    out[i] = (f64.exp(-48.0 * rel * rel) - edge) * invDenom
    i = i + 1
  }
  return move w
}

/// Resamples a window centered at `centreSec` from `src` (`srcRate`) onto `dst` (`dstRate`)
/// with a native `-O3` windowed-sinc anti-aliasing low-pass filter and Praat pre-emphasis.
fn resampleAndPreEmphasize(
  src: &[f32],
  srcRate: f64,
  centreSec: f64,
  dstRate: f64,
  dst: &mut [f64],
  work: &mut [f64],
) -> f64 {
  drop work
  return audio_native.resamplePreEmphNative(
    src,
    srcRate,
    centreSec,
    dstRate,
    PREEMPHASIS_FROM_HZ,
    move dst,
  )
}

/// Burg's algorithm for LPC coefficients (Childers 1978 / Praat `VECburg`).
/// Writes `order` coefficients `a[0..order)` such that `x[n] ~= sum_{k=1..order} a[k-1] * x[n-k]`.
/// Returns `true` on success, `false` on silent/ill-conditioned input.
pub fn burgLpc(x: &[f64], order: usize, a: &mut [f64], b1: &mut [f64], b2: &mut [f64], aa: &mut [f64]) -> bool {
  let n = x.length
  if n <= order + 1 || order == 0 {
    return false
  }
  let mut p: f64 = 0.0
  let mut j: usize = 0
  while j < n {
    p = p + x[j] * x[j]
    j = j + 1
  }
  if p <= 1.0e-18 {
    return false
  }

  j = 0
  while j < n - 1 {
    b1[j] = x[j]
    b2[j] = x[j + 1]
    j = j + 1
  }

  let mut m: usize = 0
  while m < order {
    let limit = n - 1 - m
    let mut num: f64 = 0.0
    let mut den: f64 = 0.0
    j = 0
    while j < limit {
      num = num + b1[j] * b2[j]
      den = den + b1[j] * b1[j] + b2[j] * b2[j]
      j = j + 1
    }
    if den <= 1.0e-18 {
      return false
    }
    let km = 2.0 * num / den
    if km >= 0.999999 || km <= -0.999999 {
      return false
    }
    a[m] = km
    if m > 0 {
      j = 0
      while j < m {
        a[j] = aa[j] - km * aa[m - 1 - j]
        j = j + 1
      }
    }
    if m + 1 < order {
      j = 0
      while j <= m {
        aa[j] = a[j]
        j = j + 1
      }
      j = 0
      while j < limit - 1 {
        let oldB1 = b1[j]
        let oldB2 = b2[j + 1]
        b1[j] = oldB1 - km * b2[j]
        b2[j] = oldB2 - km * b1[j + 1]
        j = j + 1
      }
    }
    m = m + 1
  }
  return true
}

/// Evaluates polynomial P(z) = sum_{k=0..deg} c[k] * z^k and derivative P'(z) at complex (zr, zi).
fn evalPolyAndDeriv(c: &[f64], deg: usize, zr: f64, zi: f64) -> [f64; 4] {
  let mut pr = c[deg]
  let mut pi: f64 = 0.0
  let mut dr: f64 = 0.0
  let mut di: f64 = 0.0
  let mut k = deg
  while k > 0 {
    k = k - 1
    // d = d * z + p
    let ndr = dr * zr - di * zi + pr
    let ndi = dr * zi + di * zr + pi
    dr = ndr
    di = ndi
    // p = p * z + c[k]
    let npr = pr * zr - pi * zi + c[k]
    let npi = pr * zi + pi * zr
    pr = npr
    pi = npi
  }
  return [pr, pi, dr, di]
}

/// Finds all complex roots of a monic degree-`deg` real polynomial `c[0..deg+1]`
/// (where `c[deg] == 1.0`) using Aberth-Ehrlich simultaneous iteration.
fn findPolyRoots(c: &[f64], deg: usize, rr: &mut [f64], ri: &mut [f64]) -> () {
  // Initial guesses evenly distributed on a slightly tilted circle of radius 0.92.
  let twoPi = 2.0 * f64.PI
  let mut k: usize = 0
  while k < deg {
    let ang = twoPi * usize.toF64(k) / usize.toF64(deg) + 0.137
    let rad = 0.88 + 0.06 * usize.toF64(k % 3)
    rr[k] = rad * f64.cos(ang)
    ri[k] = rad * f64.sin(ang)
    k = k + 1
  }

  let mut iter: usize = 0
  while iter < 48 {
    let mut maxStep: f64 = 0.0
    k = 0
    while k < deg {
      let zr = rr[k]
      let zi = ri[k]
      let pd = evalPolyAndDeriv(c, deg, zr, zi)
      let pr = pd[0]
      let pi = pd[1]
      let dr = pd[2]
      let di = pd[3]
      let dNorm = dr * dr + di * di
      if dNorm > 1.0e-30 {
        // w = P(z) / P'(z)
        let wr = (pr * dr + pi * di) / dNorm
        let wi = (pi * dr - pr * di) / dNorm
        // sum_{j != k} 1 / (z_k - z_j)
        let mut sr: f64 = 0.0
        let mut si: f64 = 0.0
        let mut j: usize = 0
        while j < deg {
          if j != k {
            let dx = zr - rr[j]
            let dy = zi - ri[j]
            let dn = dx * dx + dy * dy
            if dn > 1.0e-30 {
              sr = sr + dx / dn
              si = si - dy / dn
            }
          }
          j = j + 1
        }
        // denom = 1 - w * s
        let denR = 1.0 - (wr * sr - wi * si)
        let denI = -(wr * si + wi * sr)
        let denNorm = denR * denR + denI * denI
        if denNorm > 1.0e-30 {
          let stepR = (wr * denR + wi * denI) / denNorm
          let stepI = (wi * denR - wr * denI) / denNorm
          rr[k] = zr - stepR
          ri[k] = zi - stepI
          let mag = f64.sqrt(stepR * stepR + stepI * stepI)
          if mag > maxStep {
            maxStep = mag
          }
        }
      }
      k = k + 1
    }
    if maxStep < 1.0e-9 {
      break
    }
    iter = iter + 1
  }
}

/// Evaluates the LPC vocal-tract dB envelope at `freqHz` for `workingRate` (used in the spectrum slice).
pub fn lpcEnvelopeDb(a: &[f64], order: usize, freqHz: f64, workingRate: f64) -> f32 {
  if order == 0 || workingRate <= 0.0 || freqHz >= workingRate * 0.5 {
    return -120.0
  }
  let omega = 2.0 * f64.PI * freqHz / workingRate
  let mut re: f64 = 1.0
  let mut im: f64 = 0.0
  let mut k: usize = 0
  while k < order {
    let ang = omega * usize.toF64(k + 1)
    re = re - a[k] * f64.cos(ang)
    im = im + a[k] * f64.sin(ang)
    k = k + 1
  }
  let mag2 = re * re + im * im
  if mag2 <= 1.0e-12 {
    return 0.0
  }
  return f64.toF32(-10.0 * f64.log(mag2) / f64.log(10.0))
}

/// Reusable Praat Burg formant analyzer + incremental track.
pub struct FormantTrack {
  pub frames: List<FormantFrame>,
  pub ceilingHz: f64,
  pub hopSeconds: f64,
  pub sampleRate: f64,
  pub workingRate: f64,
  pub windowSamples: usize,
  window: List<f64>,
  resampled: List<f64>,
  work: List<f64>,
  b1: List<f64>,
  b2: List<f64>,
  pub lastLpc: List<f64>,
  pub lastLpcValid: bool,
}

impl FormantTrack {
  pub fn empty() -> FormantTrack {
    return FormantTrack {
      frames: List<FormantFrame>.make(),
      ceilingHz: DEFAULT_FORMANT_CEILING_HZ,
      hopSeconds: 1024.0 / 44100.0,
      sampleRate: 48000.0,
      workingRate: DEFAULT_FORMANT_CEILING_HZ * 2.0,
      windowSamples: 550,
      window: List<f64>.make(),
      resampled: List<f64>.make(),
      work: List<f64>.make(),
      b1: List<f64>.make(),
      b2: List<f64>.make(),
      lastLpc: List<f64>.make(),
      lastLpcValid: false,
    }
  }

  pub effect fn reset(self: &mut Self, sampleRate: f64, ceilingHz: f64, hopSeconds: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.frames.clear()
    self.sampleRate = sampleRate
    self.ceilingHz = f64.max(3000.0, f64.min(ceilingHz, sampleRate * 0.49))
    self.workingRate = self.ceilingHz * 2.0
    self.hopSeconds = hopSeconds
    // Praat actual window is 2 * halfdt_window = 0.050 s.
    let rawWin = f64.toUsize(f64.round(2.0 * DEFAULT_HALF_WINDOW_S * self.workingRate))
    self.windowSamples = if rawWin < 64 { 64 } else { rawWin }
    self.window = run makePraatGaussianWindow(self.windowSamples)

    self.resampled.clear()
    run self.resampled.appendRepeated(0.0, self.windowSamples)
    self.work.clear()
    run self.work.appendRepeated(0.0, self.windowSamples + 1)
    self.b1.clear()
    run self.b1.appendRepeated(0.0, self.windowSamples)
    self.b2.clear()
    run self.b2.appendRepeated(0.0, self.windowSamples)
    self.lastLpc.clear()
    run self.lastLpc.appendRepeated(0.0, DEFAULT_LPC_ORDER)
    self.lastLpcValid = false
  }

  pub fn analyzeFrame(self: &mut Self, samples: &[f32], centreSec: f64, saveLpc: bool) -> FormantFrame {
    let intensityDb = resampleAndPreEmphasize(
      samples,
      self.sampleRate,
      centreSec,
      self.workingRate,
      self.resampled.asMutSlice(),
      self.work.asMutSlice(),
    )
    if intensityDb < -72.0 {
      if saveLpc {
        self.lastLpcValid = false
      }
      return FormantFrame.empty(centreSec, intensityDb)
    }

    let n = self.windowSamples
    let win = self.window.asSlice()
    let x = self.resampled.asMutSlice()
    let mut i: usize = 0
    while i < n {
      x[i] = x[i] * win[i]
      i = i + 1
    }

    let mut a: [f64; 10] = [0.0; 10]
    let mut aa: [f64; 10] = [0.0; 10]
    let ok = burgLpc(self.resampled.asSlice(), DEFAULT_LPC_ORDER, &mut a, self.b1.asMutSlice(), self.b2.asMutSlice(), &mut aa)
    if !ok {
      if saveLpc {
        self.lastLpcValid = false
      }
      return FormantFrame.empty(centreSec, intensityDb)
    }

    if saveLpc {
      let dst = self.lastLpc.asMutSlice()
      i = 0
      while i < DEFAULT_LPC_ORDER {
        dst[i] = a[i]
        i = i + 1
      }
      self.lastLpcValid = true
    }

    // Polynomial in reverse order with leading 1.0 (Praat Sound_to_Formant.cpp:41-53):
    //   P(z) = z^p - a[0]*z^(p-1) - ... - a[p-1]
    let mut poly: [f64; 11] = [0.0; 11]
    i = 0
    while i < DEFAULT_LPC_ORDER {
      poly[i] = -a[DEFAULT_LPC_ORDER - 1 - i]
      i = i + 1
    }
    poly[DEFAULT_LPC_ORDER] = 1.0

    let mut rr: [f64; 10] = [0.0; 10]
    let mut ri: [f64; 10] = [0.0; 10]
    findPolyRoots(&poly, DEFAULT_LPC_ORDER, &mut rr, &mut ri)

    // Convert roots on/above real axis into (freq, bw) after reflecting unstable roots into unit circle.
    let nyq = self.workingRate * 0.5
    let mut peaks: [FormantPeak; 10] = [FormantPeak { freq: 0.0, bw: 0.0 }; 10]
    let mut pCount: usize = 0

    i = 0
    while i < DEFAULT_LPC_ORDER {
      let mut re = rr[i]
      let mut im = ri[i]
      let mut norm2 = re * re + im * im
      if norm2 > 1.0 {
        // Reflect outside root inside: 1 / conj(z) = z / |z|^2
        re = re / norm2
        im = im / norm2
        norm2 = 1.0 / norm2
      }
      // Keep only upper half-plane roots (im >= 0) so conjugate pairs are counted once.
      if im >= 1.0e-7 && norm2 > 1.0e-12 {
        let freq = f64.abs(f64.atan2(im, re)) * nyq / f64.PI
        let bw = -f64.log(norm2) * nyq / f64.PI
        if freq >= SAFETY_MARGIN_HZ && freq <= nyq - SAFETY_MARGIN_HZ && bw > 0.0 && bw <= MAX_FORMANT_BANDWIDTH_HZ {
          peaks[pCount] = FormantPeak { freq: freq, bw: bw }
          pCount = pCount + 1
        }
      }
      i = i + 1
    }

    // Selection sort ascending by frequency (Praat Formant_sort).
    i = 0
    while i < pCount {
      let mut best = i
      let mut j = i + 1
      while j < pCount {
        if peaks[j].freq < peaks[best].freq {
          best = j
        }
        j = j + 1
      }
      if best != i {
        let tmp = peaks[i]
        peaks[i] = peaks[best]
        peaks[best] = tmp
      }
      i = i + 1
    }

    let mut frame = FormantFrame.empty(centreSec, intensityDb)
    // Save up to 6 candidate Burg roots (wide enough to keep real F1/F2 transitions without slot-shifting)
    let mut kept: usize = 0
    i = 0
    while i < pCount && kept < 6 {
      let pf = peaks[i].freq
      let pbw = peaks[i].bw
      let bwLim = if pf < 1200.0 { 650.0 } else if pf < 2600.0 { 780.0 } else { 900.0 }
      if pbw <= bwLim {
        frame.candFreqs[kept] = pf
        frame.candBws[kept] = pbw
        kept = kept + 1
      }
      i = i + 1
    }
    frame.candCount = kept

    // Assign live formants using physiological band priors so live recording never shifts
    // F3->F2 or F4->F3 when a lower formant is missed (keeps live Size aligned with post-stop Neural).
    let scale = f64.max(0.75, f64.min(1.25, nyq / 5500.0))
    let refF1 = 550.0 * scale
    let refF2 = 1650.0 * scale
    let refF3 = 2750.0 * scale
    let refF4 = 3850.0 * scale

    let mut bestScore: f64 = 1.0e18
    let mut bestF1: f64 = 0.0
    let mut bestB1: f64 = 0.0
    let mut bestF2: f64 = 0.0
    let mut bestB2: f64 = 0.0
    let mut bestF3: f64 = 0.0
    let mut bestB3: f64 = 0.0
    let mut bestF4: f64 = 0.0
    let mut bestB4: f64 = 0.0
    let mut foundTriple = false

    if kept >= 3 {
      let mut a: usize = 0
      while a < kept {
        let fa = frame.candFreqs[a]
        let ba = frame.candBws[a]
        if fa >= 220.0 && fa <= 1180.0 {
          let mut b = a + 1
          while b < kept {
            let fb = frame.candFreqs[b]
            let bb = frame.candBws[b]
            if fb >= 650.0 && fb <= 3200.0 && fb >= fa + 150.0 {
              let mut c = b + 1
              while c < kept {
                let fc = frame.candFreqs[c]
                let bc = frame.candBws[c]
                if fc >= 1650.0 && fc <= 3600.0 && fc >= fb + 180.0 {
                  let d1 = f64.log2(fa / refF1)
                  let d2 = f64.log2(fb / refF2)
                  let d3 = f64.log2(fc / refF3)
                  let sc = 0.85 * d1 * d1 + 0.65 * d2 * d2 + 1.25 * d3 * d3
                    + 0.40 * (ba / fa) + 0.35 * (bb / fb) + 0.30 * (bc / fc)
                  if sc < bestScore {
                    bestScore = sc
                    bestF1 = fa
                    bestB1 = ba
                    bestF2 = fb
                    bestB2 = bb
                    bestF3 = fc
                    bestB3 = bc
                    bestF4 = 0.0
                    bestB4 = 0.0
                    let mut d = c + 1
                    let mut bestDSc: f64 = 1.0e9
                    while d < kept {
                      let fd = frame.candFreqs[d]
                      let bd = frame.candBws[d]
                      if fd >= 2800.0 && fd >= fc + 200.0 && fd <= nyq - 80.0 {
                        let ds = f64.abs(f64.log2(fd / refF4)) + 0.35 * (bd / fd)
                        if ds < bestDSc {
                          bestDSc = ds
                          bestF4 = fd
                          bestB4 = bd
                        }
                      }
                      d = d + 1
                    }
                    foundTriple = true
                  }
                }
                c = c + 1
              }
            }
            b = b + 1
          }
        }
        a = a + 1
      }
    }

    if foundTriple {
      frame.f1 = bestF1
      frame.bw1 = bestB1
      frame.f2 = bestF2
      frame.bw2 = bestB2
      frame.f3 = bestF3
      frame.bw3 = bestB3
      frame.f4 = bestF4
      frame.bw4 = bestB4
      frame.count = if bestF4 > 0.0 { 4 } else { 3 }
    } else if kept >= 2 {
      // Fallback: pick best F1 and F2 in physiological bands without shifting F3/F4 down into them
      let mut b1Sc: f64 = 1.0e9
      let mut b2Sc: f64 = 1.0e9
      let mut b3Sc: f64 = 1.0e9
      i = 0
      while i < kept {
        let f = frame.candFreqs[i]
        let bw = frame.candBws[i]
        if f >= 220.0 && f <= 1150.0 {
          let s = f64.abs(f64.log2(f / refF1)) + 0.30 * (bw / f)
          if s < b1Sc {
            b1Sc = s
            bestF1 = f
            bestB1 = bw
          }
        } else if f >= 800.0 && f <= 2900.0 {
          let s = f64.abs(f64.log2(f / refF2)) + 0.30 * (bw / f)
          if s < b2Sc {
            b2Sc = s
            bestF2 = f
            bestB2 = bw
          }
        } else if f >= 1900.0 && f <= 3900.0 {
          let s = f64.abs(f64.log2(f / refF3)) + 0.30 * (bw / f)
          if s < b3Sc {
            b3Sc = s
            bestF3 = f
            bestB3 = bw
          }
        }
        i = i + 1
      }
      if bestF1 > 0.0 && bestF2 > bestF1 + 120.0 {
        frame.f1 = bestF1
        frame.bw1 = bestB1
        frame.f2 = bestF2
        frame.bw2 = bestB2
        if bestF3 > bestF2 + 150.0 {
          frame.f3 = bestF3
          frame.bw3 = bestB3
          frame.count = 3
        } else {
          frame.count = 2
        }
      } else {
        frame.count = 0
      }
    }
    return frame
  }

  /// Appends newly computable formant frames for `samples`.
  pub effect fn update(self: &mut Self, samples: &[f32]) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.updateChunk(samples, 1000000)
  }

  /// Appends up to `maxFrames` formant frames for non-blocking progressive analysis.
  pub effect fn updateChunk(self: &mut Self, samples: &[f32], maxFrames: usize) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let duration = usize.toF64(samples.length) / self.sampleRate
    if duration < DEFAULT_HALF_WINDOW_S * 2.0 || maxFrames == 0 {
      return 0
    }
    let margin = DEFAULT_HALF_WINDOW_S
    let computable = f64.toUsize(f64.floor((duration - 2.0 * margin) / self.hopSeconds)) + 1
    let already = self.frames.length()
    if computable <= already {
      return 0
    }
    let target = if already + maxFrames < computable { already + maxFrames } else { computable }
    let mut added: usize = 0
    let mut idx = already
    while idx < target {
      let t = margin + usize.toF64(idx) * self.hopSeconds
      let frame = self.analyzeFrame(samples, t, false)
      run self.frames.append(frame)
      idx = idx + 1
      added = added + 1
    }
    return added
  }

  pub fn totalComputable(self: &Self, sampleCount: usize) -> usize {
    let duration = usize.toF64(sampleCount) / self.sampleRate
    if duration < DEFAULT_HALF_WINDOW_S * 2.0 {
      return 0
    }
    let margin = DEFAULT_HALF_WINDOW_S
    return f64.toUsize(f64.floor((duration - 2.0 * margin) / self.hopSeconds)) + 1
  }

  /// Fast-path shell allocation (timestamps + RMS intensityDb only, <1 ms for 60s)
  /// used when FormantsTracker ONNX is already loaded in the background worker so we
  /// completely skip slow Classic Burg LPC + companion-matrix root finding on long clips!
  pub effect fn populateShellFrames(self: &mut Self, samples: &[f32]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.frames.clear()
    let duration = usize.toF64(samples.length) / self.sampleRate
    if duration < DEFAULT_HALF_WINDOW_S * 2.0 {
      return ()
    }
    let margin = DEFAULT_HALF_WINDOW_S
    let computable = f64.toUsize(f64.floor((duration - 2.0 * margin) / self.hopSeconds)) + 1
    let halfWinN = f64.toUsize(f64.max(16.0, margin * self.sampleRate))
    let step = if halfWinN > 64 { (halfWinN * 2) / 48 } else { 1 }
    let mut idx: usize = 0
    while idx < computable {
      let t = margin + usize.toF64(idx) * self.hopSeconds
      let center = f64.toUsize(f64.round(t * self.sampleRate))
      let s0 = if center > halfWinN { center - halfWinN } else { 0 }
      let s1Raw = center + halfWinN
      let s1 = if s1Raw < samples.length { s1Raw } else { samples.length }
      let mut sq: f64 = 0.0
      let mut cnt: usize = 0
      let mut j = s0
      while j < s1 {
        let v = f32.toF64(samples[j])
        sq = sq + v * v
        cnt = cnt + 1
        j = j + step
      }
      let msq = if cnt > 0 { sq / usize.toF64(cnt) } else { 0.0 }
      let db = if msq > 1.0e-12 { 4.342944819032518 * f64.log(msq) } else { -120.0 }
      run self.frames.append(FormantFrame.empty(t, db))
      idx = idx + 1
    }
  }

  /// Incrementally voice-gates and continuity-tracks newly added frames (`fromIdx..len`)
  /// during live recording so F1–F3 ribbons, VOWELS live dot, and F1/F2/F3 Hz readouts
  /// update in real time while speaking.
  pub fn updateLiveTracked(
    self: &mut Self,
    pitchFrames: &[PitchFrame],
    displayClarity: f64,
    fromIdx: usize,
  ) -> () {
    let n = self.frames.length()
    if fromIdx >= n {
      return ()
    }
    let ceiling = self.workingRate * 0.5
    let scale = f64.max(0.75, f64.min(1.25, ceiling / 5500.0))
    let refF1 = 550.0 * scale
    let refF2 = 1650.0 * scale
    let refF3 = 2750.0 * scale
    let frMut = self.frames.asMutSlice()

    let mut i = fromIdx
    while i < n {
      let ft = frMut[i].time
      let fDb = frMut[i].intensityDb
      let mut isVoiced = false
      let mut curF0: f64 = 0.0
      if pitchFrames.length > 0 {
        let mut lo: usize = 0
        let mut hi: usize = pitchFrames.length - 1
        while lo < hi {
          let mid = lo + (hi - lo) / 2
          if pitchFrames[mid].time < ft {
            lo = mid + 1
          } else {
            hi = mid
          }
        }
        let mut bestP = lo
        if lo > 0 && f64.abs(pitchFrames[lo - 1].time - ft) < f64.abs(pitchFrames[lo].time - ft) {
          bestP = lo - 1
        }
        let pf = pitchFrames[bestP]
        if f64.abs(pf.time - ft) <= 0.045 && pf.voiced && pf.clarity >= displayClarity && fDb >= -58.0 {
          isVoiced = true
          curF0 = pf.frequency
        }
      }

      if !isVoiced || frMut[i].candCount < 2 {
        frMut[i].tracked = false
        i = i + 1
        continue
      }

      let hasPrev = i > 0 && frMut[i - 1].tracked && (ft - frMut[i - 1].time) <= 0.06
      let prevF1 = if hasPrev { frMut[i - 1].f1 } else { 0.0 }
      let prevF2 = if hasPrev { frMut[i - 1].f2 } else { 0.0 }
      let prevF3 = if hasPrev { frMut[i - 1].f3 } else { 0.0 }

      let f1Floor = f64.max(200.0, curF0 * 1.10)
      let cc = frMut[i].candCount
      let mut bestSc: f64 = 1.0e18
      let mut bestF1: f64 = 0.0
      let mut bestB1: f64 = 0.0
      let mut bestF2: f64 = 0.0
      let mut bestB2: f64 = 0.0
      let mut bestF3: f64 = 0.0
      let mut bestB3: f64 = 0.0
      let mut found = false

      if cc >= 3 {
        let mut a: usize = 0
        while a < cc {
          let fa = frMut[i].candFreqs[a]
          let ba = frMut[i].candBws[a]
          if fa >= f1Floor && fa <= 1180.0 {
            let mut b = a + 1
            while b < cc {
              let fb = frMut[i].candFreqs[b]
              let bb = frMut[i].candBws[b]
              if fb >= 650.0 && fb <= 3200.0 && fb >= fa + 150.0 {
                let mut c = b + 1
                while c < cc {
                  let fc = frMut[i].candFreqs[c]
                  let bc = frMut[i].candBws[c]
                  if fc >= 1650.0 && fc <= 3600.0 && fc >= fb + 180.0 {
                    let d1 = f64.log2(fa / refF1)
                    let d2 = f64.log2(fb / refF2)
                    let d3 = f64.log2(fc / refF3)
                    let f0Pen = if curF0 > 50.0 && fa < curF0 * 1.28 { 1.4 } else { 0.0 }
                    let mut sc = 0.75 * d1 * d1 + 0.55 * d2 * d2 + 1.15 * d3 * d3 + f0Pen
                      + 0.35 * (ba / fa) + 0.30 * (bb / fb) + 0.25 * (bc / fc)
                    if hasPrev && prevF1 > 150.0 && prevF2 > 400.0 {
                      let j1 = f64.log2(fa / prevF1)
                      let j2 = f64.log2(fb / prevF2)
                      sc = sc + 2.4 * (j1 * j1 + j2 * j2)
                      if prevF3 > 1200.0 {
                        let j3 = f64.log2(fc / prevF3)
                        sc = sc + 2.8 * j3 * j3
                      }
                    }
                    if sc < bestSc {
                      bestSc = sc
                      bestF1 = fa
                      bestB1 = ba
                      bestF2 = fb
                      bestB2 = bb
                      bestF3 = fc
                      bestB3 = bc
                      found = true
                    }
                  }
                  c = c + 1
                }
              }
              b = b + 1
            }
          }
          a = a + 1
        }
      }

      if found {
        let mut f1Out = bestF1
        let mut f2Out = bestF2
        let mut f3Out = bestF3
        if hasPrev {
          if prevF1 > 150.0 && f64.abs(f64.log2(f1Out / prevF1)) < 0.45 {
            f1Out = prevF1 * 0.52 + f1Out * 0.48
          }
          if prevF2 > 400.0 && f64.abs(f64.log2(f2Out / prevF2)) < 0.45 {
            f2Out = prevF2 * 0.52 + f2Out * 0.48
          }
          if prevF3 > 1200.0 && f64.abs(f64.log2(f3Out / prevF3)) < 0.40 {
            f3Out = prevF3 * 0.58 + f3Out * 0.42
          }
        }
        frMut[i].f1 = f1Out
        frMut[i].bw1 = bestB1
        frMut[i].f2 = f2Out
        frMut[i].bw2 = bestB2
        frMut[i].f3 = f3Out
        frMut[i].bw3 = bestB3
        frMut[i].count = 3
        frMut[i].tracked = true
      } else if frMut[i].count >= 2 && frMut[i].f1 >= f1Floor && frMut[i].f1 <= 1180.0 && frMut[i].f2 > frMut[i].f1 + 120.0 {
        if hasPrev {
          if prevF1 > 150.0 && f64.abs(f64.log2(frMut[i].f1 / prevF1)) < 0.45 {
            frMut[i].f1 = prevF1 * 0.52 + frMut[i].f1 * 0.48
          }
          if prevF2 > 400.0 && f64.abs(f64.log2(frMut[i].f2 / prevF2)) < 0.45 {
            frMut[i].f2 = prevF2 * 0.52 + frMut[i].f2 * 0.48
          }
          if frMut[i].count >= 3 && prevF3 > 1200.0 && f64.abs(f64.log2(frMut[i].f3 / prevF3)) < 0.40 {
            frMut[i].f3 = prevF3 * 0.58 + frMut[i].f3 * 0.42
          }
        }
        frMut[i].tracked = true
      } else {
        frMut[i].tracked = false
      }
      i = i + 1
    }
  }

  pub fn nearest(self: &Self, timeSec: f64) -> Option<FormantFrame> {
    let n = self.frames.length()
    if n == 0 {
      return Option<FormantFrame>.None
    }
    let firstT = self.frames.get(0).time
    if self.hopSeconds <= 0.0 {
      return Option<FormantFrame>.some(self.frames.get(0))
    }
    let raw = f64.round((timeSec - firstT) / self.hopSeconds)
    if raw < 0.0 {
      return Option<FormantFrame>.some(self.frames.get(0))
    }
    let idx = f64.toUsize(raw)
    if idx >= n {
      return Option<FormantFrame>.some(self.frames.get(n - 1))
    }
    return Option<FormantFrame>.some(self.frames.get(idx))
  }

  /// Voicing-gated Praat-style Viterbi formant tracking + temporal smoothing.
  /// Eliminates unvoiced consonant confetti, F1<->F2<->F3 slot swaps, and frame-to-frame jitter.
  pub effect fn refineTracked(self: &mut Self, pitchFrames: &[PitchFrame], displayClarity: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let n = self.frames.length()
    if n == 0 {
      return ()
    }
    let ceiling = self.workingRate * 0.5
    let scale = f64.max(0.75, f64.min(1.25, ceiling / 5500.0))
    let refF1 = 550.0 * scale
    let refF2 = 1650.0 * scale
    let refF3 = 2750.0 * scale
    let refF4 = 3850.0 * scale

    // 1. Determine active voiced speech frames via pitch track + relative intensity
    let mut peakDb: f64 = -120.0
    let mut i: usize = 0
    while i < n {
      let db = self.frames.asSlice()[i].intensityDb
      if db > peakDb {
        peakDb = db
      }
      i = i + 1
    }
    let minActiveDb = f64.max(-58.0, peakDb - 34.0)

    let mut active = List<bool>.make()
    run active.appendRepeated(false, n)
    let actSl = active.asMutSlice()
    let mut frameF0 = List<f64>.make()
    run frameF0.appendRepeated(0.0, n)
    let f0Sl = frameF0.asMutSlice()

    let mut pIdx: usize = 0
    i = 0
    while i < n {
      let ft = self.frames.asSlice()[i].time
      let fDb = self.frames.asSlice()[i].intensityDb
      let mut isVoiced = false
      let mut matchedF0: f64 = 0.0
      if pitchFrames.length > 0 {
        while pIdx + 1 < pitchFrames.length && pitchFrames[pIdx + 1].time < ft {
          pIdx = pIdx + 1
        }
        let mut bestP = pIdx
        if pIdx + 1 < pitchFrames.length {
          let d0 = f64.abs(pitchFrames[pIdx].time - ft)
          let d1 = f64.abs(pitchFrames[pIdx + 1].time - ft)
          if d1 < d0 {
            bestP = pIdx + 1
          }
        }
        let pf = pitchFrames[bestP]
        if f64.abs(pf.time - ft) <= 0.035 && pf.voiced && pf.clarity >= displayClarity && fDb >= minActiveDb {
          isVoiced = true
          matchedF0 = pf.frequency
        }
      } else if fDb >= minActiveDb {
        isVoiced = true
      }
      actSl[i] = isVoiced && self.frames.asSlice()[i].candCount >= 2
      f0Sl[i] = matchedF0
      i = i + 1
    }

    // 2. Drop tiny isolated 1-2 frame voiced blips
    i = 0
    while i < n {
      if actSl[i] {
        let mut j = i
        while j < n && actSl[j] {
          j = j + 1
        }
        if j - i < 3 {
          let mut k = i
          while k < j {
            actSl[k] = false
            k = k + 1
          }
        }
        i = j
      } else {
        i = i + 1
      }
    }

    // 3. Process each contiguous voiced run with Viterbi DP over ordered candidate tuples (F1 < F2 < F3 [< F4])
    // Max candidates = 6 -> at most C(6,3) = 20 triples per frame (super fast!)
    let maxStates: usize = 24
    let bigInf: f64 = 1.0e18

    let mut runStart: usize = 0
    while runStart < n {
      if !actSl[runStart] {
        let frMut = self.frames.asMutSlice()
        frMut[runStart].tracked = false
        frMut[runStart].f1 = 0.0
        frMut[runStart].f2 = 0.0
        frMut[runStart].f3 = 0.0
        frMut[runStart].f4 = 0.0
        frMut[runStart].count = 0
        runStart = runStart + 1
        continue
      }
      let mut runEnd = runStart
      while runEnd < n && actSl[runEnd] {
        runEnd = runEnd + 1
      }
      let rLen = runEnd - runStart

      // Enumerate valid candidate states for each frame in the run
      let mut stCount = List<usize>.make()
      run stCount.appendRepeated(0, rLen)
      let mut stF1 = List<f64>.make()
      run stF1.appendRepeated(0.0, rLen * maxStates)
      let mut stF2 = List<f64>.make()
      run stF2.appendRepeated(0.0, rLen * maxStates)
      let mut stF3 = List<f64>.make()
      run stF3.appendRepeated(0.0, rLen * maxStates)
      let mut stF4 = List<f64>.make()
      run stF4.appendRepeated(0.0, rLen * maxStates)
      let mut stB1 = List<f64>.make()
      run stB1.appendRepeated(0.0, rLen * maxStates)
      let mut stB2 = List<f64>.make()
      run stB2.appendRepeated(0.0, rLen * maxStates)
      let mut stB3 = List<f64>.make()
      run stB3.appendRepeated(0.0, rLen * maxStates)
      let mut stB4 = List<f64>.make()
      run stB4.appendRepeated(0.0, rLen * maxStates)
      let mut stEmit = List<f64>.make()
      run stEmit.appendRepeated(bigInf, rLen * maxStates)

      let stCntSl = stCount.asMutSlice()
      let f1Sl = stF1.asMutSlice()
      let f2Sl = stF2.asMutSlice()
      let f3Sl = stF3.asMutSlice()
      let f4Sl = stF4.asMutSlice()
      let b1Sl = stB1.asMutSlice()
      let b2Sl = stB2.asMutSlice()
      let b3Sl = stB3.asMutSlice()
      let b4Sl = stB4.asMutSlice()
      let emSl = stEmit.asMutSlice()
      let frSl = self.frames.asSlice()

      let mut t: usize = 0
      while t < rLen {
        let fr = frSl[runStart + t]
        let curF0 = f0Sl[runStart + t]
        let f1Floor = f64.max(200.0, curF0 * 1.10)
        let cc = fr.candCount
        let base = t * maxStates
        let mut sc: usize = 0

        if cc >= 3 {
          let mut a: usize = 0
          while a < cc && sc < maxStates {
            let fa = fr.candFreqs[a]
            let ba = fr.candBws[a]
            if fa >= f1Floor && fa <= 1180.0 {
              let mut b = a + 1
              while b < cc && sc < maxStates {
                let fb = fr.candFreqs[b]
                let bb = fr.candBws[b]
                if fb >= 550.0 && fb <= 3300.0 && fb >= fa + 150.0 {
                  let mut c = b + 1
                  while c < cc && sc < maxStates {
                    let fc = fr.candFreqs[c]
                    let bc = fr.candBws[c]
                    if fc >= 1650.0 && fc <= 3600.0 && fc >= fb + 180.0 {
                      // Pick best optional F4 > F3
                      let mut fd: f64 = 0.0
                      let mut bd: f64 = 0.0
                      let mut d = c + 1
                      let mut bestDScore: f64 = 1.0e9
                      while d < cc {
                        let candD = fr.candFreqs[d]
                        let candBd = fr.candBws[d]
                        if candD >= 2800.0 && candD >= fc + 200.0 && candD <= ceiling - 80.0 {
                          let ds = f64.abs(f64.log2(candD / refF4)) + 0.35 * (candBd / candD)
                          if ds < bestDScore {
                            bestDScore = ds
                            fd = candD
                            bd = candBd
                          }
                        }
                        d = d + 1
                      }
                      // Gentle physiological band prior + bandwidth sharpness preference
                      let d1 = f64.log2(fa / refF1)
                      let d2 = f64.log2(fb / refF2)
                      let d3 = f64.log2(fc / refF3)
                      let f0ProxPen = if curF0 > 50.0 && fa < curF0 * 1.28 { 1.4 } else { 0.0 }
                      let priorCost = 0.85 * d1 * d1 + 0.65 * d2 * d2 + 1.35 * d3 * d3 + f0ProxPen
                      let bwCost = 0.45 * (ba / fa) + 0.40 * (bb / fb) + 0.35 * (bc / fc)
                      f1Sl[base + sc] = fa
                      f2Sl[base + sc] = fb
                      f3Sl[base + sc] = fc
                      f4Sl[base + sc] = fd
                      b1Sl[base + sc] = ba
                      b2Sl[base + sc] = bb
                      b3Sl[base + sc] = bc
                      b4Sl[base + sc] = bd
                      emSl[base + sc] = priorCost + bwCost
                      sc = sc + 1
                    }
                    c = c + 1
                  }
                }
                b = b + 1
              }
            }
            a = a + 1
          }
        }

        // Fallback if fewer than 3 valid physiological roots exist in this frame:
        // use the physiologically assigned live formants (never blindly slot-shift F2->F1 / F3->F2).
        if sc == 0 && fr.count >= 2 && fr.f1 >= 200.0 && fr.f2 > fr.f1 + 120.0 {
          f1Sl[base] = fr.f1
          b1Sl[base] = fr.bw1
          f2Sl[base] = fr.f2
          b2Sl[base] = fr.bw2
          if fr.count >= 3 && fr.f3 > fr.f2 + 150.0 {
            f3Sl[base] = fr.f3
            b3Sl[base] = fr.bw3
          }
          if fr.count >= 4 && fr.f4 > fr.f3 + 200.0 {
            f4Sl[base] = fr.f4
            b4Sl[base] = fr.bw4
          }
          emSl[base] = 2.0
          sc = 1
        }
        stCntSl[t] = sc
        t = t + 1
      }

      // Viterbi forward pass
      let mut dp = List<f64>.make()
      run dp.appendRepeated(bigInf, rLen * maxStates)
      let mut bk = List<usize>.make()
      run bk.appendRepeated(0, rLen * maxStates)
      let dpSl = dp.asMutSlice()
      let bkSl = bk.asMutSlice()

      let mut s: usize = 0
      while s < stCntSl[0] {
        dpSl[s] = emSl[s]
        s = s + 1
      }

      t = 1
      while t < rLen {
        let base = t * maxStates
        let pBase = (t - 1) * maxStates
        let curN = stCntSl[t]
        let prevN = stCntSl[t - 1]
        s = 0
        while s < curN {
          let cf1 = f1Sl[base + s]
          let cf2 = f2Sl[base + s]
          let cf3 = f3Sl[base + s]
          let mut bestCost = bigInf
          let mut bestPrev: usize = 0
          let mut ps: usize = 0
          while ps < prevN {
            let pCost = dpSl[pBase + ps]
            if pCost < bigInf * 0.5 {
              let pf1 = f1Sl[pBase + ps]
              let pf2 = f2Sl[pBase + ps]
              let pf3 = f3Sl[pBase + ps]
              let j1 = if cf1 > 1.0 && pf1 > 1.0 { f64.abs(f64.log2(cf1 / pf1)) } else { 0.4 }
              let j2 = if cf2 > 1.0 && pf2 > 1.0 { f64.abs(f64.log2(cf2 / pf2)) } else { 0.4 }
              let j3 = if cf3 > 1.0 && pf3 > 1.0 { f64.abs(f64.log2(cf3 / pf3)) } else { 0.25 }
              let trans = 9.5 * j1 + 9.0 * j2 + 7.5 * j3
              let total = pCost + trans
              if total < bestCost {
                bestCost = total
                bestPrev = ps
              }
            }
            ps = ps + 1
          }
          dpSl[base + s] = bestCost + emSl[base + s]
          bkSl[base + s] = bestPrev
          s = s + 1
        }
        t = t + 1
      }

      // Backtrack optimal formant track
      let mut chosen = List<usize>.make()
      run chosen.appendRepeated(0, rLen)
      let chSl = chosen.asMutSlice()
      let lastBase = (rLen - 1) * maxStates
      let mut bestEnd: usize = 0
      let mut bestEndCost = bigInf
      s = 0
      while s < stCntSl[rLen - 1] {
        if dpSl[lastBase + s] < bestEndCost {
          bestEndCost = dpSl[lastBase + s]
          bestEnd = s
        }
        s = s + 1
      }
      chSl[rLen - 1] = bestEnd
      let mut bt = rLen - 1
      while bt > 0 {
        chSl[bt - 1] = bkSl[bt * maxStates + chSl[bt]]
        bt = bt - 1
      }

      // Extract raw tracked arrays for 3-point median + [0.22, 0.56, 0.22] Gaussian smoothing
      let mut rF1 = List<f64>.make()
      let mut rF2 = List<f64>.make()
      let mut rF3 = List<f64>.make()
      let mut rF4 = List<f64>.make()
      run rF1.appendRepeated(0.0, rLen)
      run rF2.appendRepeated(0.0, rLen)
      run rF3.appendRepeated(0.0, rLen)
      run rF4.appendRepeated(0.0, rLen)
      let r1Sl = rF1.asMutSlice()
      let r2Sl = rF2.asMutSlice()
      let r3Sl = rF3.asMutSlice()
      let r4Sl = rF4.asMutSlice()

      t = 0
      while t < rLen {
        let idx = t * maxStates + chSl[t]
        r1Sl[t] = f1Sl[idx]
        r2Sl[t] = f2Sl[idx]
        r3Sl[t] = f3Sl[idx]
        r4Sl[t] = f4Sl[idx]
        t = t + 1
      }

      run smoothPositiveBand(rF1.asMutSlice())
      run smoothPositiveBand(rF2.asMutSlice())
      run smoothPositiveBand(rF3.asMutSlice())
      run smoothPositiveBand(rF4.asMutSlice())

      // Write tracked & smoothed formants back into `self.frames`
      let s1 = rF1.asSlice()
      let s2 = rF2.asSlice()
      let s3 = rF3.asSlice()
      let s4 = rF4.asSlice()
      let frMut = self.frames.asMutSlice()
      t = 0
      while t < rLen {
        let idx = t * maxStates + chSl[t]
        let dstIdx = runStart + t
        let v1 = s1[t]
        let v2 = s2[t]
        let v3 = s3[t]
        let v4 = s4[t]
        let mut cnt: usize = 0
        if v1 > 1.0 { cnt = 1 }
        if v2 > v1 + 60.0 { cnt = 2 }
        if v3 > v2 + 80.0 { cnt = 3 }
        if v4 > v3 + 80.0 { cnt = 4 }
        frMut[dstIdx].f1 = v1
        frMut[dstIdx].bw1 = b1Sl[idx]
        frMut[dstIdx].f2 = v2
        frMut[dstIdx].bw2 = b2Sl[idx]
        frMut[dstIdx].f3 = v3
        frMut[dstIdx].bw3 = b3Sl[idx]
        frMut[dstIdx].f4 = v4
        frMut[dstIdx].bw4 = b4Sl[idx]
        frMut[dstIdx].count = cnt
        frMut[dstIdx].tracked = cnt >= 2
        t = t + 1
      }

      runStart = runEnd
    }
  }
}

fn median3(a: f64, b: f64, c: f64) -> f64 {
  if a <= b {
    if b <= c { return b }
    if a <= c { return c }
    return a
  }
  if a <= c { return a }
  if b <= c { return c }
  return b
}

/// 3-point median despiking followed by gentle [0.22, 0.56, 0.22] Gaussian smoothing (zeros preserved).
effect fn smoothPositiveBand(vals: &mut [f64]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = vals.length
  if n < 3 {
    return ()
  }
  let mut med = List<f64>.make()
  run med.appendRepeated(0.0, n)
  let mSl = med.asMutSlice()

  let mut i: usize = 0
  while i < n {
    let cur = vals[i]
    if cur <= 1.0 {
      mSl[i] = 0.0
    } else if i > 0 && i + 1 < n && vals[i - 1] > 1.0 && vals[i + 1] > 1.0 {
      mSl[i] = median3(vals[i - 1], cur, vals[i + 1])
    } else {
      mSl[i] = cur
    }
    i = i + 1
  }

  i = 0
  while i < n {
    let cur = mSl[i]
    if cur <= 1.0 {
      vals[i] = 0.0
    } else if i > 0 && i + 1 < n && mSl[i - 1] > 1.0 && mSl[i + 1] > 1.0 {
      vals[i] = 0.22 * mSl[i - 1] + 0.56 * cur + 0.22 * mSl[i + 1]
    } else {
      vals[i] = cur
    }
    i = i + 1
  }
}

/// Applies neural FormantsTracker `(times, nf1, nf2, nf3)` predictions onto an existing uniform-hop
/// `FormantFrame` slice, gated by voiced pitch & relative speech energy and lightly smoothed.
pub effect fn applyNeuralFormantFrames(
  frames: &mut [FormantFrame],
  pitchFrames: &[PitchFrame],
  displayClarity: f64,
  times: &[f64],
  nf1: &[f64],
  nf2: &[f64],
  nf3: &[f64],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = frames.length
  let m = times.length
  if n == 0 || m == 0 || nf1.length < m || nf2.length < m || nf3.length < m {
    return ()
  }

  let mut peakDb: f64 = -120.0
  let mut i: usize = 0
  while i < n {
    if frames[i].intensityDb > peakDb {
      peakDb = frames[i].intensityDb
    }
    i = i + 1
  }
  let minActiveDb = f64.max(-58.0, peakDb - 34.0)

  let mut active = List<bool>.make()
  run active.appendRepeated(false, n)
  let actSl = active.asMutSlice()

  let mut pIdx: usize = 0
  i = 0
  while i < n {
    let ft = frames[i].time
    let fDb = frames[i].intensityDb
    let mut isVoiced = false
    if pitchFrames.length > 0 {
      while pIdx + 1 < pitchFrames.length && pitchFrames[pIdx + 1].time < ft {
        pIdx = pIdx + 1
      }
      let mut bestP = pIdx
      if pIdx + 1 < pitchFrames.length {
        if f64.abs(pitchFrames[pIdx + 1].time - ft) < f64.abs(pitchFrames[pIdx].time - ft) {
          bestP = pIdx + 1
        }
      }
      let pf = pitchFrames[bestP]
      if f64.abs(pf.time - ft) <= 0.035 && pf.voiced && pf.clarity >= displayClarity && fDb >= minActiveDb {
        isVoiced = true
      }
    } else if fDb >= minActiveDb {
      isVoiced = true
    }
    actSl[i] = isVoiced
    i = i + 1
  }

  // Drop isolated 1-2 frame blips
  i = 0
  while i < n {
    if actSl[i] {
      let mut j = i
      while j < n && actSl[j] {
        j = j + 1
      }
      if j - i < 3 {
        let mut k = i
        while k < j {
          actSl[k] = false
          k = k + 1
        }
      }
      i = j
    } else {
      i = i + 1
    }
  }

  // Interpolate neural F1/F2/F3 onto each active frame
  let mut rF1 = List<f64>.make()
  let mut rF2 = List<f64>.make()
  let mut rF3 = List<f64>.make()
  run rF1.appendRepeated(0.0, n)
  run rF2.appendRepeated(0.0, n)
  run rF3.appendRepeated(0.0, n)
  let sl1 = rF1.asMutSlice()
  let sl2 = rF2.asMutSlice()
  let sl3 = rF3.asMutSlice()

  let mut ti: usize = 0
  i = 0
  while i < n {
    if actSl[i] {
      let t = frames[i].time
      while ti + 1 < m && times[ti + 1] < t {
        ti = ti + 1
      }
      let mut v1: f64 = 0.0
      let mut v2: f64 = 0.0
      let mut v3: f64 = 0.0
      if ti + 1 < m && t >= times[ti] && t <= times[ti + 1] && (times[ti + 1] - times[ti]) > 1.0e-6 {
        let a = (t - times[ti]) / (times[ti + 1] - times[ti])
        v1 = nf1[ti] + a * (nf1[ti + 1] - nf1[ti])
        v2 = nf2[ti] + a * (nf2[ti + 1] - nf2[ti])
        v3 = nf3[ti] + a * (nf3[ti + 1] - nf3[ti])
      } else {
        let mut best = ti
        if ti + 1 < m && f64.abs(times[ti + 1] - t) < f64.abs(times[ti] - t) {
          best = ti + 1
        }
        if f64.abs(times[best] - t) <= 0.04 {
          v1 = nf1[best]
          v2 = nf2[best]
          v3 = nf3[best]
        }
      }
      if v1 >= 150.0 && v1 <= 1300.0 && v2 >= v1 + 100.0 && v2 <= 3600.0 {
        sl1[i] = v1
        sl2[i] = v2
        if v3 >= v2 + 120.0 && v3 <= 4600.0 {
          sl3[i] = v3
        }
      }
    }
    i = i + 1
  }

  run smoothPositiveBand(rF1.asMutSlice())
  run smoothPositiveBand(rF2.asMutSlice())
  run smoothPositiveBand(rF3.asMutSlice())

  let o1 = rF1.asSlice()
  let o2 = rF2.asSlice()
  let o3 = rF3.asSlice()
  i = 0
  while i < n {
    if actSl[i] && o1[i] > 1.0 && o2[i] > o1[i] + 80.0 {
      let v1 = o1[i]
      let v2 = o2[i]
      let v3 = o3[i]
      let prevF4 = frames[i].f4
      let v4 = if v3 > v2 + 80.0 && prevF4 > v3 + 150.0 { prevF4 } else { 0.0 }
      let mut cnt: usize = 2
      if v3 > v2 + 80.0 { cnt = 3 }
      if v4 > v3 + 150.0 { cnt = 4 }
      frames[i].f1 = v1
      frames[i].f2 = v2
      frames[i].f3 = v3
      frames[i].f4 = v4
      frames[i].count = cnt
      frames[i].tracked = true
    } else {
      frames[i].f1 = 0.0
      frames[i].f2 = 0.0
      frames[i].f3 = 0.0
      frames[i].f4 = 0.0
      frames[i].count = 0
      frames[i].tracked = false
    }
    i = i + 1
  }
}

/// Applies a live rolling window of Neural FormantsTracker frames `[winStart..winEnd]`
/// onto `frames` during active recording, using the exact same pitch/energy gating and
/// smoothing as post-stop `applyNeuralFormantFrames` so live F1-F3 matches post-stop F1-F3!
pub effect fn applyNeuralFormantFramesRange(
  frames: &mut [FormantFrame],
  pitchFrames: &[PitchFrame],
  displayClarity: f64,
  times: &[f64],
  nf1: &[f64],
  nf2: &[f64],
  nf3: &[f64],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = frames.length
  let m = times.length
  if n == 0 || m == 0 || nf1.length < m || nf2.length < m || nf3.length < m {
    return ()
  }
  let winStart = times[0] - 0.02
  let winEnd = times[m - 1] + 0.02

  let mut startIdx: usize = n
  let mut endIdx: usize = 0
  let mut i: usize = 0
  while i < n {
    let ft = frames[i].time
    if ft >= winStart && ft <= winEnd {
      if startIdx == n { startIdx = i }
      endIdx = i + 1
    }
    i = i + 1
  }
  if startIdx >= endIdx {
    return ()
  }
  let subLen = endIdx - startIdx

  let mut peakDb: f64 = -120.0
  i = 0
  while i < n {
    if frames[i].intensityDb > peakDb {
      peakDb = frames[i].intensityDb
    }
    i = i + 1
  }
  let minActiveDb = f64.max(-58.0, peakDb - 34.0)

  let mut active = List<bool>.make()
  run active.appendRepeated(false, subLen)
  let actSl = active.asMutSlice()

  let mut pIdx: usize = 0
  let mut k: usize = 0
  while k < subLen {
    let fi = startIdx + k
    let ft = frames[fi].time
    let fDb = frames[fi].intensityDb
    let mut isVoiced = false
    if pitchFrames.length > 0 {
      while pIdx + 1 < pitchFrames.length && pitchFrames[pIdx + 1].time < ft {
        pIdx = pIdx + 1
      }
      let mut bestP = pIdx
      if pIdx + 1 < pitchFrames.length {
        if f64.abs(pitchFrames[pIdx + 1].time - ft) < f64.abs(pitchFrames[pIdx].time - ft) {
          bestP = pIdx + 1
        }
      }
      let pf = pitchFrames[bestP]
      if f64.abs(pf.time - ft) <= 0.035 && pf.voiced && pf.clarity >= displayClarity && fDb >= minActiveDb {
        isVoiced = true
      }
    } else if fDb >= minActiveDb {
      isVoiced = true
    }
    actSl[k] = isVoiced
    k = k + 1
  }

  let mut rF1 = List<f64>.make()
  let mut rF2 = List<f64>.make()
  let mut rF3 = List<f64>.make()
  run rF1.appendRepeated(0.0, subLen)
  run rF2.appendRepeated(0.0, subLen)
  run rF3.appendRepeated(0.0, subLen)
  let sl1 = rF1.asMutSlice()
  let sl2 = rF2.asMutSlice()
  let sl3 = rF3.asMutSlice()

  let mut ti: usize = 0
  k = 0
  while k < subLen {
    if actSl[k] {
      let t = frames[startIdx + k].time
      while ti + 1 < m && times[ti + 1] < t {
        ti = ti + 1
      }
      let mut v1: f64 = 0.0
      let mut v2: f64 = 0.0
      let mut v3: f64 = 0.0
      if ti + 1 < m && t >= times[ti] && t <= times[ti + 1] && (times[ti + 1] - times[ti]) > 1.0e-6 {
        let a = (t - times[ti]) / (times[ti + 1] - times[ti])
        v1 = nf1[ti] + a * (nf1[ti + 1] - nf1[ti])
        v2 = nf2[ti] + a * (nf2[ti + 1] - nf2[ti])
        v3 = nf3[ti] + a * (nf3[ti + 1] - nf3[ti])
      } else {
        let mut best = ti
        if ti + 1 < m && f64.abs(times[ti + 1] - t) < f64.abs(times[ti] - t) {
          best = ti + 1
        }
        if f64.abs(times[best] - t) <= 0.04 {
          v1 = nf1[best]
          v2 = nf2[best]
          v3 = nf3[best]
        }
      }
      if v1 >= 150.0 && v1 <= 1300.0 && v2 >= v1 + 100.0 && v2 <= 3600.0 {
        sl1[k] = v1
        sl2[k] = v2
        if v3 >= v2 + 120.0 && v3 <= 4600.0 {
          sl3[k] = v3
        }
      }
    }
    k = k + 1
  }

  run smoothPositiveBand(rF1.asMutSlice())
  run smoothPositiveBand(rF2.asMutSlice())
  run smoothPositiveBand(rF3.asMutSlice())

  let o1 = rF1.asSlice()
  let o2 = rF2.asSlice()
  let o3 = rF3.asSlice()
  k = 0
  while k < subLen {
    let fi = startIdx + k
    if actSl[k] && o1[k] > 1.0 && o2[k] > o1[k] + 80.0 {
      let v1 = o1[k]
      let v2 = o2[k]
      let v3 = o3[k]
      let mut cnt: usize = 2
      if v3 > v2 + 80.0 { cnt = 3 }
      frames[fi].f1 = v1
      frames[fi].f2 = v2
      frames[fi].f3 = v3
      frames[fi].f4 = 0.0
      frames[fi].count = cnt
      frames[fi].tracked = true
    } else {
      frames[fi].f1 = 0.0
      frames[fi].f2 = 0.0
      frames[fi].f3 = 0.0
      frames[fi].f4 = 0.0
      frames[fi].count = 0
      frames[fi].tracked = false
    }
    k = k + 1
  }
}
