//! Pitch detection by autocorrelation, ported directly from `voiceapp/packages/audio/src/dsp/Pitch.ts`
//! (Boersma 1993: windowed ACF divided by the window's own ACF + 61-tap windowed-sinc peak height
//! interpolation + octave preference), plus note/cents conversion and voiced-run splitting.
import audio_native
import dsp
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

pub const SINC_HALF_WIDTH: usize = 30
/// Boersma (1993) octave preference cost per octave (prevents subharmonic 2*T0 / 3*T0 lock-on).
pub const OCTAVE_COST: f64 = 0.03
/// Praat Viterbi octave-jump transition penalty between adjacent frames.
pub const OCTAVE_JUMP_COST: f64 = 0.35
/// Praat Viterbi voiced <-> unvoiced transition cost.
pub const VOICED_UNVOICED_COST: f64 = 0.14
pub const MAX_CANDS: usize = 8
pub const MAX_CONNECTED_SEMITONES: f64 = 7.0
pub const A4_HZ: f64 = 440.0
pub const A4_MIDI: i32 = 69

pub struct PitchConfig {
  pub floorHz: f64,
  pub ceilingHz: f64,
  pub clarityThreshold: f64,
  pub intensityFloorDb: f64,
  pub hopSeconds: f64,
}

impl Copy for PitchConfig {}

impl PitchConfig {
  /// Praat-aligned speech & voice-training defaults (`75..600 Hz`, voicing `0.42`, floor `-60 dB`, `~23.2 ms` hop).
  /// Singing range (`50..1400 Hz`) remains 1-click selectable in Settings → Analyzer & Pitch.
  pub fn defaults() -> PitchConfig {
    return PitchConfig {
      floorHz: 75.0,
      ceilingHz: 600.0,
      clarityThreshold: 0.42,
      intensityFloorDb: -60.0,
      hopSeconds: 1024.0 / 44100.0,
    }
  }
}

/// Top pitch candidates retained per frame so `PitchTrack.refineViterbi` can find the exact
/// Praat-style smooth continuous pitch contour without octave drops or consonant spikes.
pub struct FrameCandidates {
  pub count: usize,
  pub freqs: [f64; 8],
  pub strengths: [f64; 8],
  pub rawClarity: [f64; 8],
  pub intensityDb: f64,
  pub zcr: f64,
}

impl Copy for FrameCandidates {}

impl FrameCandidates {
  pub fn empty(intensityDb: f64, zcr: f64) -> FrameCandidates {
    return FrameCandidates {
      count: 0,
      freqs: [0.0; 8],
      strengths: [0.0; 8],
      rawClarity: [0.0; 8],
      intensityDb: intensityDb,
      zcr: zcr,
    }
  }
}

pub struct PitchFrame {
  /// Centre time of the analysed segment, in seconds.
  pub time: f64,
  /// Fundamental frequency in Hz, or `0.0` when unvoiced.
  pub frequency: f64,
  pub voiced: bool,
  /// Normalized peak height in `[0, 1]`.
  pub clarity: f64,
  /// RMS level in dBFS.
  pub intensityDb: f64,
}

impl Copy for PitchFrame {}

pub struct NoteReading {
  pub pitchClass: usize,
  pub octave: i32,
  pub midi: i32,
  pub cents: i32,
}

impl Copy for NoteReading {}

pub fn noteClassName(pc: usize) -> string<'static> {
  return match pc {
    0 => "C"
    1 => "C#"
    2 => "D"
    3 => "D#"
    4 => "E"
    5 => "F"
    6 => "F#"
    7 => "G"
    8 => "G#"
    9 => "A"
    10 => "A#"
    _ => "B"
  }
}

pub fn frequencyToNote(freq: f64) -> NoteReading {
  if freq <= 1.0 {
    return NoteReading { pitchClass: 0, octave: 0, midi: 0, cents: 0 }
  }
  let exact = i32.toF64(A4_MIDI) + 12.0 * f64.log2(freq / A4_HZ)
  let midi = f64.toI32(f64.round(exact))
  let cents = f64.toI32(f64.round((exact - i32.toF64(midi)) * 100.0))
  let mut pc = midi % 12
  if pc < 0 {
    pc = pc + 12
  }
  let octave = (midi - pc) / 12 - 1
  return NoteReading {
    pitchClass: i32.toUsize(pc),
    octave: octave,
    midi: midi,
    cents: cents,
  }
}

pub fn midiToFrequency(midi: i32) -> f64 {
  return A4_HZ * f64.pow(2.0, i32.toF64(midi - A4_MIDI) / 12.0)
}

pub fn semitonesBetween(a: f64, b: f64) -> f64 {
  if a <= 0.0 || b <= 0.0 {
    return 999.0
  }
  return f64.abs(12.0 * f64.log2(b / a))
}

fn nextPow2(n: usize) -> usize {
  let mut p: usize = 4
  while p < n {
    p = p * 2
  }
  return p
}

fn sincInterpolate(values: &[f64], n: usize, x: f64) -> f64 {
  let nearestF = f64.round(x)
  if f64.abs(x - nearestF) < 1.0e-9 {
    let idx = if nearestF < 0.0 { 0 } else { f64.toUsize(nearestF) }
    if idx < n {
      return values[idx]
    }
    return 0.0
  }
  let nearest = if nearestF < 0.0 { 0 } else { f64.toUsize(nearestF) }
  let lo = if nearest > SINC_HALF_WIDTH { nearest - SINC_HALF_WIDTH } else { 0 }
  let hi = if nearest + SINC_HALF_WIDTH < n { nearest + SINC_HALF_WIDTH } else { n - 1 }
  let hwPlus1 = usize.toF64(SINC_HALF_WIDTH + 1)

  let mut sum: f64 = 0.0
  let mut weight: f64 = 0.0
  let mut i = lo
  while i <= hi {
    let d = x - usize.toF64(i)
    let sinc = if f64.abs(d) < 1.0e-9 {
      1.0
    } else {
      let pd = f64.PI * d
      f64.sin(pd) / pd
    }
    let taper = 0.5 + 0.5 * f64.cos(f64.PI * d / hwPlus1)
    let w = sinc * taper
    sum = sum + values[i] * w
    weight = weight + w
    i = i + 1
  }
  return if weight == 0.0 { 0.0 } else { sum / weight }
}

/// Reusable Boersma (1993) single-frame + incremental pitch detector with sub-bass rumble HPF.
pub struct PitchDetector {
  pub config: PitchConfig,
  pub sampleRate: f64,
  pub windowSize: usize,
  fftSize: usize,
  minLag: usize,
  maxLag: usize,
  hpB0: f64,
  hpB1: f64,
  hpB2: f64,
  hpA1: f64,
  hpA2: f64,
  window: List<f32>,
  windowAcf: List<f64>,
  frameBuf: List<f32>,
  rawAcf: List<f64>,
  acf: List<f64>,
}

impl PitchDetector {
  pub effect fn make(sampleRate: f64, config: PitchConfig) -> PitchDetector
    ! OutOfMemoryError
    ? &mut Allocator {
    let rawWin = f64.toUsize(f64.round(3.0 * sampleRate / f64.max(config.floorHz, 20.0)))
    let windowSize = if rawWin < 4 { 4 } else { rawWin }
    let fftSize = nextPow2(windowSize + windowSize / 2)
    let halfWindow = windowSize / 2
    let minLagRaw = f64.toUsize(f64.floor(sampleRate / f64.max(config.ceilingHz, 40.0)))
    let minLag = if minLagRaw < 2 { 2 } else { minLagRaw }
    let maxLagRaw = f64.toUsize(f64.ceil(sampleRate / f64.max(config.floorHz, 20.0)))
    let maxLag = if maxLagRaw >= halfWindow { halfWindow - 1 } else { maxLagRaw }

    // 2nd-order Butterworth high-pass filter just below pitch floor (`0.95 * floorHz`, min 45 Hz)
    // to reject 50/60/70 Hz room hum, mic rumble, and DC offset before autocorrelation.
    let hpFc = f64.min(sampleRate * 0.25, f64.max(45.0, config.floorHz * 0.95))
    let w0 = 2.0 * f64.PI * hpFc / f64.max(sampleRate, 1000.0)
    let cosW0 = f64.cos(w0)
    let alpha = f64.sin(w0) / (2.0 * 0.7071067811865476)
    let a0 = 1.0 + alpha
    let hpB0 = (1.0 + cosW0) * 0.5 / a0
    let hpB1 = -(1.0 + cosW0) / a0
    let hpB2 = (1.0 + cosW0) * 0.5 / a0
    let hpA1 = -2.0 * cosW0 / a0
    let hpA2 = (1.0 - alpha) / a0

    let window = run dsp.makeHannWindow(windowSize)
    let acfLen = halfWindow + 1
    let mut windowAcf = List<f64>.make()
    run windowAcf.appendRepeated(0.0, acfLen)
    audio_native.autocorrFftNative(window.asSlice(), usize.toI32(fftSize), windowAcf.asMutSlice())
    let zero = windowAcf.get(0)
    if zero > 0.0 {
      let wa = windowAcf.asMutSlice()
      let mut l: usize = 0
      while l < acfLen {
        wa[l] = wa[l] / zero
        l = l + 1
      }
    }

    let mut frameBuf = List<f32>.make()
    run frameBuf.appendRepeated(0.0, windowSize)
    let mut rawAcf = List<f64>.make()
    run rawAcf.appendRepeated(0.0, acfLen)
    let mut acf = List<f64>.make()
    run acf.appendRepeated(0.0, acfLen)

    return PitchDetector {
      config: config,
      sampleRate: sampleRate,
      windowSize: windowSize,
      fftSize: fftSize,
      minLag: minLag,
      maxLag: maxLag,
      hpB0: hpB0,
      hpB1: hpB1,
      hpB2: hpB2,
      hpA1: hpA1,
      hpA2: hpA2,
      window: move window,
      windowAcf: move windowAcf,
      frameBuf: move frameBuf,
      rawAcf: move rawAcf,
      acf: move acf,
    }
  }

  pub fn analyzeWithCandidates(
    self: &mut Self,
    samples: &[f32],
    offset: usize,
    time: f64,
    outCands: &mut FrameCandidates,
  ) -> PitchFrame {
    let length = self.windowSize
    if offset + length > samples.length {
      outCands.* = FrameCandidates.empty(-120.0, 0.0)
      return PitchFrame { time: time, frequency: 0.0, voiced: false, clarity: 0.0, intensityDb: -120.0 }
    }

    // Warm up the 2nd-order Butterworth HPF on up to 512 preceding samples so frame edges have
    // zero startup transient and 50/60/70 Hz room hum is cleanly rejected from both RMS and ACF.
    let preStart = if offset > 512 { offset - 512 } else { 0 }
    let mut x1 = f32.toF64(samples[preStart])
    let mut x2 = x1
    let mut y1: f64 = 0.0
    let mut y2: f64 = 0.0
    let mut p = preStart
    while p < offset {
      let x0 = f32.toF64(samples[p])
      let y0 = self.hpB0 * x0 + self.hpB1 * x1 + self.hpB2 * x2 - self.hpA1 * y1 - self.hpA2 * y2
      x2 = x1
      x1 = x0
      y2 = y1
      y1 = y0
      p = p + 1
    }

    let mut sum: f64 = 0.0
    let mut energy: f64 = 0.0
    let mut crossings: usize = 0
    let mut prevSign = true
    let buf = self.frameBuf.asMutSlice()
    let mut i: usize = 0
    while i < length {
      let x0 = f32.toF64(samples[offset + i])
      let y0 = self.hpB0 * x0 + self.hpB1 * x1 + self.hpB2 * x2 - self.hpA1 * y1 - self.hpA2 * y2
      x2 = x1
      x1 = x0
      y2 = y1
      y1 = y0
      buf[i] = f64.toF32(y0)
      let curSign = y0 >= 0.0
      if i > 0 && curSign != prevSign {
        crossings = crossings + 1
      }
      prevSign = curSign
      sum = sum + y0
      energy = energy + y0 * y0
      i = i + 1
    }
    let zcr = usize.toF64(crossings) / usize.toF64(if length > 1 { length - 1 } else { 1 })
    let rms = f64.sqrt(energy / usize.toF64(length))
    let intensityDb = if rms > 1.0e-9 { 20.0 * f64.log(rms) / f64.log(10.0) } else { -120.0 }
    if rms <= 1.0e-9 {
      outCands.* = FrameCandidates.empty(-120.0, zcr)
      return PitchFrame { time: time, frequency: 0.0, voiced: false, clarity: 0.0, intensityDb: -120.0 }
    }

    let mean = sum / usize.toF64(length)
    let winSlice = self.window.asSlice()
    i = 0
    while i < length {
      buf[i] = f64.toF32((f32.toF64(buf[i]) - mean) * f32.toF64(winSlice[i]))
      i = i + 1
    }

    audio_native.autocorrFftNative(self.frameBuf.asSlice(), usize.toI32(self.fftSize), self.rawAcf.asMutSlice())
    let raw = self.rawAcf.asSlice()
    let zero = raw[0]
    let wa = self.windowAcf.asSlice()
    let limit = if self.maxLag + 2 < wa.length { self.maxLag + 2 } else { wa.length - 1 }
    let acfMut = self.acf.asMutSlice()
    let mut l: usize = 0
    while l <= limit {
      let w = wa[l]
      acfMut[l] = if zero <= 0.0 || w <= 0.0 { 0.0 } else { raw[l] / zero / w }
      l = l + 1
    }

    // Collect top MAX_CANDS local autocorrelation peaks with Praat's Boersma (1993) octave cost:
    // `strength = r(lag) - OCTAVE_COST * log2(ceilingHz / freq)`
    let acf = self.acf.asSlice()
    let mut cands = FrameCandidates.empty(intensityDb, zcr)
    let searchEnd = if self.maxLag < limit { self.maxLag } else { limit - 1 }
    let minLagF = usize.toF64(self.minLag)
    let maxLagF = usize.toF64(self.maxLag)
    let ceilHz = f64.max(self.config.ceilingHz, 100.0)
    // Pure voiceless sibilants (/s/, /ʃ/, /f/, /tʃ/) have very high zero-crossing rate.
    let sibilantPenalty = if zcr > 0.24 { f64.min(0.35, (zcr - 0.24) * 1.4) } else { 0.0 }

    l = self.minLag
    while l <= searchEnd {
      let v = acf[l]
      if v > 0.22 && v > acf[l - 1] && v >= acf[l + 1] {
        let a = acf[l - 1]
        let c = acf[l + 1]
        let denom = 2.0 * (2.0 * v - a - c)
        let mut shift = if denom == 0.0 { 0.0 } else { (c - a) / denom }
        if shift < -1.0 { shift = -1.0 }
        if shift > 1.0 { shift = 1.0 }
        let lag = usize.toF64(l) + shift
        if lag >= minLagF && lag <= maxLagF && lag > 0.0 {
          let mut rawR = sincInterpolate(acf, limit + 1, lag)
          if rawR < 0.0 { rawR = 0.0 }
          if rawR > 1.0 { rawR = 1.0 }
          let freq = self.sampleRate / lag
          if freq >= self.config.floorHz && freq <= ceilHz {
            let octPen = OCTAVE_COST * f64.max(0.0, f64.log2(ceilHz / freq))
            let scored = rawR - octPen - sibilantPenalty
            // Insert into top MAX_CANDS sorted descending by `scored`
            let mut pos = cands.count
            if pos >= MAX_CANDS {
              if scored > cands.strengths[MAX_CANDS - 1] {
                pos = MAX_CANDS - 1
              } else {
                pos = MAX_CANDS
              }
            } else {
              cands.count = cands.count + 1
            }
            if pos < MAX_CANDS {
              while pos > 0 && scored > cands.strengths[pos - 1] {
                cands.freqs[pos] = cands.freqs[pos - 1]
                cands.strengths[pos] = cands.strengths[pos - 1]
                cands.rawClarity[pos] = cands.rawClarity[pos - 1]
                pos = pos - 1
              }
              cands.freqs[pos] = freq
              cands.strengths[pos] = scored
              cands.rawClarity[pos] = rawR
            }
          }
        }
      }
      l = l + 1
    }

    outCands.* = cands
    if cands.count == 0 {
      return PitchFrame { time: time, frequency: 0.0, voiced: false, clarity: 0.0, intensityDb: intensityDb }
    }

    let bestFreq = cands.freqs[0]
    let bestClarity = cands.rawClarity[0]
    let bestScored = cands.strengths[0]
    let voiced = bestScored >= self.config.clarityThreshold
      && intensityDb >= self.config.intensityFloorDb
      && bestFreq >= self.config.floorHz
      && bestFreq <= self.config.ceilingHz

    return PitchFrame {
      time: time,
      frequency: if voiced { bestFreq } else { 0.0 },
      voiced: voiced,
      clarity: bestClarity,
      intensityDb: intensityDb,
    }
  }

  pub fn analyze(self: &mut Self, samples: &[f32], offset: usize, time: f64) -> PitchFrame {
    let mut tmp = FrameCandidates.empty(-120.0, 0.0)
    return self.analyzeWithCandidates(samples, offset, time, &mut tmp)
  }
}

/// Incremental pitch track over append-only mono audio + Praat-style Viterbi path refinement.
pub struct PitchTrack {
  pub frames: List<PitchFrame>,
  pub candidates: List<FrameCandidates>,
  pub hopSamples: usize,
  pub sampleRate: f64,
  pub windowSize: usize,
  pub config: PitchConfig,
  detector: Option<PitchDetector>,
}

impl PitchTrack {
  pub fn empty() -> PitchTrack {
    return PitchTrack {
      frames: List<PitchFrame>.make(),
      candidates: List<FrameCandidates>.make(),
      hopSamples: 1024,
      sampleRate: 48000.0,
      windowSize: 2880,
      config: PitchConfig.defaults(),
      detector: Option<PitchDetector>.None,
    }
  }

  pub effect fn reset(self: &mut Self, sampleRate: f64, config: PitchConfig) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.frames.clear()
    self.candidates.clear()
    self.sampleRate = sampleRate
    self.config = config
    let hop = f64.toUsize(f64.round(config.hopSeconds * sampleRate))
    self.hopSamples = if hop < 64 { 64 } else { hop }
    let det = run PitchDetector.make(sampleRate, config)
    self.windowSize = det.windowSize
    self.detector = Option<PitchDetector>.some(move det)
  }

  /// Appends newly computable pitch frames for `samples`. Returns number of frames added.
  pub effect fn update(self: &mut Self, samples: &[f32]) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    if samples.length < self.windowSize {
      return 0
    }
    let computable = (samples.length - self.windowSize) / self.hopSamples + 1
    let already = self.frames.length()
    if computable <= already {
      return 0
    }
    let halfWin = usize.toF64(self.windowSize) * 0.5
    let mut added: usize = 0
    if let Option<PitchDetector>.Some { value: det } = &mut self.detector {
      let mut idx = already
      while idx < computable {
        let offset = idx * self.hopSamples
        let time = (usize.toF64(offset) + halfWin) / self.sampleRate
        let mut cands = FrameCandidates.empty(-120.0, 0.0)
        let frame = det.analyzeWithCandidates(samples, offset, time, &mut cands)
        run self.frames.append(frame)
        run self.candidates.append(cands)
        idx = idx + 1
        added = added + 1
      }
    }
    return added
  }

  /// Runs Praat's Boersma (1993) Viterbi dynamic-programming path across stored per-frame
  /// candidates to eliminate octave jumps, consonant spikes, and brief breathy voiced dropouts.
  pub effect fn refineViterbi(self: &mut Self, minClarity: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let n = self.frames.length()
    if n < 3 || self.candidates.length() < n {
      return ()
    }
    let candsSl = self.candidates.asSlice()
    // Peak intensity across clip for Praat-style relative silence gate (`peakDb - 36 dB`)
    let mut peakDb: f64 = -120.0
    let mut i: usize = 0
    while i < n {
      if candsSl[i].intensityDb > peakDb {
        peakDb = candsSl[i].intensityDb
      }
      i = i + 1
    }
    let relSilenceDb = f64.max(self.config.intensityFloorDb, peakDb - 28.0)
    let voiceThresh = f64.max(0.28, f64.min(0.85, minClarity))

    // States per frame: `0` = unvoiced, `1..=count` = voiced candidate index `k - 1`
    let stride: usize = MAX_CANDS + 1
    let negInf: f64 = -1.0e18
    let mut dp = List<f64>.make()
    run dp.appendRepeated(negInf, n * stride)
    let mut back = List<u8>.make()
    run back.appendRepeated(0, n * stride)
    let dpSl = dp.asMutSlice()
    let bkSl = back.asMutSlice()

    // Base frame (t = 0)
    let c0 = candsSl[0]
    let silent0 = c0.intensityDb < relSilenceDb
    dpSl[0] = voiceThresh + (if silent0 { 0.45 } else { 0.0 })
    let mut k: usize = 0
    while k < c0.count {
      dpSl[1 + k] = if silent0 { negInf } else { c0.strengths[k] }
      k = k + 1
    }

    // Forward DP pass
    i = 1
    while i < n {
      let cur = candsSl[i]
      let prev = candsSl[i - 1]
      let curSilent = cur.intensityDb < relSilenceDb
      let unvoicedReward = voiceThresh + (if curSilent { 0.45 } else { 0.0 })
      let row = i * stride
      let pRow = (i - 1) * stride

      // State 0: unvoiced
      let mut bestU = dpSl[pRow]
      let mut bestUPrev: u8 = 0
      let mut pk: usize = 0
      while pk < prev.count {
        let sc = dpSl[pRow + 1 + pk] - VOICED_UNVOICED_COST
        if sc > bestU {
          bestU = sc
          bestUPrev = usize.toU8(1 + pk)
        }
        pk = pk + 1
      }
      dpSl[row] = bestU + unvoicedReward
      bkSl[row] = bestUPrev

      // States 1..=cur.count: voiced candidates
      k = 0
      while k < cur.count {
        if curSilent {
          dpSl[row + 1 + k] = negInf
          bkSl[row + 1 + k] = 0
        } else {
          let cf = cur.freqs[k]
          let cReward = cur.strengths[k]
          let mut bestV = dpSl[pRow] - VOICED_UNVOICED_COST
          let mut bestVPrev: u8 = 0
          pk = 0
          while pk < prev.count {
            let pScore = dpSl[pRow + 1 + pk]
            if pScore > negInf * 0.5 {
              let pf = prev.freqs[pk]
              let octDiff = f64.abs(f64.log2(f64.max(20.0, cf) / f64.max(20.0, pf)))
              let sc = pScore - OCTAVE_JUMP_COST * octDiff
              if sc > bestV {
                bestV = sc
                bestVPrev = usize.toU8(1 + pk)
              }
            }
            pk = pk + 1
          }
          dpSl[row + 1 + k] = bestV + cReward
          bkSl[row + 1 + k] = bestVPrev
        }
        k = k + 1
      }
      i = i + 1
    }

    // Backtrack best state sequence
    let mut states = List<u8>.make()
    run states.appendRepeated(0, n)
    let stSl = states.asMutSlice()
    let lastRow = (n - 1) * stride
    let mut bestFinal = dpSl[lastRow]
    let mut bestState: u8 = 0
    k = 0
    while k < candsSl[n - 1].count {
      if dpSl[lastRow + 1 + k] > bestFinal {
        bestFinal = dpSl[lastRow + 1 + k]
        bestState = usize.toU8(1 + k)
      }
      k = k + 1
    }
    stSl[n - 1] = bestState
    let mut bIdx: usize = n - 1
    while bIdx > 0 {
      let curSt = u8.toUsize(stSl[bIdx])
      stSl[bIdx - 1] = bkSl[bIdx * stride + curSt]
      bIdx = bIdx - 1
    }

    // Write refined path back into `self.frames`, dropping isolated 1-frame consonant blips
    let fsMut = self.frames.asMutSlice()
    i = 0
    while i < n {
      let st = u8.toUsize(stSl[i])
      let isIsolated = st > 0
        && (i == 0 || stSl[i - 1] == 0)
        && (i + 1 >= n || stSl[i + 1] == 0)
      if st > 0 && !isIsolated && (st - 1) < candsSl[i].count {
        let ci = st - 1
        let clar = candsSl[i].rawClarity[ci]
        // Boost effective display clarity slightly on Viterbi-supported continuous frames so
        // brief slightly-breathy voiced frames don't tear holes in the contour!
        let effClar = if clar < voiceThresh { voiceThresh } else { clar }
        fsMut[i] = PitchFrame {
          time: fsMut[i].time,
          frequency: candsSl[i].freqs[ci],
          voiced: true,
          clarity: effClar,
          intensityDb: candsSl[i].intensityDb,
        }
      } else {
        fsMut[i] = PitchFrame {
          time: fsMut[i].time,
          frequency: 0.0,
          voiced: false,
          clarity: if candsSl[i].count > 0 { candsSl[i].rawClarity[0] } else { 0.0 },
          intensityDb: candsSl[i].intensityDb,
        }
      }
      i = i + 1
    }
  }

  /// Looks up the nearest pitch frame to `timeSec`.
  pub fn nearest(self: &Self, timeSec: f64) -> Option<PitchFrame> {
    let n = self.frames.length()
    if n == 0 {
      return Option<PitchFrame>.None
    }
    let firstT = self.frames.get(0).time
    let dt = usize.toF64(self.hopSamples) / self.sampleRate
    if dt <= 0.0 {
      return Option<PitchFrame>.some(self.frames.get(0))
    }
    let raw = f64.round((timeSec - firstT) / dt)
    if raw < 0.0 {
      return Option<PitchFrame>.some(self.frames.get(0))
    }
    let idx = f64.toUsize(raw)
    if idx >= n {
      return Option<PitchFrame>.some(self.frames.get(n - 1))
    }
    return Option<PitchFrame>.some(self.frames.get(idx))
  }
}

/// Praat-exact selection pitch summary (`Pitch_getMean` / `Sampled_getMean` with `interpolate = true`).
pub struct SelectionPitchStats {
  pub valid: bool,
  /// Linear-Hz interpolated mean (exact match to Praat's `Pitch > Get pitch` / `Hertz`).
  pub meanHz: f64,
  /// Log-Hz interpolated mean converted back to Hz (`exp(mean(ln(f0)))`, Praat's `Hertz (logarithmic)`).
  pub logMeanHz: f64,
  pub medianHz: f64,
  pub minHz: f64,
  pub maxHz: f64,
  pub sdSemitones: f64,
  pub voicedFrames: usize,
  pub voicedPct: u32,
}

impl Copy for SelectionPitchStats {}

impl SelectionPitchStats {
  pub fn empty() -> SelectionPitchStats {
    return SelectionPitchStats {
      valid: false,
      meanHz: 0.0,
      logMeanHz: 0.0,
      medianHz: 0.0,
      minHz: 0.0,
      maxHz: 0.0,
      sdSemitones: 0.0,
      voicedFrames: 0,
      voicedPct: 0,
    }
  }
}

fn frameValAt(frames: &[PitchFrame], idx: i32, minClarity: f64, useLog: bool) -> f64 {
  if idx < 0 || i32.toUsize(idx) >= frames.length {
    return -1.0
  }
  let pf = frames[i32.toUsize(idx)]
  if !pf.voiced || pf.clarity < minClarity || pf.frequency <= 0.0 {
    return -1.0
  }
  return if useLog { f64.log(pf.frequency) } else { pf.frequency }
}

/// Exact port of Praat's `Sampled_getMean(..., interpolate = true)` from `fon/Sampled.cpp`.
/// Integrates the linearly interpolated pitch curve across `[tMin, tMax]` with partial-frame
/// edge corrections and divides by the voiced definition range.
fn praatSampledMean(
  frames: &[PitchFrame],
  dx: f64,
  tMin: f64,
  tMax: f64,
  minClarity: f64,
  useLog: bool,
) -> f64 {
  let nx = frames.length
  if nx == 0 || dx <= 0.0 || tMax <= tMin {
    return -1.0
  }
  let x1 = frames[0].time
  let leftEdge = x1 - 0.5 * dx
  let rightEdge = leftEdge + usize.toF64(nx) * dx
  let xmin = f64.max(tMin, leftEdge)
  let xmax = f64.min(tMax, rightEdge)
  if xmax <= xmin {
    return -1.0
  }

  let iminF = f64.ceil((xmin - x1) / dx)
  let imaxF = f64.floor((xmax - x1) / dx)
  let mut imin = f64.toI32(iminF)
  let mut imax = f64.toI32(imaxF)
  if imin < 0 { imin = 0 }
  let maxIdx = usize.toI32(nx) - 1
  if imax > maxIdx { imax = maxIdx }

  let mut sum: f64 = 0.0
  let mut defRange: f64 = 0.0

  if imax >= imin {
    let mut k = imin
    while k <= imax {
      let v = frameValAt(frames, k, minClarity, useLog)
      if v >= 0.0 {
        defRange = defRange + 1.0
        sum = sum + v
      }
      k = k + 1
    }

    // Left boundary partial-frame correction (exact Praat Sampled.cpp)
    if xmin > leftEdge {
      let mut phase = (x1 + i32.toF64(imin) * dx - xmin) / dx
      let rightVal = frameValAt(frames, imin, minClarity, useLog)
      let leftVal = frameValAt(frames, imin - 1, minClarity, useLog)
      if rightVal >= 0.0 {
        defRange = defRange - 0.5
        sum = sum - 0.5 * rightVal
        if leftVal >= 0.0 {
          defRange = defRange + phase
          sum = sum + phase * (rightVal + 0.5 * phase * (leftVal - rightVal))
        } else {
          if phase > 0.5 { phase = 0.5 }
          defRange = defRange + phase
          sum = sum + phase * rightVal
        }
      } else if leftVal >= 0.0 && phase > 0.5 {
        defRange = defRange + (phase - 0.5)
        sum = sum + (phase - 0.5) * leftVal
      }
    }

    // Right boundary partial-frame correction (exact Praat Sampled.cpp)
    if xmax < rightEdge {
      let mut phase = (xmax - (x1 + i32.toF64(imax) * dx)) / dx
      let leftVal = frameValAt(frames, imax, minClarity, useLog)
      let rightVal = frameValAt(frames, imax + 1, minClarity, useLog)
      if leftVal >= 0.0 {
        defRange = defRange - 0.5
        sum = sum - 0.5 * leftVal
        if rightVal >= 0.0 {
          defRange = defRange + phase
          sum = sum + phase * (leftVal + 0.5 * phase * (rightVal - leftVal))
        } else {
          if phase > 0.5 { phase = 0.5 }
          defRange = defRange + phase
          sum = sum + phase * leftVal
        }
      } else if rightVal >= 0.0 && phase > 0.5 {
        defRange = defRange + (phase - 0.5)
        sum = sum + (phase - 0.5) * rightVal
      }
    }
  } else {
    // Sub-frame selection: no frame centre lies strictly inside [xmin, xmax].
    let leftIdx = f64.toI32(f64.floor((xmin - x1) / dx))
    let rightIdx = leftIdx + 1
    let leftVal = frameValAt(frames, leftIdx, minClarity, useLog)
    let rightVal = frameValAt(frames, rightIdx, minClarity, useLog)
    let mut phase1 = (xmin - (x1 + i32.toF64(leftIdx) * dx)) / dx
    let mut phase2 = (xmax - (x1 + i32.toF64(leftIdx) * dx)) / dx
    if leftVal >= 0.0 {
      if rightVal >= 0.0 {
        defRange = defRange + (phase2 - phase1)
        sum = sum + (phase2 - phase1) * (leftVal + 0.5 * (phase1 + phase2) * (rightVal - leftVal))
      } else if phase1 < 0.5 {
        if phase2 > 0.5 { phase2 = 0.5 }
        defRange = defRange + (phase2 - phase1)
        sum = sum + (phase2 - phase1) * leftVal
      }
    } else if rightVal >= 0.0 && phase2 > 0.5 {
      if phase1 < 0.5 { phase1 = 0.5 }
      defRange = defRange + (phase2 - phase1)
      sum = sum + (phase2 - phase1) * rightVal
    }
  }

  if defRange <= 0.0 {
    return -1.0
  }
  return sum / defRange
}

/// Computes Praat-exact pitch statistics over `[tMin, tMax]`.
pub effect fn selectionPitchStats(
  frames: &[PitchFrame],
  dx: f64,
  tMin: f64,
  tMax: f64,
  minClarity: f64,
) -> SelectionPitchStats
  ! OutOfMemoryError
  ? &mut Allocator {
  if frames.length == 0 || tMax <= tMin {
    return SelectionPitchStats.empty()
  }
  let step = if dx > 0.0 {
    dx
  } else if frames.length >= 2 {
    frames[1].time - frames[0].time
  } else {
    0.0232
  }

  let meanHz = praatSampledMean(frames, step, tMin, tMax, minClarity, false)
  let logMeanRaw = praatSampledMean(frames, step, tMin, tMax, minClarity, true)
  if meanHz <= 0.0 || logMeanRaw < 0.0 {
    return SelectionPitchStats.empty()
  }
  let logMeanHz = f64.exp(logMeanRaw)

  let mut vals = List<f64>.make()
  let mut totalInRange: usize = 0
  let mut minHz: f64 = 1.0e9
  let mut maxHz: f64 = 0.0
  let mut i: usize = 0
  while i < frames.length {
    let pf = frames[i]
    if pf.time >= tMin - step * 0.5 && pf.time <= tMax + step * 0.5 {
      totalInRange = totalInRange + 1
      if pf.voiced && pf.clarity >= minClarity && pf.frequency > 0.0 {
        run vals.append(pf.frequency)
        if pf.frequency < minHz { minHz = pf.frequency }
        if pf.frequency > maxHz { maxHz = pf.frequency }
      }
    }
    i = i + 1
  }

  let vCount = vals.length()
  if vCount == 0 {
    return SelectionPitchStats {
      valid: true,
      meanHz: meanHz,
      logMeanHz: logMeanHz,
      medianHz: meanHz,
      minHz: meanHz,
      maxHz: meanHz,
      sdSemitones: 0.0,
      voicedFrames: 1,
      voicedPct: 100,
    }
  }

  // Sort voiced frequencies for exact median
  let s = vals.asMutSlice()
  let mut a: usize = 1
  while a < s.length {
    let key = s[a]
    let mut b = a
    while b > 0 && s[b - 1] > key {
      s[b] = s[b - 1]
      b = b - 1
    }
    s[b] = key
    a = a + 1
  }
  let mid = s.length / 2
  let medianHz = if (s.length % 2) == 1 {
    s[mid]
  } else {
    0.5 * (s[mid - 1] + s[mid])
  }

  // Standard deviation in semitones around logMeanHz
  let mut varSt: f64 = 0.0
  if s.length >= 2 {
    let mut j: usize = 0
    while j < s.length {
      let d = 12.0 * f64.log2(s[j] / logMeanHz)
      varSt = varSt + d * d
      j = j + 1
    }
    varSt = f64.sqrt(varSt / usize.toF64(s.length - 1))
  }

  let pct = if totalInRange > 0 {
    let p = f64.toU32(f64.round((usize.toF64(vCount) / usize.toF64(totalInRange)) * 100.0))
    if p > 100 { 100 } else { p }
  } else {
    100
  }

  return SelectionPitchStats {
    valid: true,
    meanHz: meanHz,
    logMeanHz: logMeanHz,
    medianHz: medianHz,
    minHz: minHz,
    maxHz: maxHz,
    sdSemitones: varSt,
    voicedFrames: vCount,
    voicedPct: pct,
  }
}

/// Parses a frequency in Hz (e.g. "220", "185.5", "1.8k", "500hz") OR a musical note
/// (e.g. "A3", "C#4", "Bb3", "eb4"). Returns Hz > 0.0 on success, or 0.0 if invalid.
pub fn parseFreqOrNote(text: string) -> f64 {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut end = bytes.length
  while start < end && (bytes[start] == 32 || bytes[start] == 9) {
    start = start + 1
  }
  while end > start && (bytes[end - 1] == 32 || bytes[end - 1] == 9) {
    end = end - 1
  }
  if start >= end {
    return 0.0
  }

  // Check if starts with note letter A..G / a..g
  let c0 = bytes[start]
  let mut pc: i32 = -1
  if c0 == 67 || c0 == 99 { pc = 0 }        // C
  else if c0 == 68 || c0 == 100 { pc = 2 }  // D
  else if c0 == 69 || c0 == 101 { pc = 4 }  // E
  else if c0 == 70 || c0 == 102 { pc = 5 }  // F
  else if c0 == 71 || c0 == 103 { pc = 7 }  // G
  else if c0 == 65 || c0 == 97 { pc = 9 }   // A
  else if c0 == 66 || c0 == 98 { pc = 11 }  // B

  if pc >= 0 {
    let mut idx = start + 1
    if idx < end {
      if bytes[idx] == 35 { // '#'
        pc = pc + 1
        idx = idx + 1
      } else if bytes[idx] == 98 || bytes[idx] == 66 { // 'b' / 'B'
        pc = pc - 1
        idx = idx + 1
      }
    }
    if idx >= end {
      return 0.0
    }
    let mut neg = false
    if bytes[idx] == 45 { // '-'
      neg = true
      idx = idx + 1
    }
    if idx >= end || bytes[idx] < 48 || bytes[idx] > 57 {
      return 0.0
    }
    let mut oct: i32 = 0
    while idx < end && bytes[idx] >= 48 && bytes[idx] <= 57 {
      oct = oct * 10 + u8.toI32(bytes[idx] - 48)
      idx = idx + 1
    }
    if neg { oct = -oct }
    let midi = (oct + 1) * 12 + pc
    if midi < 0 || midi > 132 {
      return 0.0
    }
    return midiToFrequency(midi)
  }

  // Otherwise parse numeric Hz (optional decimal + optional 'k'/'K' multiplier)
  let mut val: f64 = 0.0
  let mut sawDigit = false
  let mut idx = start
  while idx < end && bytes[idx] >= 48 && bytes[idx] <= 57 {
    val = val * 10.0 + i32.toF64(u8.toI32(bytes[idx] - 48))
    sawDigit = true
    idx = idx + 1
  }
  if idx < end && bytes[idx] == 46 { // '.'
    idx = idx + 1
    let mut place: f64 = 0.1
    while idx < end && bytes[idx] >= 48 && bytes[idx] <= 57 {
      val = val + i32.toF64(u8.toI32(bytes[idx] - 48)) * place
      place = place * 0.1
      sawDigit = true
      idx = idx + 1
    }
  }
  if !sawDigit {
    return 0.0
  }
  if idx < end && (bytes[idx] == 107 || bytes[idx] == 75) { // 'k' / 'K'
    val = val * 1000.0
  }
  if val < 10.0 || val > 24000.0 {
    return 0.0
  }
  return val
}
