pub effect fn listInputDevices() -> List<AudioDeviceInfo>
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = unsafe ov_audio_input_count()
  let mut out = List<AudioDeviceInfo>.make()
  let mut buf: [u8; 256] = [0; 256]
  let mut i: i32 = 0
  while i < count {
    let id = unsafe ov_audio_input_id(i)
    let len = unsafe ov_audio_input_name(i, Pointer.fromMutSlice(&mut buf), 256)
    let name = if len > 0 { run copyUtf8Lossy(Slice.view<u8>(&buf, 0, i32.toUsize(len))) } else { String.make() }
    run out.append(AudioDeviceInfo { id: id, name: move name })
    i = i + 1
  }
  return move out
}

pub effect fn listOutputDevices() -> List<AudioDeviceInfo>
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = unsafe ov_audio_output_count()
  let mut out = List<AudioDeviceInfo>.make()
  let mut buf: [u8; 256] = [0; 256]
  let mut i: i32 = 0
  while i < count {
    let id = unsafe ov_audio_output_id(i)
    let len = unsafe ov_audio_output_name(i, Pointer.fromMutSlice(&mut buf), 256)
    let name = if len > 0 { run copyUtf8Lossy(Slice.view<u8>(&buf, 0, i32.toUsize(len))) } else { String.make() }
    run out.append(AudioDeviceInfo { id: id, name: move name })
    i = i + 1
  }
  return move out
}

