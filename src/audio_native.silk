pub fn vowelAnalyze(
  jobId: i32,
  isRef: bool,
  samples: &[f32],
  sampleRate: f64,
  f0Times: &[f64],
  f0Hz: &[f64],
  f0Conf: &[f64],
  fmtTimes: &[f64],
  f1: &[f64],
  f2: &[f64],
  f3: &[f64],
  wantNeural: bool,
) -> usize {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    if samples.length < 64 {
      return 0
    }
    let mut f0N = f0Times.length
    if f0Hz.length < f0N { f0N = f0Hz.length }
    if f0Conf.length < f0N { f0N = f0Conf.length }
    let mut fmtN = fmtTimes.length
    if f1.length < fmtN { fmtN = f1.length }
    if f2.length < fmtN { fmtN = f2.length }
    if f3.length < fmtN { fmtN = f3.length }
    let n = unsafe ov_vowel_analyze(
      jobId,
      if isRef { 1 } else { 0 },
      Pointer.fromSlice(samples),
      usize.toI32(samples.length),
      sampleRate,
      Pointer.fromSlice(f0Times),
      Pointer.fromSlice(f0Hz),
      Pointer.fromSlice(f0Conf),
      usize.toI32(f0N),
      Pointer.fromSlice(fmtTimes),
      Pointer.fromSlice(f1),
      Pointer.fromSlice(f2),
      Pointer.fromSlice(f3),
      usize.toI32(fmtN),
      if wantNeural { 1 } else { 0 },
    )
    return if n > 0 { i32.toUsize(n) } else { 0 }
  } else {
    drop jobId
    drop isRef
    drop samples
    drop sampleRate
    drop f0Times
    drop f0Hz
    drop f0Conf
    drop fmtTimes
    drop f1
    drop f2
    drop f3
    drop wantNeural
    return 0
  }
}

