//! Platform bindings:
//!   - macOS native: `native/audio.m` (CoreAudio + Accelerate vDSP + real filesystem library)
//!   - Browser WASM: `glint#*` JS imports (Web Audio + IndexedDB storage) + `dsp_wasm` pure-Silk DSP
static if Intrinsic.targetArchitecture() == "wasm32" {
  import dsp_wasm
}
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.text.string { InvalidUtf8, String }

static if Intrinsic.targetArchitecture() == "wasm32" {
  unsafe extern "C" fn ov_audio_refresh_devices() -> i32 as "glint#ov_audio_refresh_devices"
  unsafe extern "C" fn ov_audio_input_count() -> i32 as "glint#ov_audio_input_count"
  unsafe extern "C" fn ov_audio_input_id(idx: i32) -> u32 as "glint#ov_audio_input_id"
  unsafe extern "C" fn ov_audio_input_name(idx: i32, out: ?[*]mut u8, cap: i32) -> i32 as "glint#ov_audio_input_name"
