pub fn neuralCopyPitch(times: &mut [f64], hz: &mut [f64], conf: &mut [f64]) -> usize {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    let mut cap = times.length
    if hz.length < cap { cap = hz.length }
    if conf.length < cap { cap = conf.length }
    if cap == 0 {
      return 0
    }
    let n = unsafe ov_neural_copy_pitch(
      Pointer.fromMutSlice(move times),
      Pointer.fromMutSlice(move hz),
      Pointer.fromMutSlice(move conf),
      usize.toI32(cap),
    )
    return if n > 0 { i32.toUsize(n) } else { 0 }
  } else {
    drop times
    drop hz
    drop conf
    return 0
  }
}

