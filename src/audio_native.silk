pub fn playSetRefWarp(lut: &[f32], takeDur: f64) -> () {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    if lut.length >= 2 && takeDur > 0.01 {
      unsafe ov_play_set_ref_warp(Pointer.fromSlice(lut), usize.toI32(lut.length), takeDur)
    } else {
      unsafe ov_play_set_ref_warp(Pointer.fromSlice(lut), 0, 0.0)
    }
  } else {
    drop lut
    drop takeDur
  }
}

pub fn playWarpedRef(samples: &[f32], sampleRate: f64, startSec: f64, endSec: f64, loop: bool) -> bool {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    if samples.length < 64 || sampleRate <= 0.0 {
      return false
    }
    return unsafe ov_play_warped_ref(
      Pointer.fromSlice(samples),
      usize.toI32(samples.length),
      sampleRate,
      startSec,
      endSec,
      if loop { 1 } else { 0 },
    ) != 0
  } else {
    return playRange(samples, sampleRate, startSec, endSec, loop)
  }
}

