pub fn synthRender(
  samples: &[f32],
  sampleRate: f64,
  f0Times: &[f64],
  f0Hz: &[f64],
  refF0: &[f64],
  hasRefF0: bool,
  pitchSemi: f64,
  followContour: bool,
  contourBlend: f64,
  sizePct: f64,
  weightDb: f64,
) -> usize {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    if samples.length < 64 {
      return 0
    }
    let f0N = if f0Times.length < f0Hz.length { f0Times.length } else { f0Hz.length }
    let useRef = hasRefF0 && refF0.length >= f0N && f0N > 0
    let n = unsafe ov_synth_render(
      Pointer.fromSlice(samples),
      usize.toI32(samples.length),
      sampleRate,
      Pointer.fromSlice(f0Times),
      Pointer.fromSlice(f0Hz),
      usize.toI32(f0N),
      Pointer.fromSlice(refF0),
      if useRef { 1 } else { 0 },
      pitchSemi,
      if followContour { 1 } else { 0 },
      contourBlend,
      sizePct,
      weightDb,
    )
    return if n > 0 { i32.toUsize(n) } else { 0 }
  } else {
    drop samples
    drop sampleRate
    drop f0Times
    drop f0Hz
    drop refF0
    drop hasRefF0
    drop pitchSemi
    drop followContour
    drop contourBlend
    drop sizePct
    drop weightDb
    return 0
  }
}

