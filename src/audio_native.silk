  unsafe extern "C" fn ov_audio_get_output_device() -> u32 as "glint#ov_audio_get_output_device"
  unsafe extern "C" fn ov_audio_set_input_device(devId: u32) -> i32 as "glint#ov_audio_set_input_device"
  unsafe extern "C" fn ov_audio_set_output_device(devId: u32) -> i32 as "glint#ov_audio_set_output_device"

  unsafe extern "C" fn ov_mic_start_rate(preferredRate: f64) -> i32 as "glint#ov_mic_start_rate"
  unsafe extern "C" fn ov_mic_start() -> i32 as "glint#ov_mic_start"
  unsafe extern "C" fn ov_mic_stop() -> () as "glint#ov_mic_stop"
  unsafe extern "C" fn ov_mic_running() -> i32 as "glint#ov_mic_running"
  unsafe extern "C" fn ov_mic_sample_rate() -> f64 as "glint#ov_mic_sample_rate"
  unsafe extern "C" fn ov_mic_level_db() -> f32 as "glint#ov_mic_level_db"
  unsafe extern "C" fn ov_mic_available() -> i32 as "glint#ov_mic_available"
  unsafe extern "C" fn ov_mic_drain(out: ?[*]mut f32, maxCount: i32) -> i32 as "glint#ov_mic_drain"
  unsafe extern "C" fn ov_mic_error(out: ?[*]mut u8, capacity: i32) -> i32 as "glint#ov_mic_error"

  unsafe extern "C" fn ov_load_file(path: ?[*]const u8, length: usize) -> i32 as "glint#ov_load_file"
  unsafe extern "C" fn ov_loaded_count() -> i32 as "glint#ov_loaded_count"
  unsafe extern "C" fn ov_loaded_rate() -> f64 as "glint#ov_loaded_rate"
  unsafe extern "C" fn ov_loaded_copy(out: ?[*]mut f32, maxCount: i32) -> i32 as "glint#ov_loaded_copy"
