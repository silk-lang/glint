    return 0
  }
}

pub fn vowelIsNeural(isRef: bool) -> bool {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    return unsafe ov_vowel_is_neural(if isRef { 1 } else { 0 }) != 0
  } else {
    drop isRef
    return false
  }
}

pub fn vowelCopySpans(
  isRef: bool,
  t0: &mut [f64],
  t1: &mut [f64],
  labelBuf: &mut [u8],
  labelStride: usize,
) -> usize {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    let mut cap = t0.length
    if t1.length < cap { cap = t1.length }
    if cap == 0 || labelStride == 0 || labelBuf.length < cap * labelStride {
      return 0
    }
    let n = unsafe ov_vowel_copy_spans(
      if isRef { 1 } else { 0 },
      Pointer.fromMutSlice(move t0),
      Pointer.fromMutSlice(move t1),
      Pointer.fromMutSlice(move labelBuf),
      usize.toI32(labelStride),
      usize.toI32(cap),
    )
    return if n > 0 { i32.toUsize(n) } else { 0 }
  } else {
    drop isRef
    drop t0
    drop t1
    drop labelBuf
    drop labelStride
    return 0
  }
}

pub effect fn vowelLabelAt(buf: &[u8], idx: usize, stride: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = idx * stride
  if start >= buf.length || stride == 0 {
    return String.make()
  }
  let mut lim = start + stride
  if lim > buf.length {
    lim = buf.length
  }
  let mut end = start
  while end < lim && buf[end] != 0 {
    end = end + 1
  }
  if end <= start {
    return String.make()
  }
  return run copyUtf8Lossy(Slice.view<u8>(buf, start, end - start))
}

pub fn playFiltered(
  isRef: bool,
  samples: &[f32],
  sampleRate: f64,
  startSec: f64,
  endSec: f64,
  loop: bool,
  mode: u32,
  timingMode: u32,
  labMode: u32,
  targetMonoHz: f64,
) -> bool {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    if samples.length == 0 {
      return false
    }
    let modeI32: i32 = if mode == 1 { 1 } else if mode == 2 { 2 } else { 0 }
    let timingI32: i32 = if timingMode == 2 { 2 } else if timingMode == 1 { 1 } else { 0 }
    let labI32: i32 = if labMode <= 7 { usize.toI32(u32.toUsize(labMode)) } else { 0 }
    return unsafe ov_play_filtered(
      if isRef { 1 } else { 0 },
      Pointer.fromSlice(samples),
      usize.toI32(samples.length),
      sampleRate,
      startSec,
      endSec,
      if loop { 1 } else { 0 },
      modeI32,
      timingI32,
      labI32,
      targetMonoHz,
    ) != 0
  } else {
    drop isRef
    drop mode
    drop timingMode
    drop labMode
    drop targetMonoHz
    return playRange(samples, sampleRate, startSec, endSec, loop)
  }
}

pub fn klattPlay(f0: f64, f1: f64, f2: f64, f3: f64, f4: f64, durSec: f64, tiltDb: f64) -> bool {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    return unsafe ov_klatt_play(f0, f1, f2, f3, f4, durSec, tiltDb) != 0
  } else {
    drop f0
    drop f1
    drop f2
    drop f3
    drop f4
    drop durSec
    drop tiltDb
    return false
  }
}
