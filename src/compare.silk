//! Reference clip storage, bidirectional DTW alignment (`Ref -> Take` AND `Take -> Ref` so you
//! can plot YOUR voice directly on top of the Reference's spectrogram!), and composite Match Score.
import audio_native
import formants { FormantFrame }
import pitch { PitchFrame }
import voice_metrics { LTAS_BINS, LTAS_FMAX, LTAS_FMIN, VoiceFrame, VoiceSummary, computeExpressiveness }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize
import silk.text.string { String }

/// Pinned reference clip (any clip from any folder, or the currently open clip).
pub struct ReferenceClip {
  pub active: bool,
  pub fullPath: String,
  pub name: String,
  pub samples: List<f32>,
  pub sampleRate: f64,
  pub durationSec: f64,
  pub pitchFrames: List<PitchFrame>,
  pub formantFrames: List<FormantFrame>,
  pub voiceFrames: List<VoiceFrame>,
  pub summary: VoiceSummary,
  pub ltas: [f32; 64],
  pub hasLtas: bool,
}

impl ReferenceClip {
  pub fn empty() -> ReferenceClip {
    return ReferenceClip {
      active: false,
      fullPath: String.make(),
      name: String.make(),
      samples: List<f32>.make(),
      sampleRate: 48000.0,
      durationSec: 0.0,
      pitchFrames: List<PitchFrame>.make(),
      formantFrames: List<FormantFrame>.make(),
      voiceFrames: List<VoiceFrame>.make(),
      summary: VoiceSummary.empty(),
      ltas: [0.0; 64],
      hasLtas: false,
    }
  }

  pub fn clear(self: &mut Self) -> () {
    self.active = false
    self.fullPath.clear()
    self.name.clear()
    self.samples.clear()
    self.durationSec = 0.0
    self.pitchFrames.clear()
    self.formantFrames.clear()
    self.voiceFrames.clear()
    self.summary = VoiceSummary.empty()
    self.ltas = [0.0; 64]
    self.hasLtas = false
  }
}

/// Heatmap metric selector when comparing against a Reference.
pub const HEATMAP_OVERALL: u32 = 0
pub const HEATMAP_PITCH: u32 = 1
pub const HEATMAP_SIZE: u32 = 2
pub const HEATMAP_WEIGHT: u32 = 3
pub const HEATMAP_VOWEL: u32 = 4

/// One warped point projected onto the target timeline (used for BOTH Ref-on-Take and Take-on-Ref!).
pub struct AlignedRefPoint {
  pub time: f64,
  /// Source timestamp on the paired clip (e.g. Reference timestamp warped onto Take's `time`).
  pub refTime: f64,
  pub voiced: bool,
  pub f0: f64,
  pub sizeNorm: f64,
  pub weightLightNorm: f64,
  pub hnrDb: f64,
  pub f1: f64,
  pub f2: f64,
  pub f3: f64,
  pub f4: f64,
  pub hasFormants: bool,
  /// Per-frame normalized divergence [0 = exact match .. 1 = large divergence] for the spectrogram heatmap.
  pub bothVoiced: bool,
  pub divOverall: f64,
  pub divPitch: f64,
  pub divSize: f64,
  pub divWeight: f64,
  pub divVowel: f64,
}

impl Copy for AlignedRefPoint {}

/// One matched `(takeFrameIdx, refFrameIdx)` pair along the alignment path (used for selection bisecting).
pub struct DtwPair {
  pub takeIdx: usize,
  pub refIdx: usize,
}

impl Copy for DtwPair {}

/// User-configurable comparison weights for the composite Match Score.
pub struct MatchWeights {
  pub pitch: f64,
  pub size: f64,
  pub weight: f64,
  pub vowel: f64,
}

impl Copy for MatchWeights {}

impl MatchWeights {
  pub fn defaults() -> MatchWeights {
    return MatchWeights { pitch: 25.0, size: 35.0, weight: 25.0, vowel: 15.0 }
  }
}

/// Transparent voice-training match score (0..100) derived from DTW-aligned acoustic comparison.
pub struct MatchScore {
  pub valid: bool,
  pub overall: u32,
  pub pitchScore: u32,
  pub sizeScore: u32,
  pub weightScore: u32,
  pub vowelScore: u32,
}

impl Copy for MatchScore {}

impl MatchScore {
  pub fn empty() -> MatchScore {
    return MatchScore {
      valid: false,
      overall: 0,
      pitchScore: 0,
      sizeScore: 0,
      weightScore: 0,
      vowelScore: 0,
    }
  }
}

/// Bisected comparison result for a user-selected time range `[takeStart, takeEnd]` against
/// its DTW-matched Reference span `[refStart, refEnd]`.
pub struct SelectionCompare {
  pub valid: bool,
  pub takeStart: f64,
  pub takeEnd: f64,
  pub refStart: f64,
  pub refEnd: f64,
  pub deltaSemi: f64,
  pub deltaVtlCm: f64,
  pub deltaH1H2Db: f64,
  pub deltaHnrDb: f64,
  pub deltaCppsDb: f64,
  pub deltaTwangDb: f64,
  pub deltaStrainPct: f64,
  pub deltaPitchSpanSt: f64,
  pub deltaVowelF2: f64,
  pub takeSummary: VoiceSummary,
  pub refSummary: VoiceSummary,
  pub takeLtas: [f32; 64],
  pub hasTakeLtas: bool,
  pub refLtas: [f32; 64],
  pub hasRefLtas: bool,
  pub score: MatchScore,
}

impl Copy for SelectionCompare {}

impl SelectionCompare {
  pub fn empty() -> SelectionCompare {
    return SelectionCompare {
      valid: false,
      takeStart: 0.0,
      takeEnd: 0.0,
      refStart: 0.0,
      refEnd: 0.0,
      deltaSemi: 0.0,
      deltaVtlCm: 0.0,
      deltaH1H2Db: 0.0,
      deltaHnrDb: 0.0,
      deltaCppsDb: 0.0,
      deltaTwangDb: 0.0,
      deltaStrainPct: 0.0,
      deltaPitchSpanSt: 0.0,
      deltaVowelF2: 0.0,
      takeSummary: VoiceSummary.empty(),
      refSummary: VoiceSummary.empty(),
      takeLtas: [0.0; 64],
      hasTakeLtas: false,
      refLtas: [0.0; 64],
      hasRefLtas: false,
      score: MatchScore.empty(),
    }
  }
}

/// Bidirectional DTW comparison alignment, summary deltas, and match score (Take vs Reference).
pub struct CompareAlignment {
  pub valid: bool,
  /// Reference warped onto Take's timeline (for plotting Ref ghosts & waveform on Take spectrogram).
  pub points: List<AlignedRefPoint>,
  /// Take warped onto Reference's timeline (for plotting YOUR voice on top of Reference spectrogram!).
  pub takeOnRef: List<AlignedRefPoint>,
  /// Matched `(takeIdx, refIdx)` frame index pairs along the alignment path for instant selection bisecting.
  pub pairs: List<DtwPair>,
  pub deltaSemi: f64,
  pub deltaVtlCm: f64,
  pub deltaH1H2Db: f64,
  pub deltaHnrDb: f64,
  pub deltaCppsDb: f64,
  pub deltaTwangDb: f64,
  pub deltaStrainPct: f64,
  pub deltaPitchSpanSt: f64,
  pub deltaVowelF2: f64,
  pub score: MatchScore,
}

impl CompareAlignment {
  pub fn empty() -> CompareAlignment {
    return CompareAlignment {
      valid: false,
      points: List<AlignedRefPoint>.make(),
      takeOnRef: List<AlignedRefPoint>.make(),
      pairs: List<DtwPair>.make(),
      deltaSemi: 0.0,
      deltaVtlCm: 0.0,
      deltaH1H2Db: 0.0,
      deltaHnrDb: 0.0,
      deltaCppsDb: 0.0,
      deltaTwangDb: 0.0,
      deltaStrainPct: 0.0,
      deltaPitchSpanSt: 0.0,
      deltaVowelF2: 0.0,
      score: MatchScore.empty(),
    }
  }
}

struct DtwFeat {
  origIdx: usize,
  voiced: f64,
  energyNorm: f64,
  pitchRel: f64,
  sizeNorm: f64,
}

impl Copy for DtwFeat {}

fn medianSortF64(vals: &mut [f64]) -> f64 {
  let n = vals.length
  if n == 0 {
    return 0.0
  }
  let mut i: usize = 1
  while i < n {
    let key = vals[i]
    let mut j = i
    while j > 0 && vals[j - 1] > key {
      vals[j] = vals[j - 1]
      j = j - 1
    }
    vals[j] = key
    i = i + 1
  }
  let mid = n / 2
  if (n % 2) == 1 {
    return vals[mid]
  }
  return 0.5 * (vals[mid - 1] + vals[mid])
}

effect fn extractActiveFeatures(frames: &[VoiceFrame], maxPoints: usize) -> List<DtwFeat>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<DtwFeat>.make()
  if frames.length == 0 {
    return move out
  }

  let mut peakDb: f64 = -120.0
  let mut i: usize = 0
  while i < frames.length {
    if frames[i].voiced && frames[i].intensityDb > peakDb {
      peakDb = frames[i].intensityDb
    }
    i = i + 1
  }
  let activeDb = f64.max(-62.0, peakDb - 32.0)

  let mut first: usize = frames.length
  let mut last: usize = 0
  let mut logF0s = List<f64>.make()
  i = 0
  while i < frames.length {
    if frames[i].voiced && frames[i].intensityDb >= activeDb {
      if first == frames.length {
        first = i
      }
      last = i
      run logF0s.append(f64.log2(f64.max(50.0, frames[i].f0)))
    }
    i = i + 1
  }
  if first == frames.length || logF0s.length() == 0 {
    return move out
  }
  if first >= 2 { first = first - 2 } else { first = 0 }
  if last + 2 < frames.length { last = last + 2 } else { last = frames.length - 1 }

  // Median log2(f0) is immune to any stray single-frame octave outlier!
  let medLogF0 = medianSortF64(logF0s.asMutSlice())
  let span = last - first + 1
  let target = if span > maxPoints { maxPoints } else { span }

  let mut k: usize = 0
  while k < target {
    let idx = if target <= 1 {
      first
    } else {
      first + (k * (span - 1)) / (target - 1)
    }
    let fr = frames[idx]
    let eNorm = f64.max(0.0, f64.min(1.0, (fr.intensityDb + 65.0) / 55.0))
    let pRelRaw = if fr.voiced {
      f64.log2(f64.max(50.0, fr.f0)) - medLogF0
    } else {
      0.0
    }
    // Clamp pitchRel to ±1.2 octaves so stray glitches never pull DTW off-course
    let pRel = f64.max(-1.2, f64.min(1.2, pRelRaw))
    run out.append(DtwFeat {
      origIdx: idx,
      voiced: if fr.voiced { 1.0 } else { 0.0 },
      energyNorm: eNorm,
      pitchRel: pRel,
      sizeNorm: fr.sizeNorm,
    })
    k = k + 1
  }
  return move out
}

fn featDist(a: DtwFeat, b: DtwFeat) -> f64 {
  let dv = a.voiced - b.voiced
  let de = a.energyNorm - b.energyNorm
  let dp = a.pitchRel - b.pitchRel
  let ds = a.sizeNorm - b.sizeNorm
  return 1.6 * dv * dv + 1.4 * de * de + 0.55 * dp * dp + 0.35 * ds * ds
}

fn clampScore(x: f64) -> u32 {
  let c = f64.max(0.0, f64.min(100.0, f64.round(x * 100.0)))
  return f64.toU32(c)
}

effect fn computeMatchScore(
  takeSummary: VoiceSummary,
  takeLtas: &[f32],
  hasTakeLtas: bool,
  refClip: &ReferenceClip,
  takeFrames: &[VoiceFrame],
  refFrames: &[VoiceFrame],
  aSl: &[DtwFeat],
  bSl: &[DtwFeat],
  mapJ: &[usize],
  weights: MatchWeights,
) -> MatchScore
  ! OutOfMemoryError
  ? &mut Allocator {
  if takeSummary.voicedFrames < 3 || refClip.summary.voicedFrames < 3 {
    return MatchScore.empty()
  }

  // 1. Frame-by-frame DTW-aligned contour & trajectory errors (outlier-resistant Huber + median!)
  let mut pitchAbsErrs = List<f64>.make()
  let mut pitchClippedSq: f64 = 0.0
  let mut sizeAbsErrs = List<f64>.make()
  let mut sizeClippedSq: f64 = 0.0
  let mut weightErrSq: f64 = 0.0
  let mut weightCnt: usize = 0

  let mut i: usize = 0
  while i < aSl.length && i < mapJ.length {
    let tf = takeFrames[aSl[i].origIdx]
    let rf = refFrames[bSl[mapJ[i]].origIdx]
    if tf.voiced && rf.voiced {
      let absSemi = f64.abs(12.0 * f64.log2(f64.max(40.0, tf.f0) / f64.max(40.0, rf.f0)))
      run pitchAbsErrs.append(absSemi)
      // Cap per-frame error at 9 st so a stray octave/consonant glitch can never explode RMSE!
      let cappedSemi = f64.min(9.0, absSemi)
      pitchClippedSq = pitchClippedSq + cappedSemi * cappedSemi

      if tf.vtlCm > 1.0 && rf.vtlCm > 1.0 {
        let absDs = f64.abs(tf.sizeNorm - rf.sizeNorm)
        run sizeAbsErrs.append(absDs)
        let cappedDs = f64.min(0.45, absDs)
        sizeClippedSq = sizeClippedSq + cappedDs * cappedDs
      }

      let dw = tf.weightLightNorm - rf.weightLightNorm
      weightErrSq = weightErrSq + dw * dw
      weightCnt = weightCnt + 1
    }
    i = i + 1
  }

  // Pitch score: 50% median semitone proximity + 50% robust aligned contour error (median + clipped RMSE)
  let deltaSemi = if takeSummary.medianF0 > 1.0 && refClip.summary.medianF0 > 1.0 {
    f64.abs(12.0 * f64.log2(takeSummary.medianF0 / refClip.summary.medianF0))
  } else {
    12.0
  }
  let pitchMedianSim = f64.exp(-(deltaSemi / 5.0) * (deltaSemi / 5.0))
  let pitchContourErr = if pitchAbsErrs.length() > 0 {
    let clippedRmse = f64.sqrt(pitchClippedSq / usize.toF64(pitchAbsErrs.length()))
    let medAbs = medianSortF64(pitchAbsErrs.asMutSlice())
    0.55 * medAbs + 0.45 * clippedRmse
  } else {
    deltaSemi
  }
  let pitchContourSim = f64.exp(-(pitchContourErr / 4.5) * (pitchContourErr / 4.5))
  let pitchSim = 0.50 * pitchMedianSim + 0.50 * pitchContourSim

  // Resonance / Size score: 55% median VTL proximity + 45% robust aligned size curve error
  let deltaVtl = if takeSummary.medianVtlCm > 1.0 && refClip.summary.medianVtlCm > 1.0 {
    f64.abs(takeSummary.medianVtlCm - refClip.summary.medianVtlCm)
  } else {
    3.0
  }
  let vtlSim = f64.exp(-(deltaVtl / 1.8) * (deltaVtl / 1.8))
  let sizeContourErr = if sizeAbsErrs.length() > 0 {
    let clippedRmse = f64.sqrt(sizeClippedSq / usize.toF64(sizeAbsErrs.length()))
    let medAbs = medianSortF64(sizeAbsErrs.asMutSlice())
    0.55 * medAbs + 0.45 * clippedRmse
  } else {
    0.35
  }
  let sizeCurveSim = f64.exp(-(sizeContourErr / 0.26) * (sizeContourErr / 0.26))
  let sizeSim = 0.55 * vtlSim + 0.45 * sizeCurveSim

  // Vocal Weight score (25%): combines median H1-H2 proximity + DTW weight curve + breathiness guard
  let deltaH1H2 = f64.abs(takeSummary.medianH1H2Db - refClip.summary.medianH1H2Db)
  let h1h2Sim = f64.exp(-(deltaH1H2 / 6.5) * (deltaH1H2 / 6.5))
  let weightRmse = if weightCnt > 0 { f64.sqrt(weightErrSq / usize.toF64(weightCnt)) } else { 0.35 }
  let weightCurveSim = f64.exp(-(weightRmse / 0.30) * (weightRmse / 0.30))
  // Gentle breathiness penalty if take HNR drops much lower than ref HNR
  let hnrDrop = f64.max(0.0, refClip.summary.medianHnrDb - takeSummary.medianHnrDb - 3.0)
  let hnrGuard = f64.exp(-(hnrDrop / 10.0) * (hnrDrop / 10.0))
  let weightSim = (0.50 * h1h2Sim + 0.50 * weightCurveSim) * (0.80 + 0.20 * hnrGuard)

  // Vowel Space & Spectral Balance score (15%): F1/F2 centroid proximity + LTAS midband match (150..4500 Hz)
  let mut vowelCentroidSim: f64 = 0.70
  if takeSummary.formantCount > 0 && refClip.summary.formantCount > 0 && takeSummary.meanF1 > 100.0 && refClip.summary.meanF1 > 100.0 {
    let df1 = f64.log2(takeSummary.meanF1 / refClip.summary.meanF1)
    let df2 = f64.log2(takeSummary.meanF2 / refClip.summary.meanF2)
    let vDist = f64.sqrt(df1 * df1 + df2 * df2)
    vowelCentroidSim = f64.exp(-(vDist / 0.42) * (vDist / 0.42))
  }
  let mut ltasSim: f64 = vowelCentroidSim
  if hasTakeLtas && refClip.hasLtas && takeLtas.length >= LTAS_BINS {
    // Bins 12..58 (~150 Hz .. 4.5 kHz) avoid mic sub-bass rumble and high-end codec rolloff.
    let mut errSq: f64 = 0.0
    let mut cnt: usize = 0
    let mut b: usize = 12
    while b < 58 && b < LTAS_BINS {
      let d = f32.toF64(takeLtas[b] - refClip.ltas[b])
      errSq = errSq + d * d
      cnt = cnt + 1
      b = b + 1
    }
    if cnt > 0 {
      let rmse = f64.sqrt(errSq / usize.toF64(cnt))
      ltasSim = f64.exp(-(rmse / 9.0) * (rmse / 9.0))
    }
  }
  let vowelSim = 0.55 * vowelCentroidSim + 0.45 * ltasSim

  let wSum = weights.pitch + weights.size + weights.weight + weights.vowel
  let overallSim = if wSum > 0.001 {
    (weights.pitch * pitchSim + weights.size * sizeSim + weights.weight * weightSim + weights.vowel * vowelSim) / wSum
  } else {
    0.25 * (pitchSim + sizeSim + weightSim + vowelSim)
  }
  return MatchScore {
    valid: true,
    overall: clampScore(overallSim),
    pitchScore: clampScore(pitchSim),
    sizeScore: clampScore(sizeSim),
    weightScore: clampScore(weightSim),
    vowelScore: clampScore(vowelSim),
  }
}

struct FrameDiv {
  bothVoiced: bool,
  overall: f64,
  pitch: f64,
  size: f64,
  weight: f64,
  vowel: f64,
}

impl Copy for FrameDiv {}

fn computeFrameDiv(tf: VoiceFrame, rf: VoiceFrame, weights: MatchWeights) -> FrameDiv {
  if !tf.voiced || !rf.voiced || tf.f0 <= 40.0 || rf.f0 <= 40.0 {
    return FrameDiv { bothVoiced: false, overall: 0.0, pitch: 0.0, size: 0.0, weight: 0.0, vowel: 0.0 }
  }
  let dSemi = f64.abs(12.0 * f64.log2(tf.f0 / rf.f0))
  let dp = f64.min(1.0, dSemi / 6.0)
  let ds = if tf.vtlCm > 1.0 && rf.vtlCm > 1.0 {
    f64.min(1.0, f64.abs(tf.vtlCm - rf.vtlCm) / 2.6)
  } else {
    f64.min(1.0, f64.abs(tf.sizeNorm - rf.sizeNorm) / 0.45)
  }
  let dw = f64.min(1.0, f64.abs(tf.h1h2Db - rf.h1h2Db) / 8.0)
  let dv = if tf.hasFormants && rf.hasFormants && tf.f1 > 100.0 && rf.f1 > 100.0 && tf.f2 > 300.0 && rf.f2 > 300.0 {
    let e1 = 12.0 * f64.log2(tf.f1 / rf.f1)
    let e2 = 12.0 * f64.log2(tf.f2 / rf.f2)
    f64.min(1.0, f64.sqrt(e1 * e1 + e2 * e2) / 6.0)
  } else {
    ds
  }
  let wSum = f64.max(1.0, weights.pitch + weights.size + weights.weight + weights.vowel)
  let ov = (weights.pitch * dp + weights.size * ds + weights.weight * dw + weights.vowel * dv) / wSum
  return FrameDiv {
    bothVoiced: true,
    overall: f64.min(1.0, ov),
    pitch: dp,
    size: ds,
    weight: dw,
    vowel: dv,
  }
}

effect fn smoothDivergence(pts: &mut [AlignedRefPoint]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = pts.length
  if n < 3 {
    return ()
  }
  let mut sOv = List<f64>.make()
  let mut sP = List<f64>.make()
  let mut sS = List<f64>.make()
  let mut sW = List<f64>.make()
  let mut sV = List<f64>.make()
  run sOv.appendRepeated(0.0, n)
  run sP.appendRepeated(0.0, n)
  run sS.appendRepeated(0.0, n)
  run sW.appendRepeated(0.0, n)
  run sV.appendRepeated(0.0, n)
  let ovSl = sOv.asMutSlice()
  let pSl = sP.asMutSlice()
  let sSl = sS.asMutSlice()
  let wSl = sW.asMutSlice()
  let vSl = sV.asMutSlice()

  let mut i: usize = 0
  while i < n {
    let cur = pts[i]
    if !cur.bothVoiced {
      ovSl[i] = 0.0
      pSl[i] = 0.0
      sSl[i] = 0.0
      wSl[i] = 0.0
      vSl[i] = 0.0
    } else {
      let hasL = i > 0 && pts[i - 1].bothVoiced && (cur.time - pts[i - 1].time) <= 0.14
      let hasR = i + 1 < n && pts[i + 1].bothVoiced && (pts[i + 1].time - cur.time) <= 0.14
      let w0: f64 = 0.50
      let wL: f64 = if hasL { 0.25 } else { 0.0 }
      let wR: f64 = if hasR { 0.25 } else { 0.0 }
      let inv = 1.0 / (w0 + wL + wR)
      ovSl[i] = (w0 * cur.divOverall + (if hasL { wL * pts[i - 1].divOverall } else { 0.0 }) + (if hasR { wR * pts[i + 1].divOverall } else { 0.0 })) * inv
      pSl[i] = (w0 * cur.divPitch + (if hasL { wL * pts[i - 1].divPitch } else { 0.0 }) + (if hasR { wR * pts[i + 1].divPitch } else { 0.0 })) * inv
      sSl[i] = (w0 * cur.divSize + (if hasL { wL * pts[i - 1].divSize } else { 0.0 }) + (if hasR { wR * pts[i + 1].divSize } else { 0.0 })) * inv
      wSl[i] = (w0 * cur.divWeight + (if hasL { wL * pts[i - 1].divWeight } else { 0.0 }) + (if hasR { wR * pts[i + 1].divWeight } else { 0.0 })) * inv
      vSl[i] = (w0 * cur.divVowel + (if hasL { wL * pts[i - 1].divVowel } else { 0.0 }) + (if hasR { wR * pts[i + 1].divVowel } else { 0.0 })) * inv
    }
    i = i + 1
  }
  i = 0
  while i < n {
    pts[i].divOverall = ovSl[i]
    pts[i].divPitch = pSl[i]
    pts[i].divSize = sSl[i]
    pts[i].divWeight = wSl[i]
    pts[i].divVowel = vSl[i]
    i = i + 1
  }
}

/// Aligns Take <-> Reference bidirectionally via banded DTW (or straight clock time if `!useDtw`),
/// producing both `Ref-on-Take` and `Take-on-Ref` overlays plus deltas and MatchScore.
pub effect fn buildCompareAlignment(
  takeFrames: &[VoiceFrame],
  takeSummary: VoiceSummary,
  takeLtas: &[f32],
  hasTakeLtas: bool,
  refClip: &ReferenceClip,
  useDtw: bool,
  weights: MatchWeights,
) -> CompareAlignment
  ! OutOfMemoryError
  ? &mut Allocator {
  if !refClip.active || refClip.voiceFrames.length() == 0 {
    return CompareAlignment.empty()
  }

  let refFs = refClip.voiceFrames.asSlice()
  let mut refOnTake = List<AlignedRefPoint>.make()
  let mut takeOnRef = List<AlignedRefPoint>.make()
  let mut pairs = List<DtwPair>.make()

  let deltaSemi = if takeSummary.medianF0 > 1.0 && refClip.summary.medianF0 > 1.0 {
    12.0 * f64.log2(takeSummary.medianF0 / refClip.summary.medianF0)
  } else {
    0.0
  }
  let deltaVtlCm = if takeSummary.medianVtlCm > 1.0 && refClip.summary.medianVtlCm > 1.0 {
    takeSummary.medianVtlCm - refClip.summary.medianVtlCm
  } else {
    0.0
  }
  let deltaH1H2Db = takeSummary.medianH1H2Db - refClip.summary.medianH1H2Db
  let deltaHnrDb = takeSummary.medianHnrDb - refClip.summary.medianHnrDb
  let deltaCppsDb = takeSummary.medianCppsDb - refClip.summary.medianCppsDb
  let deltaTwangDb = takeSummary.medianTwangDb - refClip.summary.medianTwangDb
  let deltaStrainPct = (takeSummary.medianStrainNorm - refClip.summary.medianStrainNorm) * 100.0
  let deltaPitchSpanSt = takeSummary.pitchSpanSt - refClip.summary.pitchSpanSt
  let deltaVowelF2 = if takeSummary.formantCount > 0 && refClip.summary.formantCount > 0 && takeSummary.meanF2 > 100.0 && refClip.summary.meanF2 > 100.0 {
    f64.log2(takeSummary.meanF2 / refClip.summary.meanF2)
  } else {
    0.0
  }

  let aFeats = run extractActiveFeatures(takeFrames, 140)
  let bFeats = run extractActiveFeatures(refFs, 140)
  let n = aFeats.length()
  let m = bFeats.length()

  if !useDtw || n < 3 || m < 3 {
    let mut i: usize = 0
    while i < refFs.length {
      let rf = refFs[i]
      // Match nearest take frame by time for linear fallback divergence
      let tIdx = if takeFrames.length > 0 {
        let clamped = if i < takeFrames.length { i } else { takeFrames.length - 1 }
        clamped
      } else {
        0
      }
      let fd = if takeFrames.length > 0 {
        computeFrameDiv(takeFrames[tIdx], rf, weights)
      } else {
        FrameDiv { bothVoiced: false, overall: 0.0, pitch: 0.0, size: 0.0, weight: 0.0, vowel: 0.0 }
      }
      run refOnTake.append(AlignedRefPoint {
        time: rf.time,
        refTime: rf.time,
        voiced: rf.voiced,
        f0: rf.f0,
        sizeNorm: rf.sizeNorm,
        weightLightNorm: rf.weightLightNorm,
        hnrDb: rf.hnrDb,
        f1: rf.f1,
        f2: rf.f2,
        f3: rf.f3,
        f4: rf.f4,
        hasFormants: rf.hasFormants,
        bothVoiced: fd.bothVoiced,
        divOverall: fd.overall,
        divPitch: fd.pitch,
        divSize: fd.size,
        divWeight: fd.weight,
        divVowel: fd.vowel,
      })
      i = i + 1
    }
    i = 0
    while i < takeFrames.length {
      let tf = takeFrames[i]
      let rIdx = if refFs.length > 0 {
        if i < refFs.length { i } else { refFs.length - 1 }
      } else {
        0
      }
      let fd = if refFs.length > 0 {
        computeFrameDiv(tf, refFs[rIdx], weights)
      } else {
        FrameDiv { bothVoiced: false, overall: 0.0, pitch: 0.0, size: 0.0, weight: 0.0, vowel: 0.0 }
      }
      run takeOnRef.append(AlignedRefPoint {
        time: tf.time,
        refTime: tf.time,
        voiced: tf.voiced,
        f0: tf.f0,
        sizeNorm: tf.sizeNorm,
        weightLightNorm: tf.weightLightNorm,
        hnrDb: tf.hnrDb,
        f1: tf.f1,
        f2: tf.f2,
        f3: tf.f3,
        f4: tf.f4,
        hasFormants: tf.hasFormants,
        bothVoiced: fd.bothVoiced,
        divOverall: fd.overall,
        divPitch: fd.pitch,
        divSize: fd.size,
        divWeight: fd.weight,
        divVowel: fd.vowel,
      })
      i = i + 1
    }
    run smoothDivergence(refOnTake.asMutSlice())
    run smoothDivergence(takeOnRef.asMutSlice())
    // Linear fallback mapping for score & selection bisecting if both have active speech
    let mut linMap = List<usize>.make()
    if n >= 3 && m >= 3 {
      let aSlLin = aFeats.asSlice()
      let bSlLin = bFeats.asSlice()
      let mut k: usize = 0
      while k < n {
        let mj = (k * (m - 1)) / (n - 1)
        run linMap.append(mj)
        run pairs.append(DtwPair { takeIdx: aSlLin[k].origIdx, refIdx: bSlLin[mj].origIdx })
        k = k + 1
      }
    }
    let score = run computeMatchScore(
      takeSummary,
      takeLtas,
      hasTakeLtas,
      refClip,
      takeFrames,
      refFs,
      aFeats.asSlice(),
      bFeats.asSlice(),
      linMap.asSlice(),
      weights,
    )
    return CompareAlignment {
      valid: true,
      points: move refOnTake,
      takeOnRef: move takeOnRef,
      pairs: move pairs,
      deltaSemi: deltaSemi,
      deltaVtlCm: deltaVtlCm,
      deltaH1H2Db: deltaH1H2Db,
      deltaHnrDb: deltaHnrDb,
      deltaCppsDb: deltaCppsDb,
      deltaTwangDb: deltaTwangDb,
      deltaStrainPct: deltaStrainPct,
      deltaPitchSpanSt: deltaPitchSpanSt,
      deltaVowelF2: deltaVowelF2,
      score: score,
    }
  }

  let aSl = aFeats.asSlice()
  let bSl = bFeats.asSlice()
  let bigInf: f64 = 1.0e20
  let total = n * m
  let mut dp = List<f64>.make()
  run dp.appendRepeated(bigInf, total)
  let mut back = List<u8>.make()
  run back.appendRepeated(0, total)
  let dpSl = dp.asMutSlice()
  let bkSl = back.asMutSlice()

  let maxDim = if n > m { n } else { m }
  let bandRaw = (maxDim * 35) / 100
  let band = if bandRaw < 18 { 18 } else { bandRaw }
  let slope = usize.toF64(m) / usize.toF64(n)

  dpSl[0] = featDist(aSl[0], bSl[0])
  let mut i: usize = 0
  while i < n {
    let centerJ = f64.toUsize(f64.round(usize.toF64(i) * slope))
    let jLo = if centerJ > band { centerJ - band } else { 0 }
    let jHi = if centerJ + band < m { centerJ + band } else { m - 1 }
    let mut j = jLo
    while j <= jHi {
      if !(i == 0 && j == 0) {
        let mut best = bigInf
        let mut dir: u8 = 0
        if i > 0 && j > 0 {
          let c = dpSl[(i - 1) * m + (j - 1)]
          if c < best {
            best = c
            dir = 1
          }
        }
        if i > 0 {
          let c = dpSl[(i - 1) * m + j] + 0.04
          if c < best {
            best = c
            dir = 2
          }
        }
        if j > 0 {
          let c = dpSl[i * m + (j - 1)] + 0.04
          if c < best {
            best = c
            dir = 3
          }
        }
        if best < bigInf * 0.5 {
          dpSl[i * m + j] = best + featDist(aSl[i], bSl[j])
          bkSl[i * m + j] = dir
        }
      }
      j = j + 1
    }
    i = i + 1
  }

  // Backtrack best warp path to build BOTH `take->ref` (`mapJ`) AND `ref->take` (`mapI`)!
  let mut mapJ = List<usize>.make()
  run mapJ.appendRepeated(0, n)
  let mut mapI = List<usize>.make()
  run mapI.appendRepeated(0, m)
  let mapJSl = mapJ.asMutSlice()
  let mapISl = mapI.asMutSlice()

  let mut ci = n - 1
  let mut cj = m - 1
  let mut guard: usize = n + m + 4
  while guard > 0 {
    mapJSl[ci] = cj
    mapISl[cj] = ci
    if ci == 0 && cj == 0 {
      break
    }
    let dir = bkSl[ci * m + cj]
    if dir == 1 && ci > 0 && cj > 0 {
      ci = ci - 1
      cj = cj - 1
    } else if dir == 2 && ci > 0 {
      ci = ci - 1
    } else if dir == 3 && cj > 0 {
      cj = cj - 1
    } else {
      if ci > 0 { ci = ci - 1 }
      if cj > 0 { cj = cj - 1 }
    }
    guard = guard - 1
  }

  // 1. Reference projected onto Take's timestamps + store matched frame pairs + per-frame divergence
  i = 0
  while i < n {
    let tIdx = aSl[i].origIdx
    let rIdx = bSl[mapJSl[i]].origIdx
    let tf = takeFrames[tIdx]
    let rf = refFs[rIdx]
    let fd = computeFrameDiv(tf, rf, weights)
    run pairs.append(DtwPair { takeIdx: tIdx, refIdx: rIdx })
    run refOnTake.append(AlignedRefPoint {
      time: tf.time,
      refTime: rf.time,
      voiced: rf.voiced,
      f0: rf.f0,
      sizeNorm: rf.sizeNorm,
      weightLightNorm: rf.weightLightNorm,
      hnrDb: rf.hnrDb,
      f1: rf.f1,
      f2: rf.f2,
      f3: rf.f3,
      f4: rf.f4,
      hasFormants: rf.hasFormants,
      bothVoiced: fd.bothVoiced,
      divOverall: fd.overall,
      divPitch: fd.pitch,
      divSize: fd.size,
      divWeight: fd.weight,
      divVowel: fd.vowel,
    })
    i = i + 1
  }

  // 2. YOUR Take projected directly onto Reference's timestamps!
  let mut j: usize = 0
  while j < m {
    let rf = refFs[bSl[j].origIdx]
    let tf = takeFrames[aSl[mapISl[j]].origIdx]
    let fd = computeFrameDiv(tf, rf, weights)
    run takeOnRef.append(AlignedRefPoint {
      time: rf.time,
      refTime: tf.time,
      voiced: tf.voiced,
      f0: tf.f0,
      sizeNorm: tf.sizeNorm,
      weightLightNorm: tf.weightLightNorm,
      hnrDb: tf.hnrDb,
      f1: tf.f1,
      f2: tf.f2,
      f3: tf.f3,
      f4: tf.f4,
      hasFormants: tf.hasFormants,
      bothVoiced: fd.bothVoiced,
      divOverall: fd.overall,
      divPitch: fd.pitch,
      divSize: fd.size,
      divWeight: fd.weight,
      divVowel: fd.vowel,
    })
    j = j + 1
  }

  run smoothDivergence(refOnTake.asMutSlice())
  run smoothDivergence(takeOnRef.asMutSlice())

  let score = run computeMatchScore(
    takeSummary,
    takeLtas,
    hasTakeLtas,
    refClip,
    takeFrames,
    refFs,
    aSl,
    bSl,
    mapJ.asSlice(),
    weights,
  )

  return CompareAlignment {
    valid: true,
    points: move refOnTake,
    takeOnRef: move takeOnRef,
    pairs: move pairs,
    deltaSemi: deltaSemi,
    deltaVtlCm: deltaVtlCm,
    deltaH1H2Db: deltaH1H2Db,
    deltaHnrDb: deltaHnrDb,
    deltaCppsDb: deltaCppsDb,
    deltaTwangDb: deltaTwangDb,
    deltaStrainPct: deltaStrainPct,
    deltaPitchSpanSt: deltaPitchSpanSt,
    deltaVowelF2: deltaVowelF2,
    score: score,
  }
}

pub effect fn summarizeVoiceRange(
  frames: &[VoiceFrame],
  tStart: f64,
  tEnd: f64,
  outVoicedTimes: &mut List<f64>,
) -> VoiceSummary
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut f0s = List<f64>.make()
  let mut f0Seq = List<f64>.make()
  let mut vtls = List<f64>.make()
  let mut sizes = List<f64>.make()
  let mut h1h2s = List<f64>.make()
  let mut lights = List<f64>.make()
  let mut hnrs = List<f64>.make()
  let mut cppsList = List<f64>.make()
  let mut twangDbs = List<f64>.make()
  let mut twangNorms = List<f64>.make()
  let mut strains = List<f64>.make()
  let mut f1Sum: f64 = 0.0
  let mut f2Sum: f64 = 0.0
  let mut fmtCnt: usize = 0
  let mut firstT: f64 = -1.0
  let mut lastT: f64 = 0.0

  let mut i: usize = 0
  while i < frames.length {
    let fr = frames[i]
    if fr.voiced && fr.time >= tStart && fr.time <= tEnd {
      if firstT < 0.0 { firstT = fr.time }
      lastT = fr.time
      run f0s.append(fr.f0)
      run f0Seq.append(fr.f0)
      run h1h2s.append(fr.h1h2Db)
      run lights.append(fr.weightLightNorm)
      run hnrs.append(fr.hnrDb)
      run cppsList.append(fr.cppsDb)
      run twangDbs.append(fr.twangDb)
      run twangNorms.append(fr.twangNorm)
      run strains.append(fr.strainNorm)
      run outVoicedTimes.append(fr.time)
      if fr.vtlCm > 1.0 {
        run vtls.append(fr.vtlCm)
        run sizes.append(fr.sizeNorm)
      }
      if fr.hasFormants {
        f1Sum = f1Sum + fr.f1
        f2Sum = f2Sum + fr.f2
        fmtCnt = fmtCnt + 1
      }
    }
    i = i + 1
  }
  if f0s.length() == 0 {
    return VoiceSummary.empty()
  }
  let medF0 = medianSortF64(f0s.asMutSlice())
  let expr = computeExpressiveness(f0s.asSlice(), f0Seq.asSlice(), outVoicedTimes.asSlice())
  return VoiceSummary {
    voicedFrames: f0s.length(),
    medianF0: medF0,
    medianVtlCm: if vtls.length() > 0 { medianSortF64(vtls.asMutSlice()) } else { 0.0 },
    medianSizeNorm: if sizes.length() > 0 { medianSortF64(sizes.asMutSlice()) } else { 0.5 },
    medianH1H2Db: medianSortF64(h1h2s.asMutSlice()),
    medianWeightLight: medianSortF64(lights.asMutSlice()),
    medianHnrDb: medianSortF64(hnrs.asMutSlice()),
    medianCppsDb: medianSortF64(cppsList.asMutSlice()),
    medianTwangDb: medianSortF64(twangDbs.asMutSlice()),
    medianTwangNorm: medianSortF64(twangNorms.asMutSlice()),
    medianStrainNorm: medianSortF64(strains.asMutSlice()),
    pitchSpanSt: expr.pitchSpanSt,
    expressNorm: expr.expressNorm,
    meanF1: if fmtCnt > 0 { f1Sum / usize.toF64(fmtCnt) } else { 0.0 },
    meanF2: if fmtCnt > 0 { f2Sum / usize.toF64(fmtCnt) } else { 0.0 },
    formantCount: fmtCnt,
    activeStartSec: if firstT >= 0.0 { firstT } else { tStart },
    activeEndSec: lastT,
  }
}

/// Computes a bisected Match Score for ONLY the user's selected time range `[selStart, selEnd]`
/// against the exact DTW-matched time slice `[refStart, refEnd]` of the Reference clip!
pub effect fn computeSelectionCompare(
  takeSamples: &[f32],
  takeSampleRate: f64,
  takeFrames: &[VoiceFrame],
  refClip: &ReferenceClip,
  align: &CompareAlignment,
  selStart: f64,
  selEnd: f64,
  plotOnRef: bool,
  weights: MatchWeights,
) -> SelectionCompare
  ! OutOfMemoryError
  ? &mut Allocator {
  if !refClip.active || !align.valid || takeFrames.length == 0 || refClip.voiceFrames.length() == 0 {
    return SelectionCompare.empty()
  }
  let lo = f64.min(selStart, selEnd)
  let hi = f64.max(selStart, selEnd)
  if hi - lo < 0.03 {
    return SelectionCompare.empty()
  }

  let refFs = refClip.voiceFrames.asSlice()
  let pairSl = align.pairs.asSlice()
  let mut matched = List<DtwPair>.make()
  let mut tMin: f64 = 1.0e9
  let mut tMax: f64 = -1.0
  let mut rMin: f64 = 1.0e9
  let mut rMax: f64 = -1.0

  let mut i: usize = 0
  while i < pairSl.length {
    let p = pairSl[i]
    if p.takeIdx < takeFrames.length && p.refIdx < refFs.length {
      let tt = takeFrames[p.takeIdx].time
      let rt = refFs[p.refIdx].time
      let inside = if plotOnRef { rt >= lo && rt <= hi } else { tt >= lo && tt <= hi }
      if inside {
        run matched.append(p)
        if tt < tMin { tMin = tt }
        if tt > tMax { tMax = tt }
        if rt < rMin { rMin = rt }
        if rt > rMax { rMax = rt }
      }
    }
    i = i + 1
  }

  let takeStart = if plotOnRef { if tMax >= tMin { tMin } else { lo } } else { lo }
  let takeEnd = if plotOnRef { if tMax >= tMin { tMax } else { hi } } else { hi }
  let refStart = if plotOnRef { lo } else { if rMax >= rMin { rMin } else { lo } }
  let refEnd = if plotOnRef { hi } else { if rMax >= rMin { rMax } else { hi } }

  // Pad bisected boundaries by half a hop (~15 ms) so edge voiced frames are included cleanly
  let mut takeVTimes = List<f64>.make()
  let mut refVTimes = List<f64>.make()
  let takeSum = run summarizeVoiceRange(takeFrames, takeStart - 0.015, takeEnd + 0.015, &mut takeVTimes)
  let refSum = run summarizeVoiceRange(refFs, refStart - 0.015, refEnd + 0.015, &mut refVTimes)
  if takeSum.voicedFrames < 2 || refSum.voicedFrames < 2 {
    return SelectionCompare.empty()
  }

  let deltaSemi = if takeSum.medianF0 > 1.0 && refSum.medianF0 > 1.0 {
    12.0 * f64.log2(takeSum.medianF0 / refSum.medianF0)
  } else {
    0.0
  }
  let deltaVtlCm = if takeSum.medianVtlCm > 1.0 && refSum.medianVtlCm > 1.0 {
    takeSum.medianVtlCm - refSum.medianVtlCm
  } else {
    0.0
  }
  let deltaH1H2Db = takeSum.medianH1H2Db - refSum.medianH1H2Db
  let deltaHnrDb = takeSum.medianHnrDb - refSum.medianHnrDb
  let deltaCppsDb = takeSum.medianCppsDb - refSum.medianCppsDb
  let deltaTwangDb = takeSum.medianTwangDb - refSum.medianTwangDb
  let deltaStrainPct = (takeSum.medianStrainNorm - refSum.medianStrainNorm) * 100.0
  let deltaPitchSpanSt = takeSum.pitchSpanSt - refSum.pitchSpanSt
  let deltaVowelF2 = if takeSum.formantCount > 0 && refSum.formantCount > 0 && takeSum.meanF2 > 100.0 && refSum.meanF2 > 100.0 {
    f64.log2(takeSum.meanF2 / refSum.meanF2)
  } else {
    0.0
  }

  let mut pitchAbsErrs = List<f64>.make()
  let mut pitchClippedSq: f64 = 0.0
  let mut sizeAbsErrs = List<f64>.make()
  let mut sizeClippedSq: f64 = 0.0
  let mut weightErrSq: f64 = 0.0
  let mut weightCnt: usize = 0

  let mSl = matched.asSlice()
  i = 0
  while i < mSl.length {
    let tf = takeFrames[mSl[i].takeIdx]
    let rf = refFs[mSl[i].refIdx]
    if tf.voiced && rf.voiced {
      let absSemi = f64.abs(12.0 * f64.log2(f64.max(40.0, tf.f0) / f64.max(40.0, rf.f0)))
      run pitchAbsErrs.append(absSemi)
      let cappedSemi = f64.min(9.0, absSemi)
      pitchClippedSq = pitchClippedSq + cappedSemi * cappedSemi

      if tf.vtlCm > 1.0 && rf.vtlCm > 1.0 {
        let absDs = f64.abs(tf.sizeNorm - rf.sizeNorm)
        run sizeAbsErrs.append(absDs)
        let cappedDs = f64.min(0.45, absDs)
        sizeClippedSq = sizeClippedSq + cappedDs * cappedDs
      }

      let dw = tf.weightLightNorm - rf.weightLightNorm
      weightErrSq = weightErrSq + dw * dw
      weightCnt = weightCnt + 1
    }
    i = i + 1
  }

  let absDeltaSemi = f64.abs(deltaSemi)
  let pitchMedianSim = f64.exp(-(absDeltaSemi / 5.0) * (absDeltaSemi / 5.0))
  let pitchContourErr = if pitchAbsErrs.length() > 0 {
    let clippedRmse = f64.sqrt(pitchClippedSq / usize.toF64(pitchAbsErrs.length()))
    let medAbs = medianSortF64(pitchAbsErrs.asMutSlice())
    0.55 * medAbs + 0.45 * clippedRmse
  } else {
    absDeltaSemi
  }
  let pitchContourSim = f64.exp(-(pitchContourErr / 4.5) * (pitchContourErr / 4.5))
  let pitchSim = 0.50 * pitchMedianSim + 0.50 * pitchContourSim

  let absDeltaVtl = if takeSum.medianVtlCm > 1.0 && refSum.medianVtlCm > 1.0 {
    f64.abs(deltaVtlCm)
  } else {
    3.0
  }
  let vtlSim = f64.exp(-(absDeltaVtl / 1.8) * (absDeltaVtl / 1.8))
  let sizeContourErr = if sizeAbsErrs.length() > 0 {
    let clippedRmse = f64.sqrt(sizeClippedSq / usize.toF64(sizeAbsErrs.length()))
    let medAbs = medianSortF64(sizeAbsErrs.asMutSlice())
    0.55 * medAbs + 0.45 * clippedRmse
  } else {
    0.35
  }
  let sizeCurveSim = f64.exp(-(sizeContourErr / 0.26) * (sizeContourErr / 0.26))
  let sizeSim = 0.55 * vtlSim + 0.45 * sizeCurveSim

  let absDeltaH1H2 = f64.abs(deltaH1H2Db)
  let h1h2Sim = f64.exp(-(absDeltaH1H2 / 6.5) * (absDeltaH1H2 / 6.5))
  let weightRmse = if weightCnt > 0 { f64.sqrt(weightErrSq / usize.toF64(weightCnt)) } else { 0.35 }
  let weightCurveSim = f64.exp(-(weightRmse / 0.30) * (weightRmse / 0.30))
  let hnrDrop = f64.max(0.0, refSum.medianHnrDb - takeSum.medianHnrDb - 3.0)
  let hnrGuard = f64.exp(-(hnrDrop / 10.0) * (hnrDrop / 10.0))
  let weightSim = (0.50 * h1h2Sim + 0.50 * weightCurveSim) * (0.80 + 0.20 * hnrGuard)

  let mut vowelCentroidSim: f64 = 0.70
  if takeSum.formantCount > 0 && refSum.formantCount > 0 && takeSum.meanF1 > 100.0 && refSum.meanF1 > 100.0 {
    let df1 = f64.log2(takeSum.meanF1 / refSum.meanF1)
    let df2 = f64.log2(takeSum.meanF2 / refSum.meanF2)
    let vDist = f64.sqrt(df1 * df1 + df2 * df2)
    vowelCentroidSim = f64.exp(-(vDist / 0.42) * (vDist / 0.42))
  }
  let mut takeLtasBuf: [f32; 64] = [0.0; 64]
  let mut refLtasBuf: [f32; 64] = [0.0; 64]
  let hasTakeSelLtas = audio_native.computeLtasNative(
    takeSamples,
    takeSampleRate,
    takeVTimes.asSlice(),
    &mut takeLtasBuf,
    LTAS_FMIN,
    LTAS_FMAX,
  )
  let hasRefSelLtas = audio_native.computeLtasNative(
    refClip.samples.asSlice(),
    refClip.sampleRate,
    refVTimes.asSlice(),
    &mut refLtasBuf,
    LTAS_FMIN,
    LTAS_FMAX,
  )
  let mut ltasSim: f64 = vowelCentroidSim
  if hasTakeSelLtas && hasRefSelLtas {
    let mut errSq: f64 = 0.0
    let mut cnt: usize = 0
    let mut b: usize = 12
    while b < 58 && b < LTAS_BINS {
      let d = f32.toF64(takeLtasBuf[b] - refLtasBuf[b])
      errSq = errSq + d * d
      cnt = cnt + 1
      b = b + 1
    }
    if cnt > 0 {
      let rmse = f64.sqrt(errSq / usize.toF64(cnt))
      ltasSim = f64.exp(-(rmse / 9.0) * (rmse / 9.0))
    }
  }
  let vowelSim = 0.55 * vowelCentroidSim + 0.45 * ltasSim

  let wSum = weights.pitch + weights.size + weights.weight + weights.vowel
  let overallSim = if wSum > 0.001 {
    (weights.pitch * pitchSim + weights.size * sizeSim + weights.weight * weightSim + weights.vowel * vowelSim) / wSum
  } else {
    0.25 * (pitchSim + sizeSim + weightSim + vowelSim)
  }

  return SelectionCompare {
    valid: true,
    takeStart: takeStart,
    takeEnd: takeEnd,
    refStart: refStart,
    refEnd: refEnd,
    deltaSemi: deltaSemi,
    deltaVtlCm: deltaVtlCm,
    deltaH1H2Db: deltaH1H2Db,
    deltaHnrDb: deltaHnrDb,
    deltaCppsDb: deltaCppsDb,
    deltaTwangDb: deltaTwangDb,
    deltaStrainPct: deltaStrainPct,
    deltaPitchSpanSt: deltaPitchSpanSt,
    deltaVowelF2: deltaVowelF2,
    takeSummary: takeSum,
    refSummary: refSum,
    takeLtas: takeLtasBuf,
    hasTakeLtas: hasTakeSelLtas,
    refLtas: refLtasBuf,
    hasRefLtas: hasRefSelLtas,
    score: MatchScore {
      valid: true,
      overall: clampScore(overallSim),
      pitchScore: clampScore(pitchSim),
      sizeScore: clampScore(sizeSim),
      weightScore: clampScore(weightSim),
      vowelScore: clampScore(vowelSim),
    },
  }
}
