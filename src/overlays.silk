//! Vector canvas drawings & formatting helpers for Overtone's VoceVista-style workspace:
//!   - Spectrogram overlays (note grid, frequency guides, Boersma F0 pitch + harmonics,
//!     Praat Burg F1-F4 formant tracks, selection band, playhead & scrub cursor, crosshair)
//!   - Vertical piano keyboard aligned 1:1 with the spectrogram's frequency scale
//!   - Power spectrum slice + smooth LPC vocal-tract envelope + F1-F4 / F0 markers
//!   - 2D Vowel Space (F1 vs F2 phonetic trapezoid with IPA landmarks & live voice position)
//!   - Waveform overview strip with visible viewport window & playhead
import compare { AlignedRefPoint }
import dsp { ColumnData }
import formants {
  DEFAULT_LPC_ORDER,
  FormantFrame,
  VOWELS_FEM,
  VOWELS_MASC,
  VOWEL_MODE_BOTH,
  VOWEL_MODE_FEM,
  VOWEL_MODE_MASC,
  lpcEnvelopeDb
}
import pitch { MAX_CONNECTED_SEMITONES, PitchFrame, frequencyToNote, midiToFrequency, noteClassName, semitonesBetween }
import viewport { Viewport }
import voice_metrics { LTAS_BINS, VoiceFrame, VoiceSummary }
import loom.drawing { Drawing }
import loom.lib { CanvasCommand }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
