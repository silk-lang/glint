      inputLevelDb: -120.0,
      statusMsg: run String.copy("Ready · R: record · ⌘N: new · Right-click spectrogram for menu · ⌘,: settings"),
      errorMsg: String.make(),

      vp: vp,
      brightness: 0.0,
      contrast: 1.0,
      displayFloorDb: DEFAULT_DISPLAY_FLOOR_DB,
      displayCeilingDb: DEFAULT_DISPLAY_CEILING_DB,
      palette: Palette.Muted,
