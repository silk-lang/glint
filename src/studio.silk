  ToggleScale,
  CyclePalette,
  ResetView,
  TogglePitch,
  ToggleHarmonics,
  ToggleFormants,
  ToggleMetricsLane,
  ToggleRefOverlay,
  TogglePlotOnRef,
  ToggleDtwAlign,
  ToggleNoteGrid,
  ToggleLibrary,
  ToggleReadouts,
  ResizeSidebarDown { pub isRight: bool, pub x: f32 },
  SetSpectrumTab { pub ltas: bool },
  PinReference,
  ClearReference,
  PlayReferenceOnce,
  PlayRefSelection,
  ToggleRefWave,
  SaveCurrentClip,
  SaveSelectionAsClip,
  ToggleDrillMode,
  ToggleEchoMode,
  StopPractice,
  // IDE-style Explorer Tree (real folders & audio files at ~/Documents/Overtone Library/)
  ToggleLibFolder { pub idx: usize },
  SelectRootFolder,
  RefreshLibDir,
  ToggleNewFolderInput,
  OpenNewFolderAtRoot,
  OpenNewFolderInEntry { pub idx: usize },
  NewFolderNameInput { pub text: String },
  CreateNewFolder,
  RevealDirInFinder,
  RevealEntryInFinder { pub idx: usize },
  DownloadLibClip { pub idx: usize },
  ShareLibClip { pub idx: usize },
  TogglePinchZoom,
  SetLibFilter { pub filter: u32 },
  SetLibSortMode { pub mode: i32 },
  RescoreVisibleClips,
  OpenLibClip { pub idx: usize },
  SetLibClipAsRef { pub idx: usize },
  ToggleStarLibClip { pub idx: usize },
  SetRatingLibClip { pub idx: usize, pub rating: i32 },
  StartRenameEntry { pub idx: usize },
  RenameEntryInput { pub text: String },
  CommitRenameEntry,
  CancelRenameEntry,
  EditCommentInput { pub text: String },
  DeleteLibEntry { pub idx: usize },
  MoveEntryToRoot { pub idx: usize },
  OpenExplorerCtx { pub kind: u32, pub idx: usize, pub x: f32, pub y: f32 },
  ExplorerPanelLayout { pub rect: Rect<f32> },
  ExplorerTreeLayout { pub rect: Rect<f32> },
  ExplorerWheel { pub dy: f32 },
  ExplorerScrollTrackDown { pub y: f32 },
  ExplorerScrollMove { pub y: f32 },
  ExplorerScrollUp,
  ExplorerRowLayout { pub idx: usize, pub rect: Rect<f32> },
  ExplorerRowDown { pub idx: usize, pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32 },
  ExplorerEmptyDown { pub x: f32, pub y: f32, pub button: u32 },
  ExplorerPointerMove { pub x: f32, pub y: f32 },
  ExplorerPointerUp,
  // Reference-grouped library, multi-selection, safe ref recording, split view, mix, norm, trim & favorites
  ToggleRefGroupExpand { pub idx: usize },
  ToggleLibSelectMode,
  EnterSelectModeWithClip { pub idx: usize },
  ToggleSelectLibClip { pub idx: usize },
  SelectAllLibClips,
  ClearLibSelection,
  DeleteSelectedLibClips,
  UnmarkLibClipAsRef { pub idx: usize },
  UnmarkCurrentRef,
  DetachLibClipFromRef { pub idx: usize },
  CreateEmptyRef,
  SelectGeneralMode,
  RecordOntoRef,
  ToggleSplitRefSpec,
  SetListenMode { pub mode: u32 },
  ToggleNormToRef,
  BakeNormToRef,
  TrimSilence,
  ToggleFavInput { pub id: u32 },
  ToggleFavOutput { pub id: u32 },
  ClearGuides,
  AddGuideAtHover,
  ToggleGuidesPanel,
  GuideInputChanged { pub text: String },
  AddGuideFromInput,
  AddGuideHz { pub hz: f64 },
  AddGuideAtCursor,
  AddGuideAtRefMean,
  RemoveGuide { pub idx: usize },
  // Audio I/O Device Picker
  ToggleAudioPanel,
  RefreshAudioDevices,
  SelectInputDevice { pub id: u32 },
  SelectOutputDevice { pub id: u32 },
  // Editing tools (Copy / Cut / Paste / Delete / Undo)
  CopySelection,
  CutSelection,
  DeleteSelection,
  PasteAtCursor,
  UndoEdit,
  // Exercise Script / Notes scratchpad
  ToggleNotesPanel,
  EditSessionNotes { pub text: String },
  InsertNotesPreset { pub preset: u32 },
  // Spectrogram Visibility / Dimming
  ToggleSpectrogram,
  SetSpecOpacityPreset { pub opacity: f32 },
  // Praat-style F5 Query Pitch
  QuerySelectionPitch,
  // New document (VoceVista style — Rec appends to current document!)
  NewDocument,
  // Select All (Cmd/Ctrl+A)
  SelectAll,
  // Global keyboard handler forwarded from host.silk
  GlobalKeyDown { pub key: String, pub modifiers: u32 },
  TextFocusChanged { pub focused: bool },
  // Context & Dropdown Menus
  OpenContextMenu { pub kind: u32, pub x: f32, pub y: f32 },
  CloseContextMenu,
  PlayFromTime { pub sec: f64 },
  PasteAtTime { pub sec: f64 },
  // Direct Palette selection
  SelectPalette { pub idx: u32 },
  // Playback speed & scrubbing
  SetPlaySpeed { pub speed: f32 },
  ToggleScrubAudio,
  ToggleFollowRecording,
  SetRecGapSec { pub sec: f64 },
  // Draggable Guides & Snapping
  StartGuideDrag { pub idx: usize, pub y: f32 },
  ToggleGuideSnap,
  // Time Ruler Move & Stretch
  TimeRulerDown { pub x: f32, pub y: f32 },
  TimeRulerMove { pub x: f32, pub y: f32 },
  TimeRulerUp,
  // Frequency presets & Pitch Range presets
  SetFreqRangePreset { pub f0: f64, pub f1: f64 },
  SetPitchRangePreset { pub floorHz: f64, pub ceilHz: f64 },
  // Comparison Weight presets
  SetMatchWeightsPreset { pub pitch: f64, pub size: f64, pub weight: f64, pub vowel: f64 },
  // Divergence heatmap, formant band filter, and bottom contour lane tab
  ToggleHeatmap,
  SetHeatmapMetric { pub metric: u32 },
  ToggleFormantBit { pub bit: u32 },
  SetFormantMask { pub mask: u32 },
  SetBottomLaneTab { pub tab: u32 },
  ToggleNeural,
  NeuralReady { pub jobId: i32, pub isRef: bool, pub hasPitch: bool, pub hasFormants: bool },
  NeuralStatus { pub flags: i32 },
  // Vowel / consonant isolation, TD-PSOLA stretch, Voice Lab & Klatt vowel synth
  SetIsolateMode { pub mode: u32 },
  SetIsolateTiming { pub timing: u32 },
  SetVoiceLabMode { pub mode: u32 },
  SetNeuralPhonemes { pub enabled: bool },
  ToggleNeuralPhonemes,
  ToggleVowelOverlay,
  PhonemesReady { pub jobId: i32, pub isRef: bool },
  SelectVowelSpan { pub idx: usize },
  StepVowelSpan { pub delta: i32 },
  PlayKlattAtCursor,
  PlayKlattAtRef,
  PlayKlattAtSelection,
  ClickVowelChart { pub x: f32, pub y: f32 },
  VowelChartLayout { pub rect: Rect<f32> },
  // Hear in your voice (source-filter preview resynthesis)
  ToggleVoicePreview,
  PlaySynthAdjusted,
  PlayOriginalPreview,
  StopSynthPreview,
  PinSynthAsRef,
  ToggleSynthPitch,
  ToggleSynthSize,
  ToggleSynthWeight,
  ToggleSynthContour,
  SynthMatchRef,
  SynthReset,
  SynthPreset { pub pitch: f64, pub size: f64, pub weight: f64 },
  SetSynthMorph { pub morph: f32 },
  // Continuous Vocal-Tract Resonance continuum (0.0 = Dark/large -> 0.5 = Balanced -> 1.0 = Bright/small)
  SetVowelResonance { pub value: f32 },
  ApplyVowelGuides { pub idx: usize },
  ToggleClickVowelGuides,
  ClearError,
  // VoceVista-style Settings / Preferences modal
  ToggleSettings,
  OpenSettingsTab { pub tab: u32 },
  CloseSettings,
  SetFormantCeilingPreset { pub hz: f64 },
  SpecLayout { pub rect: Rect<f32> },
  OverviewLayout { pub rect: Rect<f32> },
  SliceLayout { pub rect: Rect<f32> },
  SpecDown { pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32 },
  SpecMove { pub x: f32, pub y: f32, pub modifiers: u32 },
  SpecUp { pub x: f32, pub y: f32 },
  SpecLeave,
  SpecWheel { pub x: f32, pub y: f32, pub dx: f32, pub dy: f32, pub modifiers: u32 },
  OverviewDown { pub x: f32 },
  OverviewMove { pub x: f32 },
  OverviewUp,
  SliderDown { pub id: u32, pub x: f32, pub left: f32, pub width: f32 },
  SliderMove { pub x: f32 },
  SliderUp,
  SliderLayout { pub id: u32, pub rect: Rect<f32> },
  ClearSelection,
  PanStep { pub dir: f64 },
  ZoomStep { pub factor: f64 },
}

pub struct Overtone {
  // Audio transport & practice state machine (stdlib silk.machine single source of truth)
  pub transport: TransportSnapshot,

  // Audio clip state (Your current take or loaded clip)
  pub clipName: String,
  pub samples: List<f32>,
  pub sampleRate: f64,
  pub recording: bool,
  pub playing: bool,
  pub playingRefOnly: bool,
  pub loopSelection: bool,
  pub followRecording: bool,
  pub cursorSec: f64,
  pub hasSelection: bool,
  pub selStart: f64,
  pub selEnd: f64,
  pub volume: f32,
  pub playSpeed: f32,
  pub scrubAudio: bool,
  pub lastScrubTime: f64,
  pub isDemoClip: bool,
  pub recSilenceGapSec: f64,
  pub inputLevelDb: f32,
  pub statusMsg: String,
  pub errorMsg: String,

  // Viewport & display settings
  pub vp: Viewport,
  pub brightness: f32,
  pub contrast: f32,
  pub displayFloorDb: f32,
  pub displayCeilingDb: f32,
  pub palette: Palette,
  pub showSpectrogram: bool,
  pub specOpacity: f32,

  // Audio I/O device picker + persisted favorites
  pub showAudioPanel: bool,
  pub inputDevices: List<AudioDeviceInfo>,
  pub outputDevices: List<AudioDeviceInfo>,
  pub selectedInputId: u32,
  pub selectedOutputId: u32,
  pub favInputName: String,
  pub favOutputName: String,

  // Editing clipboard & undo snapshot
  pub clipboardSamples: List<f32>,
  pub clipboardRate: f64,
  pub undoSamples: List<f32>,
  pub undoRate: f64,
  pub undoCursor: f64,
  pub hasUndo: bool,

  // Exercise notes / script scratchpad (persisted per session)
  pub showNotesPanel: bool,
  pub sessionNotes: String,

  // Overlays & analysis settings
  pub showPitch: bool,
  pub showHarmonics: bool,
  pub showFormants: bool,
  pub showMetricsLane: bool,
  pub showRefOverlay: bool,
  pub showRefWave: bool,
  /// When true (and Ref is active), the WebGPU spectrogram shows the Reference and plots YOUR
  /// DTW-aligned pitch, formants, size, and weight directly on top of it!
  pub plotOnRef: bool,
  /// Vertical split spectrogram: Reference on top, Your take on bottom!
  pub splitRefSpec: bool,
  /// Listening mix when Ref is active: 0=You, 1=Ref, 2=Both simultaneously
  pub listenMode: u32,
  /// Auto-normalize your take's loudness (spectrogram dB + playback gain) to match the Reference!
  pub normToRef: bool,
  pub normRefGainDb: f32,
  pub readoutNormGain: String,
  pub refOverlayDrawing: Drawing,
  pub refPianoDrawing: Drawing,
  pub refFreqTicks: List<AxisTick>,
  pub recordOntoRefOnce: bool,
  pub useDtwAlign: bool,
  pub showNoteGrid: bool,
  pub showLtasTab: bool,
  pub showLibrary: bool,
  pub showReadouts: bool,
  pub libWidth: f32,
  pub readoutsWidth: f32,
  pub resizeStartWidth: f32,
  pub showGuidesPanel: bool,
  pub guideInputDraft: String,
  pub pitchConfig: PitchConfig,
  pub displayClarity: f64,
  pub formantCeilingHz: f64,
  pub guides: List<f64>,
  pub guideLabels: List<GuideBadge>,
  pub snapGuidesToNote: bool,
  pub vowelResonance: f32,
  pub clickVowelAddsGuides: bool,

  // Comparison score weights (normalized automatically)
  pub matchWeights: MatchWeights,

  // VoceVista-style Settings modal & Floating Context Menus
  pub showSettings: bool,
  pub settingsTab: u32,
  pub ctxMenuKind: u32,
  pub ctxMenuX: f32,
  pub ctxMenuY: f32,
  pub ctxMenuTimeSec: f64,
  pub ctxMenuFreqHz: f64,
  pub ctxMenuGuideIdx: i32,
  pub ctxMenuHeader: String,
  pub textInputFocused: bool,

  // Analysis data & caches
  pub coarseWin: WindowCache,
  pub sharpWin: WindowCache,
  pub coarseTracker: TierTracker,
  pub liveTracker: TierTracker,
  pub pitchTrack: PitchTrack,
  pub formantTrack: FormantTrack,
  pub voiceMetrics: VoiceMetricsTrack,
  pub sliceData: ColumnData,

  // Reference clip & bidirectional DTW comparison + Match Score + Selection Bisecting
  pub refClip: ReferenceClip,
  pub compare: CompareAlignment,
  pub selCompare: SelectionCompare,

  // Formant band selection (bit 0=F1, 1=F2, 2=F3, 3=F4), divergence heatmap, and bottom contour lane
  pub formantMask: u32,
  pub showHeatmap: bool,
  pub heatmapMetric: u32,
  pub bottomLaneTab: u32,

  // IDE-style Explorer Tree (~/Documents/Overtone Library/)
  pub expandedDirs: List<String>,
  pub selectedFolderRel: String,
