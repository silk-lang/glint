  pub activeItemRating: i32,
  pub activeItemStarred: bool,
  pub activeClipIsRef: bool,
  pub activeClipParentRef: String,
  pub pendingNewRef: bool,
  // Library multi-selection (Cmd/Ctrl+Click, Shift+Click, Select mode, bulk delete)
  pub libSelectMode: bool,
  pub selectedClipPaths: List<String>,
  pub lastSelectedLibIdx: i32,
  // Virtualized Explorer viewport & Drag-Drop state (real file & folder moving + attach to Ref)
  pub explorerPanelRect: Rect<f32>,
  pub explorerTreeRect: Rect<f32>,
