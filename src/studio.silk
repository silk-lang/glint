    audio_native.setVolume(model.volume)
    run model.syncDeviceNames()
    run model.restoreSessionPrefs()
    return move model
  }

  pub fn handlesGlobalKey(self: &Self, k: string, modifiers: u32) -> bool {
    let cmd = (modifiers & (MOD_META | MOD_CONTROL)) != 0
    if cmd {
      return k == "o" || k == "O" || k == "s" || k == "S" || k == "a" || k == "A"
        || k == "c" || k == "C" || k == "x" || k == "X" || k == "v" || k == "V"
        || k == "z" || k == "Z" || k == "n" || k == "N" || k == "r" || k == "R" || k == ","
    }
    if k == "Escape" || k == " " || k == "F2" || k == "F5" || k == "0"
      || k == "ArrowLeft" || k == "ArrowRight" || k == "=" || k == "+" || k == "-" {
      return true
    }
    if (k == "Backspace" || k == "Delete") && (self.hasSelection || self.selectedClipPaths.length() > 0) {
      return true
    }
    return k == "r" || k == "R" || k == "d" || k == "D" || k == "e" || k == "E"
      || k == "p" || k == "P" || k == "b" || k == "B" || k == "l" || k == "L"
      || k == "g" || k == "G" || k == "h" || k == "H" || k == "n" || k == "N"
  }

  pub fn isSplitRefSpec(self: &Self) -> bool {
    return self.splitRefSpec && self.refClip.active && !self.plotOnRef
  }

  pub fn isEditingActiveRef(self: &Self) -> bool {
    return self.refClip.active
      && String.byteLength(String.view(&self.refClip.fullPath)) > 0
      && String.view(&self.activeClipPath) == String.view(&self.refClip.fullPath)
  }

  pub fn isViewingRefClip(self: &Self) -> bool {
    return self.activeClipIsRef || self.isEditingActiveRef()
  }

  fn clearActiveRefSilent(self: &mut Self) -> () {
    if self.refClip.active {
      self.refClip.clear()
      self.gpuNeedRefReload = true
    }
    self.plotOnRef = false
    self.listenMode = LISTEN_YOU
    self.bgScoreActive = false
    self.readoutBgScore.clear()
  }

  pub fn activeTakeGainDb(self: &Self) -> f32 {
    if self.normToRef && self.refClip.active && !self.isPlottingOnRef() && !self.isEditingActiveRef() {
      return self.normRefGainDb
    }
    return 0.0
  }

  fn yToFreqNorm(self: &Self, ly: f32, h: f32) -> f64 {
    let safeH = f32.max(1.0, h)
    if self.isSplitRefSpec() {
      let halfH = safeH * 0.497
      if ly <= halfH {
        return f64.max(0.0, f64.min(1.0, 1.0 - f32.toF64(ly / halfH)))
      }
      let botTop = safeH * 0.503
      let botY = f32.max(0.0, ly - botTop)
      return f64.max(0.0, f64.min(1.0, 1.0 - f32.toF64(botY / halfH)))
    }
    return f64.max(0.0, f64.min(1.0, 1.0 - f32.toF64(ly / safeH)))
  }

  fn computeSpeechRmsDb(samples: &[f32], sampleRate: f64) -> f64 {
    if samples.length < 64 || sampleRate <= 0.0 {
      return -60.0
    }
    let frameLen = f64.toUsize(f64.max(64.0, sampleRate * 0.02))
    let mut peakSq: f64 = 0.0
    let mut pos: usize = 0
    while pos + frameLen <= samples.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < frameLen {
        let v = f32.toF64(samples[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      let meanSq = sq / usize.toF64(frameLen)
      if meanSq > peakSq {
        peakSq = meanSq
      }
      pos = pos + frameLen
    }
    if peakSq <= 1e-10 {
      return -60.0
    }
    // Average active speech frames within 24 dB of peak (ignores leading/trailing silence!)
    let threshSq = f64.max(1e-5, peakSq * 0.004)
    let mut activeSum: f64 = 0.0
    let mut activeCount: usize = 0
    pos = 0
    while pos + frameLen <= samples.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < frameLen {
        let v = f32.toF64(samples[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      let meanSq = sq / usize.toF64(frameLen)
      if meanSq >= threshSq {
        activeSum = activeSum + meanSq
        activeCount = activeCount + 1
      }
      pos = pos + frameLen
    }
    let rmsSq = if activeCount > 0 { activeSum / usize.toF64(activeCount) } else { peakSq }
    return 4.342944819032518 * f64.log(f64.max(1e-12, rmsSq))
  }

  effect fn recomputeNormGain(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || self.refClip.samples.length() < 64 || self.samples.length() < 64 || self.isEditingActiveRef() {
      self.normRefGainDb = 0.0
      self.readoutNormGain.clear()
      audio_native.playSetGainDb(0.0)
      return ()
    }
    let refDb = Overtone.computeSpeechRmsDb(self.refClip.samples.asSlice(), self.refClip.sampleRate)
    let takeDb = Overtone.computeSpeechRmsDb(self.samples.asSlice(), self.sampleRate)
    let diff = f64.max(-24.0, f64.min(36.0, refDb - takeDb))
    self.normRefGainDb = f64.toF32(diff)
    let mut s = String.make()
    if diff >= 0.0 {
      run s.append("+")
    }
    run appendFixed(&mut s, diff, 1)
    run s.append(" dB")
    self.readoutNormGain = move s
    audio_native.playSetGainDb(self.activeTakeGainDb())
  }

  effect fn saveSessionPrefs(self: &Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    audio_native.prefSet("last_clip", String.view(&self.activeClipPath))
    audio_native.prefSet("last_ref", if self.refClip.active { String.view(&self.refClip.fullPath) } else { "" })
    let exp = run self.expandedDirsString()
    audio_native.prefSet("expanded_dirs", String.view(&exp))
    audio_native.prefSet("split_ref", if self.splitRefSpec { "1" } else { "0" })
    audio_native.prefSet("listen_mode", if self.listenMode == LISTEN_REF { "1" } else if self.listenMode == LISTEN_BOTH { "2" } else { "0" })
    audio_native.prefSet("norm_ref", if self.normToRef { "1" } else { "0" })
    audio_native.prefSet("show_pitch", if self.showPitch { "1" } else { "0" })
    audio_native.prefSet("show_formants", if self.showFormants { "1" } else { "0" })
    audio_native.prefSet("show_harmonics", if self.showHarmonics { "1" } else { "0" })
    audio_native.prefSet("show_metrics", if self.showMetricsLane { "1" } else { "0" })
    audio_native.prefSet("show_grid", if self.showNoteGrid { "1" } else { "0" })
    audio_native.prefSet("show_lib", if self.showLibrary { "1" } else { "0" })
    audio_native.prefSet("show_readouts", if self.showReadouts { "1" } else { "0" })
    let mut palStr = String.make()
    run appendInt(&mut palStr, u32.toI32(paletteIndex(self.palette)))
    audio_native.prefSet("palette", String.view(&palStr))
    audio_native.prefSet("fav_input", String.view(&self.favInputName))
    audio_native.prefSet("fav_output", String.view(&self.favOutputName))
    let mut vrStr = String.make()
    run appendInt(&mut vrStr, f32.toI32(f32.round(self.vowelResonance * 100.0)))
    audio_native.prefSet("vowel_res", String.view(&vrStr))
  }

  effect fn applyFavoriteAudioDevices(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let favIn = String.view(&self.favInputName)
    if String.byteLength(favIn) > 0 {
      let ins = self.inputDevices.asSlice()
      let mut i: usize = 0
      while i < ins.length {
        if String.view(&ins[i].name) == favIn {
          if self.selectedInputId != ins[i].id {
            drop audio_native.setInputDevice(ins[i].id)
            self.selectedInputId = ins[i].id
          }
          break
        }
        i = i + 1
      }
    }
    let favOut = String.view(&self.favOutputName)
    if String.byteLength(favOut) > 0 {
      let outs = self.outputDevices.asSlice()
      let mut i: usize = 0
      while i < outs.length {
        if String.view(&outs[i].name) == favOut {
          if self.selectedOutputId != outs[i].id {
            drop audio_native.setOutputDevice(outs[i].id)
            self.selectedOutputId = outs[i].id
          }
          break
        }
        i = i + 1
      }
    }
    run self.syncDeviceNames()
  }

  effect fn restoreSessionPrefs(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.favInputName = run audio_native.prefGet("fav_input")
    self.favOutputName = run audio_native.prefGet("fav_output")
    run self.applyFavoriteAudioDevices()

    let sp = run audio_native.prefGet("split_ref")
    if String.view(&sp) == "1" { self.splitRefSpec = true }
    let lm = run audio_native.prefGet("listen_mode")
    if String.view(&lm) == "1" { self.listenMode = LISTEN_REF }
    else if String.view(&lm) == "2" { self.listenMode = LISTEN_BOTH }
    let nr = run audio_native.prefGet("norm_ref")
    if String.view(&nr) == "1" { self.normToRef = true }
    let vr = run audio_native.prefGet("vowel_res")
    let vrBytes = String.utf8Bytes(String.view(&vr))
    if vrBytes.length > 0 {
      let mut vrNum: i32 = 0
      let mut vi: usize = 0
      while vi < vrBytes.length {
        if vrBytes[vi] >= 48 && vrBytes[vi] <= 57 {
          vrNum = vrNum * 10 + u32.toI32(u8.toU32(vrBytes[vi] - 48))
        }
        vi = vi + 1
      }
      self.vowelResonance = f32.max(0.0, f32.min(1.0, i32.toF32(vrNum) * 0.01))
    }
    let spitch = run audio_native.prefGet("show_pitch")
    if String.view(&spitch) == "0" { self.showPitch = false }
    let sfmt = run audio_native.prefGet("show_formants")
    if String.view(&sfmt) == "0" { self.showFormants = false }
    let sharm = run audio_native.prefGet("show_harmonics")
    if String.view(&sharm) == "1" { self.showHarmonics = true }
    let smet = run audio_native.prefGet("show_metrics")
    if String.view(&smet) == "0" { self.showMetricsLane = false }
    let sgrid = run audio_native.prefGet("show_grid")
    if String.view(&sgrid) == "0" { self.showNoteGrid = false }
    let slib = run audio_native.prefGet("show_lib")
    if String.view(&slib) == "0" { self.showLibrary = false }
    let sread = run audio_native.prefGet("show_readouts")
    if String.view(&sread) == "0" { self.showReadouts = false }
    let pal = run audio_native.prefGet("palette")
    if String.byteLength(String.view(&pal)) > 0 {
      let pv = String.view(&pal)
      if pv == "0" { self.palette = Palette.Muted }
      else if pv == "1" { self.palette = Palette.VoceVista }
      else if pv == "2" { self.palette = Palette.Inferno }
      else if pv == "3" { self.palette = Palette.Magma }
      else if pv == "4" { self.palette = Palette.Viridis }
      else if pv == "5" { self.palette = Palette.Ocean }
      else if pv == "6" { self.palette = Palette.Grayscale }
      else if pv == "7" { self.palette = Palette.InvertGray }
      self.gpuNeedPalette = true
    }

    // Restore expanded folders & ref groups
    let expSaved = run audio_native.prefGet("expanded_dirs")
    let expBytes = String.utf8Bytes(String.view(&expSaved))
    if expBytes.length > 0 {
      self.expandedDirs.clear()
      let mut start: usize = 0
      let mut k: usize = 0
      while k <= expBytes.length {
        if k == expBytes.length || expBytes[k] == 10 {
          if k > start {
            let seg = run String.copy(String.slice(String.view(&expSaved), start, k - start))
            run self.expandedDirs.append(move seg)
          }
          start = k + 1
        }
        k = k + 1
      }
    }

    run self.reloadTree(false)

    // Restore last open clip (opening a child take automatically activates its parent Reference;
    // opening a Reference itself or a loose clip leaves no Reference active).
    let savedClip = run audio_native.prefGet("last_clip")
    let mut opened = false
    if String.byteLength(String.view(&savedClip)) > 0 {
      let clipIdx = self.findLibIdxByFullPath(String.view(&savedClip))
      if clipIdx < self.libTree.length() {
        run self.loadLibraryClip(clipIdx, false)
        opened = true
      }
    }
    if !opened {
      let mut firstClipIdx: usize = 0
      let mut hasFirstClip = false
      let treeNodes = self.libTree.asSlice()
      let mut ti: usize = 0
      while ti < treeNodes.length {
        if !treeNodes[ti].isDir {
          firstClipIdx = ti
          hasFirstClip = true
          break
        }
        ti = ti + 1
      }
      if hasFirstClip {
        run self.loadLibraryClip(firstClipIdx, false)
      } else {
        run self.analyzeAll()
        run self.rebuildDrawings(true)
      }
    }
  }

  fn findLibIdxByFullPath(self: &Self, fullPath: string) -> usize {
    let nodes = self.libTree.asSlice()
    let mut i: usize = 0
    while i < nodes.length {
      if !nodes[i].isDir && String.view(&nodes[i].fullPath) == fullPath {
        return i
      }
      i = i + 1
    }
    return nodes.length
  }

  pub fn isClipMultiSelected(self: &Self, fullPath: string) -> bool {
    let sl = self.selectedClipPaths.asSlice()
    let mut i: usize = 0
    while i < sl.length {
      if String.view(&sl[i]) == fullPath {
        return true
      }
      i = i + 1
    }
    return false
  }

  effect fn toggleMultiSelectPath(self: &mut Self, fullPath: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut kept = List<String>.make()
    let mut found = false
    let sl = self.selectedClipPaths.asSlice()
    let mut i: usize = 0
    while i < sl.length {
      if String.view(&sl[i]) == fullPath {
        found = true
      } else {
        run kept.append(run String.copy(String.view(&sl[i])))
      }
      i = i + 1
    }
    if !found {
      run kept.append(run String.copy(fullPath))
    }
    self.selectedClipPaths = move kept
  }

  effect fn selectLibRange(self: &mut Self, fromIdx: usize, toIdx: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let nodes = self.libTree.asSlice()
    if nodes.length == 0 {
      return ()
    }
    let lo = if fromIdx < toIdx { fromIdx } else { toIdx }
    let hi = if fromIdx > toIdx { fromIdx } else { toIdx }
    self.selectedClipPaths.clear()
    let mut i = lo
    while i <= hi && i < nodes.length {
      if !nodes[i].isDir {
        run self.selectedClipPaths.append(run String.copy(String.view(&nodes[i].fullPath)))
      }
      i = i + 1
    }
  }

  effect fn deleteSelectedLibClips(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.selectedClipPaths.length() == 0 {
      return ()
    }
    let mut deletedCount: i32 = 0
    let mut toDelParents = List<String>.make()
    let mut toDelNames = List<String>.make()
    let mut toDelFulls = List<String>.make()
    let nodes = self.libTree.asSlice()
    let mut i: usize = 0
    while i < nodes.length {
      if !nodes[i].isDir && self.isClipMultiSelected(String.view(&nodes[i].fullPath)) {
        run toDelParents.append(run String.copy(String.view(&nodes[i].parentRel)))
        run toDelNames.append(run String.copy(String.view(&nodes[i].name)))
        run toDelFulls.append(run String.copy(String.view(&nodes[i].fullPath)))
      }
      i = i + 1
    }
    let parents = toDelParents.asSlice()
    let names = toDelNames.asSlice()
    let fulls = toDelFulls.asSlice()
    i = 0
    while i < names.length {
      if audio_native.libDeleteEntry(String.view(&parents[i]), String.view(&names[i]), false) {
        deletedCount = deletedCount + 1
        if String.view(&self.activeClipPath) == String.view(&fulls[i]) {
          self.activeClipPath.clear()
          self.activeClipFilename.clear()
          self.activeClipDir.clear()
          self.activeClipInLib = false
        }
        if self.refClip.active && String.view(&self.refClip.fullPath) == String.view(&fulls[i]) {
          self.refClip.clear()
          self.gpuNeedRefReload = true
        }
      }
      i = i + 1
    }
    self.selectedClipPaths.clear()
    self.lastSelectedLibIdx = -1
    self.libSelectMode = false
    run self.reloadTree(false)
    run self.saveSessionPrefs()
    let mut msg = String.make()
    run msg.append("Deleted ")
    run appendInt(&mut msg, deletedCount)
    run msg.append(if deletedCount == 1 { " take" } else { " takes" })
    self.statusMsg = move msg
  }

  effect fn trimSilence(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.recording || self.practiceMode != PRACTICE_OFF || self.samples.length() < 128 || self.sampleRate <= 0.0 {
      return ()
    }
    let sr = self.sampleRate
    let src = self.samples.asSlice()
    let frameLen = f64.toUsize(f64.max(64.0, sr * 0.010))
    let mut peakSq: f64 = 0.0
    let mut pos: usize = 0
    while pos + frameLen <= src.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < frameLen {
        let v = f32.toF64(src[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      let msq = sq / usize.toF64(frameLen)
      if msq > peakSq { peakSq = msq }
      pos = pos + frameLen
    }
    if peakSq <= 1e-10 {
      self.statusMsg = run String.copy("Audio is completely silent — nothing to trim.")
      return ()
    }
    let peakDb = 4.342944819032518 * f64.log(peakSq)
    // Adaptive threshold: 34 dB below speech peak, clamped to [-50, -32] dB so soft plosives stay safe!
    let threshDb = f64.max(-50.0, f64.min(-32.0, peakDb - 34.0))
    let threshSq = f64.pow(10.0, threshDb / 10.0)

    let mut firstIdx: usize = src.length
    let mut lastIdx: usize = 0
    pos = 0
    while pos + frameLen <= src.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < frameLen {
        let v = f32.toF64(src[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      if (sq / usize.toF64(frameLen)) >= threshSq {
        if firstIdx == src.length {
          firstIdx = pos
        }
        lastIdx = pos + frameLen
      }
      pos = pos + frameLen
    }
    if firstIdx >= lastIdx {
      self.statusMsg = run String.copy("No silence found to trim.")
      return ()
    }
    let leadPad = f64.toUsize(sr * 0.045)
    let tailPad = f64.toUsize(sr * 0.060)
    let startIdx = if firstIdx > leadPad { firstIdx - leadPad } else { 0 }
    let endRaw = lastIdx + tailPad
    let endIdx = if endRaw < src.length { endRaw } else { src.length }
    let trimmedN = startIdx + (src.length - endIdx)
    if trimmedN < f64.toUsize(sr * 0.03) || endIdx <= startIdx + 128 {
      self.statusMsg = run String.copy("Already tight — less than 30 ms of edge silence.")
      return ()
    }
    run self.saveUndoSnapshot()
    let srcAfter = self.samples.asSlice()
    let mut next = List<f32>.make()
    let mut i = startIdx
    while i < endIdx && i < srcAfter.length {
      run next.append(srcAfter[i])
      i = i + 1
    }
    // Smooth 6 ms edge fade so trimmed ends never click
    let fadeN = f64.toUsize(f64.max(16.0, f64.min(320.0, sr * 0.006)))
    let out = next.asMutSlice()
    if out.length > fadeN * 2 {
      let mut k: usize = 0
      while k < fadeN {
        let g = usize.toF32(k) / usize.toF32(fadeN)
        out[k] = out[k] * g
        out[out.length - 1 - k] = out[out.length - 1 - k] * g
        k = k + 1
      }
    }
    let cutSec = usize.toF64(trimmedN) / sr
    self.samples = move next
    let mut msg = String.make()
    run msg.append("Trimmed ")
    let cs = run formatSecShort(cutSec)
    run msg.append(String.view(&cs))
    run msg.append(" silence (⌘Z to undo)")
    run self.finishAudioEdit(0.0, true, String.view(&msg))
  }

  effect fn bakeNormToRef(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.recording || self.practiceMode != PRACTICE_OFF || !self.refClip.active || self.samples.length() < 64 {
      return ()
    }
    run self.recomputeNormGain()
    let db = f32.toF64(self.normRefGainDb)
    if f64.abs(db) < 0.25 {
      self.statusMsg = run String.copy("Level already matches Reference within 0.2 dB.")
      return ()
    }
    run self.saveUndoSnapshot()
    let gain = f64.toF32(f64.pow(10.0, db / 20.0))
    let mut next = List<f32>.make()
    let src = self.samples.asSlice()
    let mut i: usize = 0
    while i < src.length {
      let x = src[i] * gain
      // Smooth soft-limiter above 0.88 so peaks never hard-clip
      let ax = f32.abs(x)
      let y = if ax <= 0.88 {
        x
      } else {
        let sign: f32 = if x < 0.0 { -1.0 } else { 1.0 }
        let over = (ax - 0.88) / 0.12
        sign * (0.88 + 0.11 * (over / (1.0 + over)))
      }
      run next.append(y)
      i = i + 1
    }
    self.samples = move next
    let mut msg = String.make()
    run msg.append("Normalized level to Ref (")
    if db >= 0.0 { run msg.append("+") }
    run appendFixed(&mut msg, db, 1)
    run msg.append(" dB · ⌘Z to undo)")
    let keepCur = self.cursorSec
    run self.finishAudioEdit(keepCur, false, String.view(&msg))
  }

  effect fn syncDeviceNames(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut mic = String.make()
    let ins = self.inputDevices.asSlice()
    let mut i: usize = 0
    while i < ins.length {
      if ins[i].id == self.selectedInputId || (self.selectedInputId == 0 && i == 0) {
        mic = run String.copy(String.view(&ins[i].name))
        break
      }
      i = i + 1
    }
    if String.byteLength(String.view(&mic)) == 0 {
      mic = if ins.length > 0 {
        run String.copy(String.view(&ins[0].name))
      } else {
        run String.copy("Default Mic")
      }
    }
    self.readoutActiveMic = move mic

    let mut out = String.make()
    let outs = self.outputDevices.asSlice()
    i = 0
    while i < outs.length {
      if outs[i].id == self.selectedOutputId || (self.selectedOutputId == 0 && i == 0) {
        out = run String.copy(String.view(&outs[i].name))
        break
      }
      i = i + 1
    }
    if String.byteLength(String.view(&out)) == 0 {
      out = if outs.length > 0 {
        run String.copy(String.view(&outs[0].name))
      } else {
        run String.copy("Default Output")
      }
    }
    self.readoutActiveOut = move out
  }

  effect fn updateWeightReadouts(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let w = self.matchWeights
    let sum = f64.max(0.001, w.pitch + w.size + w.weight + w.vowel)
    self.readoutWPitchPct = run formatScorePct(f64.toI32(f64.round((w.pitch / sum) * 100.0)))
    self.readoutWSizePct = run formatScorePct(f64.toI32(f64.round((w.size / sum) * 100.0)))
    self.readoutWWeightPct = run formatScorePct(f64.toI32(f64.round((w.weight / sum) * 100.0)))
    self.readoutWVowelPct = run formatScorePct(f64.toI32(f64.round((w.vowel / sum) * 100.0)))
  }

  effect fn updateSpeedReadout(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut s = String.make()
    run appendFixed(&mut s, f32.toF64(self.playSpeed), 2)
    run s.append("×")
    self.readoutSpeedStr = move s
  }

  effect fn updatePitchRangeReadout(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut s = String.make()
    run appendFixed(&mut s, self.pitchConfig.floorHz, 0)
    run s.append("–")
    run appendFixed(&mut s, self.pitchConfig.ceilingHz, 0)
    run s.append(" Hz")
    self.readoutPitchRangeStr = move s
  }

  fn findGuideNearY(self: &Self, ly: f32, tolPx: f32) -> i32 {
    let sh = self.specRect.height()
    if sh <= 4.0 {
      return -1
    }
    let gs = self.guides.asSlice()
    let mut bestIdx: i32 = -1
    let mut bestDist: f32 = tolPx + 1.0
    let mut i: usize = 0
    while i < gs.length {
      let hz = gs[i]
      if hz >= self.vp.f0 && hz <= self.vp.f1 {
        let gy = f64.toF32(1.0 - self.vp.freqToNormAt(hz)) * sh
        let d = f32.abs(ly - gy)
        if d <= tolPx && d < bestDist {
          bestDist = d
          bestIdx = usize.toI32(i)
        }
      }
      i = i + 1
    }
    return bestIdx
  }

  /// Syncs cached view/host mirror flags from the single-source-of-truth `silk.machine` transport state.
  fn syncTransportFlags(self: &mut Self) -> () {
    let s = self.transport.value
    self.recording = isRecording(s)
    self.playing = isPlaying(s)
    self.playingRefOnly = isPlayingRefOnly(s)
    self.practiceMode = if isDrill(s) {
      PRACTICE_DRILL
    } else if isEcho(s) {
      PRACTICE_ECHO
    } else {
      PRACTICE_OFF
    }
    self.practicePhase = match s {
      TransportState.DrillPlayRef => PHASE_PLAY_REF
      TransportState.DrillListen => PHASE_LISTEN_SPEECH
      TransportState.EchoListen => PHASE_LISTEN_SPEECH
      TransportState.DrillRecord => PHASE_REC_SPEECH
      TransportState.EchoRecord => PHASE_REC_SPEECH
      TransportState.EchoPlayback => PHASE_ECHO_PLAY
      TransportState.DrillCooldown => PHASE_COOLDOWN
      TransportState.EchoCooldown => PHASE_COOLDOWN
      _ => PHASE_IDLE
    }
  }

  /// Sends an event into the stdlib `silk.machine` transport statechart and runs all emitted effects.
  effect fn sendTransport(self: &mut Self, ev: TransportEvent) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let effects = run stepTransport(&mut self.transport, ev)
    self.syncTransportFlags()
    let effs = effects.asSlice()
    let mut i: usize = 0
    while i < effs.length {
      run self.runTransportEffect(effs[i])
      i = i + 1
    }
  }

  effect fn runTransportEffect(self: &mut Self, eff: TransportEffect) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match eff {
      TransportEffect.StartAudioPlayback => {
        run self.doStartPlayback()
      }
      TransportEffect.PauseAudioPlayback => {
        self.doPausePlayback()
      }
      TransportEffect.StopAudioOnly => {
        audio_native.playStop()
      }
      TransportEffect.StartRefPlayback => {
        run self.doStartRefPlayback()
      }
      TransportEffect.StartMicRecording => {
        run self.doStartRecording()
      }
      TransportEffect.StopAndSaveRecording => {
        run self.doStopRecording()
      }
      TransportEffect.StartScrubAudio => {
        let dur = self.gpuDuration()
        if self.scrubAudio && dur > 0.02 {
          let sr = self.gpuSampleRate()
          let cSec = self.cursorSec
          audio_native.scrubBegin(self.gpuSamples(), sr, cSec)
          self.lastScrubTime = self.nowTime
        }
      }
      TransportEffect.StopScrubAudio => {
        audio_native.scrubStop()
      }
      TransportEffect.StartDrillRefPlay => {
        self.lastTickTime = -1.0
        run self.doStartDrillRefPlayback()
      }
      TransportEffect.ArmPracticeMic => {
        self.lastTickTime = -1.0
        run self.doArmPracticeListening()
      }
      TransportEffect.BeginPracticeRec => {
        run self.beginLiveRecStream(true)
        self.silenceAccumSec = 0.0
        self.silenceProgress = 0.0
        self.practiceStatus = if isDrill(self.transport.value) {
          run String.copy("Recording repetition…")
        } else {
          run String.copy("Recording phrase…")
        }
        run self.rebuildDrawings(true)
      }
      TransportEffect.FinishPracticeRecOnly => {
        run self.doFinishPracticeTake()
        run self.rebuildDrawings(true)
      }
      TransportEffect.FinishPracticeRecAndEcho => {
        run self.doFinishPracticeTake()
        let dur = self.clipDuration()
        if dur > 0.05 && audio_native.playRange(self.samples.asSlice(), self.sampleRate, 0.0, dur, false) {
          self.practiceStatus = run String.copy("Echoing your take…")
          run self.rebuildDrawings(true)
        } else {
          run self.sendTransport(TransportEvent.PlaybackEnded)
        }
      }
      TransportEffect.StartPracticeCooldown => {
        if isDrill(self.transport.value) {
          self.phaseTimerSec = 0.65
          self.practiceStatus = run String.copy("Saved take · Next round…")
        } else {
          self.phaseTimerSec = 0.22
          self.practiceStatus = run String.copy("Re-arming mic…")
        }
        run self.rebuildDrawings(true)
      }
      TransportEffect.AbortPractice => {
        run self.doAbortPractice()
      }
    }
  }

  effect fn newDocument(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.sendTransport(TransportEvent.StopAll)
    self.ctxMenuKind = CTX_NONE
    self.isDemoClip = false
    self.plotOnRef = false
    self.activeClipPath.clear()
    self.activeClipFilename.clear()
    self.activeClipDir.clear()
    self.activeClipInLib = false
    self.renamingRel.clear()
    self.renameDraft.clear()
    self.clipName = run String.copy("Untitled Recording")
    self.samples.clear()
    self.sampleRate = 48000.0
    self.cursorSec = 0.0
    self.hasSelection = false
    self.readoutSelSpan.clear()
    self.selPitchStats = SelectionPitchStats.empty()
    self.readoutSelPitchChip.clear()
    self.readoutSelPitchMain.clear()
    self.readoutSelPitchSub.clear()
    self.hasUndo = false
    self.undoSamples.clear()
    self.vp.reset(RECORD_VIEW_S, self.sampleRate * 0.5)
    self.vp.setTimeRange(0.0, RECORD_VIEW_S)
    run self.pitchTrack.reset(self.sampleRate, self.pitchConfig)
    run self.formantTrack.reset(self.sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    self.voiceMetrics.reset()
    run self.recomputeCompare()
    run self.refreshActiveLibMeta()
    self.gpuNeedClear = true
    self.gpuNeedFullReload = false
    self.gpuNeedSharp = false
    self.gpuNeedRedraw = true
    self.errorMsg.clear()
    self.statusMsg = run String.copy("New empty document · Press R or ● Rec to start recording")
    run self.rebuildDrawings(true)
  }

  pub fn clipDuration(self: &Self) -> f64 {
    if self.sampleRate <= 0.0 {
      return 0.0
    }
    return usize.toF64(self.samples.length()) / self.sampleRate
  }

  /// Active audio buffer shown on the WebGPU spectrogram (switches between Take & Reference!).
  pub fn isPlottingOnRef(self: &Self) -> bool {
    return self.plotOnRef && self.refClip.active && !self.recording
  }

  pub fn gpuSamples<'a>(self: &'a Self) -> &'a [f32] {
    if self.isPlottingOnRef() {
      return self.refClip.samples.asSlice()
    }
    return self.samples.asSlice()
  }

  pub fn gpuSampleRate(self: &Self) -> f64 {
    if self.isPlottingOnRef() {
      return self.refClip.sampleRate
    }
    return self.sampleRate
  }

  pub fn gpuDuration(self: &Self) -> f64 {
    if self.isPlottingOnRef() {
      return self.refClip.durationSec
    }
    return self.clipDuration()
  }

  pub fn scheduleSharp(self: &mut Self) -> () {
    self.gpuNeedSharp = true
    self.sharpDueTime = 0.0
    self.gpuNeedRedraw = true
  }

  effect fn expandedDirsString(self: &Self) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = String.make()
    let dirs = self.expandedDirs.asSlice()
    let mut i: usize = 0
    while i < dirs.length {
      if i > 0 {
        run out.append("\n")
      }
      run out.append(String.view(&dirs[i]))
      i = i + 1
    }
    return move out
  }

  fn isDirExpanded(self: &Self, rel: string) -> bool {
    let dirs = self.expandedDirs.asSlice()
    let mut i: usize = 0
    while i < dirs.length {
      if String.view(&dirs[i]) == rel {
        return true
      }
      i = i + 1
    }
    return false
  }

  effect fn ensureDirExpanded(self: &mut Self, rel: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if String.byteLength(rel) == 0 || self.isDirExpanded(rel) {
      return ()
    }
    let copy = run String.copy(rel)
    run self.expandedDirs.append(move copy)
  }

  effect fn toggleDirExpanded(self: &mut Self, rel: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.expandedDirs.length() {
      if String.view(&self.expandedDirs.asSlice()[i]) == rel {
        drop self.expandedDirs.remove(i)
        return ()
      }
      i = i + 1
    }
    let copy = run String.copy(rel)
    run self.expandedDirs.append(move copy)
  }

  /// Replaces `oldPrefix` (or `oldPrefix/...`) with `newPrefix` (or `newPrefix/...`).
  effect fn replacePathPrefix(val: string, oldPrefix: string, newPrefix: string) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    if val == oldPrefix {
      return Option<String>.some(run String.copy(newPrefix))
    }
    let vb = String.utf8Bytes(val)
    let ob = String.utf8Bytes(oldPrefix)
    if ob.length == 0 || vb.length <= ob.length {
      return Option<String>.None
    }
    if vb[ob.length] != 47 {
      return Option<String>.None
    }
    let mut i: usize = 0
    while i < ob.length {
      if vb[i] != ob[i] {
        return Option<String>.None
      }
      i = i + 1
    }
    let mut out = run String.copy(newPrefix)
    run out.append(String.slice(val, ob.length, vb.length - ob.length))
    return Option<String>.some(move out)
  }

  effect fn refreshActiveLibMeta(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.activeClipInLib {
      let targetPath = String.view(&self.activeClipPath)
      let nodes = self.libTree.asSlice()
      let mut i: usize = 0
      while i < nodes.length {
        if !nodes[i].isDir && String.view(&nodes[i].fullPath) == targetPath {
          self.activeItemRating = nodes[i].rating
          self.activeItemStarred = nodes[i].starred
          self.activeCommentDraft = run String.copy(String.view(&nodes[i].comment))
          self.activeClipIsRef = nodes[i].isRef || nodes[i].childCount > 0
          self.activeClipParentRef = run String.copy(String.view(&nodes[i].parentRef))
          return ()
        }
        i = i + 1
      }
    }
    if !self.activeClipInLib {
      self.activeItemRating = 0
      self.activeItemStarred = false
      self.activeCommentDraft.clear()
      self.activeClipIsRef = false
      self.activeClipParentRef.clear()
    }
  }

  /// Strips a trailing audio extension (`.wav`, `.mp3`, `.m4a`, `.flac`, etc.) for clean display.
  effect fn stripAudioExt(name: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(name)
    let mut lastDot: usize = bytes.length
    let mut i: usize = 0
    while i < bytes.length {
      if bytes[i] == 46 {
        lastDot = i
      }
      i = i + 1
    }
    if lastDot > 0 && lastDot + 1 < bytes.length {
      let ext = String.slice(name, lastDot + 1, bytes.length - lastDot - 1)
      if ext == "wav" || ext == "WAV" || ext == "mp3" || ext == "MP3"
        || ext == "m4a" || ext == "M4A" || ext == "aac" || ext == "AAC"
        || ext == "flac" || ext == "FLAC" || ext == "aiff" || ext == "AIFF"
        || ext == "aif" || ext == "AIF" || ext == "caf" || ext == "CAF"
        || ext == "ogg" || ext == "OGG" {
        return run String.copy(String.slice(name, 0, lastDot))
      }
    }
    return run String.copy(name)
  }

  fn isSameOrSubpath(path: string, prefix: string) -> bool {
    if path == prefix {
      return true
    }
    let pb = String.utf8Bytes(path)
    let xb = String.utf8Bytes(prefix)
    if xb.length == 0 || pb.length <= xb.length || pb[xb.length] != 47 {
      return false
    }
    let mut i: usize = 0
    while i < xb.length {
      if pb[i] != xb[i] {
        return false
      }
      i = i + 1
    }
    return true
  }

  /// Rebuilds the virtualized Explorer viewport slice so ONLY rows overlapping the visible
  /// container are rendered (completely bypassing SilkUI Overflow.Scroll culling glitches!).
  effect fn rebuildExplorerVisibleRows(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let nodes = self.libTree.asSlice()
    let filter = self.libFilter
    let viewH = f32.max(120.0, self.explorerTreeRect.height())

    // First pass: compute exact cumulative height of all non-filtered rows
    let mut totalH: f32 = 4.0
    let mut i: usize = 0
    while i < nodes.length {
      let node = &nodes[i]
      let visible = node.isDir || filter != FILTER_STARRED || node.starred || node.rating > 0
      if visible {
        let hasMeta = !node.isDir && (node.rating > 0 || String.byteLength(String.view(&node.comment)) > 0)
        let rh = if hasMeta { EXPLORER_ROW_META_H } else { EXPLORER_ROW_H }
        totalH = totalH + rh + EXPLORER_ROW_GAP
      }
      i = i + 1
    }
    totalH = totalH + 14.0
    self.explorerTotalH = totalH

    let maxScroll = f32.max(0.0, totalH - viewH)
    if self.explorerScrollY < 0.0 { self.explorerScrollY = 0.0 }
    if self.explorerScrollY > maxScroll { self.explorerScrollY = maxScroll }

    // Second pass: collect ONLY rows intersecting [scrollY - 40, scrollY + viewH + 40]
    let yLo = self.explorerScrollY - 40.0
    let yHi = self.explorerScrollY + viewH + 40.0
    self.explorerVisibleRows.clear()
    let mut curY: f32 = 4.0
    i = 0
    while i < nodes.length {
      let node = &nodes[i]
      let visible = node.isDir || filter != FILTER_STARRED || node.starred || node.rating > 0
      if visible {
        let hasMeta = !node.isDir && (node.rating > 0 || String.byteLength(String.view(&node.comment)) > 0)
        let rh = if hasMeta { EXPLORER_ROW_META_H } else { EXPLORER_ROW_H }
        if curY + rh >= yLo && curY <= yHi {
          run self.explorerVisibleRows.append(ExplorerRowSlot { idx: i, y: curY, h: rh })
        }
        curY = curY + rh + EXPLORER_ROW_GAP
      }
      i = i + 1
    }
    // Reset stale row rects for off-screen rows so drag-drop hit-testing only hits visible rows
    self.explorerRowRects.clear()
    let mut k: usize = 0
    while k < nodes.length {
      run self.explorerRowRects.append(Rect<f32>.new(0.0, 0.0, 0.0, 0.0))
      k = k + 1
    }
  }

  effect fn startBgScoring(self: &mut Self, force: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || self.refClip.voiceFrames.length() == 0 {
      self.bgScoreActive = false
      self.bgScoreDone = 0
      self.bgScoreTotal = 0
      self.readoutBgScore.clear()
      return ()
    }
    let refPath = String.view(&self.refClip.fullPath)
    let nodes = self.libTree.asSlice()
    let mut need: usize = 0
    let mut i: usize = 0
    while i < nodes.length {
      // Only score takes attached to this Reference (never recompute unrelated audios!)
      if !nodes[i].isDir
        && String.view(&nodes[i].fullPath) != refPath
        && String.view(&nodes[i].parentRef) == refPath
      {
        if force || nodes[i].scoreVer < SCORE_VERSION {
          need = need + 1
        }
      }
      i = i + 1
    }
    if need == 0 {
      self.bgScoreActive = false
      self.bgScoreDone = 0
      self.bgScoreTotal = 0
      self.readoutBgScore.clear()
      return ()
    }
    self.bgScoreActive = true
    self.bgScoreForce = force
    self.bgScoreDone = 0
    self.bgScoreTotal = need
    self.bgScoreCursor = 0
    let mut s = String.make()
    run s.append("Scoring 0/")
    run appendFixed(&mut s, usize.toF64(need), 0)
    run s.append("…")
    self.readoutBgScore = move s
  }

  /// Scores one pending visible library clip against the current Reference per frame (~20ms)
  /// so an entire 50-clip folder gets all 5 metric scores populated automatically with zero UI freeze!
  effect fn stepBgScoring(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.bgScoreActive || !self.refClip.active {
      self.bgScoreActive = false
      self.readoutBgScore.clear()
      return ()
    }
    let refPathView = String.view(&self.refClip.fullPath)
    let nodes = self.libTree.asSlice()
    let mut targetIdx = nodes.length
    while self.bgScoreCursor < nodes.length {
      let i = self.bgScoreCursor
      self.bgScoreCursor = self.bgScoreCursor + 1
      if !nodes[i].isDir
        && String.view(&nodes[i].fullPath) != refPathView
        && String.view(&nodes[i].parentRef) == refPathView
      {
        if self.bgScoreForce || nodes[i].scoreVer < SCORE_VERSION {
          targetIdx = i
          break
        }
      }
    }
    if targetIdx >= nodes.length {
      self.bgScoreActive = false
      self.bgScoreForce = false
      self.readoutBgScore.clear()
      run self.reloadTree(false)
      return ()
    }
    let fullPath = run String.copy(String.view(&nodes[targetIdx].fullPath))
    let parentRel = run String.copy(String.view(&nodes[targetIdx].parentRel))
    let fname = run String.copy(String.view(&nodes[targetIdx].name))
    let refPathCopy = run String.copy(refPathView)

    match move run audio_native.loadAudioFile(String.view(&fullPath)) {
      Option<audio_native.LoadedAudio>.Some { value } => {
        let sr = value.sampleRate
        let mut pt = PitchTrack.empty()
        run pt.reset(sr, self.pitchConfig)
        drop run pt.update(value.samples.asSlice())
        run pt.refineViterbi(self.displayClarity)
        let mut ft = FormantTrack.empty()
        run ft.reset(sr, self.formantCeilingHz, self.pitchConfig.hopSeconds)
        drop run ft.update(value.samples.asSlice())
        run ft.refineTracked(pt.frames.asSlice(), self.displayClarity)
        let mut vm = VoiceMetricsTrack.empty()
        drop run vm.update(value.samples.asSlice(), sr, pt.frames.asSlice(), ft.frames.asSlice(), self.displayClarity)
        run vm.finalizeSummary(value.samples.asSlice(), sr)
        let al = run buildCompareAlignment(
          vm.frames.asSlice(),
          vm.summary,
          &vm.ltas,
          vm.hasLtas,
          &self.refClip,
          self.useDtwAlign,
          self.matchWeights,
        )
        if al.score.valid {
          drop audio_native.libUpdateScores(
            String.view(&parentRel),
            String.view(&fname),
            String.view(&refPathCopy),
            u32.toI32(al.score.overall),
            u32.toI32(al.score.pitchScore),
            u32.toI32(al.score.sizeScore),
            u32.toI32(al.score.weightScore),
            u32.toI32(al.score.vowelScore),
            SCORE_VERSION,
          )
        } else {
          // Mark unscorable/silent clip as v2 (-1) so we don't rescan it endlessly
          drop audio_native.libUpdateScores(
            String.view(&parentRel),
            String.view(&fname),
            String.view(&refPathCopy),
            -1,
            -1,
            -1,
            -1,
            -1,
            SCORE_VERSION,
          )
        }
      }
      Option<audio_native.LoadedAudio>.None => ()
    }
    self.bgScoreDone = self.bgScoreDone + 1
    if self.bgScoreDone >= self.bgScoreTotal || self.bgScoreCursor >= self.libTree.length() {
      self.bgScoreActive = false
      self.bgScoreForce = false
      self.readoutBgScore.clear()
      run self.reloadTree(false)
    } else {
      let mut s = String.make()
      run s.append("Scoring ")
      run appendFixed(&mut s, usize.toF64(self.bgScoreDone), 0)
      run s.append("/")
      run appendFixed(&mut s, usize.toF64(self.bgScoreTotal), 0)
      run s.append("…")
      self.readoutBgScore = move s
      // Periodically refresh visible badges & sort order live as scores complete
      if (self.bgScoreDone % 8) == 0 {
        run self.reloadTree(false)
      }
    }
  }

  effect fn reloadTree(self: &mut Self, reloadNotes: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let exp = run self.expandedDirsString()
    let refPath = if self.refClip.active { String.view(&self.refClip.fullPath) } else { "" }
    let listing = run audio_native.libScanTree(
      String.view(&exp),
      String.view(&self.selectedFolderRel),
      refPath,
      self.libSortMode,
    )
    self.libTree = move listing.nodes
    if reloadNotes {
      self.sessionNotes = move listing.notes
    }
    run self.rebuildExplorerVisibleRows()
    run self.refreshActiveLibMeta()
  }

  effect fn startRenameActiveOrSelected(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let nodes = self.libTree.asSlice()
    let activePath = String.view(&self.activeClipPath)
    let selFolder = String.view(&self.selectedFolderRel)
    let mut targetIdx: usize = nodes.length
    if self.activeClipInLib && String.byteLength(activePath) > 0 {
      let mut i: usize = 0
      while i < nodes.length {
        if !nodes[i].isDir && String.view(&nodes[i].fullPath) == activePath {
          targetIdx = i
          break
        }
        i = i + 1
      }
    }
    if targetIdx >= nodes.length && String.byteLength(selFolder) > 0 {
      let mut i: usize = 0
      while i < nodes.length {
        if nodes[i].isDir && String.view(&nodes[i].relPath) == selFolder {
          targetIdx = i
          break
        }
        i = i + 1
      }
    }
    if targetIdx < nodes.length {
      self.renamingRel = run String.copy(String.view(&nodes[targetIdx].relPath))
      self.renamingParentRel = run String.copy(String.view(&nodes[targetIdx].parentRel))
      self.renamingOldName = run String.copy(String.view(&nodes[targetIdx].name))
      self.renamingIsDir = nodes[targetIdx].isDir
      // Pre-fill extension-free stem for files (and folder name for dirs) so user never edits extensions!
      self.renameDraft = run String.copy(String.view(&nodes[targetIdx].displayName))
    }
  }

  /// Evaluates the destination folder OR parent Reference clip for an Explorer drag-and-drop position.
  /// Dropping a clip onto a Reference clip (or one of its takes) puts it inside that Reference.
  /// Dropping a clip onto a folder moves it into that folder (and detaches from any Reference).
  effect fn updateExplorerDropTarget(self: &mut Self, x: f32, y: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.explorerDragX = x
    self.explorerDragY = y
    let nodes = self.libTree.asSlice()
    if self.explorerDragIdx >= nodes.length {
      self.explorerDropValid = false
      self.explorerDropTargetRefPath.clear()
      self.explorerDropTargetLabel.clear()
      return ()
    }
    let pr = self.explorerPanelRect
    if x < pr.xMin || x > pr.xMax || y < pr.yMin || y > pr.yMax {
      self.explorerDropValid = false
      self.explorerDropTargetRefPath.clear()
      self.explorerDropTargetLabel.clear()
      return ()
    }

    let srcNode = &nodes[self.explorerDragIdx]
    let srcParent = String.view(&srcNode.parentRel)
    let srcRel = String.view(&srcNode.relPath)
    let srcFull = String.view(&srcNode.fullPath)
    let srcParentRef = String.view(&srcNode.parentRef)
    let srcIsDir = srcNode.isDir
    let srcHasKids = srcNode.childCount > 0

    // 1. Primary hit-test: exact tree coordinate against virtualized rows
    let mut hitIdx: usize = nodes.length
    let tr = self.explorerTreeRect
    if tr.height() > 1.0 && y >= tr.yMin && y <= tr.yMax {
      let localY = (y - tr.yMin) + self.explorerScrollY
      let slots = self.explorerVisibleRows.asSlice()
      let mut s: usize = 0
      while s < slots.length {
        let slot = &slots[s]
        if slot.idx < nodes.length && localY >= slot.y && localY <= slot.y + slot.h {
          hitIdx = slot.idx
          break
        }
        s = s + 1
      }
    }
    // 2. Fallback to reported row rects if tree rect hasn't been laid out yet
    if hitIdx >= nodes.length {
      let rects = self.explorerRowRects.asSlice()
      let mut i: usize = 0
      while i < rects.length && i < nodes.length {
        let r = rects[i]
        if r.width() > 1.0 && r.height() > 1.0 && y >= r.yMin && y <= r.yMax {
          hitIdx = i
          break
        }
        i = i + 1
      }
    }

    // Check if dragging a clip onto a Reference clip (or onto one of its child takes)
    if !srcIsDir && !srcHasKids && hitIdx < nodes.length && !nodes[hitIdx].isDir {
      let mut targetRefPath = String.make()
      let mut targetRefLabel = String.make()
      if nodes[hitIdx].isRef || nodes[hitIdx].childCount > 0 {
        targetRefPath = run String.copy(String.view(&nodes[hitIdx].fullPath))
        targetRefLabel = run String.copy(String.view(&nodes[hitIdx].displayName))
      } else if String.byteLength(String.view(&nodes[hitIdx].parentRef)) > 0 {
        let prp = String.view(&nodes[hitIdx].parentRef)
        targetRefPath = run String.copy(prp)
        let refIdx = self.findLibIdxByFullPath(prp)
        if refIdx < nodes.length {
          targetRefLabel = run String.copy(String.view(&nodes[refIdx].displayName))
        }
      }
      if String.byteLength(String.view(&targetRefPath)) > 0
        && String.view(&targetRefPath) != srcFull
        && String.view(&targetRefPath) != srcParentRef
      {
        self.explorerDropTargetRel.clear()
        self.explorerDropTargetRefPath = move targetRefPath
        self.explorerDropTargetLabel = move targetRefLabel
        self.explorerDropValid = true
        return ()
      }
    }

    let mut dstRel = String.make()
    if hitIdx < nodes.length {
      if nodes[hitIdx].isDir {
        dstRel = run String.copy(String.view(&nodes[hitIdx].relPath))
      } else {
        dstRel = run String.copy(String.view(&nodes[hitIdx].parentRel))
      }
    }
    let dstView = String.view(&dstRel)
    let sameParent = dstView == srcParent
    let intoSelf = srcIsDir && Overtone.isSameOrSubpath(dstView, srcRel)
    let canDetach = !srcIsDir && String.byteLength(srcParentRef) > 0
    self.explorerDropTargetRefPath.clear()
    self.explorerDropTargetLabel = if String.byteLength(dstView) > 0 { run String.copy(dstView) } else { run String.copy("/") }
    self.explorerDropTargetRel = move dstRel
    self.explorerDropValid = (!sameParent || canDetach) && !intoSelf
  }

  /// Attaches a library clip as a child take inside `refFullPath` (moving folders if needed).
  effect fn attachLibEntryToRef(self: &mut Self, srcIdx: usize, refFullPath: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let nodes = self.libTree.asSlice()
    if srcIdx >= nodes.length || nodes[srcIdx].isDir {
      return ()
    }
    let refIdx = self.findLibIdxByFullPath(refFullPath)
    if refIdx >= nodes.length || nodes[refIdx].isDir {
      return ()
    }
    let srcParent = run String.copy(String.view(&nodes[srcIdx].parentRel))
    let nameCopy = run String.copy(String.view(&nodes[srcIdx].name))
    let dispCopy = run String.copy(String.view(&nodes[srcIdx].displayName))
    let oldFull = run String.copy(String.view(&nodes[srcIdx].fullPath))
    let refDir = run String.copy(String.view(&nodes[refIdx].parentRel))
    let refDisp = run String.copy(String.view(&nodes[refIdx].displayName))
    let refPathCopy = run String.copy(refFullPath)

    if String.view(&oldFull) == String.view(&refPathCopy) {
      return ()
    }

    let mut curDir = run String.copy(String.view(&srcParent))
    let mut curFull = run String.copy(String.view(&oldFull))
    if String.view(&srcParent) != String.view(&refDir) {
      let res = run audio_native.libMoveEntry(
        String.view(&srcParent),
        String.view(&nameCopy),
        String.view(&refDir),
        false,
      )
      if res.ok {
        curDir = run String.copy(String.view(&refDir))
        curFull = run String.copy(String.view(&res.fullPath))
        if String.view(&self.activeClipPath) == String.view(&oldFull) {
          self.activeClipDir = run String.copy(String.view(&curDir))
          self.activeClipPath = run String.copy(String.view(&curFull))
        }
      }
    }

    drop audio_native.libSetParentRef(
      String.view(&curDir),
      String.view(&nameCopy),
      String.view(&refPathCopy),
    )
    run self.ensureDirExpanded(String.view(&refDir))
    run self.ensureDirExpanded(String.view(&refPathCopy))
    run self.reloadTree(false)

    // If the clip we just put inside a reference is currently open, activate that reference now!
    if String.view(&self.activeClipPath) == String.view(&curFull) {
      let newRefIdx = self.findLibIdxByFullPath(String.view(&refPathCopy))
      if newRefIdx < self.libTree.length() {
        run self.loadLibraryClip(newRefIdx, true)
      }
      run self.refreshActiveLibMeta()
      run self.recomputeNormGain()
      run self.recomputeCompare()
      run self.rebuildDrawings(true)
    }
    run self.saveSessionPrefs()
    let mut msg = String.make()
    run msg.append("Put ")
    run msg.append(String.view(&dispCopy))
    run msg.append(" inside ")
    run msg.append(String.view(&refDisp))
    self.statusMsg = move msg
  }

  /// Moves a real file OR directory into `dstFolderRel` ("" = library root) and updates all open paths.
  effect fn moveLibEntry(self: &mut Self, srcIdx: usize, dstFolderRel: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let nodes = self.libTree.asSlice()
    if srcIdx >= nodes.length {
      return ()
    }
    let srcParent = run String.copy(String.view(&nodes[srcIdx].parentRel))
    let srcParentRef = run String.copy(String.view(&nodes[srcIdx].parentRef))
    let nameCopy = run String.copy(String.view(&nodes[srcIdx].name))
    let dispCopy = run String.copy(String.view(&nodes[srcIdx].displayName))
    let oldRel = run String.copy(String.view(&nodes[srcIdx].relPath))
    let oldFull = run String.copy(String.view(&nodes[srcIdx].fullPath))
    let isDir = nodes[srcIdx].isDir
    let dstCopy = run String.copy(dstFolderRel)
    let hadParentRef = !isDir && String.byteLength(String.view(&srcParentRef)) > 0

    if String.view(&srcParent) == String.view(&dstCopy) {
      if hadParentRef {
        drop audio_native.libSetParentRef(String.view(&srcParent), String.view(&nameCopy), "")
        if String.view(&self.activeClipPath) == String.view(&oldFull) {
          self.clearActiveRefSilent()
          run self.recomputeNormGain()
          run self.recomputeCompare()
          run self.rebuildDrawings(false)
        }
        run self.reloadTree(false)
        run self.saveSessionPrefs()
        let mut dmsg = String.make()
        run dmsg.append("Detached ")
        run dmsg.append(String.view(&dispCopy))
        run dmsg.append(" from reference")
        self.statusMsg = move dmsg
      }
      return ()
    }
    if isDir && Overtone.isSameOrSubpath(String.view(&dstCopy), String.view(&oldRel)) {
      return ()
    }

    let res = run audio_native.libMoveEntry(
      String.view(&srcParent),
      String.view(&nameCopy),
      String.view(&dstCopy),
      isDir,
    )
    if res.ok {
      let newRel = run String.copy(String.view(&res.newRel))
      let newFull = run String.copy(String.view(&res.fullPath))
      if isDir {
        let mut ei: usize = 0
        while ei < self.expandedDirs.length() {
          let curExp = run String.copy(String.view(&self.expandedDirs.asSlice()[ei]))
          if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
            String.view(&curExp),
            String.view(&oldRel),
            String.view(&newRel),
          ) {
            let expMut = self.expandedDirs.asMutSlice()
            expMut[ei] = move updated
          }
          ei = ei + 1
        }
        let curSel = run String.copy(String.view(&self.selectedFolderRel))
        if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
          String.view(&curSel),
          String.view(&oldRel),
          String.view(&newRel),
        ) {
          self.selectedFolderRel = move updated
        }
        let curActiveDir = run String.copy(String.view(&self.activeClipDir))
        if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
          String.view(&curActiveDir),
          String.view(&oldRel),
          String.view(&newRel),
        ) {
          self.activeClipDir = move updated
        }
        let curActivePath = run String.copy(String.view(&self.activeClipPath))
        if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
          String.view(&curActivePath),
          String.view(&oldFull),
          String.view(&newFull),
        ) {
          self.activeClipPath = move updated
        }
        if self.refClip.active {
          let curRefPath = run String.copy(String.view(&self.refClip.fullPath))
          if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
            String.view(&curRefPath),
            String.view(&oldFull),
            String.view(&newFull),
          ) {
            self.refClip.fullPath = move updated
          }
        }
      } else {
        if hadParentRef {
          drop audio_native.libSetParentRef(String.view(&dstCopy), String.view(&nameCopy), "")
        }
        if String.view(&self.activeClipPath) == String.view(&oldFull) {
          self.activeClipDir = run String.copy(String.view(&dstCopy))
          self.activeClipPath = run String.copy(String.view(&newFull))
          if hadParentRef {
            self.clearActiveRefSilent()
            run self.recomputeNormGain()
            run self.recomputeCompare()
            run self.rebuildDrawings(false)
          }
        }
        if self.refClip.active && String.view(&self.refClip.fullPath) == String.view(&oldFull) {
          self.refClip.fullPath = run String.copy(String.view(&newFull))
        }
      }
      run self.ensureDirExpanded(String.view(&dstCopy))
      run self.reloadTree(false)
      run self.saveSessionPrefs()
      let mut msg = String.make()
      run msg.append("Moved ")
      run msg.append(String.view(&dispCopy))
      run msg.append(" → /")
      run msg.append(String.view(&dstCopy))
      self.statusMsg = move msg
    } else {
      self.errorMsg = run String.copy("Could not move item (an item with that name may already exist in the destination).")
    }
  }

  effect fn addGuideHz(self: &mut Self, hz: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if hz < 20.0 || hz > 22000.0 {
      return ()
    }
    let existing = self.guides.asSlice()
    let mut i: usize = 0
    while i < existing.length {
      if f64.abs(existing[i] - hz) < 0.5 {
        return ()
      }
      i = i + 1
    }
    run self.guides.append(hz)
    run self.rebuildDrawings(false)
  }

  effect fn saveUndoSnapshot(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.undoSamples = run copyF32List(self.samples.asSlice())
    self.undoRate = self.sampleRate
    self.undoCursor = self.cursorSec
    self.hasUndo = true
  }

  effect fn finishAudioEdit(self: &mut Self, newCursor: f64, clearSel: bool, msg: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.playing {
      run self.sendTransport(TransportEvent.StopAll)
    }
    let dur = self.clipDuration()
    self.vp.setLimits(f64.max(dur, 0.25), self.sampleRate * 0.5)
    let span = self.vp.t1 - self.vp.t0
    if dur <= 0.25 || span >= dur {
      self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
    } else if self.vp.t1 > dur {
      self.vp.setTimeRange(f64.max(0.0, dur - span), dur)
    }
    self.cursorSec = f64.max(0.0, f64.min(dur, newCursor))
    if clearSel {
      self.hasSelection = false
      self.readoutSelSpan.clear()
      self.selPitchStats = SelectionPitchStats.empty()
      self.readoutSelPitchChip.clear()
      self.readoutSelPitchMain.clear()
      self.readoutSelPitchSub.clear()
    }
    self.errorMsg.clear()
    run self.analyzeAll()
    // Auto-persist audio edits immediately if this clip is in the library so edits are never lost!
    if self.activeClipInLib && self.samples.length() >= 64 {
      run self.saveCurrentClipToFolder(false)
    }
    // Keep active Reference synced if user intentionally edited the Reference clip itself!
    if self.isEditingActiveRef() && self.samples.length() >= 64 {
      self.refClip.samples = run copyF32List(self.samples.asSlice())
      self.refClip.sampleRate = self.sampleRate
      self.refClip.durationSec = self.clipDuration()
      run self.reanalyzeRefClip()
      self.gpuNeedRefReload = true
    }
    run self.recomputeNormGain()
    let mut savedMsg = run String.copy(msg)
    if self.activeClipInLib {
      run savedMsg.append(" · Auto-saved")
    }
    self.statusMsg = move savedMsg
    self.gpuNeedFullReload = true
    self.gpuNeedSharp = true
    self.sharpDueTime = 0.0
    self.gpuNeedRedraw = true
    run self.rebuildDrawings(true)
  }

  effect fn copySelection(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.hasSelection {
      self.statusMsg = run String.copy("Shift+Drag a selection first to copy.")
      return ()
    }
    let src = self.gpuSamples()
    let sr = self.gpuSampleRate()
    let lo = f64.min(self.selStart, self.selEnd)
    let hi = f64.max(self.selStart, self.selEnd)
    if hi - lo < 0.015 || src.length == 0 || sr <= 0.0 {
      return ()
    }
    let i0 = f64.toUsize(f64.max(0.0, f64.floor(lo * sr)))
    let mut i1 = f64.toUsize(f64.ceil(hi * sr))
    if i1 > src.length { i1 = src.length }
    if i1 <= i0 {
      return ()
    }
    let mut copied = List<f32>.make()
    let mut i = i0
    while i < i1 {
      run copied.append(src[i])
      i = i + 1
    }
    self.clipboardSamples = move copied
    self.clipboardRate = sr
    let mut msg = String.make()
    run msg.append("Copied ")
    let ds = run formatSecShort(hi - lo)
    run msg.append(String.view(&ds))
    run msg.append(" to audio clipboard (⌘V to paste at cursor).")
    self.statusMsg = move msg
  }

  effect fn removeSelectionRange(self: &mut Self, copyFirst: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.recording || self.practiceMode != PRACTICE_OFF {
      return ()
    }
    if self.isPlottingOnRef() {
      self.statusMsg = run String.copy("Switch Base back to Take (B) to edit your take.")
      return ()
    }
    if !self.hasSelection || self.samples.length() == 0 {
      return ()
    }
    let lo = f64.min(self.selStart, self.selEnd)
    let hi = f64.max(self.selStart, self.selEnd)
    if hi - lo < 0.015 {
      return ()
    }
    if copyFirst {
      run self.copySelection()
    }
    run self.saveUndoSnapshot()
    let sr = self.sampleRate
    let src = self.samples.asSlice()
    let i0 = f64.toUsize(f64.max(0.0, f64.floor(lo * sr)))
    let mut i1 = f64.toUsize(f64.ceil(hi * sr))
    if i1 > src.length { i1 = src.length }
    if i1 <= i0 {
      return ()
    }
    let mut next = List<f32>.make()
    let mut i: usize = 0
    while i < i0 {
      run next.append(src[i])
      i = i + 1
    }
    let spliceIdx = next.length()
    i = i1
    while i < src.length {
      run next.append(src[i])
      i = i + 1
    }
    // 2 ms micro-fade around splice point so cuts never click
    let fadeN = f64.toUsize(f64.max(8.0, f64.min(128.0, sr * 0.002)))
    let out = next.asMutSlice()
    if spliceIdx > 0 && spliceIdx < out.length {
      let mut k: usize = 0
      while k < fadeN {
        let g = usize.toF32(k) / usize.toF32(fadeN)
        if spliceIdx > k {
          out[spliceIdx - 1 - k] = out[spliceIdx - 1 - k] * g
        }
        if spliceIdx + k < out.length {
          out[spliceIdx + k] = out[spliceIdx + k] * g
        }
        k = k + 1
      }
    }
    self.samples = move next
    run self.finishAudioEdit(
      lo,
      true,
      if copyFirst { "Cut selection to clipboard (⌘Z to undo)." } else { "Deleted selection (⌘Z to undo)." },
    )
  }

  effect fn pasteAtCursor(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.recording || self.practiceMode != PRACTICE_OFF {
      return ()
    }
    if self.isPlottingOnRef() {
      self.statusMsg = run String.copy("Switch Base back to Take (B) to paste into your take.")
      return ()
    }
    if self.clipboardSamples.length() == 0 {
      self.statusMsg = run String.copy("Audio clipboard is empty — Shift+Drag & ⌘C first.")
      return ()
    }
    run self.saveUndoSnapshot()
    let sr = if self.sampleRate > 0.0 { self.sampleRate } else { self.clipboardRate }
    self.sampleRate = sr
    let src = self.samples.asSlice()
    let clip = self.clipboardSamples.asSlice()

    // Prepare resampled clipboard if sample rates differ
    let mut ins = List<f32>.make()
    if f64.abs(self.clipboardRate - sr) < 1.0 || self.clipboardRate <= 0.0 {
      run ins.appendSlice(clip)
    } else {
      let ratio = self.clipboardRate / sr
      let outLen = f64.toUsize(f64.max(1.0, f64.round(usize.toF64(clip.length) / ratio)))
      let mut j: usize = 0
      while j < outLen {
        let pos = usize.toF64(j) * ratio
        let k0 = f64.toUsize(f64.floor(pos))
        let frac = f64.toF32(pos - usize.toF64(k0))
        let s0: f32 = if k0 < clip.length { clip[k0] } else { 0.0 }
        let s1: f32 = if k0 + 1 < clip.length { clip[k0 + 1] } else { s0 }
        run ins.append(s0 + (s1 - s0) * frac)
        j = j + 1
      }
    }

    // Smooth 2 ms edges on inserted clip to avoid clicks
    let fadeN = f64.toUsize(f64.max(8.0, f64.min(128.0, sr * 0.002)))
    let insMut = ins.asMutSlice()
    if insMut.length > fadeN * 2 {
      let mut k: usize = 0
      while k < fadeN {
        let g = usize.toF32(k) / usize.toF32(fadeN)
        insMut[k] = insMut[k] * g
        insMut[insMut.length - 1 - k] = insMut[insMut.length - 1 - k] * g
        k = k + 1
      }
    }

    let mut cutStart: usize = f64.toUsize(f64.max(0.0, f64.floor(self.cursorSec * sr)))
    let mut cutEnd = cutStart
    if self.hasSelection {
      let lo = f64.min(self.selStart, self.selEnd)
      let hi = f64.max(self.selStart, self.selEnd)
      if hi - lo >= 0.015 {
        cutStart = f64.toUsize(f64.max(0.0, f64.floor(lo * sr)))
        cutEnd = f64.toUsize(f64.ceil(hi * sr))
      }
    }
    if cutStart > src.length { cutStart = src.length }
    if cutEnd > src.length { cutEnd = src.length }
    if cutEnd < cutStart { cutEnd = cutStart }

    let mut next = List<f32>.make()
    let mut i: usize = 0
    while i < cutStart {
      run next.append(src[i])
      i = i + 1
    }
    run next.appendSlice(ins.asSlice())
    i = cutEnd
    while i < src.length {
      run next.append(src[i])
      i = i + 1
    }

    let pastedStartSec = usize.toF64(cutStart) / sr
    let pastedEndSec = usize.toF64(cutStart + ins.length()) / sr
    self.samples = move next
    self.hasSelection = true
    self.selStart = pastedStartSec
    self.selEnd = pastedEndSec
    run self.finishAudioEdit(pastedEndSec, false, "Pasted clipboard audio (⌘Z to undo).")
  }

  effect fn undoEdit(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.hasUndo || self.recording || self.practiceMode != PRACTICE_OFF {
      return ()
    }
    let curSamples = run copyF32List(self.samples.asSlice())
    let curRate = self.sampleRate
    let curCursor = self.cursorSec
    self.samples = run copyF32List(self.undoSamples.asSlice())
    self.sampleRate = self.undoRate
    let restoreCursor = self.undoCursor
    self.undoSamples = move curSamples
    self.undoRate = curRate
    self.undoCursor = curCursor
    run self.finishAudioEdit(restoreCursor, true, "Undid last audio edit.")
  }

  /// Syncs right-panel Match Score & Delta strings from either the bisected selection
  /// (`selCompare`) when a selection is active, or the full-clip comparison (`compare`)!
  effect fn syncMatchReadoutStrings(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active {
      self.readoutDeltaPitch.clear()
      self.readoutDeltaVtl.clear()
      self.readoutDeltaWeight.clear()
      self.readoutScoreOverall = run String.copy("—")
      self.readoutScorePitch = run String.copy("—")
      self.readoutScoreSize = run String.copy("—")
      self.readoutScoreWeight = run String.copy("—")
      self.readoutScoreVowel = run String.copy("—")
      self.readoutSelRefSpan.clear()
      self.readoutCoachHint.clear()
      self.readoutRefDuration.clear()
      self.readoutWeakestMetric = 0
      return ()
    }
    self.readoutRefDuration = run formatTime(self.refClip.durationSec)
    let useSel = self.hasSelection && self.selCompare.valid
    let sc: MatchScore = if useSel { self.selCompare.score } else { self.compare.score }
    let hasDeltas = if useSel { true } else { self.compare.valid && self.voiceMetrics.summary.voicedFrames > 0 }
    let mut dSemi: f64 = 0.0
    let mut dVtl: f64 = 0.0
    let mut dWt: f64 = 0.0
    if hasDeltas {
      dSemi = if useSel { self.selCompare.deltaSemi } else { self.compare.deltaSemi }
      dVtl = if useSel { self.selCompare.deltaVtlCm } else { self.compare.deltaVtlCm }
      dWt = if useSel { self.selCompare.deltaH1H2Db } else { self.compare.deltaH1H2Db }
      self.readoutDeltaPitch = run formatSignedFixed(dSemi, 1, "st")
      self.readoutDeltaVtl = run formatSignedFixed(dVtl, 1, " cm")
      self.readoutDeltaWeight = run formatSignedFixed(dWt, 1, " dB")
    } else {
      self.readoutDeltaPitch.clear()
      self.readoutDeltaVtl.clear()
      self.readoutDeltaWeight.clear()
    }
    if sc.valid {
      self.readoutScoreOverall = run formatScorePct(u32.toI32(sc.overall))
      self.readoutScorePitch = run formatScorePct(u32.toI32(sc.pitchScore))
      self.readoutScoreSize = run formatScorePct(u32.toI32(sc.sizeScore))
      self.readoutScoreWeight = run formatScorePct(u32.toI32(sc.weightScore))
      self.readoutScoreVowel = run formatScorePct(u32.toI32(sc.vowelScore))
      let mut weakest: u32 = 1
      let mut minVal: u32 = sc.pitchScore
      if sc.sizeScore < minVal {
        minVal = sc.sizeScore
        weakest = 2
      }
      if sc.weightScore < minVal {
        minVal = sc.weightScore
        weakest = 3
      }
      if sc.vowelScore < minVal {
        minVal = sc.vowelScore
        weakest = 4
      }
      self.readoutWeakestMetric = if minVal < 82 { weakest } else { 0 }

      let mut hint = String.make()
      if minVal >= 85 {
        run hint.append("Close match across pitch, size, weight, and vowels.")
      } else if weakest == 3 {
        run hint.append("H1–H2 is ")
        run appendFixed(&mut hint, f64.abs(dWt), 1)
        run hint.append(if dWt < 0.0 { " dB heavier than ref. Try a lighter, softer onset." } else { " dB lighter than ref. Add a touch more fold closure." })
      } else if weakest == 2 {
        run hint.append("Resonance VTL is ")
        run appendFixed(&mut hint, f64.abs(dVtl), 1)
        run hint.append(if dVtl > 0.0 { " cm larger than ref. Brighten the vocal tract slightly." } else { " cm smaller than ref. Relax and open the throat space." })
      } else if weakest == 1 {
        run hint.append("Pitch is ")
        run appendFixed(&mut hint, f64.abs(dSemi), 1)
        run hint.append(if dSemi < 0.0 { " st lower than ref. Lift the center pitch slightly." } else { " st higher than ref. Ease pitch down toward ref." })
      } else {
        run hint.append("Vowel formants diverge from ref. Match F1/F2 tongue position on held vowels.")
      }
      self.readoutCoachHint = move hint
    } else {
      self.readoutScoreOverall = run String.copy("—")
      self.readoutScorePitch = run String.copy("—")
      self.readoutScoreSize = run String.copy("—")
      self.readoutScoreWeight = run String.copy("—")
      self.readoutScoreVowel = run String.copy("—")
      self.readoutWeakestMetric = 0
      self.readoutCoachHint.clear()
    }
    if useSel {
      let mut rs = String.make()
      let t0 = run formatSecShort(self.selCompare.takeStart)
      let t1 = run formatSecShort(self.selCompare.takeEnd)
      let r0 = run formatSecShort(self.selCompare.refStart)
      let r1 = run formatSecShort(self.selCompare.refEnd)
      run rs.append(String.view(&t0))
      run rs.append("–")
      run rs.append(String.view(&t1))
      run rs.append(" vs Ref ")
      run rs.append(String.view(&r0))
      run rs.append("–")
      run rs.append(String.view(&r1))
      self.readoutSelRefSpan = move rs
    } else {
      self.readoutSelRefSpan.clear()
    }
  }

  effect fn updateSelectionCompare(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.hasSelection || !self.refClip.active || !self.compare.valid {
      self.selCompare = SelectionCompare.empty()
      run self.syncMatchReadoutStrings()
      return ()
    }
    self.selCompare = run computeSelectionCompare(
      self.samples.asSlice(),
      self.sampleRate,
      self.voiceMetrics.frames.asSlice(),
      &self.refClip,
      &self.compare,
      self.selStart,
      self.selEnd,
      self.isPlottingOnRef(),
      self.matchWeights,
    )
    run self.syncMatchReadoutStrings()
  }

  effect fn recomputeCompare(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.refClip.active {
      self.compare = run buildCompareAlignment(
        self.voiceMetrics.frames.asSlice(),
        self.voiceMetrics.summary,
        &self.voiceMetrics.ltas,
        self.voiceMetrics.hasLtas,
        &self.refClip,
        self.useDtwAlign,
        self.matchWeights,
      )
      if self.compare.score.valid {
        // Persist scores ONLY for child takes attached to the active Reference (never loose clips or refs!)
        if self.activeClipInLib
          && String.byteLength(String.view(&self.activeClipParentRef)) > 0
          && String.view(&self.activeClipParentRef) == String.view(&self.refClip.fullPath)
        {
          drop audio_native.libUpdateScores(
            String.view(&self.activeClipDir),
            String.view(&self.activeClipFilename),
            String.view(&self.refClip.fullPath),
            u32.toI32(self.compare.score.overall),
            u32.toI32(self.compare.score.pitchScore),
            u32.toI32(self.compare.score.sizeScore),
            u32.toI32(self.compare.score.weightScore),
            u32.toI32(self.compare.score.vowelScore),
            SCORE_VERSION,
          )
          run self.reloadTree(false)
        }
      }
      run self.updateSelectionCompare()
    } else {
      self.plotOnRef = false
      self.compare = CompareAlignment.empty()
      self.selCompare = SelectionCompare.empty()
      self.bgScoreActive = false
      self.readoutBgScore.clear()
      run self.syncMatchReadoutStrings()
    }
  }

  effect fn analyzeAll(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.pitchTrack.reset(self.sampleRate, self.pitchConfig)
    drop run self.pitchTrack.update(self.samples.asSlice())
    run self.pitchTrack.refineViterbi(self.displayClarity)
    run self.formantTrack.reset(self.sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    drop run self.formantTrack.update(self.samples.asSlice())
    run self.formantTrack.refineTracked(self.pitchTrack.frames.asSlice(), self.displayClarity)
    self.voiceMetrics.reset()
    drop run self.voiceMetrics.update(
      self.samples.asSlice(),
      self.sampleRate,
      self.pitchTrack.frames.asSlice(),
      self.formantTrack.frames.asSlice(),
      self.displayClarity,
    )
    run self.voiceMetrics.finalizeSummary(self.samples.asSlice(), self.sampleRate)
    run self.recomputeCompare()
    self.requestNeuralForTake()
    run self.refreshVowelAnalysis(false)
  }

  effect fn pullVowelSpansFromHost(self: &mut Self, isRef: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let n = audio_native.vowelSpanCount(isRef)
    let isNeural = audio_native.vowelIsNeural(isRef)
    let mut spans = List<VowelSpan>.make()
    if n > 0 {
      let stride: usize = 16
      let mut t0s = List<f64>.make()
      let mut t1s = List<f64>.make()
      let mut lbuf = List<u8>.make()
      run t0s.appendRepeated(0.0, n)
      run t1s.appendRepeated(0.0, n)
      run lbuf.appendRepeated(0, n * stride)
      let got = audio_native.vowelCopySpans(isRef, t0s.asMutSlice(), t1s.asMutSlice(), lbuf.asMutSlice(), stride)
      let t0sl = t0s.asSlice()
      let t1sl = t1s.asSlice()
      let lbsl = lbuf.asSlice()
      let mut i: usize = 0
      while i < got {
        let lbl = run audio_native.vowelLabelAt(lbsl, i, stride)
        run spans.append(VowelSpan { t0: t0sl[i], t1: t1sl[i], label: move lbl })
        i = i + 1
      }
    }
    if isRef {
      self.refVowelSpans = move spans
      self.refVowelIsNeural = isNeural
    } else {
      self.takeVowelSpans = move spans
      self.takeVowelIsNeural = isNeural
    }
  }

  effect fn refreshVowelAnalysis(self: &mut Self, isRef: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if isRef {
      if !self.refClip.active || self.refClip.samples.length() < 64 {
        self.refVowelSpans.clear()
        self.refVowelIsNeural = false
        return ()
      }
      self.refPhoneGen = self.refPhoneGen + 1
      let pframes = self.refClip.pitchFrames.asSlice()
      let fframes = self.refClip.formantFrames.asSlice()
      let mut pTs = List<f64>.make()
      let mut pHz = List<f64>.make()
      let mut pCf = List<f64>.make()
      let mut i: usize = 0
      while i < pframes.length {
        run pTs.append(pframes[i].time)
        run pHz.append(if pframes[i].voiced { pframes[i].frequency } else { 0.0 })
        run pCf.append(pframes[i].clarity)
        i = i + 1
      }
      let mut fTs = List<f64>.make()
      let mut f1 = List<f64>.make()
      let mut f2 = List<f64>.make()
      let mut f3 = List<f64>.make()
      i = 0
      while i < fframes.length {
        run fTs.append(fframes[i].time)
        run f1.append(fframes[i].f1)
        run f2.append(fframes[i].f2)
        run f3.append(fframes[i].f3)
        i = i + 1
      }
      drop audio_native.vowelAnalyze(
        self.refPhoneGen,
        true,
        self.refClip.samples.asSlice(),
        self.refClip.sampleRate,
        pTs.asSlice(),
        pHz.asSlice(),
        pCf.asSlice(),
        fTs.asSlice(),
        f1.asSlice(),
        f2.asSlice(),
        f3.asSlice(),
        self.useNeuralPhonemes,
      )
      run self.pullVowelSpansFromHost(true)
      return ()
    }

    if self.recording || self.samples.length() < 64 {
      self.takeVowelSpans.clear()
      self.takeVowelIsNeural = false
      return ()
    }
    self.takePhoneGen = self.takePhoneGen + 1
    let pframes = self.pitchTrack.frames.asSlice()
    let fframes = self.formantTrack.frames.asSlice()
    let mut pTs = List<f64>.make()
    let mut pHz = List<f64>.make()
    let mut pCf = List<f64>.make()
    let mut i: usize = 0
    while i < pframes.length {
      run pTs.append(pframes[i].time)
      run pHz.append(if pframes[i].voiced { pframes[i].frequency } else { 0.0 })
      run pCf.append(pframes[i].clarity)
      i = i + 1
    }
    let mut fTs = List<f64>.make()
    let mut f1 = List<f64>.make()
    let mut f2 = List<f64>.make()
    let mut f3 = List<f64>.make()
    i = 0
    while i < fframes.length {
      run fTs.append(fframes[i].time)
      run f1.append(fframes[i].f1)
      run f2.append(fframes[i].f2)
      run f3.append(fframes[i].f3)
      i = i + 1
    }
    drop audio_native.vowelAnalyze(
      self.takePhoneGen,
      false,
      self.samples.asSlice(),
      self.sampleRate,
      pTs.asSlice(),
      pHz.asSlice(),
      pCf.asSlice(),
      fTs.asSlice(),
      f1.asSlice(),
      f2.asSlice(),
      f3.asSlice(),
      self.useNeuralPhonemes,
    )
    run self.pullVowelSpansFromHost(false)
  }

  effect fn applyPhonemesReady(self: &mut Self, jobId: i32, isRef: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.useNeuralPhonemes {
      return ()
    }
    if isRef {
      if !self.refClip.active || jobId != self.refPhoneGen {
        return ()
      }
      run self.pullVowelSpansFromHost(true)
    } else {
      if self.recording || jobId != self.takePhoneGen {
        return ()
      }
      run self.pullVowelSpansFromHost(false)
    }
    run self.rebuildDrawings(false)
  }

  fn requestNeuralForTake(self: &mut Self) -> () {
    if !self.useNeural || self.recording || self.samples.length() < 64 {
      return ()
    }
    self.takeNeuralGen = self.takeNeuralGen + 1
    audio_native.neuralRequest(
      self.takeNeuralGen,
      false,
      self.samples.asSlice(),
      self.sampleRate,
      self.pitchConfig.floorHz,
      self.pitchConfig.ceilingHz,
    )
  }

  fn requestNeuralForRef(self: &mut Self) -> () {
    if !self.useNeural || !self.refClip.active || self.refClip.samples.length() < 64 {
      return ()
    }
    self.refNeuralGen = self.refNeuralGen + 1
    audio_native.neuralRequest(
      self.refNeuralGen,
      true,
      self.refClip.samples.asSlice(),
      self.refClip.sampleRate,
      self.pitchConfig.floorHz,
      self.pitchConfig.ceilingHz,
    )
  }

  effect fn applyNeuralReady(self: &mut Self, jobId: i32, isRef: bool, hasPitch: bool, hasFormants: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.useNeural {
      return ()
    }
    if isRef {
      if !self.refClip.active || jobId != self.refNeuralGen {
        return ()
      }
      if hasPitch {
        let np = audio_native.neuralPitchCount()
        if np > 0 {
          let mut ts = List<f64>.make()
          let mut hz = List<f64>.make()
          let mut cf = List<f64>.make()
          run ts.appendRepeated(0.0, np)
          run hz.appendRepeated(0.0, np)
          run cf.appendRepeated(0.0, np)
          let got = audio_native.neuralCopyPitch(ts.asMutSlice(), hz.asMutSlice(), cf.asMutSlice())
          if got > 0 {
            applyNeuralPitchFrames(
              self.refClip.pitchFrames.asMutSlice(),
              ts.asSlice(),
              hz.asSlice(),
              cf.asSlice(),
              self.pitchConfig.floorHz,
              self.pitchConfig.ceilingHz,
              self.pitchConfig.intensityFloorDb,
              self.displayClarity,
            )
          }
        }
      }
      if hasFormants {
        let nf = audio_native.neuralFormantCount()
        if nf > 0 {
          let mut fts = List<f64>.make()
          let mut f1 = List<f64>.make()
          let mut f2 = List<f64>.make()
          let mut f3 = List<f64>.make()
          run fts.appendRepeated(0.0, nf)
          run f1.appendRepeated(0.0, nf)
          run f2.appendRepeated(0.0, nf)
          run f3.appendRepeated(0.0, nf)
          let got = audio_native.neuralCopyFormants(fts.asMutSlice(), f1.asMutSlice(), f2.asMutSlice(), f3.asMutSlice())
          if got > 0 {
            run applyNeuralFormantFrames(
              self.refClip.formantFrames.asMutSlice(),
              self.refClip.pitchFrames.asSlice(),
              self.displayClarity,
              fts.asSlice(),
              f1.asSlice(),
              f2.asSlice(),
              f3.asSlice(),
            )
          }
        }
      }
      let mut vm = VoiceMetricsTrack.empty()
      drop run vm.update(
        self.refClip.samples.asSlice(),
        self.refClip.sampleRate,
        self.refClip.pitchFrames.asSlice(),
        self.refClip.formantFrames.asSlice(),
        self.displayClarity,
      )
      run vm.finalizeSummary(self.refClip.samples.asSlice(), self.refClip.sampleRate)
      self.refClip.voiceFrames = move vm.frames
      self.refClip.summary = vm.summary
      self.refClip.ltas = vm.ltas
      self.refClip.hasLtas = vm.hasLtas
      run self.recomputeCompare()
      run self.refreshVowelAnalysis(true)
      run self.rebuildDrawings(true)
      return ()
    }

    if self.recording || jobId != self.takeNeuralGen {
      return ()
    }
    if hasPitch {
      let np = audio_native.neuralPitchCount()
      if np > 0 {
        let mut ts = List<f64>.make()
        let mut hz = List<f64>.make()
        let mut cf = List<f64>.make()
        run ts.appendRepeated(0.0, np)
        run hz.appendRepeated(0.0, np)
        run cf.appendRepeated(0.0, np)
        let got = audio_native.neuralCopyPitch(ts.asMutSlice(), hz.asMutSlice(), cf.asMutSlice())
        if got > 0 {
          applyNeuralPitchFrames(
            self.pitchTrack.frames.asMutSlice(),
            ts.asSlice(),
            hz.asSlice(),
            cf.asSlice(),
            self.pitchConfig.floorHz,
            self.pitchConfig.ceilingHz,
            self.pitchConfig.intensityFloorDb,
            self.displayClarity,
          )
        }
      }
    }
    if hasFormants {
      let nf = audio_native.neuralFormantCount()
      if nf > 0 {
        let mut fts = List<f64>.make()
        let mut f1 = List<f64>.make()
        let mut f2 = List<f64>.make()
        let mut f3 = List<f64>.make()
        run fts.appendRepeated(0.0, nf)
        run f1.appendRepeated(0.0, nf)
        run f2.appendRepeated(0.0, nf)
        run f3.appendRepeated(0.0, nf)
        let got = audio_native.neuralCopyFormants(fts.asMutSlice(), f1.asMutSlice(), f2.asMutSlice(), f3.asMutSlice())
        if got > 0 {
          run applyNeuralFormantFrames(
            self.formantTrack.frames.asMutSlice(),
            self.pitchTrack.frames.asSlice(),
            self.displayClarity,
            fts.asSlice(),
            f1.asSlice(),
            f2.asSlice(),
            f3.asSlice(),
          )
        }
      }
    }
    self.voiceMetrics.reset()
    drop run self.voiceMetrics.update(
      self.samples.asSlice(),
      self.sampleRate,
      self.pitchTrack.frames.asSlice(),
      self.formantTrack.frames.asSlice(),
      self.displayClarity,
    )
    run self.voiceMetrics.finalizeSummary(self.samples.asSlice(), self.sampleRate)
    run self.recomputeCompare()
    run self.refreshVowelAnalysis(false)
    run self.rebuildDrawings(true)
  }

  effect fn syncSynthReadouts(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mScale = f32.toF64(self.synthMorph)
    let effPitch = if self.synthPitchOn { self.synthPitchSemi * mScale } else { 0.0 }
    let effSize = if self.synthSizeOn { self.synthSizePct * mScale } else { 0.0 }
    let effWeight = if self.synthWeightOn { self.synthWeightDb * mScale } else { 0.0 }

    self.synthPitchStr = run formatSignedFixed(effPitch, 1, " st")

    let mut ss = String.make()
    let szRound = f64.toI32(f64.round(effSize))
    if szRound > 0 {
      run ss.append("+")
      run appendFixed(&mut ss, i32.toF64(szRound), 0)
      run ss.append("% smaller")
    } else if szRound < 0 {
      run ss.append("−")
      run appendFixed(&mut ss, i32.toF64(-szRound), 0)
      run ss.append("% bigger")
    } else {
      run ss.append("0%")
    }
    self.synthSizeStr = move ss

    let wSuffix = if effWeight > 0.15 {
      " dB lighter"
    } else if effWeight < -0.15 {
      " dB heavier"
    } else {
      " dB"
    }
    self.synthWeightStr = run formatSignedFixed(effWeight, 1, wSuffix)

    let mut ms = String.make()
    run appendFixed(&mut ms, f64.round(mScale * 100.0), 0)
    run ms.append("%")
    self.synthMorphStr = move ms
  }

  effect fn fillSynthFromRef(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || !self.compare.valid {
      return ()
    }
    // Positive deltaSemi means take is higher than ref -> shift by -deltaSemi to match ref
    let targetPitch = f64.max(-12.0, f64.min(12.0, f64.round(-self.compare.deltaSemi * 10.0) / 10.0))
    // Formant frequency ratio scales inversely with vocal tract length: VTL_take / VTL_ref
    let takeVtl = self.voiceMetrics.summary.medianVtlCm
    let refVtl = self.refClip.summary.medianVtlCm
    let rawSizePct = if takeVtl > 5.0 && refVtl > 5.0 {
      ((takeVtl / refVtl) - 1.0) * 100.0
    } else {
      0.0
    }
    let targetSize = f64.max(-25.0, f64.min(25.0, f64.round(rawSizePct)))
    // Positive deltaH1H2Db means take is lighter than ref -> shift by -deltaH1H2Db
    let targetWeight = f64.max(-8.0, f64.min(8.0, f64.round(-self.compare.deltaH1H2Db * 10.0) / 10.0))

    self.synthPitchSemi = targetPitch
    self.synthSizePct = targetSize
    self.synthWeightDb = targetWeight
    self.synthMorph = 1.0
    self.synthPitchOn = true
    self.synthSizeOn = true
    self.synthWeightOn = true
    run self.syncSynthReadouts()
  }

  effect fn renderCurrentSynth(self: &mut Self) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.samples.length() < 64 {
      return 0
    }
    let pFrames = self.pitchTrack.frames.asSlice()
    let pn = pFrames.length
    let mut f0Times = List<f64>.make()
    let mut f0Hz = List<f64>.make()
    let mut refF0 = List<f64>.make()
    run f0Times.appendRepeated(0.0, pn)
    run f0Hz.appendRepeated(0.0, pn)
    let tSl = f0Times.asMutSlice()
    let hSl = f0Hz.asMutSlice()
    let mut i: usize = 0
    while i < pn {
      tSl[i] = pFrames[i].time
      hSl[i] = if pFrames[i].voiced && pFrames[i].clarity >= self.displayClarity { pFrames[i].frequency } else { 0.0 }
      i = i + 1
    }

    let aligned = self.compare.points.asSlice()
    let hasRefF0 = self.synthFollowContour && self.refClip.active && aligned.length >= 2 && pn > 0
    if hasRefF0 {
      run refF0.appendRepeated(0.0, pn)
      let rSl = refF0.asMutSlice()
      let mut ai: usize = 0
      i = 0
      while i < pn {
        let t = pFrames[i].time
        while ai + 1 < aligned.length && aligned[ai + 1].time < t {
          ai = ai + 1
        }
        let mut best = ai
        if ai + 1 < aligned.length && f64.abs(aligned[ai + 1].time - t) < f64.abs(aligned[ai].time - t) {
          best = ai + 1
        }
        if f64.abs(aligned[best].time - t) <= 0.08 && aligned[best].voiced && aligned[best].f0 > 45.0 {
          rSl[i] = aligned[best].f0
        }
        i = i + 1
      }
    }

    let mScale = f32.toF64(self.synthMorph)
    let effPitch = if self.synthPitchOn {
      if hasRefF0 { 0.0 } else { self.synthPitchSemi * mScale }
    } else {
      0.0
    }
    let effContour = self.synthPitchOn && hasRefF0
    let effSize = if self.synthSizeOn { self.synthSizePct * mScale } else { 0.0 }
    let effWeight = if self.synthWeightOn { self.synthWeightDb * mScale } else { 0.0 }

    return audio_native.synthRender(
      self.samples.asSlice(),
      self.sampleRate,
      f0Times.asSlice(),
      f0Hz.asSlice(),
      refF0.asSlice(),
      effContour,
      effPitch,
      effContour,
      mScale,
      effSize,
      effWeight,
    )
  }

  effect fn playSynthAdjusted(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    audio_native.playStop()
    let rendered = run self.renderCurrentSynth()
    if rendered < 64 {
      return ()
    }
    let dur = self.clipDuration()
    let startS = if self.hasSelection { f64.min(self.selStart, self.selEnd) } else { 0.0 }
    let endS = if self.hasSelection { f64.max(self.selStart, self.selEnd) } else { dur }
    drop audio_native.synthPlay(startS, endS, false)
  }

  effect fn pinSynthPreviewAsRef(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let rendered = run self.renderCurrentSynth()
    if rendered < 64 {
      return ()
    }
    let mut pcm = List<f32>.make()
    run pcm.appendRepeated(0.0, rendered)
    let got = audio_native.synthCopy(pcm.asMutSlice())
    if got < 64 {
      return ()
    }
    let sr = self.sampleRate
    let mut refName = run String.copy(String.view(&self.clipName))
    run refName.append(" (target)")
    let refPath = run String.copy("synth://target-preview")
    run self.analyzeAndPinBufferAsRef(move refName, move pcm, sr, move refPath)
    self.showVoicePreview = false
    run self.rebuildDrawings(true)
  }

  /// Re-analyzes the currently pinned Reference clip using the active pitch range, clarity,
  /// and formant ceiling so Take and Reference always share identical analysis parameters!
  effect fn reanalyzeRefClip(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || self.refClip.samples.length() < 64 {
      return ()
    }
    let sr = self.refClip.sampleRate
    let mut pt = PitchTrack.empty()
    run pt.reset(sr, self.pitchConfig)
    drop run pt.update(self.refClip.samples.asSlice())
    run pt.refineViterbi(self.displayClarity)
    let mut ft = FormantTrack.empty()
    run ft.reset(sr, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    drop run ft.update(self.refClip.samples.asSlice())
    run ft.refineTracked(pt.frames.asSlice(), self.displayClarity)
    let mut vm = VoiceMetricsTrack.empty()
    drop run vm.update(self.refClip.samples.asSlice(), sr, pt.frames.asSlice(), ft.frames.asSlice(), self.displayClarity)
    run vm.finalizeSummary(self.refClip.samples.asSlice(), sr)
    self.refClip.pitchFrames = move pt.frames
    self.refClip.formantFrames = move ft.frames
    self.refClip.voiceFrames = move vm.frames
    self.refClip.summary = vm.summary
    self.refClip.ltas = vm.ltas
    self.refClip.hasLtas = vm.hasLtas
    self.requestNeuralForRef()
    run self.refreshVowelAnalysis(true)
  }

  effect fn reanalyzeFormants(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.formantTrack.reset(self.sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    drop run self.formantTrack.update(self.samples.asSlice())
    run self.formantTrack.refineTracked(self.pitchTrack.frames.asSlice(), self.displayClarity)
    self.voiceMetrics.reset()
    drop run self.voiceMetrics.update(
      self.samples.asSlice(),
      self.sampleRate,
      self.pitchTrack.frames.asSlice(),
      self.formantTrack.frames.asSlice(),
      self.displayClarity,
    )
    run self.voiceMetrics.finalizeSummary(self.samples.asSlice(), self.sampleRate)
    run self.reanalyzeRefClip()
    run self.recomputeCompare()
    run self.rebuildDrawings(true)
  }

  effect fn analyzeAndPinBufferAsRef(
    self: &mut Self,
    name: String,
    samples: List<f32>,
    sampleRate: f64,
    fullPath: String,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut pt = PitchTrack.empty()
    run pt.reset(sampleRate, self.pitchConfig)
    drop run pt.update(samples.asSlice())
    run pt.refineViterbi(self.displayClarity)
    let mut ft = FormantTrack.empty()
    run ft.reset(sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    drop run ft.update(samples.asSlice())
    run ft.refineTracked(pt.frames.asSlice(), self.displayClarity)
    let mut vm = VoiceMetricsTrack.empty()
    drop run vm.update(samples.asSlice(), sampleRate, pt.frames.asSlice(), ft.frames.asSlice(), self.displayClarity)
    run vm.finalizeSummary(samples.asSlice(), sampleRate)

    let dur = usize.toF64(samples.length()) / sampleRate
    self.refClip = ReferenceClip {
      active: true,
      fullPath: move fullPath,
      name: move name,
      samples: move samples,
      sampleRate: sampleRate,
      durationSec: dur,
      pitchFrames: move pt.frames,
      formantFrames: move ft.frames,
      voiceFrames: move vm.frames,
      summary: vm.summary,
      ltas: vm.ltas,
      hasLtas: vm.hasLtas,
    }
    self.showRefOverlay = true
    self.gpuNeedRefReload = true
    let refExpCopy = run String.copy(String.view(&self.refClip.fullPath))
    if String.byteLength(String.view(&refExpCopy)) > 0 {
      run self.ensureDirExpanded(String.view(&refExpCopy))
    }
    run self.recomputeNormGain()
    run self.recomputeCompare()
    run self.reloadTree(false)
    run self.startBgScoring(false)
    self.requestNeuralForRef()
    run self.refreshVowelAnalysis(true)
    run self.saveSessionPrefs()
  }

  /// Promotes the currently open clip into `self.refClip` in memory (used right before recording a new take
  /// or starting Repeat Drill while viewing a Reference clip).
  effect fn activateCurrentRefForRecording(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.samples.length() < 64 {
      return ()
    }
    let refSamples = run copyF32List(self.samples.asSlice())
    let mut refPitch = List<PitchFrame>.make()
    run refPitch.appendSlice(self.pitchTrack.frames.asSlice())
    let mut refFormants = List<FormantFrame>.make()
    run refFormants.appendSlice(self.formantTrack.frames.asSlice())
    let mut refVoice = List<VoiceFrame>.make()
    run refVoice.appendSlice(self.voiceMetrics.frames.asSlice())

    self.refClip = ReferenceClip {
      active: true,
      fullPath: run String.copy(String.view(&self.activeClipPath)),
      name: run String.copy(String.view(&self.clipName)),
      samples: move refSamples,
      sampleRate: self.sampleRate,
      durationSec: self.clipDuration(),
      pitchFrames: move refPitch,
      formantFrames: move refFormants,
      voiceFrames: move refVoice,
      summary: self.voiceMetrics.summary,
      ltas: self.voiceMetrics.ltas,
      hasLtas: self.voiceMetrics.hasLtas,
    }
    self.showRefOverlay = true
    self.gpuNeedRefReload = true
    let refExpCopy = run String.copy(String.view(&self.refClip.fullPath))
    if String.byteLength(String.view(&refExpCopy)) > 0 {
      run self.ensureDirExpanded(String.view(&refExpCopy))
    }
  }

  /// Turns the currently open clip into a Reference clip in the library.
  /// Because you are viewing the Reference itself, no comparison ref is set active until you record or open a take under it.
  effect fn pinCurrentAsReference(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.samples.length() < 64 {
      return ()
    }
    if !self.activeClipInLib {
      self.pendingNewRef = true
      run self.saveCurrentClipToFolder(false)
    } else {
      drop audio_native.libSetIsRef(
        String.view(&self.activeClipDir),
        String.view(&self.activeClipFilename),
        true,
      )
    }
    self.clearActiveRefSilent()
    run self.reloadTree(false)
    run self.recomputeNormGain()
    run self.recomputeCompare()
    run self.saveSessionPrefs()
    self.statusMsg = run String.copy("Turned into Reference · Press R (Rec take) or Repeat drill to record takes under it")
    run self.rebuildDrawings(false)
  }

  /// Saves current document to a real `.wav` file in the current folder (or updates it in-place if already a library WAV).
  effect fn saveCurrentClipToFolder(self: &mut Self, forceNewFile: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.samples.length() < 64 {
      return ()
    }
    let updateInPlace = !forceNewFile
      && self.activeClipInLib
      && String.byteLength(String.view(&self.activeClipFilename)) > 0

    let makeNewRef = self.pendingNewRef && !updateInPlace
    self.pendingNewRef = false

    let attachToRef = !updateInPlace
      && !makeNewRef
      && self.refClip.active
      && String.byteLength(String.view(&self.refClip.fullPath)) > 0

    let sc: i32 = if (attachToRef || (updateInPlace && String.byteLength(String.view(&self.activeClipParentRef)) > 0))
      && self.compare.score.valid
      && String.view(&self.activeClipPath) != String.view(&self.refClip.fullPath)
    {
      u32.toI32(self.compare.score.overall)
    } else {
      -1
    }

    let mut refDir = String.make()
    if attachToRef {
      let rIdx = self.findLibIdxByFullPath(String.view(&self.refClip.fullPath))
      if rIdx < self.libTree.length() {
        refDir = run String.copy(String.view(&self.libTree.asSlice()[rIdx].parentRel))
      }
    }

    let saveDir = if updateInPlace {
      run String.copy(String.view(&self.activeClipDir))
    } else if attachToRef && String.byteLength(String.view(&refDir)) > 0 {
      move refDir
    } else if String.byteLength(String.view(&self.selectedFolderRel)) > 0 {
      run String.copy(String.view(&self.selectedFolderRel))
    } else {
      // Loose recording with no reference -> default to "General" folder!
      run String.copy("General")
    }
    let desired = if updateInPlace {
      run String.copy(String.view(&self.activeClipFilename))
    } else if !self.isDemoClip
      && String.byteLength(String.view(&self.clipName)) > 0
      && String.view(&self.clipName) != "Live Microphone"
      && String.view(&self.clipName) != "Untitled Recording"
    {
      run String.copy(String.view(&self.clipName))
    } else if attachToRef && String.byteLength(String.view(&self.refClip.name)) > 0 {
      let mut tn = run String.copy(String.view(&self.refClip.name))
      run tn.append(" take")
      move tn
    } else if makeNewRef {
      run String.copy("reference")
    } else {
      run String.copy("recording")
    }

    let sr = self.sampleRate
    let res = run audio_native.libSaveWav(
      String.view(&saveDir),
      String.view(&desired),
      updateInPlace,
      self.samples.asSlice(),
      sr,
      -1,
    )
    if res.ok {
      let dirCopy = run String.copy(String.view(&saveDir))
      self.clipName = run Overtone.stripAudioExt(String.view(&res.filename))
      self.activeClipFilename = run String.copy(String.view(&res.filename))
      self.activeClipPath = move res.fullPath
      self.activeClipDir = move saveDir
      self.activeClipInLib = true
      self.isDemoClip = false
      if makeNewRef {
        drop audio_native.libSetIsRef(
          String.view(&self.activeClipDir),
          String.view(&self.activeClipFilename),
          true,
        )
        self.activeClipIsRef = true
        self.activeClipParentRef.clear()
      } else if attachToRef {
        drop audio_native.libSetParentRef(
          String.view(&self.activeClipDir),
          String.view(&self.activeClipFilename),
          String.view(&self.refClip.fullPath),
        )
        self.activeClipIsRef = false
        self.activeClipParentRef = run String.copy(String.view(&self.refClip.fullPath))
        let refExp = run String.copy(String.view(&self.refClip.fullPath))
        run self.ensureDirExpanded(String.view(&refExp))
      }
      if sc >= 0 && self.refClip.active && String.byteLength(String.view(&self.activeClipParentRef)) > 0 {
        drop audio_native.libUpdateScores(
          String.view(&self.activeClipDir),
          String.view(&self.activeClipFilename),
          String.view(&self.refClip.fullPath),
          u32.toI32(self.compare.score.overall),
          u32.toI32(self.compare.score.pitchScore),
          u32.toI32(self.compare.score.sizeScore),
          u32.toI32(self.compare.score.weightScore),
          u32.toI32(self.compare.score.vowelScore),
          SCORE_VERSION,
        )
      }
      run self.ensureDirExpanded(String.view(&dirCopy))
      run self.reloadTree(false)
      run self.saveSessionPrefs()
      let mut msg = String.make()
      run msg.append("Saved ")
      run msg.append(String.view(&self.clipName))
      self.statusMsg = move msg
    }
  }

  /// Extracts `[selStart..selEnd]` from the currently viewed audio into a real `.wav` clip in the selected folder!
  effect fn saveSelectionAsClip(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.hasSelection {
      return ()
    }
    let lo = f64.min(self.selStart, self.selEnd)
    let hi = f64.max(self.selStart, self.selEnd)
    if hi - lo < 0.08 {
      self.errorMsg = run String.copy("Selection is too short — Shift+Drag at least 0.1s.")
      return ()
    }
    let sr = self.gpuSampleRate()
    let src = self.gpuSamples()
    let i0 = f64.toUsize(f64.max(0.0, f64.floor(lo * sr)))
    let i1Raw = f64.toUsize(f64.ceil(hi * sr))
    let i1 = if i1Raw > src.length { src.length } else { i1Raw }
    if i1 <= i0 + 64 {
      return ()
    }
    let mut sliced = List<f32>.make()
    let mut k = i0
    while k < i1 {
      run sliced.append(src[k])
      k = k + 1
    }

    let targetDir = run String.copy(String.view(&self.selectedFolderRel))
    let res = run audio_native.libSaveWav(
      String.view(&targetDir),
      "clip",
      false,
      sliced.asSlice(),
      sr,
      -1,
    )
    self.hasSelection = false
    self.readoutSelSpan.clear()
    if res.ok {
      let dispCopy = run Overtone.stripAudioExt(String.view(&res.filename))
      self.activeClipFilename = move res.filename
      self.activeClipPath = move res.fullPath
      self.activeClipDir = run String.copy(String.view(&targetDir))
      self.activeClipInLib = true
      self.plotOnRef = false
      run self.ensureDirExpanded(String.view(&targetDir))
      run self.loadSamples(move dispCopy, move sliced, sr)
      run self.reloadTree(false)
      let mut msg = String.make()
      run msg.append("Saved selection as ")
      run msg.append(String.view(&self.clipName))
      self.statusMsg = move msg
    }
  }

  /// Opens a real audio clip from the Explorer tree in the editor, OR sets it as the current Reference.
  effect fn loadLibraryClip(self: &mut Self, idx: usize, setAsRef: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if isPractice(self.transport.value) {
      run self.sendTransport(TransportEvent.StopAll)
    }
    let nodes = self.libTree.asSlice()
    if idx >= nodes.length || nodes[idx].isDir {
      return ()
    }
    let path = run String.copy(String.view(&nodes[idx].fullPath))
    let fname = run String.copy(String.view(&nodes[idx].name))
    let dispName = run String.copy(String.view(&nodes[idx].displayName))
    let parentDir = run String.copy(String.view(&nodes[idx].parentRel))
    let parentRef = run String.copy(String.view(&nodes[idx].parentRef))
    let isClipRef = nodes[idx].isRef || nodes[idx].childCount > 0

    // Strict reference activation rule:
    // - Child of a reference -> its parent reference becomes active!
    // - Reference itself OR loose clip (no parent ref) -> nothing is set as reference!
    if !setAsRef {
      if String.byteLength(String.view(&parentRef)) > 0 && !isClipRef {
        let alreadyActiveRef = self.refClip.active && String.view(&self.refClip.fullPath) == String.view(&parentRef)
        if !alreadyActiveRef {
          let pIdx = self.findLibIdxByFullPath(String.view(&parentRef))
          if pIdx < self.libTree.length() {
            run self.loadLibraryClip(pIdx, true)
          } else {
            self.clearActiveRefSilent()
          }
        }
      } else {
        self.clearActiveRefSilent()
      }
    }

    match move run audio_native.loadAudioFile(String.view(&path)) {
      Option<audio_native.LoadedAudio>.Some { value } => {
        if setAsRef {
          let nameCopy = run String.copy(String.view(&dispName))
          run self.analyzeAndPinBufferAsRef(move nameCopy, move value.samples, value.sampleRate, move path)
          if self.isPlottingOnRef() {
            self.vp.reset(f64.max(self.refClip.durationSec, 0.25), self.refClip.sampleRate * 0.5)
            self.vp.setTimeRange(0.0, f64.max(self.refClip.durationSec, 0.25))
            self.gpuNeedFullReload = true
            self.gpuNeedSharp = true
            self.sharpDueTime = 0.0
          }
          run self.reloadTree(false)
          let mut msg = String.make()
          run msg.append("Current Ref → ")
          run msg.append(String.view(&dispName))
          self.statusMsg = move msg
          run self.rebuildDrawings(true)
        } else {
          self.activeClipPath = move path
          self.activeClipFilename = move fname
          self.activeClipDir = run String.copy(String.view(&parentDir))
          self.selectedFolderRel = move parentDir
          self.activeClipInLib = true
          self.activeClipIsRef = isClipRef
          self.activeClipParentRef = move parentRef
          self.pendingNewRef = false
          self.plotOnRef = false
          run self.loadSamples(move dispName, move value.samples, value.sampleRate)
          run self.recomputeNormGain()
          run self.refreshActiveLibMeta()
          run self.saveSessionPrefs()
        }
      }
      Option<audio_native.LoadedAudio>.None => {
        self.errorMsg = run String.copy("Could not decode audio file (supports WAV, MP3, M4A, FLAC, AIFF).")
      }
    }
  }

  effect fn loadSamples(self: &mut Self, name: String, samples: List<f32>, sampleRate: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.sendTransport(TransportEvent.StopAll)
    self.clipName = move name
    self.samples = move samples
    self.sampleRate = sampleRate
    self.isDemoClip = false
    let dur = self.gpuDuration()
    let sr = self.gpuSampleRate()
    self.vp.reset(f64.max(dur, 0.25), sr * 0.5)
    self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
    self.cursorSec = f64.min(dur * 0.25, dur)
    self.hasSelection = false
    self.readoutSelSpan.clear()
    self.errorMsg.clear()
    self.statusMsg = run String.copy("Loaded clip · Shift+Drag to slice a selection into a Ref or Take")
    run self.analyzeAll()
    self.gpuNeedFullReload = true
    self.gpuNeedSharp = true
    self.sharpDueTime = 0.0
    self.gpuNeedRedraw = true
    run self.rebuildDrawings(true)
  }

  /// Trims excess leading silence from `self.preRoll` before prepending into a practice take,
  /// preserving ~0.18s of lead-in before the earliest speech onset so soft consonants & early starts
  /// during the final second of the Reference are NEVER cut off!
  effect fn appendTrimmedPreRoll(self: &mut Self, sampleRate: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let sl = self.preRoll.asSlice()
    if sl.length == 0 {
      return ()
    }
    let sr = if sampleRate > 0.0 { sampleRate } else { 48000.0 }
    let chunk = f64.toUsize(f64.max(64.0, sr * 0.015))
    let leadIn = f64.toUsize(sr * 0.18)
    // Threshold 8 dB below VAD gate catches soft consonant onsets (/p/, /t/, /f/, /h/, "the...")
    let onsetDb = f32.toF64(self.vadThresholdDb) - 8.0
    let onsetRms = f64.pow(10.0, onsetDb / 20.0)
    let onsetSq = onsetRms * onsetRms

    let mut firstSpeech: usize = sl.length
    let mut pos: usize = 0
    while pos + chunk <= sl.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < chunk {
        let v = f32.toF64(sl[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      if (sq / usize.toF64(chunk)) >= onsetSq {
        firstSpeech = pos
        break
      }
      pos = pos + chunk
    }
    let startIdx = if firstSpeech < sl.length {
      if firstSpeech > leadIn { firstSpeech - leadIn } else { 0 }
    } else {
      let fallbackKeep = f64.toUsize(sr * 0.35)
      if sl.length > fallbackKeep { sl.length - fallbackKeep } else { 0 }
    }
    let mut k = startIdx
    while k < sl.length {
      run self.samples.append(sl[k])
      k = k + 1
    }
    self.preRoll.clear()
  }

  /// Checks whether the pre-armed pre-roll buffer already contains speech above `vadThresholdDb`.
  fn preRollHasSpeech(self: &Self, sampleRate: f64) -> bool {
    let sl = self.preRoll.asSlice()
    if sl.length < 256 {
      return false
    }
    let sr = if sampleRate > 0.0 { sampleRate } else { 48000.0 }
    let chunk = f64.toUsize(f64.max(64.0, sr * 0.020))
    let threshRms = f64.pow(10.0, f32.toF64(self.vadThresholdDb) / 20.0)
    let threshSq = threshRms * threshRms
    let mut pos: usize = 0
    while pos + chunk <= sl.length {
      let mut sq: f64 = 0.0
      let mut j: usize = 0
      while j < chunk {
        let v = f32.toF64(sl[pos + j])
        sq = sq + v * v
        j = j + 1
      }
      if (sq / usize.toF64(chunk)) >= threshSq {
        return true
      }
      pos = pos + chunk
    }
    return false
  }

  effect fn beginLiveRecStream(self: &mut Self, prependPreRoll: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.plotOnRef = false
    self.recording = true
    self.followRecording = true
    self.isDemoClip = false
    self.samples.clear()
    self.sampleRate = audio_native.micSampleRate()
    if self.sampleRate <= 0.0 {
      self.sampleRate = 48000.0
    }
    if prependPreRoll && self.preRoll.length() > 0 {
      let sr = self.sampleRate
      run self.appendTrimmedPreRoll(sr)
    }
    self.clipName = run String.copy("Live Microphone")
    self.activeClipPath.clear()
    self.activeClipFilename.clear()
    self.activeClipDir.clear()
    self.activeClipInLib = false
    self.hasSelection = false
    self.readoutSelSpan.clear()
    self.cursorSec = self.clipDuration()
    self.vp.reset(RECORD_VIEW_S, self.sampleRate * 0.5)
    self.coarseTracker = TierTracker.make(COARSE_HOP, 0.0)
    self.liveTracker = TierTracker.make(LIVE_HOP, f64.min(self.sampleRate * 0.5, 16000.0))
    run self.pitchTrack.reset(self.sampleRate, self.pitchConfig)
    run self.formantTrack.reset(self.sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
    self.voiceMetrics.reset()
    self.gpuNeedBeginRec = true
    self.gpuNeedFullReload = false
    self.gpuNeedSharp = false
    self.gpuNeedRedraw = true
  }

  /// Recording effect triggered by the `silk.machine` transport statechart:
  /// SAFE REFERENCE PROTECTION: if the currently open clip IS a Reference (and user
  /// didn't explicitly choose "Record onto this ref"), activates it as `self.refClip` and
  /// ALWAYS starts a brand-new take attached as a child of that Reference!
  effect fn doStartRecording(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let protectRef = self.isViewingRefClip() && !self.recordOntoRefOnce && self.samples.length() >= 64
    self.recordOntoRefOnce = false
    if protectRef && !self.refClip.active {
      run self.activateCurrentRefForRecording()
    }
    let appending = !protectRef && !self.isDemoClip && self.samples.length() > 0 && self.sampleRate > 0.0
    let wantRate = if appending { self.sampleRate } else { 0.0 }
    if !audio_native.micStartAt(wantRate) {
      self.errorMsg = run audio_native.micError()
      if String.byteLength(String.view(&self.errorMsg)) == 0 {
        self.errorMsg = run String.copy("Could not open microphone.")
      }
      run self.sendTransport(TransportEvent.MicFailed)
      return ()
    }
    self.errorMsg.clear()
    if appending {
      // Save undo before appending so user can undo a bad appended take!
      run self.saveUndoSnapshot()
      self.plotOnRef = false
      self.followRecording = true
      // Optional VoceVista silence gap between appended takes
      if self.recSilenceGapSec > 0.01 {
        let gapSamples = f64.toUsize(f64.round(self.recSilenceGapSec * self.sampleRate))
        if gapSamples > 0 {
          run self.samples.appendRepeated(0.0, gapSamples)
        }
      }
      self.hasSelection = false
      self.readoutSelSpan.clear()
      let dur = self.clipDuration()
      self.cursorSec = dur
      let winSpan = f64.max(RECORD_VIEW_S, self.vp.t1 - self.vp.t0)
      let maxDur = f64.max(dur + 2.0, winSpan)
      self.vp.setLimits(maxDur, self.sampleRate * 0.5)
      if dur > winSpan - 1.5 {
        self.vp.setTimeRange(f64.max(0.0, dur - winSpan + 1.5), dur + 1.5)
      } else {
        self.vp.setTimeRange(0.0, winSpan)
      }
      self.coarseTracker = TierTracker.make(COARSE_HOP, 0.0)
      self.liveTracker = TierTracker.make(LIVE_HOP, f64.min(self.sampleRate * 0.5, 16000.0))
      run self.pitchTrack.reset(self.sampleRate, self.pitchConfig)
      drop run self.pitchTrack.update(self.samples.asSlice())
      run self.formantTrack.reset(self.sampleRate, self.formantCeilingHz, self.pitchConfig.hopSeconds)
      drop run self.formantTrack.update(self.samples.asSlice())
      self.voiceMetrics.reset()
      drop run self.voiceMetrics.update(
        self.samples.asSlice(),
        self.sampleRate,
        self.pitchTrack.frames.asSlice(),
        self.formantTrack.frames.asSlice(),
        self.displayClarity,
      )
      self.gpuNeedBeginRec = true
      self.gpuNeedRecAppend = true
      self.gpuNeedFullReload = false
      self.gpuNeedSharp = false
      self.gpuNeedRedraw = true
      self.statusMsg = run String.copy("Appending live mic to document… press R or Space to stop (⌘N for blank doc)")
    } else {
      run self.beginLiveRecStream(false)
      self.statusMsg = run String.copy("Recording live microphone… press R or Space to stop")
    }
    run self.rebuildDrawings(true)
  }

  effect fn doStopRecording(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    drop run audio_native.micDrainInto(&mut self.samples)
    audio_native.micStop()
    self.inputLevelDb = -120.0
    drop run self.pitchTrack.update(self.samples.asSlice())
    run self.pitchTrack.refineViterbi(self.displayClarity)
    drop run self.formantTrack.update(self.samples.asSlice())
    run self.formantTrack.refineTracked(self.pitchTrack.frames.asSlice(), self.displayClarity)
    self.voiceMetrics.reset()
    drop run self.voiceMetrics.update(
      self.samples.asSlice(),
      self.sampleRate,
      self.pitchTrack.frames.asSlice(),
      self.formantTrack.frames.asSlice(),
      self.displayClarity,
    )
    run self.voiceMetrics.finalizeSummary(self.samples.asSlice(), self.sampleRate)
    run self.recomputeCompare()
    self.requestNeuralForTake()
    let dur = self.clipDuration()
    self.cursorSec = dur
    if dur > 0.05 {
      self.vp.setLimits(f64.max(dur, 0.25), self.sampleRate * 0.5)
      self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
      run self.saveCurrentClipToFolder(false)
    }
    self.gpuNeedFullReload = true
    self.scheduleSharp()
    run self.rebuildDrawings(true)
  }

  fn trimTrailingSilence(self: &mut Self, silenceSec: f64) -> () {
    let keepTail = 0.12
    if silenceSec <= keepTail || self.sampleRate <= 0.0 {
      return ()
    }
    let trimSec = silenceSec - keepTail
    let trimSamples = f64.toUsize(trimSec * self.sampleRate)
    let minKeep = f64.toUsize(0.25 * self.sampleRate)
    if self.samples.length() > trimSamples + minKeep {
      let newLen = self.samples.length() - trimSamples
      self.samples.truncate(newLen)
    }
  }

  effect fn doFinishPracticeTake(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    drop run audio_native.micDrainInto(&mut self.samples)
    audio_native.micStop()
    self.inputLevelDb = -120.0
    let silSec = self.silenceAccumSec
    self.trimTrailingSilence(silSec)
    self.silenceAccumSec = 0.0
    self.silenceProgress = 0.0

    let dur = self.clipDuration()
    self.vp.reset(f64.max(dur, 0.25), self.sampleRate * 0.5)
    self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
    self.cursorSec = 0.0
    run self.analyzeAll()
    if self.compare.score.valid {
      self.drillRound = self.drillRound + 1
      let sc = u32.toI32(self.compare.score.overall)
      self.drillLastScore = sc
      if sc > self.drillBestScore {
        self.drillBestScore = sc
      }
    }
    run self.saveCurrentClipToFolder(true)
    self.gpuNeedFullReload = true
    self.gpuNeedSharp = true
    self.sharpDueTime = 0.0
    self.gpuNeedRedraw = true
  }

  effect fn drainPreRoll(self: &mut Self, maxSeconds: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.inputLevelDb = audio_native.micLevelDb()
    let added = run audio_native.micDrainInto(&mut self.preRoll)
    if added > 0 {
      let sr = audio_native.micSampleRate()
      let maxPre = f64.toUsize(maxSeconds * (if sr > 0.0 { sr } else { 48000.0 }))
      if self.preRoll.length() > maxPre {
        let dropN = self.preRoll.length() - maxPre
        let mut trimmed = List<f32>.make()
        let sl = self.preRoll.asSlice()
        let mut k = dropN
        while k < sl.length {
          run trimmed.append(sl[k])
          k = k + 1
        }
        self.preRoll = move trimmed
      }
    }
  }

  effect fn doArmPracticeListening(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let wasPreArmed = audio_native.micRunning()
    if !wasPreArmed {
      if !audio_native.micStart() {
        self.errorMsg = run audio_native.micError()
        if String.byteLength(String.view(&self.errorMsg)) == 0 {
          self.errorMsg = run String.copy("Could not open microphone for practice mode.")
        }
        run self.sendTransport(TransportEvent.MicFailed)
        return ()
      }
      self.preRoll.clear()
    } else {
      // Mic was already pre-armed 1.0s before the Reference finished! Keep the captured pre-roll!
      run self.drainPreRoll(1.15)
    }
    self.errorMsg.clear()
    self.silenceAccumSec = 0.0
    self.silenceProgress = 0.0
    self.practiceStatus = if isDrill(self.transport.value) {
      run String.copy("Your turn — speak now…")
    } else {
      run String.copy("Listening — say a phrase…")
    }
    // If the user ALREADY started speaking during the final second of the Reference,
    // promote directly into DrillRecord right now with ZERO cut-off!
    let micSr = audio_native.micSampleRate()
    if wasPreArmed && (self.inputLevelDb >= self.vadThresholdDb || self.preRollHasSpeech(micSr)) {
      run self.sendTransport(TransportEvent.PracticeSpeechStarted)
      return ()
    }
    run self.rebuildDrawings(false)
  }

  effect fn doStartDrillRefPlayback(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || self.refClip.durationSec <= 0.02 {
      run self.sendTransport(TransportEvent.PlayFailed)
      return ()
    }
    audio_native.micStop()
    audio_native.playStop()
    self.preRoll.clear()
    if audio_native.playRange(self.refClip.samples.asSlice(), self.refClip.sampleRate, 0.0, self.refClip.durationSec, false) {
      self.practiceStatus = run String.copy("Playing Reference…")
      self.silenceAccumSec = 0.0
      self.silenceProgress = 0.0
      run self.rebuildDrawings(false)
    } else {
      run self.sendTransport(TransportEvent.PlayFailed)
    }
  }

  effect fn doAbortPractice(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    audio_native.micStop()
    audio_native.playStop()
    self.practiceStatus.clear()
    self.preRoll.clear()
    self.silenceAccumSec = 0.0
    self.silenceProgress = 0.0
    self.phaseTimerSec = 0.0
    self.inputLevelDb = -120.0
    self.statusMsg = run String.copy("Practice stopped · Takes saved in your library")
    run self.rebuildDrawings(true)
  }

  effect fn stepPracticeTick(self: &mut Self, dt: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match self.transport.value {
      TransportState.DrillPlayRef => {
        // Pre-arm microphone 1.0s before the Reference finishes so speaking early (or right on cue)
        // is captured continuously in the 1.15s pre-roll with ZERO cut-off!
        let pos = audio_native.playPosition()
        let rem = self.refClip.durationSec - pos
        if rem <= 1.05 {
          if !audio_native.micRunning() {
            if audio_native.micStart() {
              self.preRoll.clear()
              self.practiceStatus = run String.copy("Playing Ref (mic ready)…")
            }
          }
          if audio_native.micRunning() {
            run self.drainPreRoll(1.15)
          }
        }
        if audio_native.takeFinished() {
          run self.sendTransport(TransportEvent.PlaybackEnded)
        }
      }
      TransportState.DrillListen => {
        run self.stepPracticeListenTick()
      }
      TransportState.EchoListen => {
        run self.stepPracticeListenTick()
      }
      TransportState.DrillRecord => {
        run self.stepPracticeRecordTick(dt)
      }
      TransportState.EchoRecord => {
        run self.stepPracticeRecordTick(dt)
      }
      TransportState.EchoPlayback => {
        if audio_native.takeFinished() {
          self.cursorSec = self.clipDuration()
          run self.sendTransport(TransportEvent.PlaybackEnded)
        } else {
          self.cursorSec = audio_native.playPosition()
          run self.updateCursorFast(false)
        }
      }
      TransportState.DrillCooldown => {
        self.phaseTimerSec = self.phaseTimerSec - dt
        if self.phaseTimerSec <= 0.0 {
          run self.sendTransport(TransportEvent.PracticeCooldownDone)
        }
      }
      TransportState.EchoCooldown => {
        self.phaseTimerSec = self.phaseTimerSec - dt
        if self.phaseTimerSec <= 0.0 {
          run self.sendTransport(TransportEvent.PracticeCooldownDone)
        }
      }
      _ => ()
    }
  }

  effect fn stepPracticeListenTick(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.drainPreRoll(1.15)
    if self.inputLevelDb >= self.vadThresholdDb {
      run self.sendTransport(TransportEvent.PracticeSpeechStarted)
    }
  }

  effect fn stepPracticeRecordTick(self: &mut Self, dt: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.inputLevelDb = audio_native.micLevelDb()
    let added = run audio_native.micDrainInto(&mut self.samples)
    if added > 0 {
      let dur = self.clipDuration()
      self.cursorSec = dur
      let newLimitsDur = f64.max(dur, RECORD_VIEW_S)
      self.vp.setLimits(newLimitsDur, self.sampleRate * 0.5)
      if self.followRecording && dur > self.vp.t1 {
        let span = self.vp.t1 - self.vp.t0
        self.vp.setTimeRange(dur - span, dur)
      }
      drop run self.pitchTrack.update(self.samples.asSlice())
      drop run self.formantTrack.update(self.samples.asSlice())
      drop run self.voiceMetrics.update(
        self.samples.asSlice(),
        self.sampleRate,
        self.pitchTrack.frames.asSlice(),
        self.formantTrack.frames.asSlice(),
        self.displayClarity,
      )
      self.gpuNeedRecAppend = true
      self.gpuNeedRedraw = true
      run self.rebuildDrawings(true)
    }

    if self.inputLevelDb < self.vadThresholdDb {
      self.silenceAccumSec = self.silenceAccumSec + dt
    } else {
      self.silenceAccumSec = 0.0
    }
    let prog = f64.toF32(f64.max(0.0, f64.min(1.0, self.silenceAccumSec / f64.max(0.15, self.silenceHoldSec))))
    self.silenceProgress = prog
    if self.silenceAccumSec > 0.10 {
      let mut st = String.make()
      run st.append("Silence ")
      let sStr = run formatSecShort(self.silenceAccumSec)
      run st.append(String.view(&sStr))
      run st.append(" / ")
      let tStr = run formatSecShort(self.silenceHoldSec)
      run st.append(String.view(&tStr))
      self.practiceStatus = move st
    } else {
      self.practiceStatus = if isDrill(self.transport.value) {
        run String.copy("Recording repetition…")
      } else {
        run String.copy("Recording phrase…")
      }
    }

    if self.silenceAccumSec >= self.silenceHoldSec && self.clipDuration() >= 0.30 {
      run self.sendTransport(TransportEvent.PracticeSilenceDone)
    }
  }

  fn monoTargetHz(self: &Self) -> f64 {
    if self.refClip.active && self.refClip.summary.medianF0 > 55.0 {
      return self.refClip.summary.medianF0
    }
    if self.voiceMetrics.summary.medianF0 > 55.0 {
      return self.voiceMetrics.summary.medianF0
    }
    return 195.0
  }

  effect fn doStartPlayback(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let dur = self.gpuDuration()
    if dur <= 0.01 {
      run self.sendTransport(TransportEvent.PlayFailed)
      return ()
    }
    let mut startSec = self.cursorSec
    let mut endSec = dur
    if self.hasSelection {
      let lo = f64.min(self.selStart, self.selEnd)
      let hi = f64.max(self.selStart, self.selEnd)
      if hi - lo > 0.01 {
        if startSec < lo || startSec >= hi - 0.02 {
          startSec = lo
        }
        endSec = hi
      }
    } else if startSec >= dur - 0.02 {
      startSec = 0.0
    }
    let sr = self.gpuSampleRate()
    let onRef = self.isPlottingOnRef()
    let wantMix = self.refClip.active && self.listenMode == LISTEN_BOTH && !self.isEditingActiveRef()
    let wantRef = self.refClip.active && self.listenMode == LISTEN_REF
    let started = if wantMix {
      let maxDur = f64.max(self.clipDuration(), self.refClip.durationSec)
      let mixEnd = if self.hasSelection { endSec } else { maxDur }
      audio_native.playMix(
        self.samples.asSlice(),
        self.sampleRate,
        self.refClip.samples.asSlice(),
        self.refClip.sampleRate,
        startSec,
        mixEnd,
        self.loopSelection,
        self.activeTakeGainDb(),
        0.0,
      )
    } else if wantRef {
      audio_native.playSetGainDb(0.0)
      let refEnd = f64.min(self.refClip.durationSec, if self.hasSelection { endSec } else { self.refClip.durationSec })
      let refStart = f64.min(startSec, f64.max(0.0, refEnd - 0.02))
      if self.isolateMode != ISOLATE_FULL || self.voiceLabMode != LAB_OFF {
        audio_native.playFiltered(
          true,
          self.refClip.samples.asSlice(),
          self.refClip.sampleRate,
          refStart,
          refEnd,
          self.loopSelection,
          self.isolateMode,
          self.isolateTiming,
          self.voiceLabMode,
          self.monoTargetHz(),
        )
      } else {
        audio_native.playRange(self.refClip.samples.asSlice(), self.refClip.sampleRate, refStart, refEnd, self.loopSelection)
      }
    } else {
      audio_native.playSetGainDb(self.activeTakeGainDb())
      if self.isolateMode != ISOLATE_FULL || self.voiceLabMode != LAB_OFF {
        audio_native.playFiltered(
          onRef,
          self.gpuSamples(),
          sr,
          startSec,
          endSec,
          self.loopSelection,
          self.isolateMode,
          self.isolateTiming,
          self.voiceLabMode,
          self.monoTargetHz(),
        )
      } else {
        audio_native.playRange(self.gpuSamples(), sr, startSec, endSec, self.loopSelection)
      }
    }
    if started {
      self.cursorSec = startSec
      run self.updateCursorFast(true)
    } else {
      run self.sendTransport(TransportEvent.PlayFailed)
    }
  }

  effect fn doStartRefPlayback(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.refClip.active || self.refClip.durationSec <= 0.02 {
      run self.sendTransport(TransportEvent.PlayFailed)
      return ()
    }
    let started = if self.isolateMode != ISOLATE_FULL || self.voiceLabMode != LAB_OFF {
      audio_native.playFiltered(
        true,
        self.refClip.samples.asSlice(),
        self.refClip.sampleRate,
        0.0,
        self.refClip.durationSec,
        false,
        self.isolateMode,
        self.isolateTiming,
        self.voiceLabMode,
        self.monoTargetHz(),
      )
    } else {
      audio_native.playRange(self.refClip.samples.asSlice(), self.refClip.sampleRate, 0.0, self.refClip.durationSec, false)
    }
    if !started {
      run self.sendTransport(TransportEvent.PlayFailed)
    }
  }

  fn doPausePlayback(self: &mut Self) -> () {
    self.cursorSec = audio_native.playPosition()
    audio_native.playStop()
  }

  effect fn updateSelectionReadout(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.hasSelection {
      self.readoutSelSpan.clear()
      self.selPitchStats = SelectionPitchStats.empty()
      self.readoutSelPitchChip.clear()
      self.readoutSelPitchMain.clear()
      self.readoutSelPitchSub.clear()
      run self.updateSelectionCompare()
      if self.refClip.active && self.showRefWave {
        run self.updateViewportDrawings()
      }
      return ()
    }
    let lo = f64.min(self.selStart, self.selEnd)
    let hi = f64.max(self.selStart, self.selEnd)
    if hi - lo < 0.015 {
      self.readoutSelSpan.clear()
      self.selPitchStats = SelectionPitchStats.empty()
      self.readoutSelPitchChip.clear()
      self.readoutSelPitchMain.clear()
      self.readoutSelPitchSub.clear()
      run self.updateSelectionCompare()
      if self.refClip.active && self.showRefWave {
        run self.updateViewportDrawings()
      }
      return ()
    }
    let mut s = String.make()
    run s.append("Sel ")
    let a = run formatSecShort(lo)
    let b = run formatSecShort(hi)
    run s.append(String.view(&a))
    run s.append("–")
    run s.append(String.view(&b))
    self.readoutSelSpan = move s

    // Praat-exact Sampled_getMean(interpolate = true) across the selection!
    let onRef = self.isPlottingOnRef()
    let frames = if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() }
    let dx = if onRef {
      if self.refClip.pitchFrames.length() >= 2 {
        self.refClip.pitchFrames.get(1).time - self.refClip.pitchFrames.get(0).time
      } else {
        0.0232
      }
    } else {
      usize.toF64(self.pitchTrack.hopSamples) / f64.max(self.pitchTrack.sampleRate, 1.0)
    }
    let st = run selectionPitchStats(frames, dx, lo, hi, self.displayClarity)
    self.selPitchStats = st
    if st.valid {
      let primaryHz = if self.vp.isLog() { st.logMeanHz } else { st.meanHz }
      let primaryNote = run formatNoteFull(primaryHz)
      let mut chip = String.make()
      run chip.append("Avg ")
      run appendFixed(&mut chip, primaryHz, 1)
      run chip.append(" Hz (")
      run chip.append(String.view(&primaryNote))
      run chip.append(")")
      self.readoutSelPitchChip = move chip

      let mut main = String.make()
      run appendFixed(&mut main, st.meanHz, 1)
      run main.append(" Hz · ")
      let mn = run formatNoteFull(st.meanHz)
      run main.append(String.view(&mn))
      self.readoutSelPitchMain = move main

      let mut sub = String.make()
      run sub.append("Log ")
      run appendFixed(&mut sub, st.logMeanHz, 1)
      run sub.append(" · Med ")
      run appendFixed(&mut sub, st.medianHz, 1)
      run sub.append(" · ")
      run appendFixed(&mut sub, st.minHz, 0)
      run sub.append("–")
      run appendFixed(&mut sub, st.maxHz, 0)
      run sub.append(" Hz")
      self.readoutSelPitchSub = move sub
    } else {
      self.readoutSelPitchChip = run String.copy("Avg — (unvoiced)")
      self.readoutSelPitchMain = run String.copy("Unvoiced")
      self.readoutSelPitchSub.clear()
    }
    run self.updateSelectionCompare()
    if self.refClip.active && self.showRefWave {
      run self.updateViewportDrawings()
    }
  }

  effect fn updateReadouts(self: &mut Self, recomputeSlice: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.updateSelectionReadout()
    let inspectSec = if self.recording {
      f64.max(0.0, self.clipDuration() - 0.03)
    } else {
      self.cursorSec
    }

    let pfOpt = self.pitchTrack.nearest(inspectSec)
    if let Option<PitchFrame>.Some { value: pf } = pfOpt {
      self.readoutDb = run formatDb(pf.intensityDb)
      let pct = f64.toU32(f64.round(pf.clarity * 100.0))
      self.readoutClarityPct = if pct > 100 { 100 } else { pct }
      if pf.voiced && pf.clarity >= self.displayClarity {
        let nr = frequencyToNote(pf.frequency)
        self.readoutNote = run formatNoteFull(pf.frequency)
        self.readoutHz = run formatHzFull(pf.frequency)
        self.readoutCents = run formatCents(nr.cents)
        self.readoutCentsVal = nr.cents
        self.readoutVoiced = true
      } else {
        self.readoutNote = run String.copy("—")
        self.readoutHz = run String.copy("unvoiced")
        self.readoutCents = run String.copy("—")
        self.readoutCentsVal = 0
        self.readoutVoiced = false
      }
    } else {
      self.readoutNote = run String.copy("—")
      self.readoutHz = run String.copy("—")
      self.readoutCents = run String.copy("—")
      self.readoutCentsVal = 0
      self.readoutVoiced = false
      self.readoutClarityPct = 0
      self.readoutDb = run String.copy("-∞ dB")
    }

    let ffOpt = self.formantTrack.nearest(inspectSec)
    if let Option<FormantFrame>.Some { value: ff } = ffOpt {
      self.readoutF1 = if ff.count >= 1 { run formatHz(ff.f1) } else { run String.copy("—") }
      self.readoutF2 = if ff.count >= 2 { run formatHz(ff.f2) } else { run String.copy("—") }
      self.readoutF3 = if ff.count >= 3 { run formatHz(ff.f3) } else { run String.copy("—") }
      self.readoutF4 = if ff.count >= 4 { run formatHz(ff.f4) } else { run String.copy("—") }
      self.readoutVowel = if ff.count >= 2 { estimateVowelForResonance(ff.f1, ff.f2, f32.toF64(self.vowelResonance)) } else { "—" }
    } else {
      self.readoutF1 = run String.copy("—")
      self.readoutF2 = run String.copy("—")
      self.readoutF3 = run String.copy("—")
      self.readoutF4 = run String.copy("—")
      self.readoutVowel = "—"
    }

    let vfOpt = self.voiceMetrics.nearest(inspectSec)
    if let Option<VoiceFrame>.Some { value: vf } = vfOpt {
      if vf.voiced {
        self.readoutVtl = run formatVtlCm(vf.vtlCm)
        self.readoutH1H2 = run formatSignedFixed(vf.h1h2Db, 1, " dB")
        self.readoutHnr = run formatSignedFixed(vf.hnrDb, 0, " dB")
      } else if self.voiceMetrics.summary.voicedFrames > 0 {
        self.readoutVtl = run formatVtlCm(self.voiceMetrics.summary.medianVtlCm)
        self.readoutH1H2 = run formatSignedFixed(self.voiceMetrics.summary.medianH1H2Db, 1, " dB")
        self.readoutHnr = run formatSignedFixed(self.voiceMetrics.summary.medianHnrDb, 0, " dB")
      } else {
        self.readoutVtl = run String.copy("—")
        self.readoutH1H2 = run String.copy("—")
        self.readoutHnr = run String.copy("—")
      }
    } else {
      self.readoutVtl = run String.copy("—")
      self.readoutH1H2 = run String.copy("—")
      self.readoutHnr = run String.copy("—")
    }

    if recomputeSlice && self.samples.length() > 0 {
      self.sliceData = run computeSpectrumSlice(
        self.samples.asSlice(),
        self.sampleRate,
        inspectSec,
        &self.sharpWin,
        self.sampleRate * 0.5,
      )
      drop self.formantTrack.analyzeFrame(self.samples.asSlice(), inspectSec, true)
    }

    self.readoutDuration = run formatTime(self.clipDuration())
    let mut cl = String.make()
    let cts = run formatTime(inspectSec)
    run cl.append(String.view(&cts))
    run cl.append(" · ")
    run cl.append(String.view(&self.readoutHz))
    if self.readoutVoiced {
      run cl.append(" · ")
      run cl.append(String.view(&self.readoutNote))
      run cl.append(" ")
      run cl.append(String.view(&self.readoutCents))
    }
    if String.view(&self.readoutF1) != "—" {
      run cl.append(" · F1 ")
      run cl.append(String.view(&self.readoutF1))
    }
    if String.view(&self.readoutF2) != "—" {
      run cl.append(" · F2 ")
      run cl.append(String.view(&self.readoutF2))
    }
    self.readoutCursorLine = move cl

    if self.hoverValid && self.specRect.width() > 2.0 && self.specRect.height() > 2.0 {
      let tNorm = f32.toF64(self.hoverX / self.specRect.width())
      let fNorm = self.yToFreqNorm(self.hoverY, self.specRect.height())
      let ht = self.vp.normToTimeAt(tNorm)
      let hf = self.vp.normToFreqAt(fNorm)
      let mut hs = String.make()
      run hs.append("Cursor ")
      let ts = run formatTime(ht)
      run hs.append(String.view(&ts))
      run hs.append(" · ")
      let hzs = run formatHzFull(hf)
      run hs.append(String.view(&hzs))
      run hs.append(" (")
      let ns = run formatNoteFull(hf)
      run hs.append(String.view(&ns))
      run hs.append(")")
      // When comparing against a Reference, show local divergence match% right in the hover tooltip!
      if self.refClip.active && self.compare.valid {
        let onRef = self.isPlottingOnRef()
        let pts = if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() }
        if pts.length > 0 {
          let mut bestIdx: usize = 0
          let mut bestDt: f64 = 1.0e9
          let mut pi: usize = 0
          while pi < pts.length {
            let dt = f64.abs(pts[pi].time - ht)
            if dt < bestDt {
              bestDt = dt
              bestIdx = pi
            }
            pi = pi + 1
          }
          if bestDt <= 0.08 && pts[bestIdx].bothVoiced {
            let pt = pts[bestIdx]
            let div = if self.heatmapMetric == HEATMAP_PITCH {
              pt.divPitch
            } else if self.heatmapMetric == HEATMAP_SIZE {
              pt.divSize
            } else if self.heatmapMetric == HEATMAP_WEIGHT {
              pt.divWeight
            } else if self.heatmapMetric == HEATMAP_VOWEL {
              pt.divVowel
            } else {
              pt.divOverall
            }
            let localPct = f64.toI32(f64.round((1.0 - f64.max(0.0, f64.min(1.0, div))) * 100.0))
            let ps = run formatScorePct(localPct)
            run hs.append(" · Match ")
            run hs.append(String.view(&ps))
          }
        }
      }
      self.hoverReadout = move hs
    } else {
      self.hoverReadout.clear()
    }
  }

  /// Zero-Drawing hover update: updates ONLY the cursor status readout (crosshair is a GPU h.box).
  effect fn updateHoverOnly(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.hoverValid && self.specRect.width() > 2.0 && self.specRect.height() > 2.0 {
      let tNorm = f32.toF64(self.hoverX / self.specRect.width())
      let fNorm = self.yToFreqNorm(self.hoverY, self.specRect.height())
      let ht = self.vp.normToTimeAt(tNorm)
      let hf = self.vp.normToFreqAt(fNorm)
      let mut hs = String.make()
      run hs.append("Cursor ")
      let ts = run formatTime(ht)
      run hs.append(String.view(&ts))
      run hs.append(" · ")
      let hzs = run formatHzFull(hf)
      run hs.append(String.view(&hzs))
      run hs.append(" (")
      let ns = run formatNoteFull(hf)
      run hs.append(String.view(&ns))
      run hs.append(")")
      // When comparing against a Reference, show local divergence match% right in the hover tooltip!
      if self.refClip.active && self.compare.valid {
        let onRef = self.isPlottingOnRef()
        let pts = if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() }
        if pts.length > 0 {
          let mut bestIdx: usize = 0
          let mut bestDt: f64 = 1.0e9
          let mut pi: usize = 0
          while pi < pts.length {
            let dt = f64.abs(pts[pi].time - ht)
            if dt < bestDt {
              bestDt = dt
              bestIdx = pi
            }
            pi = pi + 1
          }
          if bestDt <= 0.08 && pts[bestIdx].bothVoiced {
            let pt = pts[bestIdx]
            let div = if self.heatmapMetric == HEATMAP_PITCH {
              pt.divPitch
            } else if self.heatmapMetric == HEATMAP_SIZE {
              pt.divSize
            } else if self.heatmapMetric == HEATMAP_WEIGHT {
              pt.divWeight
            } else if self.heatmapMetric == HEATMAP_VOWEL {
              pt.divVowel
            } else {
              pt.divOverall
            }
            let localPct = f64.toI32(f64.round((1.0 - f64.max(0.0, f64.min(1.0, div))) * 100.0))
            let ps = run formatScorePct(localPct)
            run hs.append(" · Match ")
            run hs.append(String.view(&ps))
          }
        }
      }
      self.hoverReadout = move hs
    } else {
      self.hoverReadout.clear()
    }
  }

  /// Fast cursor/scrub/playback update: NEVER rebuilds spectrogram overlay, metrics lane, or overview!
  /// Throttles expensive FFT+LPC slice updates during rapid scrub/playback.
  effect fn updateCursorFast(self: &mut Self, forceSlice: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let doSlice = forceSlice || (self.nowTime - self.lastSliceTime) >= 0.065
    if doSlice {
      self.lastSliceTime = self.nowTime
    }
    run self.updateReadouts(doSlice)

    let inspectSec = if self.recording {
      f64.max(0.0, self.clipDuration() - 0.03)
    } else {
      self.cursorSec
    }
    let pfOpt = self.pitchTrack.nearest(inspectSec)
    let ffOpt = self.formantTrack.nearest(inspectSec)
    let vfOpt = self.voiceMetrics.nearest(inspectSec)

    let mut activeMidi: i32 = 0
    let mut hasActivePitch = false
    if let Option<PitchFrame>.Some { value: pf } = pfOpt {
      if pf.voiced && pf.clarity >= self.displayClarity {
        activeMidi = frequencyToNote(pf.frequency).midi
        hasActivePitch = true
      }
    }
    if activeMidi != self.lastPianoMidi || hasActivePitch != self.lastPianoActive {
      self.lastPianoMidi = activeMidi
      self.lastPianoActive = hasActivePitch
      self.pianoDrawing = run buildPianoDrawing(&self.vp, PIANO_W, self.specRect.height(), activeMidi, hasActivePitch)
    }

    if doSlice {
      let rightPlotW = f32.max(180.0, self.readoutsWidth - 32.0)
      self.sizeWeightDrawing = run buildSizeWeightPadDrawing(
        rightPlotW,
        PAD_H,
        self.voiceMetrics.frames.asSlice(),
        self.voiceMetrics.summary,
        vfOpt,
        self.refClip.voiceFrames.asSlice(),
        self.refClip.summary,
        self.compare.points.asSlice(),
        inspectSec,
        self.refClip.active,
      )
      self.sliceDrawing = run buildSpectrumSliceDrawing(
        &self.vp,
        rightPlotW,
        self.sliceHeight,
        &self.sliceData,
        self.formantTrack.lastLpc.asSlice(),
        self.formantTrack.lastLpcValid,
        self.formantTrack.workingRate,
        ffOpt,
        pfOpt,
        self.displayFloorDb,
        self.displayCeilingDb,
      )
      self.vowelDrawing = run buildVowelChartDrawing(
        rightPlotW,
        VOWEL_H,
        ffOpt,
        self.voiceMetrics.frames.asSlice(),
        self.voiceMetrics.summary,
        self.takeVowelSpans.asSlice(),
        self.refClip.voiceFrames.asSlice(),
        self.refClip.summary,
        self.refVowelSpans.asSlice(),
        self.compare.points.asSlice(),
        inspectSec,
        self.refClip.active,
        self.vowelResonance,
      )
      self.vowelChartDots = run computeVowelChartDots(
        self.takeVowelSpans.asSlice(),
        self.voiceMetrics.frames.asSlice(),
        rightPlotW,
        VOWEL_H,
      )
    }
  }

  /// Viewport-only pan/zoom update: ONLY rebuilds time/freq-dependent stage overlays & axis ticks!
  /// Leaves overviewDrawing, sliceDrawing, ltasDrawing, vowelDrawing, and sizeWeightDrawing untouched (O(1) Arc skip!).
  effect fn updateViewportDrawings(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.updateHoverOnly()
    let onRef = self.isPlottingOnRef()
    let split = self.isSplitRefSpec()
    let sw = self.specRect.width()
    let sh = self.specRect.height()
    let paneH = if split { sh * 0.497 } else { sh }
    let opts = OverlayOptions {
      showPitch: self.showPitch,
      showHarmonics: self.showHarmonics,
      showFormants: self.showFormants,
      formantMask: self.formantMask,
      showNoteGrid: self.showNoteGrid,
      showRefOverlay: self.showRefOverlay && !split,
      showRefWave: self.showRefWave && self.refClip.active && !split,
      showHeatmap: self.showHeatmap && self.refClip.active,
      heatmapMetric: self.heatmapMetric,
      useDtwAlign: self.useDtwAlign,
      plotOnRef: onRef,
      showVowelRegions: self.showVowelRegions,
      isolateMode: self.isolateMode,
      displayClarity: self.displayClarity,
      cursorSec: self.cursorSec,
      hasSelection: self.hasSelection,
      selStart: self.selStart,
      selEnd: self.selEnd,
      hasRefSel: self.hasSelection && self.selCompare.valid,
      refSelStart: self.selCompare.refStart,
      refSelEnd: self.selCompare.refEnd,
      hoverValid: self.hoverValid,
      hoverX: self.hoverX,
      hoverY: self.hoverY,
    }
    let activeVowels = if onRef { self.refVowelSpans.asSlice() } else { self.takeVowelSpans.asSlice() }
    self.overlayDrawing = run buildSpectrogramOverlay(
      &self.vp,
      sw,
      paneH,
      if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() },
      if onRef { self.refClip.formantFrames.asSlice() } else { self.formantTrack.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.refClip.samples.asSlice(),
      self.refClip.sampleRate,
      self.guides.asSlice(),
      activeVowels,
      opts,
    )
    if split {
      let refOpts = OverlayOptions {
        showPitch: self.showPitch,
        showHarmonics: self.showHarmonics,
        showFormants: self.showFormants,
        formantMask: self.formantMask,
        showNoteGrid: self.showNoteGrid,
        showRefOverlay: false,
        showRefWave: false,
        showHeatmap: false,
        heatmapMetric: self.heatmapMetric,
        useDtwAlign: self.useDtwAlign,
        plotOnRef: false,
        showVowelRegions: self.showVowelRegions,
        isolateMode: self.isolateMode,
        displayClarity: self.displayClarity,
        cursorSec: self.cursorSec,
        hasSelection: self.hasSelection,
        selStart: self.selStart,
        selEnd: self.selEnd,
        hasRefSel: false,
        refSelStart: 0.0,
        refSelEnd: 0.0,
        hoverValid: false,
        hoverX: 0.0,
        hoverY: 0.0,
      }
      self.refOverlayDrawing = run buildSpectrogramOverlay(
        &self.vp,
        sw,
        paneH,
        self.refClip.pitchFrames.asSlice(),
        self.refClip.formantFrames.asSlice(),
        &[],
        &[],
        self.refClip.sampleRate,
        self.guides.asSlice(),
        self.refVowelSpans.asSlice(),
        refOpts,
      )
      self.refPianoDrawing = run buildPianoDrawing(&self.vp, PIANO_W, paneH, 0, false)
      self.refFreqTicks = run computeFreqTicks(&self.vp, paneH)
    }
    self.vowelBadges = run computeVowelBadges(activeVowels, &self.vp, sw)
    self.metricsLaneDrawing = run buildMetricsLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      if onRef { self.refClip.voiceFrames.asSlice() } else { self.voiceMetrics.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
      self.cursorSec,
    )
    self.pitchLaneDrawing = run buildPitchContourLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
      self.displayClarity,
    )
    let activeVoiceFs = if onRef { self.refClip.voiceFrames.asSlice() } else { self.voiceMetrics.frames.asSlice() }
    self.vowelLaneDrawing = run buildVowelLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      activeVoiceFs,
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
    )
    self.vowelLaneBadges = run computeVowelLaneBadges(activeVowels, activeVoiceFs, &self.vp, sw, self.vowelResonance)
    self.pianoDrawing = run buildPianoDrawing(&self.vp, PIANO_W, paneH, self.lastPianoMidi, self.lastPianoActive)
    self.freqTicks = run computeFreqTicks(&self.vp, paneH)
    self.timeTicks = run computeTimeTicks(&self.vp, sw)
    self.guideLabels = run computeGuideBadges(self.guides.asSlice(), &self.vp, paneH)
  }

  pub effect fn rebuildDrawings(self: &mut Self, recomputeSlice: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.updateReadouts(recomputeSlice)

    let inspectSec = if self.recording {
      f64.max(0.0, self.clipDuration() - 0.03)
    } else {
      self.cursorSec
    }
    let pfOpt = self.pitchTrack.nearest(inspectSec)
    let ffOpt = self.formantTrack.nearest(inspectSec)
    let vfOpt = self.voiceMetrics.nearest(inspectSec)
    let mut activeMidi: i32 = 0
    let mut hasActivePitch = false
    if let Option<PitchFrame>.Some { value: pf } = pfOpt {
      if pf.voiced && pf.clarity >= self.displayClarity {
        activeMidi = frequencyToNote(pf.frequency).midi
        hasActivePitch = true
      }
    }

    let onRef = self.isPlottingOnRef()
    let split = self.isSplitRefSpec()
    let sw = self.specRect.width()
    let sh = self.specRect.height()
    let paneH = if split { sh * 0.497 } else { sh }
    let opts = OverlayOptions {
      showPitch: self.showPitch,
      showHarmonics: self.showHarmonics,
      showFormants: self.showFormants,
      formantMask: self.formantMask,
      showNoteGrid: self.showNoteGrid,
      showRefOverlay: self.showRefOverlay && !split,
      showRefWave: self.showRefWave && self.refClip.active && !split,
      showHeatmap: self.showHeatmap && self.refClip.active,
      heatmapMetric: self.heatmapMetric,
      useDtwAlign: self.useDtwAlign,
      plotOnRef: onRef,
      showVowelRegions: self.showVowelRegions,
      isolateMode: self.isolateMode,
      displayClarity: self.displayClarity,
      cursorSec: self.cursorSec,
      hasSelection: self.hasSelection,
      selStart: self.selStart,
      selEnd: self.selEnd,
      hasRefSel: self.hasSelection && self.selCompare.valid,
      refSelStart: self.selCompare.refStart,
      refSelEnd: self.selCompare.refEnd,
      hoverValid: self.hoverValid,
      hoverX: self.hoverX,
      hoverY: self.hoverY,
    }

    let activeVowels = if onRef { self.refVowelSpans.asSlice() } else { self.takeVowelSpans.asSlice() }
    self.overlayDrawing = run buildSpectrogramOverlay(
      &self.vp,
      sw,
      paneH,
      if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() },
      if onRef { self.refClip.formantFrames.asSlice() } else { self.formantTrack.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.refClip.samples.asSlice(),
      self.refClip.sampleRate,
      self.guides.asSlice(),
      activeVowels,
      opts,
    )
    if split {
      let refOpts = OverlayOptions {
        showPitch: self.showPitch,
        showHarmonics: self.showHarmonics,
        showFormants: self.showFormants,
        formantMask: self.formantMask,
        showNoteGrid: self.showNoteGrid,
        showRefOverlay: false,
        showRefWave: false,
        showHeatmap: false,
        heatmapMetric: self.heatmapMetric,
        useDtwAlign: self.useDtwAlign,
        plotOnRef: false,
        showVowelRegions: self.showVowelRegions,
        isolateMode: self.isolateMode,
        displayClarity: self.displayClarity,
        cursorSec: self.cursorSec,
        hasSelection: self.hasSelection,
        selStart: self.selStart,
        selEnd: self.selEnd,
        hasRefSel: false,
        refSelStart: 0.0,
        refSelEnd: 0.0,
        hoverValid: false,
        hoverX: 0.0,
        hoverY: 0.0,
      }
      self.refOverlayDrawing = run buildSpectrogramOverlay(
        &self.vp,
        sw,
        paneH,
        self.refClip.pitchFrames.asSlice(),
        self.refClip.formantFrames.asSlice(),
        &[],
        &[],
        self.refClip.sampleRate,
        self.guides.asSlice(),
        self.refVowelSpans.asSlice(),
        refOpts,
      )
      self.refPianoDrawing = run buildPianoDrawing(&self.vp, PIANO_W, paneH, 0, false)
      self.refFreqTicks = run computeFreqTicks(&self.vp, paneH)
    }
    self.vowelBadges = run computeVowelBadges(activeVowels, &self.vp, sw)
    self.metricsLaneDrawing = run buildMetricsLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      if onRef { self.refClip.voiceFrames.asSlice() } else { self.voiceMetrics.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
      self.cursorSec,
    )
    self.pitchLaneDrawing = run buildPitchContourLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() },
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
      self.displayClarity,
    )
    let activeVoiceFs = if onRef { self.refClip.voiceFrames.asSlice() } else { self.voiceMetrics.frames.asSlice() }
    self.vowelLaneDrawing = run buildVowelLaneDrawing(
      &self.vp,
      sw,
      METRICS_H,
      activeVoiceFs,
      if onRef { self.compare.takeOnRef.asSlice() } else { self.compare.points.asSlice() },
      self.showRefOverlay && self.refClip.active,
      onRef,
    )
    self.vowelLaneBadges = run computeVowelLaneBadges(activeVowels, activeVoiceFs, &self.vp, sw, self.vowelResonance)
    let rightPlotW = f32.max(180.0, self.readoutsWidth - 32.0)
    self.pianoDrawing = run buildPianoDrawing(&self.vp, PIANO_W, paneH, activeMidi, hasActivePitch)
    self.sizeWeightDrawing = run buildSizeWeightPadDrawing(
      rightPlotW,
      PAD_H,
      self.voiceMetrics.frames.asSlice(),
      self.voiceMetrics.summary,
      vfOpt,
      self.refClip.voiceFrames.asSlice(),
      self.refClip.summary,
      self.compare.points.asSlice(),
      inspectSec,
      self.refClip.active,
    )
    self.sliceDrawing = run buildSpectrumSliceDrawing(
      &self.vp,
      rightPlotW,
      self.sliceHeight,
      &self.sliceData,
      self.formantTrack.lastLpc.asSlice(),
      self.formantTrack.lastLpcValid,
      self.formantTrack.workingRate,
      ffOpt,
      pfOpt,
      self.displayFloorDb,
      self.displayCeilingDb,
    )
    self.ltasDrawing = run buildLtasDrawing(
      rightPlotW,
      self.sliceHeight,
      &self.voiceMetrics.ltas,
      self.voiceMetrics.hasLtas,
      &self.refClip.ltas,
      self.refClip.active && self.refClip.hasLtas,
    )
    self.vowelDrawing = run buildVowelChartDrawing(
      rightPlotW,
      VOWEL_H,
      ffOpt,
      self.voiceMetrics.frames.asSlice(),
      self.voiceMetrics.summary,
      self.takeVowelSpans.asSlice(),
      self.refClip.voiceFrames.asSlice(),
      self.refClip.summary,
      self.refVowelSpans.asSlice(),
      self.compare.points.asSlice(),
      inspectSec,
      self.refClip.active,
      self.vowelResonance,
    )
    self.vowelChartDots = run computeVowelChartDots(
      self.takeVowelSpans.asSlice(),
      self.voiceMetrics.frames.asSlice(),
      rightPlotW,
      VOWEL_H,
    )
    self.overviewDrawing = run buildWaveformOverview(
      self.gpuSamples(),
      self.gpuSampleRate(),
      &self.vp,
      self.overviewRect.width(),
      self.overviewRect.height(),
      self.cursorSec,
      self.hasSelection,
      self.selStart,
      self.selEnd,
    )
    self.freqTicks = run computeFreqTicks(&self.vp, paneH)
    self.timeTicks = run computeTimeTicks(&self.vp, sw)
    self.guideLabels = run computeGuideBadges(self.guides.asSlice(), &self.vp, paneH)
  }

  effect fn applySliderAt(self: &mut Self, id: u32, x: f32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let idx = u32.toUsize(id)
    if idx >= 23 {
      return ()
    }
    let w = f32.max(1.0, self.sliderWidth[idx])
    let mut t = (x - self.sliderLeft[idx]) / w
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }

    if id == SLIDER_BRIGHTNESS {
      self.brightness = -0.45 + t * 0.90
      self.gpuNeedRedraw = true
    } else if id == SLIDER_CONTRAST {
      self.contrast = 0.35 + t * 2.65
      self.gpuNeedRedraw = true
    } else if id == SLIDER_FLOOR_DB {
      let nextFloor = f32.round(-140.0 + t * 90.0)
      if nextFloor < self.displayCeilingDb - 10.0 && nextFloor != self.displayFloorDb {
        self.displayFloorDb = nextFloor
        static if Intrinsic.targetArchitecture() != "wasm32" {
          self.gpuNeedFullReload = true
        }
        self.gpuNeedRedraw = true
        run self.rebuildDrawings(false)
      }
    } else if id == SLIDER_CEILING_DB {
      let nextCeil = f32.round(-60.0 + t * 60.0)
      if nextCeil > self.displayFloorDb + 10.0 && nextCeil != self.displayCeilingDb {
        self.displayCeilingDb = nextCeil
        static if Intrinsic.targetArchitecture() != "wasm32" {
          self.gpuNeedFullReload = true
        }
        self.gpuNeedRedraw = true
        run self.rebuildDrawings(false)
      }
    } else if id == SLIDER_FORMANT_CEIL {
      let nextHz = f64.round((4000.0 + f32.toF64(t) * 2500.0) / 50.0) * 50.0
      if nextHz != self.formantCeilingHz {
        self.formantCeilingHz = nextHz
        run self.reanalyzeFormants()
      }
    } else if id == SLIDER_CLARITY {
      let nextC = f64.round((0.15 + f32.toF64(t) * 0.80) * 20.0) / 20.0
      if nextC != self.displayClarity {
        self.displayClarity = nextC
        self.pitchConfig.clarityThreshold = nextC
        run self.reanalyzeRefClip()
        run self.analyzeAll()
        run self.rebuildDrawings(false)
      }
    } else if id == SLIDER_VOLUME {
      self.volume = t
      audio_native.setVolume(self.volume)
    } else if id == SLIDER_SILENCE_HOLD {
      self.silenceHoldSec = f64.round((0.30 + f32.toF64(t) * 2.20) * 20.0) / 20.0
      self.readoutSilenceStr = run formatSecShort(self.silenceHoldSec)
    } else if id == SLIDER_VAD_THRESH {
      self.vadThresholdDb = f32.round(-55.0 + t * 37.0)
      self.readoutVadStr = run formatDb(f32.toF64(self.vadThresholdDb))
    } else if id == SLIDER_SPEC_OPACITY {
      self.specOpacity = t
      self.showSpectrogram = t > 0.01
    } else if id == SLIDER_PLAY_SPEED {
      let sp = f32.round((0.25 + t * 1.75) * 20.0) / 20.0
      self.playSpeed = sp
      audio_native.setPlaySpeed(sp)
      run self.updateSpeedReadout()
    } else if id == SLIDER_W_PITCH {
      self.matchWeights.pitch = f64.round(f32.toF64(t) * 100.0)
      run self.updateWeightReadouts()
      run self.recomputeCompare()
    } else if id == SLIDER_W_SIZE {
      self.matchWeights.size = f64.round(f32.toF64(t) * 100.0)
      run self.updateWeightReadouts()
      run self.recomputeCompare()
    } else if id == SLIDER_W_WEIGHT {
      self.matchWeights.weight = f64.round(f32.toF64(t) * 100.0)
      run self.updateWeightReadouts()
      run self.recomputeCompare()
    } else if id == SLIDER_W_VOWEL {
      self.matchWeights.vowel = f64.round(f32.toF64(t) * 100.0)
      run self.updateWeightReadouts()
      run self.recomputeCompare()
    } else if id == SLIDER_PITCH_FLOOR {
      let nextF = f64.round((40.0 + f32.toF64(t) * 160.0) / 5.0) * 5.0
      if nextF < self.pitchConfig.ceilingHz - 80.0 && nextF != self.pitchConfig.floorHz {
        self.pitchConfig.floorHz = nextF
        run self.updatePitchRangeReadout()
        run self.reanalyzeRefClip()
        run self.analyzeAll()
        run self.rebuildDrawings(false)
      }
    } else if id == SLIDER_PITCH_CEIL {
      let nextC = f64.round((300.0 + f32.toF64(t) * 1100.0) / 25.0) * 25.0
      if nextC > self.pitchConfig.floorHz + 80.0 && nextC != self.pitchConfig.ceilingHz {
        self.pitchConfig.ceilingHz = nextC
        run self.updatePitchRangeReadout()
        run self.reanalyzeRefClip()
        run self.analyzeAll()
        run self.rebuildDrawings(false)
      }
    } else if id == SLIDER_SYNTH_PITCH {
      self.synthPitchSemi = f64.round((-12.0 + f32.toF64(t) * 24.0) * 10.0) / 10.0
      self.synthPitchOn = true
      run self.syncSynthReadouts()
    } else if id == SLIDER_SYNTH_SIZE {
      self.synthSizePct = f64.round(-25.0 + f32.toF64(t) * 50.0)
      self.synthSizeOn = true
      run self.syncSynthReadouts()
    } else if id == SLIDER_SYNTH_WEIGHT {
      self.synthWeightDb = f64.round((-8.0 + f32.toF64(t) * 16.0) * 10.0) / 10.0
      self.synthWeightOn = true
      run self.syncSynthReadouts()
    } else if id == SLIDER_SYNTH_MORPH {
      self.synthMorph = f32.round(t * 20.0) / 20.0
      run self.syncSynthReadouts()
    } else if id == SLIDER_VOWEL_RESONANCE {
      let nextR = f32.round(t * 100.0) / 100.0
      if f32.abs(nextR - self.vowelResonance) >= 0.005 {
        self.vowelResonance = nextR
        run self.rebuildDrawings(false)
        run self.saveSessionPrefs()
      }
    }
  }

  effect fn handleMessage(self: &mut Self, msg: Message) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match move msg {
      Message.Tick { time } => {
        let dt = if self.lastTickTime >= 0.0 && time > self.lastTickTime {
          f64.min(0.10, time - self.lastTickTime)
        } else {
          0.016
        }
        self.lastTickTime = time
        self.nowTime = time

        if isPractice(self.transport.value) {
          run self.stepPracticeTick(dt)
        } else if isManualRecording(self.transport.value) {
          self.inputLevelDb = audio_native.micLevelDb()
          let added = run audio_native.micDrainInto(&mut self.samples)
          if added > 0 {
            let dur = self.clipDuration()
            self.cursorSec = dur
            let newLimitsDur = f64.max(dur, RECORD_VIEW_S)
            self.vp.setLimits(newLimitsDur, self.sampleRate * 0.5)
            if self.followRecording && dur > self.vp.t1 {
              let span = self.vp.t1 - self.vp.t0
              self.vp.setTimeRange(dur - span, dur)
            }
            drop run self.pitchTrack.update(self.samples.asSlice())
            drop run self.formantTrack.update(self.samples.asSlice())
            drop run self.voiceMetrics.update(
              self.samples.asSlice(),
              self.sampleRate,
              self.pitchTrack.frames.asSlice(),
              self.formantTrack.frames.asSlice(),
              self.displayClarity,
            )
            self.gpuNeedRecAppend = true
            self.gpuNeedRedraw = true
            run self.rebuildDrawings(true)
          }
        } else if isPlaying(self.transport.value) {
          if audio_native.takeFinished() {
            let wasRef = isPlayingRefOnly(self.transport.value)
            run self.sendTransport(TransportEvent.PlaybackEnded)
            if !wasRef {
              self.cursorSec = if self.hasSelection {
                f64.max(self.selStart, self.selEnd)
              } else {
                self.gpuDuration()
              }
            }
            run self.rebuildDrawings(true)
          } else if isPlayingUser(self.transport.value) {
            self.cursorSec = audio_native.playPosition()
            if self.cursorSec > self.vp.t1 || self.cursorSec < self.vp.t0 {
              let span = self.vp.t1 - self.vp.t0
              self.vp.setTimeRange(self.cursorSec - span * 0.15, self.cursorSec + span * 0.85)
              self.scheduleSharp()
              run self.updateViewportDrawings()
            }
            run self.updateCursorFast(false)
          }
        } else if self.bgScoreActive && self.refClip.active && self.drag == DRAG_NONE {
          run self.stepBgScoring()
        }
      }

      Message.ToggleRecord => {
        run self.sendTransport(TransportEvent.ToggleRecord)
      }

      Message.RecordNewClip => {
        if isManualRecording(self.transport.value) {
          run self.sendTransport(TransportEvent.ToggleRecord)
        }
        if self.isViewingRefClip() && !self.refClip.active && self.samples.length() >= 64 {
          run self.activateCurrentRefForRecording()
        }
        run self.newDocument()
        run self.sendTransport(TransportEvent.ToggleRecord)
      }

      Message.TogglePlay => {
        run self.sendTransport(TransportEvent.TogglePlay)
        if !self.playing && !self.recording {
          run self.updateCursorFast(false)
        }
      }

      Message.ToggleLoop => {
        self.loopSelection = !self.loopSelection
        if isPlayingUser(self.transport.value) {
          self.cursorSec = audio_native.playPosition()
          run self.sendTransport(TransportEvent.PlayFromCursor)
        }
      }

      Message.LoadDemo => {
        run self.sendTransport(TransportEvent.StopAll)
        self.activeClipPath.clear()
        self.activeClipFilename.clear()
        self.activeClipDir.clear()
        self.activeClipInLib = false
        self.plotOnRef = false
        let samples = run synthDemoVoice()
        run self.loadSamples(run String.copy("Demo Voice (/ɑ e i o u/)"), move samples, SYNTH_SAMPLE_RATE)
        self.isDemoClip = true
        run self.refreshActiveLibMeta()
      }

      Message.AskOpenFile => {
        self.pendingOpenDialog = true
      }

      Message.AskSaveWav => {
        self.pendingSaveDialog = true
      }

      Message.FileChosen { path } => {
        run self.sendTransport(TransportEvent.StopAll)
        let pathCopy = run String.copy(String.view(&path))
        match move run audio_native.loadAudioFile(String.view(&path)) {
          Option<audio_native.LoadedAudio>.Some { value } => {
            let disp = run Overtone.stripAudioExt(String.view(&value.name))
            self.activeClipPath = move pathCopy
            self.activeClipFilename = move value.name
            self.activeClipDir.clear()
            self.activeClipInLib = false
            self.plotOnRef = false
            run self.loadSamples(move disp, move value.samples, value.sampleRate)
            run self.refreshActiveLibMeta()
            self.statusMsg = run String.copy("Opened external file · Press ⌘S or Save to copy into your library")
          }
          Option<audio_native.LoadedAudio>.None => {
            self.errorMsg = run String.copy("Could not decode audio file (supports WAV, MP3, M4A, FLAC, AIFF).")
          }
        }
      }

      Message.SaveChosen { path } => {
        let ok = audio_native.exportWav(String.view(&path), self.samples.asSlice(), self.sampleRate)
        if ok {
          self.errorMsg.clear()
          self.statusMsg = run String.copy("Exported 16-bit WAV successfully.")
        } else {
          self.errorMsg = run String.copy("Failed to export WAV file.")
        }
      }

      Message.ToggleScale => {
        self.vp.toggleScale()
        self.gpuNeedRedraw = true
        run self.rebuildDrawings(false)
      }

      Message.CyclePalette => {
        self.palette = nextPalette(self.palette)
        self.gpuNeedPalette = true
        self.gpuNeedRedraw = true
      }

      Message.ResetView => {
        let dur = self.gpuDuration()
        let sr = self.gpuSampleRate()
        self.vp.reset(f64.max(dur, 0.25), sr * 0.5)
        self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
        self.followRecording = true
        self.scheduleSharp()
        run self.rebuildDrawings(false)
      }

      Message.TogglePitch => {
        self.showPitch = !self.showPitch
        run self.rebuildDrawings(false)
      }

      Message.ToggleHarmonics => {
        self.showHarmonics = !self.showHarmonics
        run self.rebuildDrawings(false)
      }

      Message.ToggleFormants => {
        self.showFormants = !self.showFormants
        run self.rebuildDrawings(false)
      }

      Message.ToggleMetricsLane => {
        self.showMetricsLane = !self.showMetricsLane
        run self.rebuildDrawings(false)
      }

      Message.ToggleRefOverlay => {
        self.showRefOverlay = !self.showRefOverlay
        run self.rebuildDrawings(false)
      }

      Message.TogglePlotOnRef => {
        if self.refClip.active && !self.recording {
          self.plotOnRef = !self.plotOnRef
          let dur = self.gpuDuration()
          let sr = self.gpuSampleRate()
          self.vp.reset(f64.max(dur, 0.25), sr * 0.5)
          self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
          self.cursorSec = f64.min(self.cursorSec, dur)
          self.hasSelection = false
          self.readoutSelSpan.clear()
          self.gpuNeedFullReload = true
          self.gpuNeedSharp = true
          self.sharpDueTime = 0.0
          self.gpuNeedRedraw = true
          self.statusMsg = if self.plotOnRef {
            run String.copy("Plotting YOUR voice (cyan/gold) directly on top of Reference spectrogram!")
          } else {
            run String.copy("Showing YOUR take spectrogram with Reference ghost overlay")
          }
          run self.rebuildDrawings(true)
        }
      }

      Message.ToggleDtwAlign => {
        self.useDtwAlign = !self.useDtwAlign
        run self.recomputeCompare()
        run self.rebuildDrawings(false)
      }

      Message.ToggleNoteGrid => {
        self.showNoteGrid = !self.showNoteGrid
        run self.rebuildDrawings(false)
      }

      Message.ToggleLibrary => {
        self.showLibrary = !self.showLibrary
        self.gpuNeedResize = true
      }

      Message.ToggleReadouts => {
        self.showReadouts = !self.showReadouts
        self.gpuNeedResize = true
      }

      Message.ResizeSidebarDown { isRight, x } => {
        self.ctxMenuKind = CTX_NONE
        self.drag = if isRight { DRAG_RESIZE_READOUTS } else { DRAG_RESIZE_LIB }
        self.dragStartX = x
        self.resizeStartWidth = if isRight { self.readoutsWidth } else { self.libWidth }
      }

      Message.SetSpectrumTab { ltas } => {
        self.showLtasTab = ltas
      }

      Message.PinReference => {
        run self.pinCurrentAsReference()
      }

      Message.ClearReference => {
        if isDrill(self.transport.value) {
          run self.sendTransport(TransportEvent.StopAll)
        }
        let wasOnRef = self.plotOnRef
        self.plotOnRef = false
        self.refClip.clear()
        self.gpuNeedRefReload = true
        self.listenMode = LISTEN_YOU
        run self.recomputeNormGain()
        run self.recomputeCompare()
        run self.reloadTree(false)
        if wasOnRef {
          let dur = self.clipDuration()
          self.vp.reset(f64.max(dur, 0.25), self.sampleRate * 0.5)
          self.vp.setTimeRange(0.0, f64.max(dur, 0.25))
          self.gpuNeedFullReload = true
          self.gpuNeedSharp = true
          self.sharpDueTime = 0.0
        }
        self.gpuNeedRedraw = true
        run self.saveSessionPrefs()
        self.statusMsg = run String.copy("Cleared pinned Reference.")
        run self.rebuildDrawings(false)
      }

      Message.PlayReferenceOnce => {
        if self.refClip.active && self.refClip.durationSec > 0.02 {
          run self.sendTransport(TransportEvent.PlayRef)
        }
      }

      Message.PlayRefSelection => {
        if self.refClip.active && self.selCompare.valid && self.selCompare.refEnd > self.selCompare.refStart + 0.02 {
          if isPractice(self.transport.value) || isRecording(self.transport.value) {
            run self.sendTransport(TransportEvent.StopAll)
          }
          audio_native.playStop()
          if self.isolateMode != ISOLATE_FULL || self.voiceLabMode != LAB_OFF {
            drop audio_native.playFiltered(
              true,
              self.refClip.samples.asSlice(),
              self.refClip.sampleRate,
              self.selCompare.refStart,
              self.selCompare.refEnd,
              false,
              self.isolateMode,
              self.isolateTiming,
              self.voiceLabMode,
              self.monoTargetHz(),
            )
          } else {
            drop audio_native.playRange(
              self.refClip.samples.asSlice(),
              self.refClip.sampleRate,
              self.selCompare.refStart,
              self.selCompare.refEnd,
              false,
            )
          }
        }
      }

      Message.ToggleRefWave => {
        self.showRefWave = !self.showRefWave
        run self.updateViewportDrawings()
      }

      Message.SaveCurrentClip => {
        run self.saveCurrentClipToFolder(false)
      }

      Message.SaveSelectionAsClip => {
        run self.saveSelectionAsClip()
      }

      Message.ToggleDrillMode => {
        if !isDrill(self.transport.value) && !self.refClip.active {
          if self.samples.length() < 64 {
            self.errorMsg = run String.copy("Load or record a clip first to use Repeat Drill.")
            return ()
          }
          if !self.activeClipIsRef {
            run self.pinCurrentAsReference()
          }
          run self.activateCurrentRefForRecording()
        }
        run self.sendTransport(TransportEvent.ToggleDrill)
        if isDrill(self.transport.value) {
          self.statusMsg = run String.copy("Repeat Drill active · Plays Ref → records take → scores & saves → repeats")
        }
      }

      Message.ToggleEchoMode => {
        run self.sendTransport(TransportEvent.ToggleEcho)
        if isEcho(self.transport.value) {
          self.statusMsg = run String.copy("Echo Mirror active · Speak → silence triggers auto-playback & saves take → repeats")
        }
      }

      Message.StopPractice => {
        if isPractice(self.transport.value) {
          run self.sendTransport(TransportEvent.StopAll)
        }
      }

      // IDE-style Explorer Tree actions (expand/collapse dirs, create folder, inline rename dirs & files, drag-drop, ctx menus, trash)
      Message.ToggleLibFolder { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && nodes[idx].isDir {
          let rel = run String.copy(String.view(&nodes[idx].relPath))
          self.selectedFolderRel = run String.copy(String.view(&rel))
          run self.toggleDirExpanded(String.view(&rel))
          run self.reloadTree(true)
          run self.saveSessionPrefs()
          if self.refClip.active {
            run self.startBgScoring(false)
          }
          let mut msg = String.make()
          run msg.append("Target folder: /")
          run msg.append(String.view(&rel))
          self.statusMsg = move msg
        }
      }

      Message.SelectRootFolder => {
        self.ctxMenuKind = CTX_NONE
        self.selectedFolderRel.clear()
        run self.reloadTree(true)
        self.statusMsg = run String.copy("Target folder: Root (/)")
      }

      Message.RefreshLibDir => {
        self.ctxMenuKind = CTX_NONE
        run self.reloadTree(true)
        self.statusMsg = run String.copy("Refreshed explorer tree from disk.")
      }

      Message.ToggleNewFolderInput => {
        self.ctxMenuKind = CTX_NONE
        self.showNewFolderInput = !self.showNewFolderInput
        if self.showNewFolderInput {
          self.newFolderTargetRel = run String.copy(String.view(&self.selectedFolderRel))
        } else {
          self.newFolderDraft.clear()
          self.textInputFocused = false
        }
      }

      Message.OpenNewFolderAtRoot => {
        self.ctxMenuKind = CTX_NONE
        self.newFolderTargetRel.clear()
        self.newFolderDraft.clear()
        self.showNewFolderInput = true
      }

      Message.OpenNewFolderInEntry { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length {
          if nodes[idx].isDir {
            self.newFolderTargetRel = run String.copy(String.view(&nodes[idx].relPath))
          } else {
            self.newFolderTargetRel = run String.copy(String.view(&nodes[idx].parentRel))
          }
        } else {
          self.newFolderTargetRel.clear()
        }
        self.newFolderDraft.clear()
        self.showNewFolderInput = true
      }

      Message.NewFolderNameInput { text } => {
        self.newFolderDraft = move text
      }

      Message.CreateNewFolder => {
        let parentCopy = run String.copy(String.view(&self.newFolderTargetRel))
        let createdRel = run audio_native.libCreateFolder(
          String.view(&parentCopy),
          String.view(&self.newFolderDraft),
        )
        self.newFolderDraft.clear()
        self.showNewFolderInput = false
        self.textInputFocused = false
        if String.byteLength(String.view(&createdRel)) > 0 {
          run self.ensureDirExpanded(String.view(&parentCopy))
          run self.ensureDirExpanded(String.view(&createdRel))
          self.selectedFolderRel = move createdRel
          run self.reloadTree(true)
          let mut msg = String.make()
          run msg.append("Created folder /")
          run msg.append(String.view(&self.selectedFolderRel))
          self.statusMsg = move msg
        }
      }

      Message.RevealDirInFinder => {
        self.ctxMenuKind = CTX_NONE
        audio_native.libRevealDir(String.view(&self.selectedFolderRel))
      }

      Message.RevealEntryInFinder { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length {
          audio_native.libRevealEntry(
            String.view(&nodes[idx].parentRel),
            String.view(&nodes[idx].name),
          )
        }
      }

      Message.DownloadLibClip { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let ok = audio_native.libDownloadEntry(
            String.view(&nodes[idx].parentRel),
            String.view(&nodes[idx].name),
          )
          if ok {
            self.statusMsg = run String.copy("Downloaded WAV")
          }
        }
      }

      Message.ShareLibClip { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let ok = audio_native.libShareEntry(
            String.view(&nodes[idx].parentRel),
            String.view(&nodes[idx].name),
          )
          if ok {
            self.statusMsg = run String.copy("Ready to share WAV")
          }
        }
      }

      Message.TogglePinchZoom => {
        self.enablePinchZoom = !self.enablePinchZoom
      }

      Message.SetLibFilter { filter } => {
        self.libFilter = filter
        self.explorerScrollY = 0.0
        run self.rebuildExplorerVisibleRows()
      }

      Message.SetLibSortMode { mode } => {
        self.ctxMenuKind = CTX_NONE
        self.libSortMode = mode
        self.explorerScrollY = 0.0
        run self.reloadTree(false)
        if mode > SORT_ALPHA && self.refClip.active {
          run self.startBgScoring(false)
        }
        self.statusMsg = if mode == SORT_OVERALL {
          run String.copy("Explorer sorted by Overall Match (highest first)")
        } else if mode == SORT_PITCH {
          run String.copy("Explorer sorted by Pitch Score (highest first)")
        } else if mode == SORT_SIZE {
          run String.copy("Explorer sorted by Size / Resonance Score (highest first)")
        } else if mode == SORT_WEIGHT {
          run String.copy("Explorer sorted by Vocal Weight Score (highest first)")
        } else if mode == SORT_VOWEL {
          run String.copy("Explorer sorted by Vowels Score (highest first)")
        } else {
          run String.copy("Explorer sorted alphabetically (A–Z)")
        }
      }

      Message.RescoreVisibleClips => {
        self.ctxMenuKind = CTX_NONE
        if self.refClip.active {
          run self.startBgScoring(true)
          self.statusMsg = run String.copy("Re-scoring visible clips against current Reference…")
        } else {
          self.statusMsg = run String.copy("Set a Reference clip first to score your clips.")
        }
      }

      Message.OpenLibClip { idx } => {
        self.ctxMenuKind = CTX_NONE
        run self.loadLibraryClip(idx, false)
      }

      Message.SetLibClipAsRef { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let fnCopy = run String.copy(String.view(&nodes[idx].name))
          let fullCopy = run String.copy(String.view(&nodes[idx].fullPath))
          let dispCopy = run String.copy(String.view(&nodes[idx].displayName))
          drop audio_native.libSetIsRef(String.view(&parentCopy), String.view(&fnCopy), true)
          if String.view(&self.activeClipPath) == String.view(&fullCopy) {
            self.clearActiveRefSilent()
          }
          run self.reloadTree(false)
          run self.recomputeNormGain()
          run self.recomputeCompare()
          run self.saveSessionPrefs()
          run self.rebuildDrawings(false)
          let mut msg = String.make()
          run msg.append("Turned ")
          run msg.append(String.view(&dispCopy))
          run msg.append(" into a Reference")
          self.statusMsg = move msg
        }
      }

      Message.UnmarkLibClipAsRef { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let fnCopy = run String.copy(String.view(&nodes[idx].name))
          let fullCopy = run String.copy(String.view(&nodes[idx].fullPath))
          let dispCopy = run String.copy(String.view(&nodes[idx].displayName))
          drop audio_native.libSetIsRef(String.view(&parentCopy), String.view(&fnCopy), false)
          if self.refClip.active && String.view(&self.refClip.fullPath) == String.view(&fullCopy) {
            self.clearActiveRefSilent()
          }
          run self.reloadTree(false)
          run self.recomputeNormGain()
          run self.recomputeCompare()
          run self.saveSessionPrefs()
          run self.rebuildDrawings(false)
          let mut msg = String.make()
          run msg.append("Removed reference status from ")
          run msg.append(String.view(&dispCopy))
          self.statusMsg = move msg
        }
      }

      Message.UnmarkCurrentRef => {
        self.ctxMenuKind = CTX_NONE
        if self.activeClipInLib && self.activeClipIsRef {
          drop audio_native.libSetIsRef(
            String.view(&self.activeClipDir),
            String.view(&self.activeClipFilename),
            false,
          )
          self.clearActiveRefSilent()
          run self.reloadTree(false)
          run self.recomputeNormGain()
          run self.recomputeCompare()
          run self.saveSessionPrefs()
          run self.rebuildDrawings(false)
          self.statusMsg = run String.copy("Removed reference status.")
        }
      }

      Message.DetachLibClipFromRef { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let fnCopy = run String.copy(String.view(&nodes[idx].name))
          let fullCopy = run String.copy(String.view(&nodes[idx].fullPath))
          let dispCopy = run String.copy(String.view(&nodes[idx].displayName))
          drop audio_native.libSetParentRef(String.view(&parentCopy), String.view(&fnCopy), "")
          if String.view(&self.activeClipPath) == String.view(&fullCopy) {
            self.clearActiveRefSilent()
          }
          run self.reloadTree(false)
          run self.recomputeNormGain()
          run self.recomputeCompare()
          run self.saveSessionPrefs()
          run self.rebuildDrawings(false)
          let mut msg = String.make()
          run msg.append("Detached ")
          run msg.append(String.view(&dispCopy))
          run msg.append(" from reference")
          self.statusMsg = move msg
        }
      }

      Message.ToggleStarLibClip { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let fnCopy = run String.copy(String.view(&nodes[idx].name))
          let nextStar = !nodes[idx].starred
          let rating = nodes[idx].rating
          let comment = run String.copy(String.view(&nodes[idx].comment))
          drop audio_native.libUpdateMeta(
            String.view(&parentCopy),
            String.view(&fnCopy),
            rating,
            nextStar,
            -1,
            "",
            String.view(&comment),
          )
          run self.reloadTree(false)
        }
      }

      Message.SetRatingLibClip { idx, rating } => {
        if idx < self.libTree.length() && !self.libTree.asSlice()[idx].isDir {
          let nodes = self.libTree.asSlice()
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let fnCopy = run String.copy(String.view(&nodes[idx].name))
          let nextRating = if nodes[idx].rating == rating { 0 } else { rating }
          let starred = if nextRating >= 4 { true } else { nodes[idx].starred }
          let comment = run String.copy(String.view(&nodes[idx].comment))
          drop audio_native.libUpdateMeta(
            String.view(&parentCopy),
            String.view(&fnCopy),
            nextRating,
            starred,
            -1,
            "",
            String.view(&comment),
          )
          run self.reloadTree(false)
        } else if self.activeClipInLib {
          let nextRating = if self.activeItemRating == rating { 0 } else { rating }
          let starred = if nextRating >= 4 { true } else { self.activeItemStarred }
          drop audio_native.libUpdateMeta(
            String.view(&self.activeClipDir),
            String.view(&self.activeClipFilename),
            nextRating,
            starred,
            -1,
            "",
            String.view(&self.activeCommentDraft),
          )
          run self.reloadTree(false)
        }
      }

      Message.StartRenameEntry { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length {
          self.renamingRel = run String.copy(String.view(&nodes[idx].relPath))
          self.renamingParentRel = run String.copy(String.view(&nodes[idx].parentRel))
          self.renamingOldName = run String.copy(String.view(&nodes[idx].name))
          self.renamingIsDir = nodes[idx].isDir
          // Edit stem only for audio files (never expose or allow editing the file extension!)
          self.renameDraft = run String.copy(String.view(&nodes[idx].displayName))
        }
      }

      Message.RenameEntryInput { text } => {
        self.renameDraft = move text
      }

      Message.CancelRenameEntry => {
        self.renamingRel.clear()
        self.renamingParentRel.clear()
        self.renamingOldName.clear()
        self.renameDraft.clear()
        self.textInputFocused = false
      }

      Message.CommitRenameEntry => {
        if String.byteLength(String.view(&self.renamingRel)) > 0 && String.byteLength(String.view(&self.renameDraft)) > 0 {
          let oldRel = run String.copy(String.view(&self.renamingRel))
          let parentRel = run String.copy(String.view(&self.renamingParentRel))
          let oldName = run String.copy(String.view(&self.renamingOldName))
          let isDir = self.renamingIsDir
          let newNameDraft = run String.copy(String.view(&self.renameDraft))

          let mut oldFullPath = String.make()
          let nodes = self.libTree.asSlice()
          let mut ni: usize = 0
          while ni < nodes.length {
            if String.view(&nodes[ni].relPath) == String.view(&oldRel) {
              oldFullPath = run String.copy(String.view(&nodes[ni].fullPath))
              break
            }
            ni = ni + 1
          }

          let res = run audio_native.libRenameEntry(
            String.view(&parentRel),
            String.view(&oldName),
            String.view(&newNameDraft),
            isDir,
          )
          self.renamingRel.clear()
          self.renamingParentRel.clear()
          self.renamingOldName.clear()
          self.renameDraft.clear()
          self.textInputFocused = false

          if res.ok {
            let newName = run String.copy(String.view(&res.newName))
            let newDisp = if isDir {
              run String.copy(String.view(&newName))
            } else {
              run Overtone.stripAudioExt(String.view(&newName))
            }
            let newRel = run String.copy(String.view(&res.newRel))
            let newFull = run String.copy(String.view(&res.fullPath))
            if isDir {
              let mut ei: usize = 0
              while ei < self.expandedDirs.length() {
                let curExp = run String.copy(String.view(&self.expandedDirs.asSlice()[ei]))
                if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
                  String.view(&curExp),
                  String.view(&oldRel),
                  String.view(&newRel),
                ) {
                  let expMut = self.expandedDirs.asMutSlice()
                  expMut[ei] = move updated
                }
                ei = ei + 1
              }
              let curSel = run String.copy(String.view(&self.selectedFolderRel))
              if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
                String.view(&curSel),
                String.view(&oldRel),
                String.view(&newRel),
              ) {
                self.selectedFolderRel = move updated
              }
              let curActiveDir = run String.copy(String.view(&self.activeClipDir))
              if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
                String.view(&curActiveDir),
                String.view(&oldRel),
                String.view(&newRel),
              ) {
                self.activeClipDir = move updated
              }
              if String.byteLength(String.view(&oldFullPath)) > 0 {
                let curActivePath = run String.copy(String.view(&self.activeClipPath))
                if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
                  String.view(&curActivePath),
                  String.view(&oldFullPath),
                  String.view(&newFull),
                ) {
                  self.activeClipPath = move updated
                }
                if self.refClip.active {
                  let curRefPath = run String.copy(String.view(&self.refClip.fullPath))
                  if let Option<String>.Some { value: updated } = run Overtone.replacePathPrefix(
                    String.view(&curRefPath),
                    String.view(&oldFullPath),
                    String.view(&newFull),
                  ) {
                    self.refClip.fullPath = move updated
                  }
                }
              }
            } else {
              if String.view(&self.activeClipPath) == String.view(&oldFullPath) {
                self.clipName = run String.copy(String.view(&newDisp))
                self.activeClipFilename = run String.copy(String.view(&newName))
                self.activeClipPath = run String.copy(String.view(&newFull))
              }
              if self.refClip.active && String.view(&self.refClip.fullPath) == String.view(&oldFullPath) {
                self.refClip.name = run String.copy(String.view(&newDisp))
                self.refClip.fullPath = run String.copy(String.view(&newFull))
              }
            }
            run self.reloadTree(false)
            let mut msg = String.make()
            run msg.append(if isDir { "Renamed folder → " } else { "Renamed clip → " })
            run msg.append(String.view(&newDisp))
            self.statusMsg = move msg
          } else {
            self.errorMsg = run String.copy("Could not rename (an item with that name may already exist).")
          }
        } else {
          self.renamingRel.clear()
          self.renameDraft.clear()
          self.textInputFocused = false
        }
      }

      Message.EditCommentInput { text } => {
        self.activeCommentDraft = move text
        if self.activeClipInLib {
          drop audio_native.libUpdateMeta(
            String.view(&self.activeClipDir),
            String.view(&self.activeClipFilename),
            self.activeItemRating,
            self.activeItemStarred,
            -1,
            "",
            String.view(&self.activeCommentDraft),
          )
          run self.reloadTree(false)
        }
      }

      Message.DeleteLibEntry { idx } => {
        self.ctxMenuKind = CTX_NONE
        let nodes = self.libTree.asSlice()
        if idx < nodes.length {
          let parentCopy = run String.copy(String.view(&nodes[idx].parentRel))
          let nameCopy = run String.copy(String.view(&nodes[idx].name))
          let dispCopy = run String.copy(String.view(&nodes[idx].displayName))
          let relCopy = run String.copy(String.view(&nodes[idx].relPath))
          let fullCopy = run String.copy(String.view(&nodes[idx].fullPath))
          let isDir = nodes[idx].isDir
          if audio_native.libDeleteEntry(String.view(&parentCopy), String.view(&nameCopy), isDir) {
            if isDir {
              if Overtone.isSameOrSubpath(String.view(&self.selectedFolderRel), String.view(&relCopy)) {
                self.selectedFolderRel.clear()
              }
            } else if String.view(&self.activeClipPath) == String.view(&fullCopy) {
              self.activeClipPath.clear()
              self.activeClipFilename.clear()
              self.activeClipDir.clear()
              self.activeClipInLib = false
            }
            run self.reloadTree(false)
            let mut msg = String.make()
            run msg.append("Moved ")
            run msg.append(String.view(&dispCopy))
            run msg.append(" to Trash")
            self.statusMsg = move msg
          }
        }
      }

      Message.MoveEntryToRoot { idx } => {
        self.ctxMenuKind = CTX_NONE
        run self.moveLibEntry(idx, "")
      }

      Message.OpenExplorerCtx { kind, idx, x, y } => {
        self.ctxMenuKind = kind
        self.ctxMenuX = x
        self.ctxMenuY = y
        if kind == CTX_EXPLORER_ROOT {
          self.ctxExplorerIdx = 0
          self.ctxExplorerRel.clear()
          self.ctxExplorerParentRel.clear()
          self.ctxExplorerDisplayName = run String.copy("Overtone Library (/)")
          self.ctxExplorerIsDir = true
          self.ctxExplorerExpanded = true
          self.ctxExplorerStarred = false
          self.ctxExplorerIsRef = false
          self.ctxExplorerHasParentRef = false
        } else {
          let nodes = self.libTree.asSlice()
          if idx < nodes.length {
            self.ctxExplorerIdx = idx
            self.ctxExplorerRel = run String.copy(String.view(&nodes[idx].relPath))
            self.ctxExplorerParentRel = run String.copy(String.view(&nodes[idx].parentRel))
            self.ctxExplorerDisplayName = run String.copy(String.view(&nodes[idx].displayName))
            self.ctxExplorerIsDir = nodes[idx].isDir
            self.ctxExplorerExpanded = nodes[idx].expanded
            self.ctxExplorerStarred = nodes[idx].starred
            self.ctxExplorerIsRef = nodes[idx].isRef || nodes[idx].childCount > 0
            self.ctxExplorerHasParentRef = String.byteLength(String.view(&nodes[idx].parentRef)) > 0
          } else {
            self.ctxMenuKind = CTX_NONE
          }
        }
      }

      Message.ExplorerPanelLayout { rect } => {
        self.explorerPanelRect = rect
      }

      Message.ExplorerTreeLayout { rect } => {
        let oldH = self.explorerTreeRect.height()
        self.explorerTreeRect = rect
        if f32.abs(rect.height() - oldH) > 0.5 {
          run self.rebuildExplorerVisibleRows()
        }
      }

      Message.ExplorerWheel { dy } => {
        let viewH = f32.max(120.0, self.explorerTreeRect.height())
        let maxScroll = f32.max(0.0, self.explorerTotalH - viewH)
        let nextY = f32.max(0.0, f32.min(maxScroll, self.explorerScrollY + dy))
        if f32.abs(nextY - self.explorerScrollY) > 0.25 {
          self.explorerScrollY = nextY
          run self.rebuildExplorerVisibleRows()
        }
      }

      Message.ExplorerScrollTrackDown { y } => {
        self.ctxMenuKind = CTX_NONE
        self.drag = DRAG_EXPLORER_SCROLL
        let viewH = f32.max(120.0, self.explorerTreeRect.height())
        let maxScroll = f32.max(0.0, self.explorerTotalH - viewH)
        let frac = f32.max(0.0, f32.min(1.0, (y - self.explorerTreeRect.yMin) / viewH))
        self.explorerScrollY = frac * maxScroll
        run self.rebuildExplorerVisibleRows()
      }

      Message.ExplorerScrollMove { y } => {
        if self.drag == DRAG_EXPLORER_SCROLL {
          let viewH = f32.max(120.0, self.explorerTreeRect.height())
          let maxScroll = f32.max(0.0, self.explorerTotalH - viewH)
          let frac = f32.max(0.0, f32.min(1.0, (y - self.explorerTreeRect.yMin) / viewH))
          let nextY = frac * maxScroll
          if f32.abs(nextY - self.explorerScrollY) > 0.25 {
            self.explorerScrollY = nextY
            run self.rebuildExplorerVisibleRows()
          }
        }
      }

      Message.ExplorerScrollUp => {
        if self.drag == DRAG_EXPLORER_SCROLL {
          self.drag = DRAG_NONE
        }
      }

      Message.ExplorerRowLayout { idx, rect } => {
        while self.explorerRowRects.length() <= idx {
          run self.explorerRowRects.append(Rect<f32>.new(0.0, 0.0, 0.0, 0.0))
        }
        let rs = self.explorerRowRects.asMutSlice()
        rs[idx] = rect
      }

      Message.ExplorerRowDown { idx, x, y, button, modifiers } => {
        let nodes = self.libTree.asSlice()
        if idx >= nodes.length {
          return ()
        }
        if button == 2 {
          let k = if nodes[idx].isDir { CTX_EXPLORER_DIR } else { CTX_EXPLORER_FILE }
          run self.handleMessage(Message.OpenExplorerCtx { kind: k, idx: idx, x: x, y: y })
          return ()
        }
        self.ctxMenuKind = CTX_NONE
        if button == 0 {
          let cmd = (modifiers & (MOD_META | MOD_CONTROL)) != 0
          let shift = (modifiers & MOD_SHIFT) != 0
          if !nodes[idx].isDir && (cmd || self.libSelectMode) {
            let fp = run String.copy(String.view(&nodes[idx].fullPath))
            run self.toggleMultiSelectPath(String.view(&fp))
            self.lastSelectedLibIdx = usize.toI32(idx)
            return ()
          }
          if !nodes[idx].isDir && shift && self.lastSelectedLibIdx >= 0 {
            let anchor = i32.toUsize(self.lastSelectedLibIdx)
            run self.selectLibRange(anchor, idx)
            return ()
          }
          if !nodes[idx].isDir {
            self.lastSelectedLibIdx = usize.toI32(idx)
          }
          self.explorerDragPending = true
          self.explorerDragActive = false
          self.explorerDragIdx = idx
          self.explorerDragLabel = run String.copy(String.view(&nodes[idx].displayName))
          self.dragStartX = x
          self.dragStartY = y
          self.explorerDragX = x
          self.explorerDragY = y
          self.explorerDropTargetRel.clear()
          self.explorerDropTargetRefPath.clear()
          self.explorerDropTargetLabel.clear()
          self.explorerDropValid = false
        }
      }

      Message.ToggleRefGroupExpand { idx } => {
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let fp = run String.copy(String.view(&nodes[idx].fullPath))
          let fpView = String.view(&fp)
          let mut found = false
          let mut kept = List<String>.make()
          let sl = self.expandedDirs.asSlice()
          let mut i: usize = 0
          while i < sl.length {
            if String.view(&sl[i]) == fpView {
              found = true
            } else {
              run kept.append(run String.copy(String.view(&sl[i])))
            }
            i = i + 1
          }
          if !found {
            run kept.append(move fp)
          }
          self.expandedDirs = move kept
          run self.reloadTree(false)
          run self.saveSessionPrefs()
        }
      }

      Message.ToggleLibSelectMode => {
        self.ctxMenuKind = CTX_NONE
        self.libSelectMode = !self.libSelectMode
        if !self.libSelectMode {
          self.selectedClipPaths.clear()
          self.lastSelectedLibIdx = -1
        }
      }

      Message.EnterSelectModeWithClip { idx } => {
        self.ctxMenuKind = CTX_NONE
        self.libSelectMode = true
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let fp = run String.copy(String.view(&nodes[idx].fullPath))
          if !self.isClipMultiSelected(String.view(&fp)) {
            run self.toggleMultiSelectPath(String.view(&fp))
          }
          self.lastSelectedLibIdx = usize.toI32(idx)
        }
      }

      Message.ToggleSelectLibClip { idx } => {
        let nodes = self.libTree.asSlice()
        if idx < nodes.length && !nodes[idx].isDir {
          let fp = run String.copy(String.view(&nodes[idx].fullPath))
          run self.toggleMultiSelectPath(String.view(&fp))
          self.lastSelectedLibIdx = usize.toI32(idx)
        }
      }

      Message.SelectAllLibClips => {
        self.selectedClipPaths.clear()
        let nodes = self.libTree.asSlice()
        let mut i: usize = 0
        while i < nodes.length {
          if !nodes[i].isDir {
            run self.selectedClipPaths.append(run String.copy(String.view(&nodes[i].fullPath)))
          }
          i = i + 1
        }
      }

      Message.ClearLibSelection => {
        self.selectedClipPaths.clear()
        self.lastSelectedLibIdx = -1
        self.libSelectMode = false
      }

      Message.DeleteSelectedLibClips => {
        self.ctxMenuKind = CTX_NONE
        run self.deleteSelectedLibClips()
      }

      Message.CreateEmptyRef => {
        self.ctxMenuKind = CTX_NONE
        if isPractice(self.transport.value) {
          run self.sendTransport(TransportEvent.StopAll)
        }
        self.clearActiveRefSilent()
        run self.newDocument()
        self.pendingNewRef = true
        run self.saveSessionPrefs()
        self.statusMsg = run String.copy("New empty Reference · Press R to record or drop an audio file")
      }

      Message.SelectGeneralMode => {
        self.ctxMenuKind = CTX_NONE
        self.refClip.clear()
        self.gpuNeedRefReload = true
        self.plotOnRef = false
        self.listenMode = LISTEN_YOU
        self.selectedFolderRel = run String.copy("General")
        run self.ensureDirExpanded("General")
        run self.recomputeNormGain()
        run self.recomputeCompare()
        run self.reloadTree(false)
        run self.saveSessionPrefs()
        self.gpuNeedRedraw = true
        run self.rebuildDrawings(false)
        self.statusMsg = run String.copy("General (No Ref) mode · Loose recordings save into General")
      }

      Message.RecordOntoRef => {
        self.ctxMenuKind = CTX_NONE
        self.recordOntoRefOnce = true
        run self.sendTransport(TransportEvent.ToggleRecord)
      }

      Message.ToggleSplitRefSpec => {
        self.splitRefSpec = !self.splitRefSpec
        if self.splitRefSpec {
          self.plotOnRef = false
        }
        self.gpuNeedRedraw = true
        run self.rebuildDrawings(false)
        run self.saveSessionPrefs()
      }

      Message.SetListenMode { mode } => {
        self.listenMode = mode
        run self.saveSessionPrefs()
        if isPlayingUser(self.transport.value) {
          self.cursorSec = audio_native.playPosition()
          run self.sendTransport(TransportEvent.PlayFromCursor)
        }
      }

      Message.ToggleNormToRef => {
        self.normToRef = !self.normToRef
        run self.recomputeNormGain()
        self.gpuNeedRedraw = true
        run self.saveSessionPrefs()
        if isPlayingUser(self.transport.value) {
          self.cursorSec = audio_native.playPosition()
          run self.sendTransport(TransportEvent.PlayFromCursor)
        }
      }

      Message.BakeNormToRef => {
        self.ctxMenuKind = CTX_NONE
        run self.bakeNormToRef()
      }

      Message.TrimSilence => {
        self.ctxMenuKind = CTX_NONE
        run self.trimSilence()
      }

      Message.ToggleFavInput { id } => {
        let mut devName = String.make()
        let ins = self.inputDevices.asSlice()
        let mut i: usize = 0
        while i < ins.length {
          if ins[i].id == id || (id == 0 && i == 0) {
            devName = run String.copy(String.view(&ins[i].name))
            break
          }
          i = i + 1
        }
        if String.byteLength(String.view(&devName)) > 0 {
          if String.view(&self.favInputName) == String.view(&devName) {
            self.favInputName.clear()
            self.statusMsg = run String.copy("Cleared favorite microphone.")
          } else {
            self.favInputName = move devName
            run self.applyFavoriteAudioDevices()
            let mut msg = String.make()
            run msg.append("Favorite microphone ★ ")
            run msg.append(String.view(&self.favInputName))
            self.statusMsg = move msg
          }
          run self.saveSessionPrefs()
        }
      }

      Message.ToggleFavOutput { id } => {
        let mut devName = String.make()
        let outs = self.outputDevices.asSlice()
        let mut i: usize = 0
        while i < outs.length {
          if outs[i].id == id || (id == 0 && i == 0) {
            devName = run String.copy(String.view(&outs[i].name))
            break
          }
          i = i + 1
        }
        if String.byteLength(String.view(&devName)) > 0 {
          if String.view(&self.favOutputName) == String.view(&devName) {
            self.favOutputName.clear()
            self.statusMsg = run String.copy("Cleared favorite output device.")
          } else {
            self.favOutputName = move devName
            run self.applyFavoriteAudioDevices()
            let mut msg = String.make()
            run msg.append("Favorite output ★ ")
            run msg.append(String.view(&self.favOutputName))
            self.statusMsg = move msg
          }
          run self.saveSessionPrefs()
        }
      }

      Message.ExplorerEmptyDown { x, y, button } => {
        if button == 2 {
          run self.handleMessage(Message.OpenExplorerCtx { kind: CTX_EXPLORER_ROOT, idx: 0, x: x, y: y })
          return ()
        }
        self.ctxMenuKind = CTX_NONE
        if String.byteLength(String.view(&self.selectedFolderRel)) > 0 {
          self.selectedFolderRel.clear()
          run self.reloadTree(true)
          self.statusMsg = run String.copy("Deselected folder · Target: Root (/)")
        }
      }

      Message.ExplorerPointerMove { x, y } => {
        if self.drag == DRAG_RESIZE_LIB {
          let dx = x - self.dragStartX
          self.libWidth = f32.max(160.0, f32.min(420.0, self.resizeStartWidth + dx))
          self.gpuNeedResize = true
          return ()
        }
        if self.drag == DRAG_RESIZE_READOUTS {
          let dx = self.dragStartX - x
          self.readoutsWidth = f32.max(248.0, f32.min(480.0, self.resizeStartWidth + dx))
          self.gpuNeedResize = true
          return ()
        }
        if self.explorerDragPending && !self.explorerDragActive {
          let dx = x - self.dragStartX
          let dy = y - self.dragStartY
          if dx * dx + dy * dy >= 25.0 {
            self.explorerDragActive = true
            self.drag = DRAG_EXPLORER
            run self.updateExplorerDropTarget(x, y)
          }
        } else if self.explorerDragActive {
          run self.updateExplorerDropTarget(x, y)
        }
      }

      Message.ExplorerPointerUp => {
        if self.drag == DRAG_RESIZE_LIB || self.drag == DRAG_RESIZE_READOUTS {
          let wasRight = self.drag == DRAG_RESIZE_READOUTS
          self.drag = DRAG_NONE
          self.gpuNeedResize = true
          if wasRight {
            run self.rebuildDrawings(true)
          }
          return ()
        }
        if self.explorerDragActive {
          let doMove = self.explorerDropValid
          let srcIdx = self.explorerDragIdx
          let dstRel = run String.copy(String.view(&self.explorerDropTargetRel))
          let dstRefPath = run String.copy(String.view(&self.explorerDropTargetRefPath))
          self.explorerDragPending = false
          self.explorerDragActive = false
          self.explorerDropValid = false
          self.explorerDropTargetRel.clear()
          self.explorerDropTargetRefPath.clear()
          self.explorerDropTargetLabel.clear()
          self.drag = DRAG_NONE
          if doMove {
            if String.byteLength(String.view(&dstRefPath)) > 0 {
              run self.attachLibEntryToRef(srcIdx, String.view(&dstRefPath))
            } else {
              run self.moveLibEntry(srcIdx, String.view(&dstRel))
            }
          }
        } else if self.explorerDragPending {
          let idx = self.explorerDragIdx
          self.explorerDragPending = false
          let nodes = self.libTree.asSlice()
          if idx < nodes.length {
            if nodes[idx].isDir {
              run self.handleMessage(Message.ToggleLibFolder { idx: idx })
            } else {
              self.selectedClipPaths.clear()
              run self.loadLibraryClip(idx, false)
            }
          }
        }
      }

      Message.ClearGuides => {
        self.ctxMenuKind = CTX_NONE
        self.guides.clear()
        run self.rebuildDrawings(false)
      }

      Message.AddGuideAtHover => {
        if self.hoverValid && self.specRect.height() > 2.0 {
          let fNorm = 1.0 - f32.toF64(self.hoverY / self.specRect.height())
          let hz = self.vp.normToFreqAt(fNorm)
          run self.addGuideHz(hz)
        }
      }

      Message.ToggleGuidesPanel => {
        self.showGuidesPanel = !self.showGuidesPanel
        if self.showGuidesPanel {
          self.showAudioPanel = false
        }
      }

      Message.GuideInputChanged { text } => {
        self.guideInputDraft = move text
      }

      Message.AddGuideFromInput => {
        let hz = parseFreqOrNote(String.view(&self.guideInputDraft))
        if hz > 0.0 {
          self.guideInputDraft.clear()
          run self.addGuideHz(hz)
          let mut msg = String.make()
          run msg.append("Added guide line at ")
          let hs = run formatHzFull(hz)
          run msg.append(String.view(&hs))
          run msg.append(" (")
          let ns = run formatNoteFull(hz)
          run msg.append(String.view(&ns))
          run msg.append(").")
          self.statusMsg = move msg
        } else {
          self.statusMsg = run String.copy("Enter Hz (e.g. 220, 1.8k) or a note (e.g. A3, C#4, Bb3).")
        }
      }

      Message.AddGuideHz { hz } => {
        self.ctxMenuKind = CTX_NONE
        run self.addGuideHz(hz)
      }

      Message.AddGuideAtCursor => {
        let pfOpt = self.pitchTrack.nearest(self.cursorSec)
        if let Option<PitchFrame>.Some { value: pf } = pfOpt {
          if pf.voiced && pf.frequency > 0.0 {
            run self.addGuideHz(pf.frequency)
            return ()
          }
        }
        if self.selPitchStats.valid {
          let hz = self.selPitchStats.meanHz
          run self.addGuideHz(hz)
        } else {
          self.statusMsg = run String.copy("No voiced pitch at cursor — hover spectrogram and press G, or type Hz/note.")
        }
      }

      Message.AddGuideAtRefMean => {
        if self.refClip.active && self.refClip.summary.medianF0 > 0.0 {
          let hz = self.refClip.summary.medianF0
          run self.addGuideHz(hz)
        }
      }

      Message.RemoveGuide { idx } => {
        self.ctxMenuKind = CTX_NONE
        if idx < self.guides.length() {
          let mut next = List<f64>.make()
          let cur = self.guides.asSlice()
          let mut i: usize = 0
          while i < cur.length {
            if i != idx {
              run next.append(cur[i])
            }
            i = i + 1
          }
          self.guides = move next
          run self.rebuildDrawings(false)
        }
      }

      // Audio I/O Device Picker
      Message.ToggleAudioPanel => {
        self.showAudioPanel = !self.showAudioPanel
        if self.showAudioPanel {
          self.showGuidesPanel = false
          audio_native.refreshAudioDevices()
          self.inputDevices = run audio_native.listInputDevices()
          self.outputDevices = run audio_native.listOutputDevices()
          self.selectedInputId = audio_native.getInputDevice()
          self.selectedOutputId = audio_native.getOutputDevice()
        }
      }

      Message.RefreshAudioDevices => {
        audio_native.refreshAudioDevices()
        self.inputDevices = run audio_native.listInputDevices()
        self.outputDevices = run audio_native.listOutputDevices()
        self.selectedInputId = audio_native.getInputDevice()
        self.selectedOutputId = audio_native.getOutputDevice()
        run self.applyFavoriteAudioDevices()
        self.statusMsg = run String.copy("Refreshed audio input & output devices.")
      }

      Message.SelectInputDevice { id } => {
        drop audio_native.setInputDevice(id)
        self.selectedInputId = id
        self.ctxMenuKind = CTX_NONE
        run self.syncDeviceNames()
        if self.recording && self.practiceMode == PRACTICE_OFF {
          audio_native.micStop()
          drop audio_native.micStartAt(self.sampleRate)
        }
        let mut msg = String.make()
        run msg.append("Input mic: ")
        run msg.append(String.view(&self.readoutActiveMic))
        self.statusMsg = move msg
      }

      Message.SelectOutputDevice { id } => {
        drop audio_native.setOutputDevice(id)
        self.selectedOutputId = id
        self.ctxMenuKind = CTX_NONE
        run self.syncDeviceNames()
        if isPlayingUser(self.transport.value) {
          self.cursorSec = audio_native.playPosition()
          run self.sendTransport(TransportEvent.PlayFromCursor)
        }
        let mut msg = String.make()
        run msg.append("Output device: ")
        run msg.append(String.view(&self.readoutActiveOut))
        self.statusMsg = move msg
      }

      // Audio Editing (Copy / Cut / Delete / Paste / Undo)
      Message.CopySelection => {
        self.ctxMenuKind = CTX_NONE
        run self.copySelection()
      }

      Message.CutSelection => {
        self.ctxMenuKind = CTX_NONE
        run self.removeSelectionRange(true)
      }

      Message.DeleteSelection => {
        self.ctxMenuKind = CTX_NONE
        run self.removeSelectionRange(false)
      }

      Message.PasteAtCursor => {
        self.ctxMenuKind = CTX_NONE
        run self.pasteAtCursor()
      }

      Message.UndoEdit => {
        self.ctxMenuKind = CTX_NONE
        run self.undoEdit()
      }

      // Exercise Script / Notes scratchpad (auto-saved per folder in .overtone.json)
      Message.ToggleNotesPanel => {
        self.showNotesPanel = !self.showNotesPanel
      }

      Message.EditSessionNotes { text } => {
        self.sessionNotes = move text
        drop audio_native.libSetNotes(String.view(&self.selectedFolderRel), String.view(&self.sessionNotes))
      }

      Message.InsertNotesPreset { preset } => {
        let next = if preset == 1 {
          run String.copy("When the sunlight strikes raindrops in the air, they act as a prism and form a rainbow. The rainbow is a division of white light into many beautiful colors.")
        } else if preset == 2 {
          run String.copy("Heat · Hit · Hate · Bet · Bat · Hot · Caught · Boat · Put · Boot\nKeep resonance bright & forward (/i/ → /e/ → /ɑ/) with light vocal weight.")
        } else {
          String.make()
        }
        self.sessionNotes = move next
        drop audio_native.libSetNotes(String.view(&self.selectedFolderRel), String.view(&self.sessionNotes))
      }

      // Spectrogram Visibility & Dimming
      Message.ToggleSpectrogram => {
        self.ctxMenuKind = CTX_NONE
        self.showSpectrogram = !self.showSpectrogram
        if self.showSpectrogram && self.specOpacity < 0.05 {
          self.specOpacity = 1.0
        }
      }

      Message.SetSpecOpacityPreset { opacity } => {
        self.ctxMenuKind = CTX_NONE
        self.specOpacity = opacity
        self.showSpectrogram = opacity > 0.01
      }

      // Praat F5 Query Pitch
      Message.QuerySelectionPitch => {
        self.ctxMenuKind = CTX_NONE
        if self.hasSelection && self.selPitchStats.valid {
          let st = self.selPitchStats
          let mut msg = String.make()
          run msg.append("Praat Mean: ")
          run appendFixed(&mut msg, st.meanHz, 1)
          run msg.append(" Hz (")
          let n1 = run formatNoteFull(st.meanHz)
          run msg.append(String.view(&n1))
          run msg.append(") · Log: ")
          run appendFixed(&mut msg, st.logMeanHz, 1)
          run msg.append(" Hz · Med: ")
          run appendFixed(&mut msg, st.medianHz, 1)
          run msg.append(" Hz · Range: ")
          run appendFixed(&mut msg, st.minHz, 0)
          run msg.append("–")
          run appendFixed(&mut msg, st.maxHz, 0)
          run msg.append(" Hz (±")
          run appendFixed(&mut msg, st.sdSemitones, 1)
          run msg.append(" st)")
          self.statusMsg = move msg
        } else {
          let dur = self.gpuDuration()
          let onRef = self.isPlottingOnRef()
          let frames = if onRef { self.refClip.pitchFrames.asSlice() } else { self.pitchTrack.frames.asSlice() }
          let dx = usize.toF64(self.pitchTrack.hopSamples) / f64.max(self.pitchTrack.sampleRate, 1.0)
          let st = run selectionPitchStats(frames, dx, 0.0, dur, self.displayClarity)
          if st.valid {
            let mut msg = String.make()
            run msg.append("Clip Praat Mean: ")
            run appendFixed(&mut msg, st.meanHz, 1)
            run msg.append(" Hz (")
            let n1 = run formatNoteFull(st.meanHz)
            run msg.append(String.view(&n1))
            run msg.append(") · Log: ")
            run appendFixed(&mut msg, st.logMeanHz, 1)
            run msg.append(" Hz · Med: ")
            run appendFixed(&mut msg, st.medianHz, 1)
            run msg.append(" Hz (Shift+Drag to query a selection)")
            self.statusMsg = move msg
          }
        }
      }

      Message.NewDocument => {
        run self.newDocument()
      }

      Message.SelectAll => {
        let dur = self.gpuDuration()
        if dur > 0.01 {
          self.hasSelection = true
          self.selStart = 0.0
          self.selEnd = dur
          self.ctxMenuKind = CTX_NONE
          run self.updateSelectionReadout()
          let mut msg = String.make()
          run msg.append("Selected full clip (0.0s–")
          let ds = run formatSecShort(dur)
          run msg.append(String.view(&ds))
          run msg.append(")")
          if String.byteLength(String.view(&self.readoutSelPitchChip)) > 0 {
            run msg.append(" · ")
            run msg.append(String.view(&self.readoutSelPitchChip))
          }
          self.statusMsg = move msg
        }
      }

      Message.TextFocusChanged { focused } => {
        self.textInputFocused = focused
      }

      Message.GlobalKeyDown { key, modifiers } => {
        let k = String.view(&key)
        let cmd = (modifiers & (MOD_META | MOD_CONTROL)) != 0
        if cmd && (k == "o" || k == "O") {
          self.pendingOpenDialog = true
        } else if cmd && (k == "s" || k == "S") {
          run self.saveCurrentClipToFolder(false)
        } else if cmd && (k == "a" || k == "A") {
          run self.handleMessage(Message.SelectAll)
        } else if cmd && (k == "n" || k == "N") {
          run self.newDocument()
        } else if cmd && (k == "r" || k == "R") {
          run self.handleMessage(Message.RecordNewClip)
        } else if cmd && (k == "c" || k == "C") {
          run self.copySelection()
        } else if cmd && (k == "x" || k == "X") {
          run self.removeSelectionRange(true)
        } else if cmd && (k == "v" || k == "V") {
          run self.pasteAtCursor()
        } else if cmd && (k == "z" || k == "Z") {
          run self.undoEdit()
        } else if cmd && k == "," {
          run self.handleMessage(Message.ToggleSettings)
        } else if !cmd {
          if k == "Escape" {
            if String.byteLength(String.view(&self.renamingRel)) > 0 {
              run self.handleMessage(Message.CancelRenameEntry)
            } else if self.showNewFolderInput {
              self.showNewFolderInput = false
              self.newFolderDraft.clear()
            } else if self.ctxMenuKind != CTX_NONE {
              self.ctxMenuKind = CTX_NONE
            } else if self.showSettings {
              self.showSettings = false
            } else if self.libSelectMode || self.selectedClipPaths.length() > 0 {
              run self.handleMessage(Message.ClearLibSelection)
            } else {
              run self.handleMessage(Message.ClearSelection)
            }
          } else if k == " " {
            run self.handleMessage(Message.TogglePlay)
          } else if k == "F2" {
            run self.startRenameActiveOrSelected()
          } else if k == "r" || k == "R" {
            run self.handleMessage(Message.ToggleRecord)
          } else if k == "d" || k == "D" {
            run self.handleMessage(Message.ToggleDrillMode)
          } else if k == "e" || k == "E" {
            run self.handleMessage(Message.ToggleEchoMode)
          } else if k == "p" || k == "P" {
            run self.handleMessage(Message.PinReference)
          } else if k == "b" || k == "B" {
            run self.handleMessage(Message.TogglePlotOnRef)
          } else if k == "l" || k == "L" {
            run self.handleMessage(Message.ToggleLoop)
          } else if k == "g" || k == "G" {
            run self.handleMessage(Message.AddGuideAtHover)
          } else if k == "h" || k == "H" {
            run self.handleMessage(Message.ToggleSpectrogram)
          } else if k == "n" || k == "N" {
            run self.handleMessage(Message.ToggleNotesPanel)
          } else if k == "F5" {
            run self.handleMessage(Message.QuerySelectionPitch)
          } else if k == "Backspace" || k == "Delete" {
            if self.hasSelection {
              run self.removeSelectionRange(false)
            } else if self.selectedClipPaths.length() > 0 {
              run self.deleteSelectedLibClips()
            }
          } else if k == "0" {
            run self.handleMessage(Message.ResetView)
          } else if k == "ArrowLeft" {
            run self.handleMessage(Message.PanStep { dir: -0.15 })
          } else if k == "ArrowRight" {
            run self.handleMessage(Message.PanStep { dir: 0.15 })
          } else if k == "=" || k == "+" {
            run self.handleMessage(Message.ZoomStep { factor: 0.72 })
          } else if k == "-" {
            run self.handleMessage(Message.ZoomStep { factor: 1.38 })
          }
        }
      }

      Message.OpenContextMenu { kind, x, y } => {
        if self.ctxMenuKind == kind && kind != CTX_SPEC {
          self.ctxMenuKind = CTX_NONE
        } else {
          if kind == CTX_AUDIO {
            audio_native.refreshAudioDevices()
            self.inputDevices = run audio_native.listInputDevices()
            self.outputDevices = run audio_native.listOutputDevices()
            self.selectedInputId = audio_native.getInputDevice()
            self.selectedOutputId = audio_native.getOutputDevice()
          }
          self.ctxMenuKind = kind
          self.ctxMenuX = x
          self.ctxMenuY = y
        }
      }

      Message.CloseContextMenu => {
        self.ctxMenuKind = CTX_NONE
      }

      Message.PlayFromTime { sec } => {
        self.ctxMenuKind = CTX_NONE
        let dur = self.gpuDuration()
        self.cursorSec = f64.max(0.0, f64.min(dur, sec))
        self.hasSelection = false
        self.readoutSelSpan.clear()
        run self.sendTransport(TransportEvent.PlayFromCursor)
      }

      Message.PasteAtTime { sec } => {
        self.ctxMenuKind = CTX_NONE
        let dur = self.gpuDuration()
        self.cursorSec = f64.max(0.0, f64.min(dur, sec))
        self.hasSelection = false
        run self.pasteAtCursor()
      }

      Message.SelectPalette { idx } => {
        self.palette = paletteFromIndex(idx)
        self.gpuNeedPalette = true
        self.gpuNeedRedraw = true
        self.ctxMenuKind = CTX_NONE
      }

      Message.SetPlaySpeed { speed } => {
        let sp = f32.max(0.25, f32.min(2.0, speed))
        self.playSpeed = sp
        audio_native.setPlaySpeed(sp)
        run self.updateSpeedReadout()
        self.ctxMenuKind = CTX_NONE
      }

      Message.ToggleScrubAudio => {
        self.scrubAudio = !self.scrubAudio
        if !self.scrubAudio {
          audio_native.scrubStop()
        }
      }

      Message.ToggleFollowRecording => {
        self.followRecording = !self.followRecording
      }

      Message.SetRecGapSec { sec } => {
        self.recSilenceGapSec = f64.max(0.0, f64.min(2.0, sec))
      }

      Message.StartGuideDrag { idx, y } => {
        if idx < self.guides.length() {
          self.ctxMenuKind = CTX_NONE
          self.drag = DRAG_GUIDE
          self.dragGuideIdx = idx
          self.dragStartY = y - self.specRect.yMin
        }
      }

      Message.ToggleGuideSnap => {
        self.snapGuidesToNote = !self.snapGuidesToNote
      }

      Message.TimeRulerDown { x, y } => {
        self.ctxMenuKind = CTX_NONE
        self.drag = DRAG_TIME_RULER
        self.followRecording = false
        self.dragStartX = x
        self.dragStartY = y
        self.dragStartVp = self.vp
        let w = f32.max(1.0, self.specRect.width())
        self.dragTimeRulerAnchorNorm = f64.max(0.0, f64.min(1.0, f32.toF64((x - self.specRect.xMin) / w)))
      }

      Message.TimeRulerMove { x, y } => {
        if self.drag == DRAG_TIME_RULER {
          let w = f32.max(1.0, self.specRect.width())
          let dxNorm = f32.toF64((self.dragStartX - x) / w)
          let dy = f32.toF64(y - self.dragStartY)
          self.vp = self.dragStartVp
          // Vertical drag stretches/compresses visible time; horizontal drag slides visible time!
          if f64.abs(dy) > 2.0 {
            let factor = f64.exp(dy * 0.012)
            self.vp.zoomTimeAbout(self.dragTimeRulerAnchorNorm, factor)
          }
          self.vp.panTime(dxNorm)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        }
      }

      Message.TimeRulerUp => {
        if self.drag == DRAG_TIME_RULER {
          self.drag = DRAG_NONE
        }
      }

      Message.SetFreqRangePreset { f0, f1 } => {
        let maxF = self.vp.maxFreq
        self.vp.setFreqRange(f0, f64.min(f1, maxF))
        self.scheduleSharp()
        run self.updateViewportDrawings()
      }

      Message.SetPitchRangePreset { floorHz, ceilHz } => {
        self.pitchConfig.floorHz = floorHz
        self.pitchConfig.ceilingHz = ceilHz
        run self.updatePitchRangeReadout()
        run self.reanalyzeRefClip()
        run self.analyzeAll()
        run self.rebuildDrawings(false)
      }

      Message.SetMatchWeightsPreset { pitch, size, weight, vowel } => {
        self.matchWeights = MatchWeights { pitch: pitch, size: size, weight: weight, vowel: vowel }
        run self.updateWeightReadouts()
        run self.recomputeCompare()
      }

      Message.ToggleHeatmap => {
        self.showHeatmap = !self.showHeatmap
        run self.updateViewportDrawings()
      }

      Message.ToggleNeural => {
        self.useNeural = !self.useNeural
        if self.useNeural {
          self.requestNeuralForTake()
          self.requestNeuralForRef()
        } else {
          run self.analyzeAll()
          run self.reanalyzeRefClip()
          run self.recomputeCompare()
          run self.rebuildDrawings(true)
        }
      }

      Message.NeuralReady { jobId, isRef, hasPitch, hasFormants } => {
        run self.applyNeuralReady(jobId, isRef, hasPitch, hasFormants)
      }

      Message.NeuralStatus { flags } => {
        self.neuralStatusFlags = flags
      }

      Message.SetIsolateMode { mode } => {
        self.isolateMode = mode
        if self.playing {
          if self.playingRefOnly {
            run self.doStartRefPlayback()
          } else {
            run self.doStartPlayback()
          }
        }
        run self.updateViewportDrawings()
      }

      Message.SetIsolateTiming { timing } => {
        if self.isolateTiming != timing {
          self.isolateTiming = timing
          // Auto-switch from Full -> Vowels if user picked Compact or Stretch timing!
          if timing != TIMING_INPLACE && self.isolateMode == ISOLATE_FULL {
            self.isolateMode = ISOLATE_VOWELS
            run self.updateViewportDrawings()
          }
          if self.playing && self.isolateMode != ISOLATE_FULL {
            if self.playingRefOnly {
              run self.doStartRefPlayback()
            } else {
              run self.doStartPlayback()
            }
          }
        }
      }

      Message.SetVoiceLabMode { mode } => {
        self.voiceLabMode = mode
        if self.playing {
          if self.playingRefOnly {
            run self.doStartRefPlayback()
          } else {
            run self.doStartPlayback()
          }
        }
      }

      Message.SetNeuralPhonemes { enabled } => {
        if self.useNeuralPhonemes != enabled {
          self.useNeuralPhonemes = enabled
          audio_native.phonemeSetEnabled(self.useNeuralPhonemes)
          run self.refreshVowelAnalysis(false)
          if self.refClip.active {
            run self.refreshVowelAnalysis(true)
          }
          run self.rebuildDrawings(false)
        }
      }

      Message.ToggleNeuralPhonemes => {
        self.useNeuralPhonemes = !self.useNeuralPhonemes
        audio_native.phonemeSetEnabled(self.useNeuralPhonemes)
        run self.refreshVowelAnalysis(false)
        if self.refClip.active {
          run self.refreshVowelAnalysis(true)
        }
        run self.rebuildDrawings(false)
      }

      Message.ToggleVowelOverlay => {
        self.showVowelRegions = !self.showVowelRegions
        run self.updateViewportDrawings()
      }

      Message.PhonemesReady { jobId, isRef } => {
        run self.applyPhonemesReady(jobId, isRef)
      }

      Message.SelectVowelSpan { idx } => {
        let onRef = self.isPlottingOnRef()
        let spans = if onRef { self.refVowelSpans.asSlice() } else { self.takeVowelSpans.asSlice() }
        if idx < spans.length {
          let t0 = spans[idx].t0
          let t1 = spans[idx].t1
          self.hasSelection = true
          self.selStart = t0
          self.selEnd = t1
          self.cursorSec = t0
          self.loopSelection = true
          self.ctxMenuKind = CTX_NONE
          run self.updateSelectionReadout()
          run self.rebuildDrawings(true)
          if self.playing && !self.playingRefOnly {
            run self.doStartPlayback()
          } else {
            run self.sendTransport(TransportEvent.TogglePlay)
          }
        }
      }

      Message.StepVowelSpan { delta } => {
        let onRef = self.isPlottingOnRef()
        let spans = if onRef { self.refVowelSpans.asSlice() } else { self.takeVowelSpans.asSlice() }
        if spans.length > 0 {
          let curMid = if self.hasSelection { 0.5 * (self.selStart + self.selEnd) } else { self.cursorSec }
          let mut bestIdx: usize = 0
          let mut bestDist = 1e9
          let mut i: usize = 0
          while i < spans.length {
            let m = 0.5 * (spans[i].t0 + spans[i].t1)
            let d = f64.abs(m - curMid)
            if d < bestDist {
              bestDist = d
              bestIdx = i
            }
            i = i + 1
          }
          let nextIdx: usize = if delta < 0 {
            if bestIdx > 0 { bestIdx - 1 } else { spans.length - 1 }
          } else {
            if bestIdx + 1 < spans.length { bestIdx + 1 } else { 0 }
          }
          run self.handleMessage(Message.SelectVowelSpan { idx: nextIdx })
        }
      }

      Message.PlayKlattAtCursor => {
        let mut f0 = if self.voiceMetrics.summary.medianF0 > 55.0 { self.voiceMetrics.summary.medianF0 } else { 195.0 }
        let mut f1 = if self.voiceMetrics.summary.formantCount > 0 { self.voiceMetrics.summary.meanF1 } else { 520.0 }
        let mut f2 = if self.voiceMetrics.summary.formantCount > 0 { self.voiceMetrics.summary.meanF2 } else { 1650.0 }
        let mut f3 = 2750.0
        let mut f4 = 3650.0
        let tilt = self.voiceMetrics.summary.medianH1H2Db * 0.45
        if let Option<PitchFrame>.Some { value: pf } = self.pitchTrack.nearest(self.cursorSec) {
          if pf.voiced && pf.frequency > 55.0 { f0 = pf.frequency }
        }
        if let Option<FormantFrame>.Some { value: ff } = self.formantTrack.nearest(self.cursorSec) {
          if ff.tracked && ff.f1 > 160.0 && ff.f2 > ff.f1 + 120.0 {
            f1 = ff.f1
            f2 = ff.f2
            if ff.f3 > ff.f2 + 180.0 { f3 = ff.f3 }
            if ff.f4 > f3 + 350.0 { f4 = ff.f4 }
          }
        }
        drop audio_native.klattPlay(f0, f1, f2, f3, f4, 0.65, tilt)
      }

      Message.PlayKlattAtRef => {
        if self.refClip.active {
          let mut f0 = if self.refClip.summary.medianF0 > 55.0 { self.refClip.summary.medianF0 } else { 210.0 }
          let mut f1 = if self.refClip.summary.formantCount > 0 { self.refClip.summary.meanF1 } else { 520.0 }
          let mut f2 = if self.refClip.summary.formantCount > 0 { self.refClip.summary.meanF2 } else { 1750.0 }
          let mut f3 = 2850.0
          let tilt = self.refClip.summary.medianH1H2Db * 0.45
          // Prefer Ref's aligned frame at cursor if available
          let pts = self.compare.points.asSlice()
          let mut bestDist = 1e9
          let mut i: usize = 0
          while i < pts.length {
            let d = f64.abs(pts[i].time - self.cursorSec)
            if d < bestDist && pts[i].voiced {
              bestDist = d
              if pts[i].f0 > 55.0 { f0 = pts[i].f0 }
              if pts[i].hasFormants && pts[i].f1 > 160.0 && pts[i].f2 > pts[i].f1 + 120.0 {
                f1 = pts[i].f1
                f2 = pts[i].f2
                f3 = f64.max(f2 + 520.0, 2800.0)
              }
            }
            i = i + 1
          }
          drop audio_native.klattPlay(f0, f1, f2, f3, f3 + 850.0, 0.65, tilt)
        }
      }

      Message.PlayKlattAtSelection => {
        if self.hasSelection {
          let lo = f64.min(self.selStart, self.selEnd)
          let hi = f64.max(self.selStart, self.selEnd)
          let margin = f64.min(0.015, (hi - lo) * 0.15)
          let a = lo + margin
          let b = hi - margin
          let mut sf0 = 0.0
          let mut cf0: usize = 0
          let mut sf1 = 0.0
          let mut sf2 = 0.0
          let mut sf3 = 0.0
          let mut sf4 = 0.0
          let mut cfmt: usize = 0
          let pfs = self.pitchTrack.frames.asSlice()
          let mut i: usize = 0
          while i < pfs.length {
            if pfs[i].time >= a && pfs[i].time <= b && pfs[i].voiced && pfs[i].frequency > 55.0 {
              sf0 = sf0 + pfs[i].frequency
              cf0 = cf0 + 1
            }
            i = i + 1
          }
          let ffs = self.formantTrack.frames.asSlice()
          i = 0
          while i < ffs.length {
            if ffs[i].time >= a && ffs[i].time <= b && ffs[i].tracked && ffs[i].f1 > 160.0 && ffs[i].f2 > ffs[i].f1 + 120.0 {
              sf1 = sf1 + ffs[i].f1
              sf2 = sf2 + ffs[i].f2
              sf3 = sf3 + (if ffs[i].f3 > ffs[i].f2 + 180.0 { ffs[i].f3 } else { 2750.0 })
              sf4 = sf4 + (if ffs[i].f4 > 3100.0 { ffs[i].f4 } else { 3650.0 })
              cfmt = cfmt + 1
            }
            i = i + 1
          }
          let f0 = if cf0 > 0 { sf0 / usize.toF64(cf0) } else if self.voiceMetrics.summary.medianF0 > 55.0 { self.voiceMetrics.summary.medianF0 } else { 195.0 }
          let f1 = if cfmt > 0 { sf1 / usize.toF64(cfmt) } else { 520.0 }
          let f2 = if cfmt > 0 { sf2 / usize.toF64(cfmt) } else { 1650.0 }
          let f3 = if cfmt > 0 { sf3 / usize.toF64(cfmt) } else { 2750.0 }
          let f4 = if cfmt > 0 { sf4 / usize.toF64(cfmt) } else { 3650.0 }
          let tilt = self.voiceMetrics.summary.medianH1H2Db * 0.45
          drop audio_native.klattPlay(f0, f1, f2, f3, f4, 0.72, tilt)
        } else {
          run self.handleMessage(Message.PlayKlattAtCursor)
        }
      }

      Message.VowelChartLayout { rect } => {
        self.vowelChartRect = rect
      }

      Message.ClickVowelChart { x, y } => {
        let rx = x - self.vowelChartRect.xMin
        let ry = y - self.vowelChartRect.yMin
        let w = f32.max(120.0, self.vowelChartRect.width())
        let h = f32.max(60.0, self.vowelChartRect.height())
        let f2 = vowelF2OfX(rx, w)
        let f1 = vowelF1OfY(ry, h)
        let res = f32.toF64(self.vowelResonance)
        let f3 = f64.max(f2 + 420.0, 2520.0 * f64.pow(2880.0 / 2520.0, res))
        let f0 = if self.voiceMetrics.summary.medianF0 > 55.0 {
          self.voiceMetrics.summary.medianF0
        } else {
          130.0 * f64.pow(210.0 / 130.0, res)
        }
        let tilt = self.voiceMetrics.summary.medianH1H2Db * 0.45
        drop audio_native.klattPlay(f0, f1, f2, f3, f3 + 850.0, 0.58, tilt)
      }

      Message.ToggleVoicePreview => {
        self.showVoicePreview = !self.showVoicePreview
        if self.showVoicePreview {
          self.showGuidesPanel = false
          self.ctxMenuKind = CTX_NONE
          if self.refClip.active && self.compare.valid {
            run self.fillSynthFromRef()
          } else {
            run self.syncSynthReadouts()
          }
        }
      }

      Message.PlaySynthAdjusted => {
        run self.playSynthAdjusted()
      }

      Message.PlayOriginalPreview => {
        if self.samples.length() > 64 {
          audio_native.playStop()
          let dur = self.clipDuration()
          let startS = if self.hasSelection { f64.min(self.selStart, self.selEnd) } else { 0.0 }
          let endS = if self.hasSelection { f64.max(self.selStart, self.selEnd) } else { dur }
          drop audio_native.playRange(self.samples.asSlice(), self.sampleRate, startS, endS, false)
        }
      }

      Message.StopSynthPreview => {
        audio_native.playStop()
      }

      Message.PinSynthAsRef => {
        run self.pinSynthPreviewAsRef()
      }

      Message.ToggleSynthPitch => {
        self.synthPitchOn = !self.synthPitchOn
        run self.syncSynthReadouts()
      }

      Message.ToggleSynthSize => {
        self.synthSizeOn = !self.synthSizeOn
        run self.syncSynthReadouts()
      }

      Message.ToggleSynthWeight => {
        self.synthWeightOn = !self.synthWeightOn
        run self.syncSynthReadouts()
      }

      Message.ToggleSynthContour => {
        self.synthFollowContour = !self.synthFollowContour
        run self.syncSynthReadouts()
      }

      Message.SynthMatchRef => {
        run self.fillSynthFromRef()
      }

      Message.SynthReset => {
        self.synthPitchSemi = 0.0
        self.synthSizePct = 0.0
        self.synthWeightDb = 0.0
        self.synthMorph = 1.0
        self.synthPitchOn = true
        self.synthSizeOn = true
        self.synthWeightOn = true
        self.synthFollowContour = false
        run self.syncSynthReadouts()
      }

      Message.SynthPreset { pitch, size, weight } => {
        self.synthPitchSemi = pitch
        self.synthSizePct = size
        self.synthWeightDb = weight
        self.synthMorph = 1.0
        self.synthPitchOn = true
        self.synthSizeOn = true
        self.synthWeightOn = true
        self.synthFollowContour = false
        run self.syncSynthReadouts()
      }

      Message.SetSynthMorph { morph } => {
        self.synthMorph = f32.max(0.0, f32.min(1.0, morph))
        run self.syncSynthReadouts()
      }

      Message.SetHeatmapMetric { metric } => {
        if self.heatmapMetric == metric && metric != HEATMAP_OVERALL {
          self.heatmapMetric = HEATMAP_OVERALL
        } else {
          self.heatmapMetric = metric
          self.showHeatmap = true
        }
        run self.updateViewportDrawings()
      }

      Message.ToggleFormantBit { bit } => {
        if !self.showFormants {
          self.showFormants = true
          self.formantMask = bit
        } else {
          self.formantMask = self.formantMask ^ bit
          if self.formantMask == 0 {
            self.showFormants = false
          }
        }
        run self.updateViewportDrawings()
      }

      Message.SetFormantMask { mask } => {
        self.ctxMenuKind = CTX_NONE
        if mask == 0 {
          self.showFormants = false
        } else {
          self.showFormants = true
          self.formantMask = mask
        }
        run self.updateViewportDrawings()
      }

      Message.SetBottomLaneTab { tab } => {
        self.bottomLaneTab = tab
      }

      Message.SetVowelResonance { value } => {
        self.vowelResonance = f32.max(0.0, f32.min(1.0, value))
        run self.rebuildDrawings(false)
        run self.saveSessionPrefs()
      }

      Message.ApplyVowelGuides { idx } => {
        if idx < VOWELS_MASC.length {
          let res = f32.toF64(self.vowelResonance)
          let v = vowelLandmarkAt(idx, res)
          // Audition the clicked IPA vowel target through the Klatt formant synth!
          let f0 = if self.voiceMetrics.summary.medianF0 > 55.0 {
            self.voiceMetrics.summary.medianF0
          } else {
            130.0 * f64.pow(210.0 / 130.0, res)
          }
          drop audio_native.klattPlay(f0, v.f1, v.f2, v.f3, v.f3 + 850.0, 0.62, self.voiceMetrics.summary.medianH1H2Db * 0.4)
          if !self.clickVowelAddsGuides {
            return ()
          }
          self.guides.clear()
          run self.guides.append(v.f1)
          run self.guides.append(v.f2)
          run self.guides.append(v.f3)
          let mut msg = String.make()
          run msg.append(if res < 0.30 { "Dark /" } else if res > 0.70 { "Bright /" } else { "Balanced /" })
          run msg.append(v.ipa)
          run msg.append("/ ('")
          run msg.append(v.hint)
          run msg.append("') guides: F1 ")
          run appendFixed(&mut msg, v.f1, 0)
          run msg.append(" · F2 ")
          run appendFixed(&mut msg, v.f2, 0)
          run msg.append(" · F3 ")
          run appendFixed(&mut msg, v.f3, 0)
          run msg.append(" Hz")
          self.statusMsg = move msg
          run self.rebuildDrawings(false)
        }
      }

      Message.ToggleSettings => {
        self.showSettings = !self.showSettings
        if self.showSettings {
          self.ctxMenuKind = CTX_NONE
          audio_native.refreshAudioDevices()
          self.inputDevices = run audio_native.listInputDevices()
          self.outputDevices = run audio_native.listOutputDevices()
          self.selectedInputId = audio_native.getInputDevice()
          self.selectedOutputId = audio_native.getOutputDevice()
        }
      }

      Message.OpenSettingsTab { tab } => {
        self.showSettings = true
        self.settingsTab = tab
        self.ctxMenuKind = CTX_NONE
        if tab == SET_AUDIO || tab == SET_PLAYBACK {
          audio_native.refreshAudioDevices()
          self.inputDevices = run audio_native.listInputDevices()
          self.outputDevices = run audio_native.listOutputDevices()
          self.selectedInputId = audio_native.getInputDevice()
          self.selectedOutputId = audio_native.getOutputDevice()
        }
      }

      Message.CloseSettings => {
        self.showSettings = false
      }

      Message.SetFormantCeilingPreset { hz } => {
        self.formantCeilingHz = hz
        run self.reanalyzeFormants()
      }

      Message.SpecLayout { rect } => {
        let changed = f32.abs(rect.width() - self.specRect.width()) > 0.5
          || f32.abs(rect.height() - self.specRect.height()) > 0.5
          || f32.abs(rect.xMin - self.specRect.xMin) > 0.5
          || f32.abs(rect.yMin - self.specRect.yMin) > 0.5
        self.specRect = rect
        if changed && rect.width() >= 16.0 && rect.height() >= 16.0 {
          self.gpuTargetW = f32.toU32(rect.width() * 2.0)
          self.gpuTargetH = f32.toU32(rect.height() * 2.0)
          self.gpuNeedResize = true
          self.scheduleSharp()
          run self.rebuildDrawings(false)
        }
      }

      Message.OverviewLayout { rect } => {
        self.overviewRect = rect
        run self.rebuildDrawings(false)
      }

      Message.SliceLayout { rect } => {
        if f32.abs(rect.height() - self.sliceHeight) > 0.5 && rect.height() >= 16.0 {
          self.sliceHeight = rect.height()
          run self.rebuildDrawings(false)
        }
      }

      Message.SpecDown { x, y, button, modifiers } => {
        let lx = x - self.specRect.xMin
        let ly = y - self.specRect.yMin
        let w = f32.max(1.0, self.specRect.width())
        let h = f32.max(1.0, self.specRect.height())
        let t = self.vp.normToTimeAt(f32.toF64(lx / w))
        let fNorm = self.yToFreqNorm(ly, h)
        let freqHz = self.vp.normToFreqAt(fNorm)
        let dur = self.gpuDuration()
        self.dragStartX = lx
        self.dragStartY = ly
        self.dragStartVp = self.vp
        self.hoverValid = true
        self.hoverX = lx
        self.hoverY = ly

        // Right-click opens VoceVista-style Spectrogram Context Menu!
        if button == 2 {
          self.ctxMenuKind = CTX_SPEC
          self.ctxMenuX = x
          self.ctxMenuY = y
          self.ctxMenuTimeSec = f64.max(0.0, f64.min(dur, t))
          self.ctxMenuFreqHz = freqHz
          self.ctxMenuGuideIdx = self.findGuideNearY(ly, 8.0)
          let mut hdr = String.make()
          let ts = run formatTime(self.ctxMenuTimeSec)
          run hdr.append(String.view(&ts))
          run hdr.append(" · ")
          let hs = run formatHzFull(freqHz)
          run hdr.append(String.view(&hs))
          run hdr.append(" (")
          let ns = run formatNoteFull(freqHz)
          run hdr.append(String.view(&ns))
          run hdr.append(")")
          self.ctxMenuHeader = move hdr
          return ()
        }

        self.ctxMenuKind = CTX_NONE
        let altPan = (modifiers & MOD_ALT) != 0 || button == 1
        let shiftSelect = (modifiers & MOD_SHIFT) != 0
        let hitGuide = if !altPan && !shiftSelect { self.findGuideNearY(ly, 7.0) } else { -1 }

        if hitGuide >= 0 {
          self.drag = DRAG_GUIDE
          self.dragGuideIdx = i32.toUsize(hitGuide)
        } else if altPan {
          self.drag = DRAG_PAN
          self.followRecording = false
        } else if shiftSelect {
          self.drag = DRAG_SELECT
          self.hasSelection = true
          let ct = f64.max(0.0, f64.min(dur, t))
          self.selStart = ct
          self.selEnd = ct
          run self.updateSelectionReadout()
        } else {
          self.drag = DRAG_SCRUB
          self.cursorSec = f64.max(0.0, f64.min(dur, t))
          if isPlayingUser(self.transport.value) {
            run self.sendTransport(TransportEvent.PlayFromCursor)
          } else if self.scrubAudio && !self.recording && !isPractice(self.transport.value) && dur > 0.02 {
            run self.sendTransport(TransportEvent.ScrubStart)
          }
          run self.updateCursorFast(true)
        }
      }

      Message.SpecMove { x, y, modifiers } => {
        let lx = x - self.specRect.xMin
        let ly = y - self.specRect.yMin
        self.hoverValid = true
        self.hoverX = lx
        self.hoverY = ly
        let w = f32.max(1.0, self.specRect.width())
        let h = f32.max(1.0, self.specRect.height())
        let dur = self.gpuDuration()

        if self.drag == DRAG_GUIDE {
          if self.dragGuideIdx < self.guides.length() {
            let fNorm = self.yToFreqNorm(ly, h)
            let mut hz = f64.max(20.0, f64.min(22000.0, self.vp.normToFreqAt(fNorm)))
            // Snap to nearest musical note if enabled (Alt reverses snapping, like VoceVista!)
            let altHeld = (modifiers & MOD_ALT) != 0
            let doSnap = if altHeld { !self.snapGuidesToNote } else { self.snapGuidesToNote }
            if doSnap {
              let nr = frequencyToNote(hz)
              hz = midiToFrequency(nr.midi)
            }
            let gsMut = self.guides.asMutSlice()
            gsMut[self.dragGuideIdx] = hz
            run self.updateViewportDrawings()
            let mut hs = String.make()
            run hs.append("Guide → ")
            let hzs = run formatHzFull(hz)
            run hs.append(String.view(&hzs))
            run hs.append(" (")
            let ns = run formatNoteFull(hz)
            run hs.append(String.view(&ns))
            run hs.append(")")
            self.hoverReadout = move hs
          }
        } else if self.drag == DRAG_PAN {
          self.vp = self.dragStartVp
          let dxNorm = f32.toF64((self.dragStartX - lx) / w)
          let dyNorm = f32.toF64((ly - self.dragStartY) / h)
          self.vp.panTime(dxNorm)
          self.vp.panFreq(dyNorm)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        } else if self.drag == DRAG_SELECT {
          let t = self.vp.normToTimeAt(f32.toF64(lx / w))
          self.selEnd = f64.max(0.0, f64.min(dur, t))
          run self.updateSelectionReadout()
          run self.updateHoverOnly()
        } else if self.drag == DRAG_SCRUB {
          let t = self.vp.normToTimeAt(f32.toF64(lx / w))
          self.cursorSec = f64.max(0.0, f64.min(dur, t))
          match self.transport.value {
            TransportState.Scrubbing => {
              audio_native.scrubMove(self.cursorSec)
            }
            _ => ()
          }
          run self.updateCursorFast(false)
        } else {
          run self.updateHoverOnly()
        }
      }

      Message.SpecUp { x, y } => {
        drop x
        drop y
        let wasScrub = self.drag == DRAG_SCRUB
        if wasScrub {
          match self.transport.value {
            TransportState.Scrubbing => {
              run self.sendTransport(TransportEvent.ScrubEnd)
            }
            _ => ()
          }
        }
        if self.drag == DRAG_SELECT && f64.abs(self.selEnd - self.selStart) < 0.015 {
          self.hasSelection = false
          self.readoutSelSpan.clear()
        }
        if wasScrub && isPlayingUser(self.transport.value) {
          run self.sendTransport(TransportEvent.PlayFromCursor)
        }
        self.drag = DRAG_NONE
        if wasScrub {
          run self.updateCursorFast(true)
        } else {
          run self.updateSelectionReadout()
        }
      }

      Message.SpecLeave => {
        self.hoverValid = false
        self.hoverReadout.clear()
      }

      Message.SpecWheel { x, y, dx, dy, modifiers } => {
        let lx = x - self.specRect.xMin
        let ly = y - self.specRect.yMin
        let w = f32.max(1.0, self.specRect.width())
        let h = f32.max(1.0, self.specRect.height())
        let ax = f64.max(0.0, f64.min(1.0, f32.toF64(lx / w)))
        let ay = f64.max(0.0, f64.min(1.0, 1.0 - f32.toF64(ly / h)))
        self.followRecording = false

        let alt = (modifiers & MOD_ALT) != 0
        let shift = (modifiers & MOD_SHIFT) != 0
        let cmd = (modifiers & MOD_META) != 0
        let ctrl = (modifiers & MOD_CONTROL) != 0

        if cmd {
          // VoceVista-style Command + scroll zooms time (and frequency too when holding Alt/Option)
          let factor = f64.exp(f32.toF64(dy) * 0.0045)
          self.vp.zoomTimeAbout(ax, factor)
          if alt {
            self.vp.zoomFreqAbout(ay, factor)
          }
        } else if ctrl {
          // Trackpad pinch (browsers synthesize ctrlKey + wheel) — opt-in via Settings -> Playback
          if self.enablePinchZoom {
            let factor = f64.exp(f32.toF64(dy) * 0.006)
            self.vp.zoomTimeAbout(ax, factor)
            self.vp.zoomFreqAbout(ay, factor)
          } else {
            return ()
          }
        } else if alt {
          let factor = f64.exp(f32.toF64(dy) * 0.0035)
          self.vp.zoomFreqAbout(ay, factor)
        } else if shift {
          let d = if f32.abs(dx) > f32.abs(dy) { dx } else { dy }
          self.vp.panTime(f32.toF64(d) * 0.0025)
        } else {
          // Plain two-finger scroll = clean, steady 2D panning (zero accidental zoom wobble!)
          if f32.abs(dx) > 0.25 {
            self.vp.panTime(f32.toF64(dx) * 0.0022)
          }
          if f32.abs(dy) > 0.25 {
            self.vp.panFreq(-f32.toF64(dy) * 0.0022)
          }
        }
        self.scheduleSharp()
        run self.updateViewportDrawings()
      }

      Message.OverviewDown { x } => {
        self.ctxMenuKind = CTX_NONE
        self.followRecording = false
        let w = f32.max(1.0, self.overviewRect.width())
        let lx = x - self.overviewRect.xMin
        let dur = f64.max(self.vp.duration, 0.05)
        let norm = f64.max(0.0, f64.min(1.0, f32.toF64(lx / w)))
        let leftPx = f64.toF32((self.vp.t0 / dur) * f32.toF64(w))
        let rightPx = f64.toF32((self.vp.t1 / dur) * f32.toF64(w))
        let edgeTol: f32 = 9.0

        // VoceVista-style move & stretch visible time window!
        if f32.abs(lx - leftPx) <= edgeTol && (rightPx - leftPx) > 12.0 {
          self.drag = DRAG_OVERVIEW_LEFT
        } else if f32.abs(lx - rightPx) <= edgeTol && (rightPx - leftPx) > 12.0 {
          self.drag = DRAG_OVERVIEW_RIGHT
        } else if lx >= leftPx && lx <= rightPx {
          self.drag = DRAG_OVERVIEW
          self.dragOverviewOffsetNorm = norm - (self.vp.t0 / dur)
        } else {
          self.drag = DRAG_OVERVIEW
          let span = self.vp.t1 - self.vp.t0
          let centre = norm * dur
          self.vp.setTimeRange(centre - span * 0.5, centre + span * 0.5)
          self.dragOverviewOffsetNorm = norm - (self.vp.t0 / dur)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        }
      }

      Message.OverviewMove { x } => {
        let w = f32.max(1.0, self.overviewRect.width())
        let dur = f64.max(self.vp.duration, 0.05)
        let norm = f64.max(0.0, f64.min(1.0, f32.toF64((x - self.overviewRect.xMin) / w)))
        let t = norm * dur
        if self.drag == DRAG_OVERVIEW_LEFT {
          let maxT0 = f64.max(0.0, self.vp.t1 - 0.05)
          let newT0 = f64.max(0.0, f64.min(maxT0, t))
          let curT1 = self.vp.t1
          self.vp.setTimeRange(newT0, curT1)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        } else if self.drag == DRAG_OVERVIEW_RIGHT {
          let minT1 = f64.min(dur, self.vp.t0 + 0.05)
          let newT1 = f64.max(minT1, f64.min(dur, t))
          let curT0 = self.vp.t0
          self.vp.setTimeRange(curT0, newT1)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        } else if self.drag == DRAG_OVERVIEW {
          let span = self.vp.t1 - self.vp.t0
          let newT0 = (norm - self.dragOverviewOffsetNorm) * dur
          self.vp.setTimeRange(newT0, newT0 + span)
          self.scheduleSharp()
          run self.updateViewportDrawings()
        }
      }

      Message.OverviewUp => {
        if self.drag == DRAG_OVERVIEW || self.drag == DRAG_OVERVIEW_LEFT || self.drag == DRAG_OVERVIEW_RIGHT {
          self.drag = DRAG_NONE
        }
      }

      Message.SliderLayout { id, rect } => {
        let idx = u32.toUsize(id)
        if idx < 23 {
          self.sliderLeft[idx] = rect.xMin
          self.sliderWidth[idx] = rect.width()
        }
      }

      Message.SliderDown { id, x, left, width } => {
        let idx = u32.toUsize(id)
        if idx < 23 && width > 1.0 {
          self.sliderLeft[idx] = left
          self.sliderWidth[idx] = width
        }
        self.drag = DRAG_SLIDER
        self.dragSlider = id
        run self.applySliderAt(id, x)
      }

      Message.SliderMove { x } => {
        if self.drag == DRAG_SLIDER {
          let id = self.dragSlider
          run self.applySliderAt(id, x)
        }
      }

      Message.SliderUp => {
        if self.drag == DRAG_SLIDER {
          self.drag = DRAG_NONE
        }
      }

      Message.ToggleClickVowelGuides => {
        self.clickVowelAddsGuides = !self.clickVowelAddsGuides
      }

      Message.ClearError => {
        self.errorMsg.clear()
      }

      Message.ClearSelection => {
        if isPractice(self.transport.value) {
          run self.sendTransport(TransportEvent.StopAll)
        } else {
          self.hasSelection = false
          self.readoutSelSpan.clear()
          self.selPitchStats = SelectionPitchStats.empty()
          self.readoutSelPitchChip.clear()
          self.readoutSelPitchMain.clear()
          self.readoutSelPitchSub.clear()
          run self.updateSelectionCompare()
          run self.rebuildDrawings(false)
        }
      }

      Message.PanStep { dir } => {
        self.vp.panTime(dir)
        self.scheduleSharp()
        run self.rebuildDrawings(false)
      }

      Message.ZoomStep { factor } => {
        self.vp.zoomTimeAbout(0.5, factor)
        self.scheduleSharp()
        run self.rebuildDrawings(false)
      }
    }
  }
}

impl Perform<Message, OutOfMemoryError ? &mut Allocator> for Command {
  effect fn perform(self: Self) -> Message
    ! OutOfMemoryError
    ? &mut Allocator {
    return match move self {
      Command.OpenFileDialog => Message.AskOpenFile
      Command.SaveWavDialog => Message.AskSaveWav
    }
  }
}

impl App<Message, Command> for Overtone {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    renderDocument<Message>(&mut ui, |h| studioView.render(self, h))
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<Command>) -> () {
    cx.alloc(self.handleMessage(move message))
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    if self.recording || self.playing || self.gpuNeedSharp || self.practiceMode != PRACTICE_OFF || self.bgScoreActive {
      subs.animationFrame(1, |t| Message.Tick { time: t })
    }
  }
}
