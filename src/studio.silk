effect fn copyF32List(src: &[f32]) -> List<f32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut dst = List<f32>.make()
  run dst.appendSlice(src)
  return move dst
}

impl Overtone {
  pub effect fn init() -> Overtone
    ! OutOfMemoryError
    ? &mut Allocator {
    let coarseWin = run WindowCache.blackmanNuttall(COARSE_WINDOW_SIZE)
    let sharpWin = run WindowCache.blackmanNuttall(DEFAULT_WINDOW_SIZE)
    let emptyDraw = run Drawing.make(List<CanvasCommand>.make())
    let demoSamples = run synthDemoVoice()
    let dur = usize.toF64(demoSamples.length()) / SYNTH_SAMPLE_RATE
    let mut vp = Viewport.make(dur, SYNTH_SAMPLE_RATE * 0.5)
    vp.setTimeRange(0.0, dur)

    // Initialize stdlib silk.machine transport statechart
    let transport = run beginTransport()

    // Scan real folders & audio files at ~/Documents/Overtone Library/
    let mut expandedDirs = List<String>.make()
    let initScan = run audio_native.libScanTree("", "", "", SORT_ALPHA)
    // Auto-expand the first folder on launch if there are folders and no root-level audio files
    let mut hasRootFile = false
    let mut firstFolderRel = String.make()
    let initNodes = initScan.nodes.asSlice()
    let mut ni: usize = 0
    while ni < initNodes.length {
      if !initNodes[ni].isDir {
        hasRootFile = true
      } else if String.byteLength(String.view(&firstFolderRel)) == 0 {
        firstFolderRel = run String.copy(String.view(&initNodes[ni].relPath))
      }
      ni = ni + 1
    }
    let listing = if !hasRootFile && String.byteLength(String.view(&firstFolderRel)) > 0 {
      let expCopy = run String.copy(String.view(&firstFolderRel))
      run expandedDirs.append(move expCopy)
      run audio_native.libScanTree(String.view(&firstFolderRel), "", "", SORT_ALPHA)
    } else {
      move initScan
    }
    let libTree = move listing.nodes
    let sessionNotes = move listing.notes

    // Enumerate macOS CoreAudio input & output devices
    audio_native.refreshAudioDevices()
    let inputDevices = run audio_native.listInputDevices()
    let outputDevices = run audio_native.listOutputDevices()
    let selectedInputId = audio_native.getInputDevice()
    let selectedOutputId = audio_native.getOutputDevice()

    let mut model = Overtone {
      transport: move transport,
      clipName: run String.copy("Demo Voice (/ɑ e i o u/)"),
      samples: move demoSamples,
      sampleRate: SYNTH_SAMPLE_RATE,
      recording: false,
      playing: false,
      playingRefOnly: false,
      loopSelection: false,
      followRecording: true,
      cursorSec: 1.85,
