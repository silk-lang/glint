  OpenFileDialog,
  SaveWavDialog,
}

pub union Message {
  Tick { pub time: f64 },
  ToggleRecord,
  RecordNewClip,
  TogglePlay,
  ToggleLoop,
  LoadDemo,
  AskOpenFile,
  AskSaveWav,
  FileChosen { pub path: String },
